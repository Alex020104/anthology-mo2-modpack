-- Edited by Ncenka
-- Edited by Sys 21.06.2025
local hint_shown = false
--------------------------------------------------------------------------
-- Добавляем в начало скрипта, где другие настройки
local health_penalty = true      -- включить ограничение максимального здоровья
local stamina_penalty = true     -- включить ограничение максимальной выносливости
local max_penalty = 0.7          -- максимальное снижение (70%)
--------------------------------------------------------------------------

-- НАКОПЛЕНИЕ ТОКСИНОВ ПРИ ЗАРАЖЕНИИ РАДИАЦИЕЙ

local radiation_add_toxins = true	-- разрешить повышение уровня токсинов из-за радиации

-- ВСПЛЫВАЮЩЕЕ УВЕДОМЛЕНИЕ О ТОКСИНАХ
local enable_message = true		-- разрешить показывать уведомления
local message_feelings = true	-- показывать фразы от лица героя
local message_received = 0	-- проверка, приходило ли сообщение

-- НАСТРОЙКА СКОРОСТИ ВЫВЕДЕНИЯ ТОКСИНОВ
local nat_detox = 0.05			-- стандартное количество выведения токсинов в секунду
local sleep_detox = 12.5		-- количество выведенных токсинов за один час сна
local damage_poison = 0.002		-- базовый урон при интоксикации в секунду

local toxine_tbl = {}			-- таблица количества токсинов
local drugs_toxine = {}			-- значение количества токсинов у предмета
local detox_tbl = {}			-- таблица усиления выведения токсинов
local drugs_detox = {}			-- значение усиления выведения токсинов
local drugs_time_tbl = {}		-- таблица времени действия усиления
local detox_time = {}			-- значение времени действия предмета

function on_game_load()
	if not (toxine_tbl.toxine) then toxine_tbl.toxine = 0 end
	if not (detox_tbl.detox) then detox_tbl.detox = 0 end
	if not (drugs_time_tbl.time) then drugs_time_tbl.time = 0 end
end

function save_state(m_data)
	m_data.toxine_tbl = toxine_tbl
	m_data.detox_tbl = detox_tbl
	m_data.drugs_time_tbl = drugs_time_tbl
end

function load_state(m_data)
	toxine_tbl = m_data.toxine_tbl or {}
	detox_tbl = m_data.detox_tbl or {}
	drugs_time_tbl = m_data.drugs_time_tbl or {}
end

function get_toxine_value(obj)
	local ini_toxic_boosters = ini_file("items\\settings\\items_toxic.ltx")
	local n = ini_toxic_boosters:line_count("toxic")
	for i=0,n-1 do
		result, id, value = ini_toxic_boosters:r_line_ex("toxic",i,"","")
		drugs_toxine[id] = value
	end
	if obj then return drugs_toxine[obj:section()] and tonumber(drugs_toxine[obj:section()]) or 0 end
	return 0
end

function get_detox_value(obj)
	local ini_detox_boosters = ini_file("items\\settings\\items_detox.ltx")
	local n = ini_detox_boosters:line_count("detox")
	for i=0,n-1 do
		result, id, value = ini_detox_boosters:r_line_ex("detox",i,"","")
		drugs_detox[id] = value
	end
	if obj then return drugs_detox[obj:section()] and tonumber(drugs_detox[obj:section()]) or 0 end
	return 0
end

function get_detox_boost_time(obj)
	local ini_detox_time = ini_file("items\\settings\\detox_time.ltx")
	local n = ini_detox_time:line_count("time")
	for i=0,n-1 do
		result, id, value = ini_detox_time:r_line_ex("time",i,"","")
		detox_time[id] = value
	end
	if obj then return detox_time[obj:section()] and tonumber(detox_time[obj:section()]) or 0 end
	return 0
end

function actor_on_item_use(obj)
	local toxine_value = obj and get_toxine_value(obj) or 0
	local detox_value = obj and get_detox_value(obj) or 0
	local detox_effect = detox_tbl.detox
	local boost_time_value = obj and get_detox_boost_time(obj) or 0
	
	if toxine_value and (toxine_value > 0) then
		toxine_tbl.toxine = toxine_tbl.toxine + toxine_value
	elseif (toxine_value < 0) then
		if detox_value and (detox_value > 0) then
			if (detox_effect < detox_value) then
				toxine_tbl.toxine = toxine_tbl.toxine + toxine_value
				detox_tbl.detox = detox_value
				if boost_time_value and (boost_time_value > 0) then
					drugs_time_tbl.time = boost_time_value
				end
			elseif (detox_effect == detox_value) then
				toxine_tbl.toxine = toxine_tbl.toxine + toxine_value
				detox_tbl.detox = detox_value
				if boost_time_value and (boost_time_value > 0) and (drugs_time_tbl.time > 0) then
					drugs_time_tbl.time = drugs_time_tbl.time + boost_time_value
				end
			elseif (detox_effect > detox_value) then
				toxine_tbl.toxine = toxine_tbl.toxine + toxine_value * 2
			end
		end
	end
end

function actor_on_sleep(hours)
	local sleep_detox_value = sleep_detox * hours
	local sleep_detox_effect = detox_tbl.detox * nat_detox
	local detox_time = drugs_time_tbl.time
	local sleep_detox_time = hours * 360
	local sleep_detox_boost = sleep_detox_effect * sleep_detox_time
	
	if (detox_time > 0) then
		local sleep_boost_time = detox_time - sleep_detox_time
		if (sleep_boost_time > 0) then
			drugs_time_tbl.time = sleep_boost_time
			toxine_tbl.toxine = toxine_tbl.toxine - (sleep_detox_value + sleep_detox_boost)
		else
			drugs_time_tbl.time = 0
			toxine_tbl.toxine = toxine_tbl.toxine - (sleep_detox_value + sleep_detox_effect * detox_time)
		end
	else
		toxine_tbl.toxine = toxine_tbl.toxine - sleep_detox_value
	end
end

function nature_detox()
	toxine_tbl.toxine = toxine_tbl.toxine - nat_detox
	RemoveTimeEvent("toxine_timer", "nature_detox")
end

function boost_detox()
	local toxine = toxine_tbl.toxine
	local detox = nat_detox * detox_tbl.detox
	drugs_time_tbl.time = drugs_time_tbl.time - 1
	if (toxine > 0) then
		toxine_tbl.toxine = toxine_tbl.toxine - detox
	end
	RemoveTimeEvent("toxine_timer", "boost_detox")
end

function toxine_damage()
	local toxine = toxine_tbl.toxine
	local damage = damage_poison
	
	if (toxine >= 90) then
		db.actor.health = db.actor.health - damage * 5 -- -1 hp/sec при 100%
	elseif (toxine >= 90) then
		db.actor.health = db.actor.health - damage * 2 -- -0.5 hp/sec при 90%
	end
	RemoveTimeEvent("toxine_timer", "toxine_damage")
end

function toxine_effects()
	local toxine = toxine_tbl.toxine

	-- Убираем все эффекты сначала
	level.remove_pp_effector(420)
	level.remove_pp_effector(430)
	level.remove_pp_effector(440)
	level.remove_pp_effector(450)
	level.remove_pp_effector(470)
	level.remove_pp_effector(480)
	level.remove_pp_effector(490)
	level.remove_pp_effector(500)
	level.remove_pp_effector(510)
	level.remove_pp_effector(520)
	level.remove_pp_effector(530)
	level.remove_pp_effector(540)
	level.remove_pp_effector(550)

	if (toxine >= 90) then -- Красная иконка, смертельные эффекты
		level.add_pp_effector("alcohol.ppe", 450, false)
		level.set_pp_effector_factor(450, 0.8)
		level.add_pp_effector("old_psi.ppe", 500, false)
		level.set_pp_effector_factor(500, 0.8)
		level.add_pp_effector("inv_medkit.ppe", 510, false)
		level.set_pp_effector_factor(510, 0.8)
		if (enable_message == true) and (message_received ~= 6) then
			if (message_feelings == true) then
				actor_menu.set_msg(1, (game.translate_string("ui_toxins_status_6")), 5)
			else
				display_toxine()
			end
			message_received = 6
		end
	elseif (toxine >= 60) then -- Желтая иконка, серьезные эффекты
		level.add_pp_effector("alcohol.ppe", 440, false)
		level.set_pp_effector_factor(440, 0.5)
		level.add_pp_effector("old_psi.ppe", 490, false)
		level.set_pp_effector_factor(490, 0.5)
		if (enable_message == true) and (message_received ~= 3) then
			if (message_feelings == true) then
				actor_menu.set_msg(1, (game.translate_string("ui_toxins_status_3")), 5)
			else
				display_toxine()
			end
			message_received = 3
		end
	elseif (toxine >= 40) then -- Желтая иконка, средние эффекты
		level.add_pp_effector("alcohol.ppe", 430, false)
		level.set_pp_effector_factor(430, 0.3)
		level.add_pp_effector("old_psi.ppe", 480, false)
		level.set_pp_effector_factor(480, 0.3)
		if (enable_message == true) and (message_received ~= 2) then
			if (message_feelings == true) then
				actor_menu.set_msg(1, (game.translate_string("ui_toxins_status_2")), 5)
			else
				display_toxine()
			end
			message_received = 2
		end
	elseif (toxine >= 21) then -- Зеленая иконка, слабые эффекты
		level.add_pp_effector("alcohol.ppe", 420, false)
		level.set_pp_effector_factor(420, 0.1)
		level.add_pp_effector("old_psi.ppe", 470, false)
		level.set_pp_effector_factor(470, 0.1)
		if (enable_message == true) and (message_received ~= 1) then
			if (message_feelings == true) then
				actor_menu.set_msg(1, (game.translate_string("ui_toxins_status_1")), 5)
			else
				display_toxine()
			end
			message_received = 1
		end
	else -- Нет эффектов
		if (enable_message == true) and (message_received ~= 0) then
			if (message_feelings == true) then
				actor_menu.set_msg(1, (game.translate_string("ui_toxins_status_0")), 5)
			else
				display_toxine()
			end
			message_received = 0
		end
	end
	RemoveTimeEvent("toxine_timer", "toxine_effects")
end

function toxine_timer()
	local toxine = toxine_tbl.toxine
	local time_boost_detox = drugs_time_tbl.time
	
	if (toxine > 0) and (time_boost_detox <= 0) then
		CreateTimeEvent("toxine_timer", "nature_detox", 1, nature_detox)
	end
	
	if (time_boost_detox > 0) then
		CreateTimeEvent("toxine_timer", "boost_detox", 1, boost_detox)			
	else
		drugs_time_tbl.time = 0
		detox_tbl.detox = 0
	end
	
	if (toxine >= 21) then
		CreateTimeEvent("toxine_timer", "toxine_effects", 5, toxine_effects)
	end
	
	if (toxine >= 60) then
		CreateTimeEvent("toxine_timer", "toxine_damage", 1, toxine_damage)
	end
	
	if (toxine < 0) then
		toxine_tbl.toxine = 0
	end
	
	if (radiation_add_toxins == true) then
		CreateTimeEvent("toxine_timer", "rad_toxine", 10, rad_toxine)
	end
end

function rad_toxine()
	local radiation = db.actor.radiation
	toxine_tbl.toxine = toxine_tbl.toxine + radiation
	RemoveTimeEvent("toxine_timer", "rad_toxine")
end

function actor_on_update()
	toxine_timer()
	cap_health_and_stamina()
end

function display_toxine()
	local rounded_toxine = round_idp(toxine_tbl.toxine, 2)
	local power_detox = round_idp((detox_tbl.detox/100), 2)
	local time_detox = round_idp(drugs_time_tbl.time, 0)
	local time_boost = drugs_time_tbl.time

	if (time_boost > 0) and hint_shown == true then
		actor_menu.set_msg(1, (game.translate_string("ui_toxine") .. ": " .. rounded_toxine .. "%; " .. game.translate_string("ui_boost_detox") .. ": " .. power_detox .. game.translate_string("ui_toxine_time") .. "; " .. game.translate_string("ui_boost_detox_time") .. ": " .. time_detox), 5)
	elseif hint_shown == true then
		actor_menu.set_msg(1, (game.translate_string("ui_toxine") .. ": " .. rounded_toxine .. "%; " .. game.translate_string("ui_nat_detox") .. ": " .. nat_detox .. game.translate_string("ui_toxine_time")), 5)
	end
end

-- Функция ограничения здоровья и выносливости
function cap_health_and_stamina()
    local toxine = toxine_tbl.toxine or 0
    
    if health_penalty then
        local health_cap = 1
        if toxine >= 90 then
            health_cap = 0.3 -- 30% здоровья при 90-100%
        elseif toxine >= 60 then
            health_cap = 0.5 -- 50% здоровья при 60-90%
        elseif toxine >= 40 then
            health_cap = 0.7 -- 80% здоровья при 40-60%
        elseif toxine >= 20 then
            health_cap = 0.9 -- 90% здоровья при 20-40%
        end
        
        if (toxine >= 20) and (db.actor.health > health_cap) then
            db.actor.health = clamp(health_cap, 0, 1)
        end
    end
    
    if stamina_penalty then
        local stamina_cap = 1
        if toxine >= 90 then
            stamina_cap = 0.3 -- 30% выносливости при 90-100%
        elseif toxine >= 60 then
            stamina_cap = 0.5 -- 60% выносливости при 60-90%
        elseif toxine >= 40 then
            stamina_cap = 0.7 -- 80% выносливости при 40-60%
        elseif toxine >= 20 then
            stamina_cap = 0.9 -- 90% выносливости при 20-40%
        end
        
        if (toxine >= 20) and (db.actor.power > stamina_cap) then
            db.actor.power = clamp(stamina_cap, 0, 1)
        end
    end
end
-------------------------------------------------------------------------------------
-- Сохраняем оригинальную функцию без изменений
local OriginalBuildHeader = ui_item.build_desc_header

-- Наш независимый обработчик
function ui_item.build_desc_header(obj, sec, str)
    -- 1. Получаем оригинальное описание (с простудой и другими эффектами)
    local original_result = OriginalBuildHeader(obj, sec, str)
    
    -- 2. Добавляем ТОЛЬКО наши токсины (если они есть)
    local toxine_value = obj and (get_toxine_value(obj) or 0) or 0
    local detox_value = obj and (get_detox_value(obj) or 0) or 0
    local boost_time_value = obj and (get_detox_boost_time(obj) or 0) or 0

    -- Формируем строку эффекта
    local toxine_str = ""
    if toxine_value > 0 then
        toxine_str = utils_xml.get_color("d_red").." • Токсины: +"..toxine_value.."%"..utils_xml.get_color("ui_gray_1")
    elseif toxine_value < 0 then
        toxine_str = utils_xml.get_color("d_blue").." • Токсины: "..toxine_value.."%"..utils_xml.get_color("ui_gray_1")
    elseif detox_value > 0 then
        local minutes = math.floor(boost_time_value/60)
        toxine_str = utils_xml.get_color("d_green").." • Детокс: +"..detox_value.."% ("..minutes.." мин)"..utils_xml.get_color("ui_gray_1")
    end

    -- 3. Вставляем наши токсины ПЕРЕД оригинальным описанием
    if toxine_str ~= "" then
        -- Находим базовую стоимость (первую строку)
        local base_part, rest = original_result:match("^(.-)\\n(.*)")
        base_part = base_part or original_result
        
        -- Собираем результат: базовая строка -> токсины -> остальное
        return base_part .. "\\n" .. toxine_str .. (rest and "\\n" .. rest or "")
    end

    return original_result
end
-------------------------------------------------------------------------------------


-- ФУНКЦИИ, ОТВЕЧАЮЩИЕ ЗА ВЫВОД ТОКСИНОВ У МЕДИКОВ

function actor_has_toxins(first_speaker, second_speaker)
	if (toxine_tbl.toxine > 0) then
		return true
	end
	return false
end

function actor_hasnt_toxins(first_speaker, second_speaker)
	if (toxine_tbl.toxine == 0) then
		return true
	end
	return false
end

function actor_has_toxins_and_money(first_speaker, second_speaker)
	if (toxine_tbl.toxine > 0) and (db.actor:money() >= 880) then
		return true
	end
	return false
end

function actor_detox(first_speaker, second_speaker)
	dialogs.relocate_money_from_actor (first_speaker, second_speaker, 880)
	toxine_tbl.toxine = 0
end

function toxins_medic_text_1(first_speaker, second_speaker)
	local str_0 = "st_dm_medic_general_text_7_0"
	local str_r = "st_dm_medic_general_text_7_" .. math.random(1,3)
	local str = game.translate_string(str_r) .. " " .. game.translate_string(str_0)
	return str
end

function toxins_medic_text_7(first_speaker, second_speaker)
	local str_0 = "st_dm_medic_general_text_70_0"
	local str_r = "st_dm_medic_general_text_70_" .. math.random(1,4)
	local str = game.translate_string(str_r) .. " " .. game.translate_string(str_0)
	return str
end

-- === Визуальное отображение токсинов на HUD ===
HUD = nil

function activate_hud(gui)
    if HUD == nil then
        HUD = Chemx()
        get_hud():AddDialogToRender(HUD)
    end
    RegisterScriptCallback("actor_on_net_destroy", deactivate_hud)
    RegisterScriptCallback("actor_on_before_death", deactivate_hud)
end

function deactivate_hud(gui)
    if HUD ~= nil then
        get_hud():RemoveDialogToRender(HUD)
        HUD = nil
    end
    UnregisterScriptCallback("actor_on_net_destroy", deactivate_hud)
    UnregisterScriptCallback("actor_on_before_death", deactivate_hud)
end

class "Chemx" (CUIScriptWnd)

function Chemx:__init() super()
    self:InitControls()
end

function Chemx:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)

    self.xml = CScriptXmlInit()
    local xml = self.xml
    xml:ParseFile("ui_chem_addict.xml") -- используем тот же файл разметки

    self.hud1 = xml:InitStatic("addict_hud1", self)
    self.hud2 = xml:InitStatic("addict_hud2", self)
    self.hud3 = xml:InitStatic("addict_hud3", self)
    self:Update()
end

function Chemx:Update()
    CUIScriptWnd.Update(self)

    local toxine = toxine_tbl.toxine or 0

    if db.actor:has_info("inventory_wnd_open") then
        if toxine >= 60 then
            self.hud1:Show(false)
            self.hud2:Show(false)
            self.hud3:Show(true) -- красная иконка
        elseif toxine >= 40 then
            self.hud1:Show(false)
            self.hud2:Show(true) -- желтая иконка
            self.hud3:Show(false)
        elseif toxine > 21 then
            self.hud1:Show(true) -- зеленая иконка
            self.hud2:Show(false)
            self.hud3:Show(false)
        else
            self.hud1:Show(false)
            self.hud2:Show(false)
            self.hud3:Show(false)
        end
    else
        self.hud1:Show(false)
        self.hud2:Show(false)
        self.hud3:Show(false)
    end
	
	if (self.hud1:IsCursorOverWindow() or self.hud2:IsCursorOverWindow() or self.hud3:IsCursorOverWindow()) and not hint_shown then
		hint_shown = true
		
		local rounded_toxine = round_idp(toxine_tbl.toxine, 2)	-- последняя цифра в скобках регулирует количество чисел после запятой. 2 будет показывать сотые, а 0 - только целое число
		local power_detox = round_idp((detox_tbl.detox/100), 2)
		local time_detox = round_idp(drugs_time_tbl.time, 0)
		local time_boost = drugs_time_tbl.time

		if (time_boost > 0) and hint_shown == true then
			news_manager.send_tip(db.actor, game.translate_string("ui_toxine") .. ": " .. rounded_toxine .. "%; " .. game.translate_string("ui_boost_detox") .. ": " .. power_detox .. game.translate_string("ui_toxine_time") .. "; " .. game.translate_string("ui_boost_detox_time") .. ": " .. time_detox, nil, default, 10000)
		elseif hint_shown == true then
			news_manager.send_tip(db.actor, game.translate_string("ui_toxine") .. ": " .. rounded_toxine .. "%; " .. game.translate_string("ui_nat_detox") .. ": " .. nat_detox .. game.translate_string("ui_toxine_time"), nil, default, 10000)
		end		
	elseif not (self.hud1:IsCursorOverWindow() or self.hud2:IsCursorOverWindow() or self.hud3:IsCursorOverWindow()) then
		hint_shown = false
    end	
	
end

function Chemx:__finalize()
end


function on_game_start()
	RegisterScriptCallback("on_game_load", on_game_load)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	RegisterScriptCallback("actor_on_item_use", actor_on_item_use)
	RegisterScriptCallback("actor_on_sleep", actor_on_sleep)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("GUI_on_show", activate_hud)
	RegisterScriptCallback("GUI_on_hide", deactivate_hud)
end