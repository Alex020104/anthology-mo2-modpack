<window>
	<minimap>
		<level_frame x="0.117" y="0.103" width="0.252" height="0.200" stretch="1" alignment="c" rounded="0" a="255"/>
		<!-- level_frame - width, height для увеличения или уменьшения карты. Править только оба значения одновременно т.к. -->
		<!-- если изменить одно из них карта всё равно увеличиться или уменьшиться по диагонали. -->

		<background width="0.355" height="0.335" stretch="1" alignment="c"> 
		<!-- background width, height меняет размер РАМКИ вокруг карты, но рамку уменьшать или увеличивать можно только по диагонали.
		Если просто изменить допустим width, то рамка всё равно увеличиться или уменьшиться по диагонали -->
			<texture>ui\squaredov\minimap-16-10</texture>
		</background>

		
	    <clock_wnd x="0.802" y="0.780" width="25" height="16" alignment="c"> <!-- Х и У в этой строке меняют положение цифр отображающих время под картой (БЫЛО x="0.788" y="0.776")  -->
		<!-- Для X - если увеличивать значение это смещает часы правее. Для Y - если увеличивать значение это смещает часы вверх -->
	        <text x="0" y="0" font="letterica16" r="100" g="200" b="255" a="200" align="c" vert_align="c"/> <!-- Было r="179" g="152" b="109" -->
	    </clock_wnd>

		<compass x="100" y="100" width="0" height="0" stretch="1" heading="1" rounded="0" alignment="c">
			<texture>ui\squaredov\compass</texture>
		</compass>

		<center width="64" height="64" alignment="c" stretch="1">
			<texture >ui\squaredov\player</texture>
		</center>
		
		<!-- Чтобы изменить положение счётчика нужно в файле ui_minimap_counter.script изменить параметр local Y_16_10, local X_16_10 -->
		<static_counter x="0" y="0" width="32" height="32" alignment="c">
			<texture>ui\squaredov\scounter-16-10</texture>
			<text_static width="18" height="17">
				<text  align="c" font="letterica16" x="-1.5" y="-0.3" r="100" g="200" b="255" a="200" /> <!-- Х и У в этой строке меняет положение цифр внутри счётчика (было r="179" g="152" b="109") -->
				<!-- Для Y - если уменьшать значение это поднимает цифры выше. Для Х - если увеличивать значение это сдвинет цифры влево -->
			</text_static>
		</static_counter>

	</minimap>
</window>