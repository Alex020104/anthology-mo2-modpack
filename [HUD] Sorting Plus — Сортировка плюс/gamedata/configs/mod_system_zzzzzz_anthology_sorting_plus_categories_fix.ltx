;===============================================================================
; Anthology 2.1 + Bart's New Sorting Tabs + Sorting Plus
; Quick category mapping fix, v1.0.0-beta
; Uses DLTX @ sections so each mapping is created when absent or overridden when present.
;
; The extended UI has 10 tabs, while Anthology's base system.ltx still contains
; the old 8-tab mapping. This leaves food mixed with medicine, shifts the later
; categories and gives the last tabs no valid system section.
;===============================================================================

@[button_sort_tab_1]
kinds = s_all

@[button_sort_tab_2]
kinds = w_base, w_pistol, w_shotgun, w_smg, w_rifle, w_sniper, w_explosive, w_melee, w_misc

@[button_sort_tab_3]
kinds = o_light, o_medium, o_sci, o_heavy, o_helmet, i_backpack, i_attach

@[button_sort_tab_4]
kinds = w_ammo

@[button_sort_tab_5]
kinds = i_arty, i_arty_junk, i_arty_cont, i_mutant_belt, i_mutant_part

@[button_sort_tab_6]
kinds = i_device, i_tool, i_repair, i_kit

@[button_sort_tab_7]
kinds = i_mutant_raw, i_mutant_cooked, i_food, i_drink

@[button_sort_tab_8]
kinds = i_medical

@[button_sort_tab_9]
kinds = i_misc, i_letter, i_quest

@[button_sort_tab_10]
kinds = i_part, i_upgrade
