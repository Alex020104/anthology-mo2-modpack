<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="st_player_skill_stats">
		<text>\nХАРАКТЕРИСТИКИ:</text>
	</string>

	<!-- Scavenging -->
	<string id="st_player_skills_hint_scavenging">
		<text>Увеличивает количество предметов при обыске сталкеров.\n \nОпыт накапливается, обыскивая сталкеров, сталкеры более высокого ранга дают больше опыта.\n \n</text>
	</string>

	<string id="st_skills_stats_scavenging_skill_positive">
		<text>\n%c[255,86,102,255]•%c[ui_6] Шанс получить доп. предмет: %c[d_green]$stat%</text>
	</string>
	<string id="st_skills_stats_scavenging_skill_negative">
		<text>\n%c[255,86,102,255]•%c[ui_6] Шанс потерять предмет: %c[d_red]$stat%</text>
	</string>

	<!-- Strength -->
	<string id="st_player_skills_hint_strength">
		<text>Увеличивает переносимый вес и повышает урон в ближнем бою.\n \nОпыт накапливается, путешествуя с тяжелыми грузами или в ближнем бою.\n \n</text>
	</string>

	<string id="st_skills_stats_weight_modifer_positive">
		<text>\n%c[255,255,201,86]•%c[ui_6] Множитель переносимого веса: %c[d_green]x$stat</text>
	</string>
	<string id="st_skills_stats_weight_modifer_negative">
		<text>\n%c[255,255,201,86]•%c[ui_6] Множитель переносимого веса: %c[d_red]x$stat</text>
	</string>

	<string id="st_skills_stats_melee_damage_positive">
		<text>\n%c[255,255,201,86]•%c[ui_6] Множитель урона в ближнем бою: %c[d_green]x$stat</text>
	</string>
	<string id="st_skills_stats_melee_damage_negative">
		<text>\n%c[255,255,201,86]•%c[ui_6] Множитель урона в ближнем бою: %c[d_red]x$stat</text>
	</string>

	<string id="st_skills_stats_base_weight">
		<text>\n%c[255,255,201,86]•%c[ui_6] Бонусный переносимый вес: %c[d_green]+$stat кг</text>
	</string>

	<!-- Survival -->
	<string id="st_player_skills_hint_survival">
		<text>Снижает получаемый урон и кровотечение, а также дает шанс получить дополнительную часть мутанта.\n \nОпыт накапливается, получая урон (только физический) или при разделке мутантов, более опасные мутанты дают больше опыта.\n \n</text>
	</string>
	<string id="st_skills_stats_resistance_positive">
		<text>\n%c[255,135,255,86]•%c[ui_6] Множитель сопротивления урону: %c[d_green]x$stat</text>
	</string>
	<string id="st_skills_stats_resistance_negative">
		<text>\n%c[255,135,255,86]•%c[ui_6] Множитель сопротивления урону: %c[d_red]x$stat</text>
	</string>

	<string id="st_skills_stats_bleed_restore">
		<text>\n%c[255,135,255,86]•%c[ui_6] Снижение кровотечения на: %c[d_green]$stat%</text>
	</string>

	 <string id="st_skills_stats_hunting_skill_positive">
		<text>\n%c[255,135,255,86]•%c[ui_6] Шанс получить доп. часть мутанта: %c[d_green]$stat%</text>
	</string>
	<string id="st_skills_stats_hunting_skill_negative">
		<text>\n%c[255,135,255,86]•%c[ui_6] Шанс потерять часть мутанта: %c[d_red]$stat%</text>
	</string>

	<!-- Endurance -->
	<string id="st_player_skills_hint_endurance">
		<text>Увеличивает выносливость и скорость передвижения.\n \nОпыт накапливается, путешествуя налегке.\n \n</text>
	</string>
	<string id="st_skills_stats_power_loss_positive">
		<text>\n%c[255,255,86,86]•%c[ui_6] Множитель потребления выносливости: %c[d_green]x$stat</text>
	</string>
	<string id="st_skills_stats_power_loss_negative">
		<text>\n%c[255,255,86,86]•%c[ui_6] Множитель потребления выносливости: %c[d_red]x$stat</text>
	</string>

	<string id="st_skills_stats_speed_modifier_positive">
		<text>\n%c[255,255,86,86]•%c[ui_6] Множитель скорости: %c[d_green]x$stat</text>
	</string>
	<string id="st_skills_stats_speed_modifier_negative">
		<text>\n%c[255,255,86,86]•%c[ui_6] Множитель скорости: %c[d_red]x$stat</text>
	</string>
</string_table>
