--[[

	Blackgrowl, Script made by RavenAscendant
	2021/5/2
	
	AltIcons Script - Made so it's perfectly compatible with all other mods that use "actor_status.script"
	
--]]

size_adjust = 0.5
bg_size_adjust = 0.72

local hunger_icon_satiety_threshold = 0.5
local thirst_icon_deprivation_threshold = 0.5

function get_hunger_icon_state(visual)
	local satiety = actor_status.get_satienty(false)
	if (not satiety) or satiety > hunger_icon_satiety_threshold then
		return 0
	end

	if visual then
		if satiety > 0.4 then return 1
		elseif satiety > 0.3 then return 2
		elseif satiety > 0.2 then return 3
		else return 4
		end
	end

	return actor_status.get_satienty(visual)
end

function get_thirst_icon_state(visual)
	local deprivation = actor_status_thirst.get_water_deprivation(false)
	if (not deprivation) or deprivation < thirst_icon_deprivation_threshold then
		return 0
	end

	if visual then
		if deprivation < 0.6 then return 1
		elseif deprivation < 0.7 then return 2
		elseif deprivation < 0.8 then return 3
		else return 4
		end
	end

	return actor_status_thirst.get_water_deprivation(visual)
end

basethrst = actor_status_thirst.create
	function actor_status_thirst.create()
		basethrst()
		actor_status.indicators["Thirst"]                 = { index= 3 	,typ= "state"	,functor= {"alticons","get_thirst_icon_state",true}	                    ,icon= "ui_status_thirst"      ,background= "ui_status_bg"	,anim_icon= false	,anim_bk= false  }
		
	end 

	basesleep = actor_status_sleep.create
	function actor_status_sleep.create()
		basesleep()
		actor_status.indicators["Sleep"]                  = { index= 4 	,typ= "state"	,functor= {"actor_status_sleep","get_sleep_deprivation",true}	                    ,icon= "ui_status_sleep"      ,background= "ui_status_bg"	,anim_icon= false	,anim_bk= false  }
	
	end 
    
	-- functor must return number [1-4] if it's a state (to indicate the color), boosters will always use one color

