		actor_status.indicators["Overweight"]             = { index= 5 	,typ= "state"	,functor= {"actor_status","get_overweight",true}	                ,icon= "ui_status_overweight"  ,background= "ui_status_bg"	,anim_icon= false	,anim_bk= false  }
