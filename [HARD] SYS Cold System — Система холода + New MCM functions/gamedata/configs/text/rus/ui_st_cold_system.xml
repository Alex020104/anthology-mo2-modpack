	</string>

	<string id="ui_mcm_cold_system_thermo_bar_text_mode">
		<text>Термометр Текстовый Режим</text>
	</string>
	<string id="ui_mcm_cold_system_thermo_bar_text_mode_desc">
		<text>Включите чтобы сменить полоску термометра на текстовое значение.</text>
	</string>

