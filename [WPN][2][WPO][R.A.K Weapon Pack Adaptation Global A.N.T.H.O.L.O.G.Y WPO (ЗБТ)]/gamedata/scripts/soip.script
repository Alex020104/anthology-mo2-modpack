-- ==== Инициализация переменных ====
local ini_sys = getfenv().ini_sys or require("ini").ini_system
local wk_degradation = ini_sys:r_float_ex('welding_part_tool', 'degradation_factor') or 0.125
gc = game.translate_string or function(id) return id end

-- ==== Проверка типа предмета (нужен ли газ для заправки) ====
local function has_gas(obj)
    return obj and obj:section() == 'explo_balon_gas' and obj:condition() > 0.1
end

-- ==== Имя действия для меню ====
local function name_refill(obj)
    return gc('st_refill') -- "Заправить сварочный балон"
end

-- ==== Основная функция пополнения ====
local function act_refill(don_id, rec_id, num)
    local don = level.object_by_id(don_id) -- donor (баллон с газом)
    local rec = level.object_by_id(rec_id) -- receiver (инструмент)

    if not don or not rec then return end

    local uses = don:get_remaining_uses()
    num = (num and num <= uses) and num or uses

    local con = rec:condition()
    local used = math.min(math.ceil((1 - con) / wk_degradation), num)
    local new_con = con + used * wk_degradation

    rec:set_condition(new_con)
    utils_item.discharge(don, used)

    ui_inventory.GUI:PlaySND(sound_object([[interface\inv_properties_2]]))
    ui_inventory.GUI:UpdateItems()
end

-- ==== Глобальная переменная для UI ====
local rwk_gui = nil

-- ==== Инициализация меню ====
local function init_refill_menu(obj)
    local gas_tank = nil
    db.actor:iterate_inventory(function(owner, item)
        if item:section() == 'explo_balon_gas' and item:condition() > 0.1 then
            gas_tank = item
        end
    end)

    if not gas_tank then
        news_manager.send_tip(db.actor, utils_xml.get_color("pda_yellow") .. gc('ui_st_no_welding_kit'), nil, 'swiss_knife', 6000)
        return
    end

    local context_str = { gc('ui_st_refill_one'), gc('ui_st_refill_full') }
    local context_action = { 'refill_welding_tank', 'refill_welding_tank' }
    local context_params = {
        {gas_tank:id(), obj:id(), 1},
        {gas_tank:id(), obj:id(), nil}
    }

    if not rwk_gui then
        rwk_gui = utils_ui_custom.UICellPropertiesCustom(act_refill)
    end

    rwk_gui:Reset(GetCursorPosition(), context_action, context_str, context_params)
    ui_inventory.GUI:PlaySND(sound_object([[interface\inv_properties_2]]))
end

-- ==== Регистрация пункта меню при старте игры ====
function on_game_start()
    custom_functor_autoinject.add_functor("soip_refill", function(obj)
        return obj:section() == 'welding_part_tool'
    end, name_refill, nil, init_refill_menu, false)
end