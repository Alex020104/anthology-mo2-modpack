-- R.A.K Global BLC: class-based ballistic UI rating.
-- Keeps gameplay untouched. Only changes utils_item.get_outfit_protection(..., "FireWound") display values.

local patched = false
local original_get_outfit_protection = nil

local armor_rating = {
    actor_armor_novice       = 0.12,
    actor_armor_trench       = 0.12,
    actor_armor_ghillie      = 0.16,
    actor_armor_class0       = 0.12,
    actor_armor_class1       = 0.18,
    actor_armor_class2       = 0.26,
    actor_armor_class3       = 0.34,
    actor_armor_class4       = 0.44,
    actor_armor_class5       = 0.62,

    actor_armor_suit         = 0.26,
    actor_armor_bandit       = 0.22,
    actor_armor_freedom_wind = 0.24,
    actor_armor_freedom_suit = 0.30,
    actor_armor_duty_suit    = 0.32,
    actor_armor_berill       = 0.34,
    actor_armor_cs1          = 0.22,
    actor_armor_cs2          = 0.28,
    actor_armor_cs3          = 0.34,
    actor_armor_cs_heavy     = 0.38,
    actor_armor_psz          = 0.40,
    actor_armor_radiation    = 0.36,
    actor_armor_seva         = 0.30,
    actor_armor_duty_seva    = 0.32,
    actor_armor_freedom_seva = 0.30,
    actor_armor_ssp99        = 0.22,
    actor_armor_ssp99m       = 0.28,

    actor_armor_skat         = 0.44,
    actor_armor_exo          = 0.55,
    actor_armor_bandit_exo   = 0.55,
    actor_armor_duty_exo     = 0.55,
    actor_armor_freedom_exo  = 0.55,
    actor_armor_military_exo = 0.57,

    actor_armor_light_add_1      = 0.10,
    actor_armor_light_add_2      = 0.12,
    actor_armor_light_add_3      = 0.14,
    actor_armor_light_add_4      = 0.10,
    actor_armor_light_add_5      = 0.14,
    actor_armor_medium_add_1     = 0.16,
    actor_armor_medium_add_2     = 0.18,
    actor_armor_medium_add_3     = 0.20,
    actor_armor_medium_add_4     = 0.22,
    actor_armor_heavy_add_1      = 0.22,
    actor_armor_heavy_add_2      = 0.24,
    actor_armor_heavy_add_3      = 0.26,
    actor_armor_scientific_add_1 = 0.20,
    actor_armor_scientific_add_3 = 0.22,
    actor_armor_exo_add_1        = 0.28,
    actor_armor_exo_add_2        = 0.30,
    actor_armor_exo_add_3        = 0.32,

    actor_helm_absent      = 0.00,
    actor_helm_respirator  = 0.04,
    actor_helm_hardhat     = 0.10,
    actor_helm_m40         = 0.14,
    actor_helm_screen      = 0.18,
    actor_helm_battle      = 0.24,
    actor_helm_tactic      = 0.26,
    actor_helm_exo         = 0.30,
    actor_helm_spartan     = 0.32,
}

local function section_of(obj, sec)
    if sec and sec ~= "" then
        return sec
    end
    if obj and obj.section then
        local ok, value = pcall(function() return obj:section() end)
        if ok then
            return value
        end
    end
    return nil
end

local function condition_of(obj)
    if obj and obj.condition then
        local ok, value = pcall(function() return obj:condition() end)
        if ok and tonumber(value) then
            return value
        end
    end
    return 1
end

local function read_section_rating(sec, param)
    if not sec then
        return nil
    end

    local armor = SYS_GetParam and SYS_GetParam(0, sec, param) or nil
    if armor and armor_rating[armor] then
        return armor_rating[armor]
    end

    return nil
end

local function installed_upgrades(obj, sec)
    if obj and utils_item and utils_item.get_upgrades_installed then
        local upgrades = utils_item.get_upgrades_installed(obj)
        if upgrades then
            return upgrades
        end
    end

    if sec and parse_list and ini_sys then
        return parse_list(ini_sys, sec, "installed_upgrades") or {}
    end

    return {}
end

local function upgrade_bone_rating(obj, sec)
    local rating = 0
    for _, upgrade in pairs(installed_upgrades(obj, sec)) do
        local upgrade_sec = ini_sys and ini_sys:r_string_ex(upgrade, "section") or nil
        rating = rating + (read_section_rating(upgrade_sec, "bones_koeff_protection_add") or 0)
    end
    return rating
end

local function ballistic_rating(obj, sec)
    local base = read_section_rating(sec, "bones_koeff_protection")
    if not base then
        return nil
    end

    return base + upgrade_bone_rating(obj, sec)
end

local function upgrade_float_sum(obj, sec, param)
    local value = 0
    for _, upgrade in pairs(installed_upgrades(obj, sec)) do
        local upgrade_sec = ini_sys and ini_sys:r_string_ex(upgrade, "section") or nil
        local bonus = upgrade_sec and SYS_GetParam and SYS_GetParam(2, upgrade_sec, param, 0) or 0
        value = value + (tonumber(bonus) or 0)
    end
    return value
end

local function protection_with_missing_upgrade_bonus(obj, sec, name, param, def)
    local value = original_get_outfit_protection(obj, sec, name, def)
    if not (obj and sec and SYS_GetParam) then
        return value
    end

    local base = SYS_GetParam(2, sec, param, nil)
    if not tonumber(base) then
        return value
    end

    local cond = condition_of(obj)
    local base_cond = base * cond

    -- Some UI paths receive a live object but still show the base section value.
    -- Add upgrade bonuses only in that case to avoid double-counting engine-applied values.
    if math.abs((tonumber(value) or 0) - base_cond) <= 0.0001 then
        return value + (upgrade_float_sum(obj, sec, param) * cond)
    end

    return value
end

local function patch_utils_item()
    if patched or not utils_item or not utils_item.get_outfit_protection then
        return
    end

    original_get_outfit_protection = utils_item.get_outfit_protection

    utils_item.get_outfit_protection = function(obj, sec, name, def)
        local item_sec = section_of(obj, sec)

        if name == "FireWound" then
            local rating = ballistic_rating(obj, item_sec)
            if rating then
                return rating * condition_of(obj)
            end
        end

        if name == "Explosion" then
            return protection_with_missing_upgrade_bonus(obj, item_sec, name, "explosion_protection", def)
        end

        return original_get_outfit_protection(obj, sec, name, def)
    end

    patched = true
end

function on_game_start()
    patch_utils_item()
end
