local function section_of(obj, sec)
    if sec and sec ~= "" then
        return sec
    end
    if obj and obj.section then
        local ok, value = pcall(function() return obj:section() end)
        if ok then
            return value
        end
    end
    return nil
end

local function condition_of(obj)
    if obj and obj.condition then
        local ok, value = pcall(function() return obj:condition() end)
        if ok and tonumber(value) then
            return value
        end
    end
    return 1
end

local function ballistic_rating(sec)
    if not sec then
        return nil
    end

    local armor = SYS_GetParam and SYS_GetParam(0, sec, "bones_koeff_protection") or nil
    if armor and armor_rating[armor] then
        return armor_rating[armor]
    end

    return nil
end

local function patch_utils_item()
    if patched or not utils_item or not utils_item.get_outfit_protection then
        return
    end

    original_get_outfit_protection = utils_item.get_outfit_protection

    utils_item.get_outfit_protection = function(obj, sec, name, def)
        if name == "FireWound" then
            local item_sec = section_of(obj, sec)
            local rating = ballistic_rating(item_sec)
            if rating then
                return rating * condition_of(obj)
            end
        end

        return original_get_outfit_protection(obj, sec, name, def)
    end

    patched = true
end

function on_game_start()
    patch_utils_item()
end
