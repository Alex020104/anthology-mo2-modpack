function passinc_get_unorg_character_table(story_id)
    local character_table
    if not story_id then return end
    if story_id == "esc_m_trader" or story_id == "esc_m_trader" then
        character_table = passinc_unorg_pack_table_sid
    elseif story_id == "zat_b7_bandit_boss_sultan" then
        character_table = passinc_unorg_pack_table_sul
    elseif story_id == "mar_base_stalker_barmen" then
        character_table = passinc_unorg_pack_table_lib
    elseif story_id == "hunter_gar_trader" then
        character_table = passinc_unorg_pack_table_but
    else
        printdbg("unorg character id not found: " .. story_id)
        return
    end
    return character_table
end

function passinc_get_org_faction_table(community)
    local faction_table = {}
    if community == "ecolog" then
        faction_table = passinc_org_salary_table_ecolog
    elseif community == "army" then
        faction_table = passinc_org_salary_table_army
    elseif community == "killer" then
        faction_table = passinc_org_salary_table_killer
    elseif community == "dolg" then
        faction_table = passinc_org_salary_table_dolg
    elseif community == "freedom" then
        faction_table = passinc_org_salary_table_freedom
    elseif community == "isg" then
        faction_table = passinc_org_salary_table_isg
    elseif community == "monolith" then
        faction_table = passinc_org_salary_table_monolith
    elseif community == "greh" then
        faction_table = passinc_org_salary_table_greh
    else
        printdbg("faction table not found: " .. community)
        return
    end
    return faction_table
end



