function passinc_salary_preview(first_speaker, second_speaker)
    local g_tostring = tostring
    local npc = dialogs.who_is_npc(first_speaker, second_speaker)
    local npc_community = npc:character_community()
    if npc_community == "trader" then npc_community = "stalker" end

    if not npc_community then return "What?" end

	local base_money = passinc_calculate_base_salary(nil, npc_community)
    local monster_bonus_money = passinc_calculate_monster_salary(nil, npc_community)
    local npc_bonus_money = passinc_calculate_npc_killed_salary(nil, npc_community)
    local arti_bonus_money = passinc_calculate_arti_found_salary(nil, npc_community)
    local task_bonus_money = passinc_calculate_tasks_completed_salary(nil, npc_community)
    local msg
    if npc_community == "ecolog" then
        msg = strformat(gt("passinc_salary_preview" .. "_" .. npc_community) or "", g_tostring(base_money), g_tostring(task_bonus_money), g_tostring(arti_bonus_money))
    elseif npc_community == "army" then
        msg = strformat(gt("passinc_salary_preview" .. "_" .. npc_community) or "", g_tostring(base_money), g_tostring(task_bonus_money), g_tostring(npc_bonus_money))
    elseif npc_community == "dolg" then
        msg = strformat(gt("passinc_salary_preview" .. "_" .. npc_community) or "", g_tostring(base_money), g_tostring(task_bonus_money), g_tostring(monster_bonus_money), g_tostring(npc_bonus_money))
    elseif npc_community == "killer" then
        msg = strformat(gt("passinc_salary_preview" .. "_" .. npc_community) or "", g_tostring(base_money), g_tostring(task_bonus_money))
    elseif npc_community == "freedom" then
        msg = strformat(gt("passinc_salary_preview" .. "_" .. npc_community) or "", g_tostring(base_money), g_tostring(task_bonus_money), g_tostring(npc_bonus_money))
    elseif npc_community == "isg" then
        msg = strformat(gt("passinc_salary_preview" .. "_" .. npc_community) or "", g_tostring(base_money), g_tostring(task_bonus_money), g_tostring(npc_bonus_money), g_tostring(monster_bonus_money))
    elseif npc_community == "monolith" then
        msg = strformat(gt("passinc_salary_preview" .. "_" .. npc_community) or "", g_tostring(base_money), g_tostring(task_bonus_money), g_tostring(npc_bonus_money), g_tostring(monster_bonus_money))
    elseif npc_community == "greh" then
        msg = strformat(gt("passinc_salary_preview" .. "_" .. npc_community) or "", g_tostring(base_money), g_tostring(task_bonus_money), g_tostring(npc_bonus_money), g_tostring(monster_bonus_money))
    end
    return msg
end

function passinc_unorg_salary_preview(first_speaker, second_speaker)
    local npc = dialogs.who_is_npc(first_speaker, second_speaker)
    if (not npc) then return end
    local npc_community = npc:character_community()
    if npc_community == "trader" then npc_community = "stalker" end
    local npc_id = npc:id() or nil
    local se_obj = npc_id and alife_object(npc_id)
    local story_id = get_object_story_id(npc_id)

    if not npc_community then return "What?" end
    local tasks_for_bonus
    local unorg_table = passive_income_tables.passinc_get_unorg_character_table(story_id)
    if unorg_table then
        tasks_for_bonus = (unorg_table and unorg_table["tasks_for_bonus"] and unorg_table["tasks_for_bonus"][1])
    end
    

    local msg = strformat(gt("passinc_salary_preview" .. "_" .. npc_community), tasks_for_bonus)
    return msg
end

