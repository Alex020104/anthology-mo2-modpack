--====== EMPLOYMENT TASK=======

function xr_conditions.passinc_is_employed(actor, npc, p)
    local story_id = tostring(p[1])
    if not story_id then return false end
    if not passinc_cache_tbl[story_id] then return false end
    if passinc_cache_tbl[story_id] and passinc_cache_tbl[story_id].is_employed then
        return true
    end
    return false
end

function xr_conditions.passinc_is_same_faction(actor, npc, p)
    local story_id = tostring(p[1])
    if not story_id then return false end
    if not passinc_cache_tbl[story_id] then return false end
    local actor_community = get_actor_true_community()
    local employer_community = passinc_cache_tbl[story_id].employer_community
    if actor_community == employer_community then
        return true
    end
    return false
end

function xr_conditions.passinc_is_faction_enemies(actor, npc, p)
    local story_id = tostring(p[1])
    if story_id and passinc_cache_tbl[story_id] then
        local actor_community = get_actor_true_community()
        local employer_community = passinc_cache_tbl[story_id].employer_community
        if game_relations.is_factions_enemies(employer_community, actor_community) then
            return true
        else
            return false
        end
    end
end

function xr_effects.passinc_stop_employment_task(actor, npc, p)
    local story_id = tostring(p[1])
    if passinc_cache_tbl[story_id] then
        passinc_stop_employment(story_id)
        --printdbg("employment stopped from task manager")
    end
end

-- DESCRIPTION FUNCTORS
function task_functor.passinc_task_descr_f(task_id,field,p,tsk)
    
    local msg = ""
    local giver_id
    local se_obj
    local se_giver_story_id
    if (tsk and tsk.task_giver_id) then
        giver_id = tsk.task_giver_id
        se_obj = id and alife_object(giver_id)
        se_giver_story_id = get_object_story_id(giver_id)
    end
    
    if not se_giver_story_id then
        return msg
    end

    local employer_comm = passinc_cache_tbl[se_giver_story_id].employer_community or nil
    local employer_name = passinc_cache_tbl[se_giver_story_id].employer_name or nil
    local current_stage = passinc_cache_tbl[se_giver_story_id].employment_stage or 1
    local current_progress = passinc_cache_tbl[se_giver_story_id].progress or 0
    local target_progress
    local previous_progress

    if not passinc_cache_tbl[se_giver_story_id].is_unorg then
        local org_salary_tbl = passive_income_tables.passinc_get_org_faction_table(employer_comm)
        target_progress = org_salary_tbl["promo_intervals"][current_stage]
        previous_progress = org_salary_tbl["promo_intervals"][current_stage - 1] or 0
    else
        local unorg_salary_tbl = passive_income_tables.passinc_get_unorg_character_table(se_giver_story_id)
        target_progress = unorg_salary_tbl["promo_intervals"][current_stage]
        previous_progress = unorg_salary_tbl["promo_intervals"][current_stage - 1] or 0
    end

    if (not employer_comm) or (not employer_name) or (not target_progress) then return "" end

    local progress_percent = math.floor(((current_progress - previous_progress) / (target_progress - previous_progress)) * 100)

    local msg_divider = strformat(gt("passinc_descr_divider"))    

    local msg_completed
    if passinc_cache_tbl[se_giver_story_id].is_daily_completed then
        msg_completed = strformat(gt("passinc_descr_completed"))
    else
        msg_completed = strformat(gt("passinc_descr_not_completed"))
    end

    if (not passinc_cache_tbl[se_giver_story_id].is_unorg) then
	    local msg_comm = strformat(gt("passinc_employer_name"), employer_name)
        local msg_middle = gt("passinc_descr_middle")
        local msg_base = strformat(gt("passinc_descr_base"), passinc_calculate_base_salary(se_giver_story_id, employer_comm))
        local msg_task = ""
        local msg_monster = ""
        local msg_arti = ""
        local msg_npc = ""
        local msg_stage = gt("passinc_descr_employment_stage") .. " " .. (passinc_cache_tbl[se_giver_story_id].employment_stage) .. "/" .. (max_employment_stage)
        local msg_progress = strformat(gt("passinc_descr_progress"), progress_percent)
        if (passinc_calculate_tasks_completed_salary(se_giver_story_id) > 0) then
            msg_task = strformat(gt("passinc_descr_complete_task"), passinc_calculate_tasks_completed_salary(se_giver_story_id, employer_comm))
        end
        if (passinc_calculate_monster_salary(se_giver_story_id) > 0) then
            msg_monster = strformat(gt("passinc_descr_monster_killed"), passinc_calculate_monster_salary(se_giver_story_id, employer_comm))
        end
        if (passinc_calculate_npc_killed_salary(se_giver_story_id) > 0) then
            msg_npc = strformat(gt("passinc_descr_npc_killed"), passinc_calculate_npc_killed_salary(se_giver_story_id, employer_comm))
        end
        if (passinc_calculate_arti_found_salary(se_giver_story_id) > 0) then
            msg_arti = strformat(gt("passinc_descr_arti_found"), passinc_calculate_arti_found_salary(se_giver_story_id, employer_comm))
        end    
        msg = msg_comm .. msg_stage .. msg_progress .. msg_divider .. msg_middle .. msg_base .. msg_task .. msg_monster .. msg_npc .. msg_arti .. msg_divider .. msg_completed
    else
        local unorg_table = passive_income_tables.passinc_get_unorg_character_table(se_giver_story_id)
        local bonus_interval = (unorg_table and unorg_table["tasks_for_bonus"] and unorg_table["tasks_for_bonus"][current_stage])
        local msg_name = strformat(gt("passinc_employer_name"), employer_name)
        local msg_stage = gt("passinc_unorg_descr_employment_stage") .. " " .. (passinc_cache_tbl[se_giver_story_id].employment_stage) .. "/" .. (unorg_table["stages_count"])
        local msg_progress = strformat(gt("passinc_descr_progress"), progress_percent)
        local msg_descr = strformat(gt("passinc_unorg_descr_middle"), employer_name)
        local msg_bonus = strformat(gt("passinc_unorg_descr_bonus"), bonus_interval)
        local msg_task = strformat(gt("passinc_unorg_complete_task"), (passinc_cache_tbl[se_giver_story_id].completed_tasks or 0), (employer_name))
        msg = msg_name .. msg_stage .. msg_progress .. msg_divider .. msg_descr .. msg_bonus .. msg_task .. msg_divider .. msg_completed
    end
    return msg

end

function task_functor.passinc_task_title_f(task_id,field,p,tsk)
    
    local msg = gt("passinc_task_title_fallback")
    local giver_id
    local se_obj
    local se_giver_story_id
    if (tsk and tsk.task_giver_id) then
        giver_id = tsk.task_giver_id
        se_obj = id and alife_object(giver_id)
        se_giver_story_id = get_object_story_id(giver_id)
    end
    
    if not se_giver_story_id then
        return msg
    end

    local employer_comm = passinc_cache_tbl[se_giver_story_id].employer_community or nil
    local employer_name = passinc_cache_tbl[se_giver_story_id].employer_name or nil

    if (not employer_comm) or (not employer_name) then return msg end

    local employer_comm_st = gt("passinc_employer_community_" .. employer_comm)

    if (not passinc_cache_tbl[se_giver_story_id].is_unorg) then
	    msg = strformat(gt("passinc_task_title_functor"), employer_comm_st)
    else
        msg = strformat(gt("passinc_task_title_functor"), employer_name)
    end
    return msg

end
--=================================

-- DEBUGGING

function passinc_debug_promotion()
    if not passinc_cache_tbl then return end
    for k, v in pairs(passinc_cache_tbl) do
        passinc_cache_tbl[k].days_until_promotion = 1
        printdbg("Contract id: " .. k .. "- days until promotion: " .. passinc_cache_tbl[k].days_until_promotion)
    end
end

function passinc_print_promo_prizes()
    if not passinc_cache_tbl then return end
    for k, v in pairs(passinc_cache_tbl) do
        local promo_prizes = passinc_cache_tbl[k].promotion_prizes
        for i = 1, #promo_prizes do
            printdbg("Contract id: " .. k .. "- promotion prize: " .. promo_prizes[i])
        end
        
    end
end

function passinc_print_info()
    if not passinc_cache_tbl then return end
    for k, v in pairs(passinc_cache_tbl) do
        local contract_id = k
        local emp_stage = passinc_cache_tbl[k].employment_stage
        local progress = passinc_cache_tbl[k].progress
        local lazy_days = passinc_cache_tbl[k].lazy_days
        local pay_day = passinc_cache_tbl[k].next_payday
        local next_promo = 0
        if passinc_cache_tbl[k].is_unorg then
            local unorg_table = passive_income_tables.passinc_get_unorg_character_table(k)
            next_promo = unorg_table["promo_intervals"][emp_stage]
        else
            local comm = passinc_cache_tbl[k].employer_community
            local org_table = passive_income_tables.passinc_get_org_faction_table(comm)
            next_promo = org_table["promo_intervals"][emp_stage]
        end

        printdbg("contract_id: " .. contract_id)
        printdbg("current stage: " .. emp_stage)
        printdbg("current progress: " .. progress)
        printdbg("Next promotion: " .. next_promo)
        printdbg("Next payday: " .. pay_day)
        printdbg("Lazy days: " .. lazy_days)
    end
end
