<?xml version="1.0" encoding="windows-1251" ?>

<game_dialogs>

    <dialog id="passive_income_start">
        <precondition>passive_income.passinc_is_unemployed</precondition>
        <precondition>passive_income.passinc_is_same_faction</precondition>
        <precondition>passive_income.passinc_is_not_request_timeout</precondition>
        <precondition>passive_income.passinc_is_not_same_faction_employed</precondition>
        <phrase_list>
            <phrase id="0"> <!-- actor -->
                <script_text>passive_income.passinc_ask_for_employment</script_text>
                <next>1</next>
            </phrase>
            <phrase id="1"> <!-- npc -->
                <script_text>passive_income.passinc_salary_preview</script_text>
                <next>3</next>
                <next>2</next>
            </phrase>
            <phrase id="2"> <!-- actor -->
                <script_text>passive_income.passinc_employment_back</script_text>
            </phrase>
            <phrase id="3"> <!-- actor -->
                <script_text>passive_income.passinc_employment_confirm</script_text>
                <action>passive_income.passinc_start_employment</action>
            </phrase>           
        </phrase_list>
    </dialog>

    <dialog id="passive_income_stop">
        <precondition>passive_income.passinc_is_employed</precondition>
        <precondition>passive_income.passinc_is_employer</precondition>
        <phrase_list>
            <phrase id="0"> <!-- actor -->
                <script_text>passive_income.passinc_ask_for_stop_employment</script_text>
                <next>1</next>
            </phrase>
            <phrase id="1"> <!-- npc -->
                <script_text>passive_income.passinc_stop_employment_available</script_text>
                <next>3</next>
                <next>2</next>
            </phrase>
            <phrase id="2"> <!-- actor -->
                <script_text>passive_income.passinc_employment_back</script_text>
            </phrase>
            <phrase id="3"> <!-- actor -->
                <script_text>passive_income.passinc_stop_employment_confirm</script_text>
                <action>passive_income.passinc_dialog_stop_employment</action>
                <next>5</next>
            </phrase>    
            <phrase id="5"> <!-- npc -->
                <script_text>passive_income.passinc_stop_employment_end</script_text>
            </phrase>       
        </phrase_list>
    </dialog>

    <dialog id="passive_income_get_salary">
        <precondition>passive_income.passinc_is_employer</precondition>
        <precondition>passive_income.passinc_has_accumulated_salary</precondition>
        <phrase_list>
            <phrase id="0"> <!-- actor -->
                <script_text>passive_income.passinc_ask_for_salary</script_text>
                <next>1</next>
            </phrase>
            <phrase id="1"> <!-- npc -->
                <script_text>passive_income.passinc_pay_salary_preview</script_text>
                <next>10</next>
                <next>11</next>
                <next>12</next>
                <next>2</next>
            </phrase>
            <phrase id="2"> <!-- actor -->
                <script_text>passive_income.passinc_employment_back</script_text>
            </phrase>
            <phrase id="10"> <!-- actor -->
                <precondition>passive_income.passinc_has_not_companions</precondition>
                <script_text>passive_income.passinc_get_salary</script_text>
                <action>passive_income.passinc_pay_not_share_salary</action>
            </phrase>
            <phrase id="11"> <!-- actor -->
                <precondition>passive_income.passinc_has_companions</precondition>
                <script_text>passive_income.passinc_not_share_salary</script_text>
                <action>passive_income.passinc_pay_not_share_salary</action>
            </phrase>
            <phrase id="12"> <!-- actor -->
                <precondition>passive_income.passinc_has_companions</precondition>
                <script_text>passive_income.passinc_share_salary</script_text>
                <action>passive_income.passinc_pay_share_salary</action>
            </phrase>          
        </phrase_list>
    </dialog>

    <dialog id="passive_income_transfer_contract">
        <precondition>passive_income.passinc_is_same_faction_employed</precondition>
        <precondition>passive_income.passinc_is_not_employer</precondition>
        <phrase_list>
            <phrase id="0"> <!-- actor -->
                <script_text>passive_income.passinc_ask_for_transfer</script_text>
                <next>1</next>
            </phrase>
            <phrase id="1"> <!-- npc -->
                <script_text>passive_income.passinc_ask_transfer_confirm</script_text>
                <next>3</next>
                <next>2</next>
            </phrase>
            <phrase id="2"> <!-- actor -->
                <script_text>passive_income.passinc_employment_back</script_text>
            </phrase>
            <phrase id="3"> <!-- actor -->
                <script_text>passive_income.passinc_transfer_confirm</script_text>
                <action>passive_income.passinc_transfer_contract</action>
            </phrase>           
        </phrase_list>
    </dialog>


    <dialog id="passive_income_unorg_start">
        <precondition>passive_income.passinc_is_unemployed</precondition>
        <precondition>passive_income.passinc_is_not_request_timeout</precondition> 
        <precondition>passive_income.passinc_is_not_enemies</precondition>

        <phrase_list>
            <phrase id="0"> <!-- actor -->
                <script_text>passive_income.passinc_unorg_ask_for_employment</script_text>
                <next>1</next>
            </phrase>
            <phrase id="1"> <!-- npc -->
                <script_text>passive_income.passinc_unorg_salary_preview</script_text>
                <next>3</next>
                <next>2</next>
            </phrase>
            <phrase id="2"> <!-- actor -->
                <script_text>passive_income.passinc_employment_back</script_text>
            </phrase>
            <phrase id="3"> <!-- actor -->
                <script_text>passive_income.passinc_employment_confirm</script_text>
                <action>passive_income.passinc_unorg_start_employment</action>
            </phrase>           
        </phrase_list>
    </dialog>

    <dialog id="passive_income_unorg_stop">
        <precondition>passive_income.passinc_is_employer</precondition>
        <precondition>passive_income.passinc_is_employed</precondition>
        <phrase_list>
            <phrase id="0"> <!-- actor -->
                <script_text>passive_income.passinc_ask_for_stop_employment</script_text>
                <next>1</next>
            </phrase>
            <phrase id="1"> <!-- npc -->
                <script_text>passive_income.passinc_stop_employment_available</script_text>
                <next>3</next>
                <next>2</next>
            </phrase>
            <phrase id="2"> <!-- actor -->
                <script_text>passive_income.passinc_employment_back</script_text>
            </phrase>
            <phrase id="3"> <!-- actor -->
                <script_text>passive_income.passinc_stop_employment_confirm</script_text>
                <action>passive_income.passinc_dialog_stop_employment</action>
                <next>5</next>
            </phrase>    
            <phrase id="5"> <!-- npc -->
                <script_text>passive_income.passinc_stop_employment_end</script_text>
            </phrase>       
        </phrase_list>
    </dialog>

    <dialog id="passive_income_unorg_get_salary">
        <precondition>passive_income.passinc_is_employer</precondition>
        <precondition>passive_income.passinc_unorg_has_accumulated_salary</precondition>
        <phrase_list>
            <phrase id="0"> <!-- actor -->
                <script_text>passive_income.passinc_ask_for_salary</script_text>
                <next>1</next>
            </phrase>
            <phrase id="1"> <!-- npc -->
                <script_text>passive_income.passinc_unorg_pay_salary_preview</script_text>
                <next>10</next>
                <next>2</next>
            </phrase>
            <phrase id="2"> <!-- actor -->
                <script_text>passive_income.passinc_employment_back</script_text>
            </phrase>
            <phrase id="10"> <!-- actor -->
                <script_text>passive_income.passinc_get_salary</script_text>
                <action>passive_income.passinc_unorg_pay_packs_salary</action>
            </phrase>        
        </phrase_list>
    </dialog>

</game_dialogs>
