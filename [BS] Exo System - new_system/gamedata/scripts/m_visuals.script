-- === Настройки ===
local BACKPACK_SECTION = "exobackpack_exo_outfit"
local hands_state = 0

local function is_exo_outfit_section(section)
	if type(section) ~= "string" or section == "" then
		return false
	end

	return SYS_GetParam(0, section, "repair_type") == "outfit_exo"
end

local function apply_outfit_hud(player_hud, outfit)
	if not outfit then
		return
	end

	swm_legs.actor_item_to_slot(outfit)

	local hands_sect = SYS_GetParam(0, outfit:section(), "player_hud_section")
	hands_state = 3

	if hands_sect and hands_sect ~= "" then
		player_hud:set_hands(hands_sect)
	end

	player_hud:reset_hands()
end

local function set_actor_visual(visual)
	if not db.actor or type(visual) ~= "string" or visual == "" then
		return
	end

	if db.actor:get_visual_name() ~= visual then
		db.actor:set_visual_name(visual)
	end
end

local function get_fallback_actor_visual()
	return SYS_GetParam(0, "actor", "visual")
end

local function get_outfit_actor_visual(outfit)
	if not outfit then
		return get_fallback_actor_visual()
	end

	return SYS_GetParam(0, outfit:section(), "actor_visual") or get_fallback_actor_visual()
end

local function apply_actor_visual(outfit)
	set_actor_visual(get_outfit_actor_visual(outfit))
end
-- === Регистрация колбэка ===
function on_game_start()
	RegisterScriptCallback("actor_item_to_slot", item_update) -- === Когда игрок кладёт предмет в слот ===
	RegisterScriptCallback("actor_item_to_ruck", item_update) -- === Когда игрок кладёт предмет в рюкзак ===
	RegisterScriptCallback("actor_on_first_update", update_visuals) -- === Когда игрок кладёт предмет в рюкзак ===

	RegisterScriptCallback("on_belt_size_get", belt_size)
    RegisterScriptCallback("on_artefact_count_get", ar_count)
end

function item_update(item) --здесь надо проверить слот, т.к. при проигрывании анимации игрок тоже берёт в свой (-1) слот мнимый предмет
	local slot = SYS_GetParam(2,item:section(),"slot") --здесь читаем слот предмета, в конфигах они на 1 меньше
	if slot == 12 or slot == 6 then
		CreateTimeEvent("update_armor", "update_legs",0.5,update_visuals)
		update_visuals()
	end
end

function belt_size(a_count, flags)
    local outfit = db.actor:item_in_slot(7)
    if outfit and outfit:section() == BACKPACK_SECTION then
        flags.ret_value = a_count + 5 -- Добавляем 5 слотов к поясу
    end
end

function ar_count(a_count, flags)
    local outfit = db.actor:item_in_slot(7)
    if outfit and outfit:section() == BACKPACK_SECTION then
        flags.ret_value = a_count + 5 -- Добавляем 5 слотов под артефакты
    end
end


-- === Обновление рук === --сюда же в конец всё остальное
function update_visuals()
	local outfit = db.actor:item_in_slot(7)
	local player_hud = get_player_hud()

	apply_actor_visual(outfit)

	if not outfit then
		swm_legs.reset_legs_model()
		if hands_state ~= 2 then
			player_hud:set_hands("actor_hud_05")
		end
		hands_state = 2
		player_hud:reset_hands()
	else
		apply_outfit_hud(player_hud, outfit)
	end
	return true
end
