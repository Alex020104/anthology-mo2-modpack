[sprint]
snd_windup                              = exo\wind_up_exo
snd_duration                            = exo\boost
snd_cooldown                            = exo\wind_down_exo
power_cost                              = 20
power_duration                          = 25
power_cooldown                          = 20
power_start                             = exo_powers.activate_speed
power_end                               = exo_powers.deactivate_speed
[tank]:sprint
power_start                             = exo_powers.activate_tank
power_end                               = exo_powers.deactivate_tank
[recharge]:sprint
power_duration                          = 1
snd_windup                              = device\bridge\motor_start
snd_duration                            = anomaly\electra_blast
snd_cooldown                            = device\bridge\motor_stop
radius                                  = 10
power_start                             = exo_powers.activate_blast
power_end                               = exo_powers.deactivate_blast

[super_jump]:sprint
power_start                             = exo_powers.activate_super_jump
power_end                               = exo_powers.deactivate_super_jump
power_cost                              = 20
power_duration                          = 25
power_cooldown                          = 20

snd_windup                              = device\bridge\motor_start
snd_duration                            = anomaly\electra_blast
snd_cooldown                            = device\bridge\motor_stop

[invisibility]:sprint
power_start                             = exo_powers.activate_invisibility
power_end                               = exo_powers.deactivate_invisibility
power_cost                              = 20
power_duration                          = 25
power_cooldown                          = 20

snd_windup                              = nanosuit\modes\cloak\mode_cloak_on
snd_duration                            = nanosuit\modes\cloak\mode_cloak_loop
snd_cooldown                            = nanosuit\modes\cloak\mode_cloak_off