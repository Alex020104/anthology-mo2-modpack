	</string>
	<string id="ui_mcm_body_health_system_head_pen_min_hp">
		<text>Minimum Head Damage for penalties</text>
	</string>

	<string id="ui_mcm_body_health_system_head_pen_min_hp_desc">
		<text>Damage needed to play effects. For example, default slider value of 2 means that each headshot damage must be for 2 or more HP.</text>
	</string>
	<string id="ui_mcm_body_health_system_head_anm_pwr">
