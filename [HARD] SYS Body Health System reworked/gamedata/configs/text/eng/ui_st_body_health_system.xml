	<string id="ui_mcm_body_health_system_header_general">
		<text>General</text>
	</string>

	<string id="ui_mcm_body_health_system_regen">
		<text>Limb regeneration (game minutes)</text>
	</string>
	<string id="ui_mcm_body_health_system_regen_desc">
		<text>After this game minutes the random limb will heal 1 hp (can stack if more time passed). Any game time changes and sleep are included. "0" disables autoregen.</text>
	</string>

	<string id="ui_mcm_body_health_system_damage_scale">
		<text>Limb damage mult</text>
	</string>

	<string id="ui_mcm_body_health_system_enable_display">
		<text>(Items) Enable BHS description</text>
	</string>
	<string id="ui_mcm_body_health_system_enable_display_desc">
		<text>Disable it if any other addons use their own description for BHS.</text>
	</string>

	<string id="ui_mcm_body_health_system_numeric_at">
		<text>(Items) Display numeric value at</text>
	</string>
	<string id="ui_mcm_body_health_system_numeric_at_desc">
		<text>Limb healing in item description will be displayed as number when it exceed this value.</text>
	</string>

	<string id="ui_mcm_body_health_system_numeric_always">
		<text>(Items) Display numeric always</text>
	</string>


	<!-- Arms -->
	<string id="ui_mcm_body_health_system_header_arms">
		<text>Arms</text>
	</string>

	<string id="ui_mcm_body_health_system_arm_opt">
		<text>Arms penalty</text>
	</string>

	<string id="ui_mcm_body_health_system_arm_pen_min_hp">
		<text>Minimum Arms HP (in %) for penalties</text>
	</string>
	<string id="ui_mcm_body_health_system_arm_pen_min_hp_desc">
		<text>Summary Arms HP percents must be below this value to play effects. Default slider value of 100 means that effects will play if both arms have summary 99% or less HP.</text>
	</string>

	<string id="ui_mcm_body_health_system_arm_anm_pwr">
		<text>Effects Power</text>
	</string>
	<string id="ui_mcm_body_health_system_arm_anm_pwr_desc">
		<text>Multiplier for arms penalty effect power. Default: 1.0.</text>
	</string>


	<!-- Legs -->
	<string id="ui_mcm_body_health_system_header_legs">
		<text>Legs</text>
	</string>

	<string id="ui_mcm_body_health_system_leg_opt">
		<text>Legs penalty</text>
	</string>

	<string id="ui_mcm_body_health_system_leg_pen_min_hp">
		<text>Minimum Legs HP (in %) for penalties</text>
	</string>
	<string id="ui_mcm_body_health_system_leg_pen_min_hp_desc">
		<text>Summary Legs HP percents must be below this value to play effects (speed and limping). Default slider value of 100 means that effects will play if both legs have summary 99% or less HP.</text>
	</string>

	<string id="ui_mcm_body_health_system_leg_anm_pwr">
		<text>Camera Effects Power</text>
	</string>
	<string id="ui_mcm_body_health_system_leg_anm_pwr_desc">
		<text>Multiplier of legs penalty for camera effect. Default: 1.0.</text>
	</string>

	<string id="ui_mcm_body_health_system_leg_dmg_min_hp">
		<text>Sprint damage min HP (in %)</text>
	</string>
	<string id="ui_mcm_body_health_system_leg_dmg_min_hp_desc">
		<text>Any leg HP percents must be below this value to damage during sprint. Default value 60 means that there is a chance to get damaged if at least one leg is below 60% HP.</text>
	</string>

	<string id="ui_mcm_body_health_system_new_voice_sounds">
		<text>New voice for penalties</text>
	</string>
	<string id="ui_mcm_body_health_system_new_voice_sounds_desc">
		<text>Enabling this activates new voice during sprint with damaged legs. Disabling returns voice from original mod.</text>
	</string>


