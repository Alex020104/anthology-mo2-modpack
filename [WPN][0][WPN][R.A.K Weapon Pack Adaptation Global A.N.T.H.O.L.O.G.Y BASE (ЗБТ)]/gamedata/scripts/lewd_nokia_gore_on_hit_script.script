-- lewd_nokia_gore_on_hit_script.script
-- V6 : test multi-méthodes de playback

local DEBUG_TAG = "[MELEE_GORE_DEBUG]"
local WEAPON_SECTION = "wpn_lewd_nokia"
local TARGET_COOLDOWN_MS = 120
local REQUIRE_WEAPON_ID_MATCH = true

local last_hit_by_target = {}
local spawned_sounds = {}

local function dbg(msg)
    local out = string.format("%s %s", DEBUG_TAG, tostring(msg))
    if printf then
        printf(out)
    elseif printf_me then
        printf_me(out)
    elseif log then
        log(out)
    end
end

local function safe_call(obj, method_name, ...)
    if not obj then return nil end
    local fn = obj[method_name]
    if type(fn) ~= "function" then return nil end
    local ok, result = pcall(fn, obj, ...)
    if ok then return result end
    return nil
end

local function safe_tostring(v)
    if v == nil then return "nil" end
    local ok, s = pcall(tostring, v)
    if ok then return s end
    return "<tostring error>"
end

local function split_csv(str)
    local t = {}
    if type(str) ~= "string" or str == "" then return t end
    for part in string.gmatch(str, "([^,]+)") do
        part = string.gsub(part, "^%s+", "")
        part = string.gsub(part, "%s+$", "")
        if part ~= "" then
            t[#t + 1] = part
        end
    end
    return t
end

local function get_actor()
    return db and db.actor or nil
end

local function get_active_item(actor_obj)
    return safe_call(actor_obj, "active_item")
end

local function get_target_bone_name(target, bone_id)
    if bone_id == nil then return "nil" end
    local bone_name = safe_call(target, "bone_name", bone_id)
    if bone_name == nil then return tostring(bone_id) end
    return tostring(bone_name)
end

local function target_passes_cooldown(target_id)
    local now = time_global()
    local prev = last_hit_by_target[target_id] or 0
    if now - prev < TARGET_COOLDOWN_MS then
        return false
    end
    last_hit_by_target[target_id] = now
    return true
end

local function read_weapon_sound_list()
    local ini = system_ini and system_ini()
    if not ini then return {} end

    local ok_exist, exists = pcall(function()
        return ini:line_exist(WEAPON_SECTION, "gore_hit_sounds")
    end)
    if not ok_exist or not exists then return {} end

    local ok_read, value = pcall(function()
        return ini:r_string(WEAPON_SECTION, "gore_hit_sounds")
    end)
    if not ok_read then return {} end

    return split_csv(value)
end

local function cleanup_spawned_sounds()
    for i = #spawned_sounds, 1, -1 do
        local s = spawned_sounds[i]
        local playing = false

        if s and s.playing then
            local ok, result = pcall(function()
                return s:playing()
            end)
            if ok and result then
                playing = true
            end
        end

        if not playing then
            table.remove(spawned_sounds, i)
        end
    end
end

local function try_method_1_2d(actor_obj, snd_path)
    local ok, err = pcall(function()
        local s = sound_object(snd_path)
        table.insert(spawned_sounds, s)
        s:play_no_feedback(actor_obj, sound_object.s2d, 0, vector(), 1.0)
    end)

    dbg("method1 actor+s2d+play_no_feedback => " .. (ok and "OK" or ("ECHEC: " .. safe_tostring(err))))
    return ok
end

local function try_method_2_3d(target, snd_path)
    local pos = safe_call(target, "position")
    if not pos then
        dbg("method2 cible+s3d+play_no_feedback => position nil")
        return false
    end

    local ok, err = pcall(function()
        local s = sound_object(snd_path)
        table.insert(spawned_sounds, s)
        s:play_no_feedback(target, sound_object.s3d, 0, pos, 1.0)
    end)

    dbg("method2 cible+s3d+play_no_feedback => " .. (ok and "OK" or ("ECHEC: " .. safe_tostring(err))))
    return ok
end

local function try_method_3_play(actor_obj, snd_path)
    local ok, err = pcall(function()
        local s = sound_object(snd_path)
        table.insert(spawned_sounds, s)
        s:play(actor_obj, 0, sound_object.s2d)
    end)

    dbg("method3 actor+s2d+play => " .. (ok and "OK" or ("ECHEC: " .. safe_tostring(err))))
    return ok
end

local function try_play_debug_sound(target)
    local actor_obj = get_actor()
    if not actor_obj then
        dbg("actor introuvable pour lecture son")
        return false
    end

    local sounds = read_weapon_sound_list()
    if #sounds == 0 then
        dbg("Aucun gore_hit_sounds trouvé dans [" .. WEAPON_SECTION .. "]")
        return false
    end

    local snd_path = sounds[math.random(1, #sounds)]
    dbg("Tentative lecture son V6: " .. snd_path)

    local r1 = try_method_1_2d(actor_obj, snd_path)
    local r2 = try_method_2_3d(target, snd_path)
    local r3 = try_method_3_play(actor_obj, snd_path)

    return r1 or r2 or r3
end

local function on_melee_hit_after_calcs(hit, target, bone_id)
    cleanup_spawned_sounds()

    local actor_obj = get_actor()
    if not actor_obj then return end

    local active_item = get_active_item(actor_obj)
    local active_section = safe_call(active_item, "section")
    local active_id = safe_call(active_item, "id")

    if active_section ~= WEAPON_SECTION then return end
    if not target then return end

    local actor_id = safe_call(actor_obj, "id")
    local target_id = safe_call(target, "id")
    local hit_weapon_id = hit and hit.weapon_id or nil

    if target_id ~= nil and actor_id ~= nil and target_id == actor_id then
        return
    end

    if REQUIRE_WEAPON_ID_MATCH then
        if active_id == nil or hit_weapon_id == nil or tonumber(active_id) ~= tonumber(hit_weapon_id) then
            dbg("weapon_id mismatch | active_id=" .. safe_tostring(active_id) .. " | hit.weapon_id=" .. safe_tostring(hit_weapon_id))
            return
        end
    end

    if target_id and not target_passes_cooldown(target_id) then
        return
    end

    dbg(string.format(
        "HIT GORE TRY V6 | weapon=%s | target_id=%s | target_sec=%s | bone=%s | alive=%s",
        safe_tostring(active_section),
        safe_tostring(target_id),
        safe_tostring(safe_call(target, "section")),
        safe_tostring(get_target_bone_name(target, bone_id)),
        safe_tostring(safe_call(target, "alive"))
    ))

    local ok = try_play_debug_sound(target)
    dbg("play_sound result = " .. safe_tostring(ok))
end

function on_game_start()
    dbg("initialisation du script melee_gore_debug v6 MULTI-METHOD pour " .. WEAPON_SECTION)

    if RegisterScriptCallback then
        RegisterScriptCallback("on_before_hit_after_calcs", on_melee_hit_after_calcs)
        dbg("RegisterScriptCallback(on_before_hit_after_calcs) OK")
    else
        dbg("ERREUR: RegisterScriptCallback indisponible")
    end
end