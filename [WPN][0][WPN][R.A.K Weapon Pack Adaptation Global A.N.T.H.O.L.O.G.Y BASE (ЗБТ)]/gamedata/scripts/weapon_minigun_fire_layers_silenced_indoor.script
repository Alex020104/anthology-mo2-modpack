-- weapon_minigun_fire_layers.script
-- Player-only scripted fire audio for wpn_lewd_m134
-- Supports:
--   normal
--   _indoor
--   _silenced
--   _silenced_indoor

local enabled = true

local TARGET_WEAPON = "wpn_m134"

local FIRE_AUDIO_CFG = {
    loop_start_delay_ms = 60,
    fire_hold_timeout_ms = 90,
    debug = false,
}

local fire_state = {
    mode = "idle", -- idle / start / loop
    weapon_id = nil,
    start_time = 0,
    last_fire_anim_time = 0,

    start_snd = nil,
    loop_snd = nil,
    end_snd = nil,

    loop_path = nil,
}

----------------------------------------------------------------------------------------------------
-- Debug
----------------------------------------------------------------------------------------------------

local function dbg(txt)
    if FIRE_AUDIO_CFG.debug then
        printf("[weapon_minigun_fire_layers] %s", tostring(txt))
    end
end

----------------------------------------------------------------------------------------------------
-- Time / weapon helpers
----------------------------------------------------------------------------------------------------

local function now_ms()
    return time_global()
end

local function get_active_weapon()
    if not db.actor then
        return nil
    end

    local item = db.actor:active_item()
    if not item then
        return nil
    end

    if not IsWeapon(item) or IsMelee(item) then
        return nil
    end

    return item
end

local function is_target_weapon(item)
    return item and item:section() == TARGET_WEAPON
end

----------------------------------------------------------------------------------------------------
-- Sound helpers
----------------------------------------------------------------------------------------------------

local function safe_stop(snd)
    if snd and snd:playing() then
        snd:stop()
    end
end

local function parse_sound_line_from_value(value)
    if not value or value == "" then
        return nil
    end

    local parts = str_explode(value, ",")
    if not parts or not parts[1] then
        return nil
    end

    return {
        path = parts[1],
        volume = tonumber(parts[2]) or 1,
        frequency = tonumber(parts[3]) or 1,
        delay = tonumber(parts[4]) or 0
    }
end

local function play_one_shot(data)
    if not data or not data.path then
        return nil
    end

    local snd = sound_object(data.path)
    if not snd then
        return nil
    end

    snd:play(db.actor, data.delay, sound_object.s2d)
    snd.volume = data.volume
    snd.frequency = data.frequency
    return snd
end

local function play_loop(data)
    if not data or not data.path then
        return nil
    end

    local snd = sound_object(data.path)
    if not snd then
        return nil
    end

    snd:play(db.actor, data.delay, sound_object.s2d + sound_object.looped)
    snd.volume = data.volume
    snd.frequency = data.frequency
    return snd
end

----------------------------------------------------------------------------------------------------
-- Variant selection
----------------------------------------------------------------------------------------------------

local function weapon_has_silencer(wpn)
    if not wpn then
        return false
    end

    local ok, result = pcall(function()
        local cw = wpn:cast_Weapon()
        return cw and cw:IsSilencerAttached()
    end)

    return ok and result == true
end

local function actor_is_indoor()
    local ok, result = pcall(function()
        return env_actorsnd
            and env_gunsnd_mcm
            and env_gunsnd_mcm.mcm_setup
            and env_actorsnd.score
            and env_actorsnd.score > env_gunsnd_mcm.mcm_setup.new_threshold[1]
    end)

    return ok and result == true
end

local function first_existing_sound_line(section, keys)
    for _, key in ipairs(keys) do
        local value = ini_sys:r_string_ex(section, key)
        if value and value ~= "" then
            return value, key
        end
    end

    return nil, nil
end

local function build_sound_key_candidates(base_key, silenced, indoor)
    local keys = {}

    if silenced and indoor then
        table.insert(keys, base_key .. "_silenced_indoor")
    end

    if silenced then
        table.insert(keys, base_key .. "_silenced")
    end

    if indoor then
        table.insert(keys, base_key .. "_indoor")
    end

    table.insert(keys, base_key)

    return keys
end

local function read_fire_sounds(item)
    local section = item:section()
    local silenced = weapon_has_silencer(item)
    local indoor = actor_is_indoor()

    local start_keys = build_sound_key_candidates("scripted_snd_fire_start_player", silenced, indoor)
    local loop_keys  = build_sound_key_candidates("scripted_snd_fire_loop_player", silenced, indoor)
    local end_keys   = build_sound_key_candidates("scripted_snd_fire_end_player", silenced, indoor)

    local start_value, start_key = first_existing_sound_line(section, start_keys)
    local loop_value,  loop_key  = first_existing_sound_line(section, loop_keys)
    local end_value,   end_key   = first_existing_sound_line(section, end_keys)

    dbg(string.format(
        "variants | silenced=%s indoor=%s | start=%s loop=%s end=%s",
        tostring(silenced),
        tostring(indoor),
        tostring(start_key),
        tostring(loop_key),
        tostring(end_key)
    ))

    return {
        start = start_value and parse_sound_line_from_value(start_value) or nil,
        loop  = loop_value and parse_sound_line_from_value(loop_value) or nil,
        ["end"] = end_value and parse_sound_line_from_value(end_value) or nil,
    }
end

----------------------------------------------------------------------------------------------------
-- State control
----------------------------------------------------------------------------------------------------

local function reset_state()
    safe_stop(fire_state.start_snd)
    safe_stop(fire_state.loop_snd)
    safe_stop(fire_state.end_snd)

    fire_state.mode = "idle"
    fire_state.weapon_id = nil
    fire_state.start_time = 0
    fire_state.last_fire_anim_time = 0

    fire_state.start_snd = nil
    fire_state.loop_snd = nil
    fire_state.end_snd = nil

    fire_state.loop_path = nil
end

local function begin_fire_start(item)
    local snds = read_fire_sounds(item)

    safe_stop(fire_state.start_snd)
    safe_stop(fire_state.loop_snd)
    safe_stop(fire_state.end_snd)

    fire_state.start_snd = nil
    fire_state.loop_snd = nil
    fire_state.end_snd = nil

    fire_state.mode = "start"
    fire_state.weapon_id = item:id()
    fire_state.start_time = now_ms()
    fire_state.last_fire_anim_time = fire_state.start_time
    fire_state.loop_path = snds.loop and snds.loop.path or nil

    if snds.start then
        fire_state.start_snd = play_one_shot(snds.start)
        dbg("fire_start")
    else
        dbg("fire_start skipped (no sound)")
    end
end

local function begin_fire_loop(item)
    local snds = read_fire_sounds(item)
    local next_loop_path = snds.loop and snds.loop.path or nil

    if fire_state.mode == "loop"
        and fire_state.loop_snd
        and fire_state.loop_snd:playing()
        and fire_state.weapon_id == item:id()
        and fire_state.loop_path == next_loop_path
    then
        return
    end

    safe_stop(fire_state.loop_snd)
    fire_state.loop_snd = nil

    fire_state.mode = "loop"
    fire_state.weapon_id = item:id()
    fire_state.loop_path = next_loop_path

    if snds.loop then
        fire_state.loop_snd = play_loop(snds.loop)
        dbg("fire_loop")
    else
        dbg("fire_loop missing")
    end
end

local function stop_fire_with_tail(item)
    local active = item or get_active_weapon()

    safe_stop(fire_state.start_snd)
    safe_stop(fire_state.loop_snd)
    fire_state.start_snd = nil
    fire_state.loop_snd = nil

    if active and is_target_weapon(active) then
        local snds = read_fire_sounds(active)
        if snds["end"] then
            fire_state.end_snd = play_one_shot(snds["end"])
            dbg("fire_end")
        end
    end

    fire_state.mode = "idle"
    fire_state.weapon_id = nil
    fire_state.start_time = 0
    fire_state.last_fire_anim_time = 0
    fire_state.loop_path = nil
end

local function mark_fire_activity(item)
    if not item then
        return
    end

    if fire_state.mode == "idle" then
        begin_fire_start(item)
    else
        fire_state.last_fire_anim_time = now_ms()
    end
end

----------------------------------------------------------------------------------------------------
-- Fire animation detection
----------------------------------------------------------------------------------------------------

local function is_fire_anim_name(anm_name)
    if not anm_name then
        return false
    end

    local name = string.lower(anm_name)

    if string.find(name, "reload") then return false end
    if string.find(name, "bore") then return false end
    if string.find(name, "show") then return false end
    if string.find(name, "hide") then return false end
    if string.find(name, "sprint") then return false end
    if string.find(name, "idle_aim") then return false end
    if string.find(name, "aim_start") then return false end
    if string.find(name, "aim_end") then return false end
    if string.find(name, "jam") then return false end
    if string.find(name, "misfire") then return false end

    if string.find(name, "shot") then return true end
    if string.find(name, "shoot") then return true end
    if string.find(name, "fire") then return true end

    return false
end

----------------------------------------------------------------------------------------------------
-- Callbacks
----------------------------------------------------------------------------------------------------

function actor_on_hud_animation_play(anm_table, item)
    if not enabled then
        return
    end

    local active_item = get_active_weapon()
    if not active_item or not item then
        return
    end

    if item:id() ~= active_item:id() then
        return
    end

    if not is_target_weapon(item) then
        return
    end

    local anm_name = anm_table and anm_table.anm_name or nil
    if not anm_name then
        return
    end

    if is_fire_anim_name(anm_name) then
        dbg("fire anim detected: " .. tostring(anm_name))
        mark_fire_activity(item)
    end
end

function minigun_fire_actor_on_update()
    if not enabled then
        reset_state()
        return
    end

    local active = get_active_weapon()

    if not active or not is_target_weapon(active) then
        if fire_state.mode ~= "idle" then
            stop_fire_with_tail(nil)
        end
        return
    end

    if fire_state.mode == "start" then
        if now_ms() - fire_state.start_time >= FIRE_AUDIO_CFG.loop_start_delay_ms then
            begin_fire_loop(active)
        end
        return
    end

    if fire_state.mode == "loop" then
        if now_ms() - fire_state.last_fire_anim_time > FIRE_AUDIO_CFG.fire_hold_timeout_ms then
            stop_fire_with_tail(active)
        end
        return
    end
end

function actor_on_item_moved(item)
    if item and fire_state.weapon_id and item:id() == fire_state.weapon_id then
        stop_fire_with_tail(nil)
    end
end

function stop_all_minigun_fire_sounds()
    reset_state()
end

function on_game_start()
    RegisterScriptCallback("actor_on_hud_animation_play", actor_on_hud_animation_play)
    RegisterScriptCallback("actor_on_update", minigun_fire_actor_on_update)

    RegisterScriptCallback("actor_on_item_drop", actor_on_item_moved)
    RegisterScriptCallback("actor_item_to_ruck", actor_on_item_moved)
    RegisterScriptCallback("actor_item_to_slot", actor_on_item_moved)

    RegisterScriptCallback("actor_on_attach_vehicle", stop_all_minigun_fire_sounds)
    RegisterScriptCallback("actor_on_before_death", stop_all_minigun_fire_sounds)
    RegisterScriptCallback("actor_on_net_destroy", stop_all_minigun_fire_sounds)
end