-- toz34_teivaz_full_reload_dynamic_surface_casing_sound.script
-- Localized version to reduce global namespace conflicts

local enabled = true

local mat_to_sound = {
    ["earth"]    = "_dirt_",
    ["dirt"]     = "_dirt_",
    ["bush"]     = "_grass_",
    ["grass"]    = "_grass_",
    ["wood"]     = "_wood_",
    ["tree"]     = "_wood_",
    ["metal"]    = "_metal_",
    ["tin"]      = "_metal_",
    ["gravel"]   = "_concrete_",
    ["asphalt"]  = "_concrete_",
    ["tile"]     = "_concrete_",
    ["concrete"] = "_concrete_",
    ["shifer"]   = "_concrete_",
    ["bricks"]   = "_concrete_",
    ["water"]    = "_water_",
}

local soft_mats = {
    ["_dirt_"]  = true,
    ["_grass_"] = true,
    ["_mud_"]   = true,
}

local S = {
    current_material = "dirt",
    current_material_sound = "_dirt_",

    last_anim_name = nil,
    last_weapon_id = nil,
    last_anim_time = 0,
    anti_double_ms = 120,

    token = 0,
    pending = false,

    tracked_weapon_id = nil,
    tracked_source_anim = nil,

    scheduled_class = nil,
    scheduled_variants = 1,
    scheduled_offset = "0.33, 0.18",
}

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

local function now_ms()
    return time_global()
end

local function safe_active_weapon()
    if not db.actor then
        return nil
    end

    local ok, item = pcall(function()
        return db.actor:active_item()
    end)

    if ok then
        return item
    end

    return nil
end

local function safe_id(obj)
    if not obj then
        return nil
    end

    local ok, id = pcall(function()
        return obj:id()
    end)

    if ok then
        return id
    end

    return nil
end

local function safe_section(obj)
    if not obj then
        return nil
    end

    local ok, sec = pcall(function()
        return obj:section()
    end)

    if ok then
        return sec
    end

    return nil
end

local function is_weapon(obj)
    if not obj then
        return false
    end

    local ok, result = pcall(function()
        return IsWeapon(obj) and not IsMelee(obj)
    end)

    return ok and result == true
end

local function read_ini_string(section, key)
    if not section or not key then
        return nil
    end

    local ok, value = pcall(function()
        return ini_sys:r_string_ex(section, key)
    end)

    if ok and value and value ~= "" then
        return value
    end

    return nil
end

local function get_parent_or_self_section(section)
    if not section then
        return nil
    end

    return read_ini_string(section, "parent_section") or section
end

local function get_cfg_string(wpn, key)
    local sec = safe_section(wpn)
    if not sec then
        return nil
    end

    local value = read_ini_string(sec, key)
    if value then
        return value
    end

    local parent_sec = get_parent_or_self_section(sec)
    if parent_sec and parent_sec ~= sec then
        return read_ini_string(parent_sec, key)
    end

    return nil
end

local function get_cfg_number(wpn, key, default_value)
    local sec = safe_section(wpn)
    if not sec then
        return default_value
    end

    local raw = read_ini_string(sec, key)
    if raw then
        local n = tonumber(raw)
        if n then
            return n
        end
    end

    local parent_sec = get_parent_or_self_section(sec)
    if parent_sec and parent_sec ~= sec then
        local raw2 = read_ini_string(parent_sec, key)
        if raw2 then
            local n2 = tonumber(raw2)
            if n2 then
                return n2
            end
        end
    end

    return default_value
end

local function get_body_state()
    local crouch = IsMoveState('mcCrouch')
    local accel = IsMoveState('mcAccel')
    local body_st = "stand"

    if crouch then
        if accel then
            body_st = "low_crouch"
        else
            body_st = "crouch"
        end
    end

    return body_st
end

local function offset_pos(pos, dir, offset_string)
    if not offset_string or offset_string == "" then
        return pos
    end

    local parts = str_explode(offset_string, ",")
    local ox = tonumber(parts and parts[1]) or 0
    local oz = tonumber(parts and parts[2]) or 0

    pos.x = pos.x + dir.z * ox + dir.x * oz
    pos.z = pos.z - dir.x * ox + dir.z * oz
    return pos
end

local function resolve_material_sound()
    local material_sound = S.current_material_sound or "_dirt_"

    if level.rain_wetness() > 0.25 and level.rain_hemi() > 0.25 and soft_mats[material_sound] then
        material_sound = "_mud_"
    end

    return material_sound
end

--------------------------------------------------------------------------------
-- State control
--------------------------------------------------------------------------------

local function cancel_pending_playback()
    S.token = S.token + 1
    S.pending = false
    S.tracked_weapon_id = nil
    S.tracked_source_anim = nil
    S.scheduled_class = nil
    S.scheduled_variants = 1
    S.scheduled_offset = "0.33, 0.18"
end

--------------------------------------------------------------------------------
-- Surface tracking
--------------------------------------------------------------------------------

local function actor_on_footstep_cb(material, power, hud_view, flags)
    local current_material = tostring(material)

    for k, _ in pairs(mat_to_sound) do
        if string.find(current_material, k) then
            current_material = k
            break
        end
    end

    S.current_material = current_material
    S.current_material_sound = mat_to_sound[current_material] or "_dirt_"
end

--------------------------------------------------------------------------------
-- Sound playback
--------------------------------------------------------------------------------

local function play_shell_drop_sound(shell_drop_class, variants, offset_string)
    if not db.actor or not shell_drop_class or shell_drop_class == "" then
        return true
    end

    local actor = db.actor
    local pos = actor:position()
    local dir = actor:direction()
    local volume = 1.0

    local body_st = get_body_state()
    if body_st == "low_crouch" then
        volume = volume * 0.25
        pos.y = pos.y - 0.001
    elseif body_st == "crouch" then
        volume = volume * 0.5
        pos.y = pos.y - 0.0067
    else
        pos.y = pos.y - 0.009
    end

    pos = offset_pos(pos, dir, offset_string)

    local material_sound = resolve_material_sound()
    local count = math.max(1, math.floor(variants or 4))
    local roll = math.random(count)

    local snd_path = "casings\\" .. shell_drop_class .. material_sound .. tostring(roll)

    local snd = sound_object(snd_path)
    if not snd then
        return true
    end

    snd:play_no_feedback(actor, sound_object.s3d, 0, pos, volume, 1)
    return true
end

--------------------------------------------------------------------------------
-- Delayed fire function
--------------------------------------------------------------------------------

local function toz34_shell_drop_delay_fire(my_token)
    if not enabled then
        return true
    end

    if not S.pending then
        return true
    end

    if my_token ~= S.token then
        return true
    end

    local active_wpn = safe_active_weapon()
    if not active_wpn then
        return true
    end

    if safe_id(active_wpn) ~= S.tracked_weapon_id then
        return true
    end

    local cls = S.scheduled_class
    local vars = S.scheduled_variants
    local off = S.scheduled_offset

    S.pending = false
    S.tracked_weapon_id = nil
    S.tracked_source_anim = nil
    S.scheduled_class = nil
    S.scheduled_variants = 1
    S.scheduled_offset = "0.33, 0.18"

    play_shell_drop_sound(cls, vars, off)
    return true
end

local function schedule_shell_drop(wpn, anim_name, shell_drop_class, shell_drop_delay, shell_drop_variants, shell_drop_offset)
    if not wpn or not shell_drop_class or shell_drop_class == "" then
        return
    end

    local my_token = S.token + 1

    S.token = my_token
    S.pending = true
    S.tracked_weapon_id = safe_id(wpn)
    S.tracked_source_anim = anim_name
    S.scheduled_class = shell_drop_class
    S.scheduled_variants = shell_drop_variants
    S.scheduled_offset = shell_drop_offset

    -- shell_drop_delay is in SECONDS
    CreateTimeEvent(
        "toz34_shell_drop_delay_fire",
        my_token,
        shell_drop_delay,
        toz34_shell_drop_delay_fire,
        my_token
    )
end

--------------------------------------------------------------------------------
-- Main trigger
--------------------------------------------------------------------------------

local function actor_on_hud_animation_play_cb(anm_table, wpn)
    if not enabled or not anm_table then
        return
    end

    local anm_name = anm_table.anm_name
    if not anm_name or anm_name == "" then
        return
    end

    -- Only explicit hide cancels here
    if string.find(anm_name, "hide") then
        cancel_pending_playback()
        return
    end

    local active_wpn = safe_active_weapon()
    if not wpn or not is_weapon(wpn) or not active_wpn then
        return
    end

    if safe_id(wpn) ~= safe_id(active_wpn) then
        return
    end

    local cfg_anim = get_cfg_string(wpn, "shell_drop_anim")
    if not cfg_anim or cfg_anim == "" then
        return
    end

    if anm_name ~= cfg_anim then
        return
    end

    local t = now_ms()
    local wid = safe_id(wpn)
    if S.last_weapon_id == wid and S.last_anim_name == anm_name and (t - S.last_anim_time) <= S.anti_double_ms then
        return
    end

    S.last_weapon_id = wid
    S.last_anim_name = anm_name
    S.last_anim_time = t

    local shell_drop_class = get_cfg_string(wpn, "shell_drop_class")
    if not shell_drop_class or shell_drop_class == "" then
        return
    end

    local shell_drop_delay = get_cfg_number(wpn, "shell_drop_delay", 0.0)
    local shell_drop_variants = get_cfg_number(wpn, "shell_drop_variants", 1)
    local shell_drop_offset = get_cfg_string(wpn, "shell_drop_offset") or "0.33, 0.18"

    schedule_shell_drop(
        wpn,
        anm_name,
        shell_drop_class,
        shell_drop_delay,
        shell_drop_variants,
        shell_drop_offset
    )
end

local function actor_on_hud_animation_end_cb(wpn, anim_name, p3, p4, p5)
    -- Intentionally no cancel here.
    -- The source animation can end normally long before delayed shell-drop playback.
end

--------------------------------------------------------------------------------
-- Edge cases
--------------------------------------------------------------------------------

local function actor_on_item_moved_cb(item)
    if not item then
        return
    end

    if S.tracked_weapon_id and safe_id(item) == S.tracked_weapon_id then
        cancel_pending_playback()
    end
end

local function stop_shell_drop_sound_system_cb()
    cancel_pending_playback()
end

--------------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------------

function on_game_start()
    RegisterScriptCallback("actor_on_footstep", actor_on_footstep_cb)
    RegisterScriptCallback("actor_on_hud_animation_play", actor_on_hud_animation_play_cb)
    RegisterScriptCallback("actor_on_hud_animation_end", actor_on_hud_animation_end_cb)

    RegisterScriptCallback("actor_on_item_drop", actor_on_item_moved_cb)
    RegisterScriptCallback("actor_item_to_ruck", actor_on_item_moved_cb)
    RegisterScriptCallback("actor_item_to_slot", actor_on_item_moved_cb)

    RegisterScriptCallback("actor_on_attach_vehicle", stop_shell_drop_sound_system_cb)
    RegisterScriptCallback("actor_on_before_death", stop_shell_drop_sound_system_cb)
    RegisterScriptCallback("actor_on_net_destroy", stop_shell_drop_sound_system_cb)
end