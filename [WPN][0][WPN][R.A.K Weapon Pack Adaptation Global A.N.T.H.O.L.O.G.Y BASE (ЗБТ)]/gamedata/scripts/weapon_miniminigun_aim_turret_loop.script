-- weapon_minigun_aim_rattle.script
-- Version avec support indoor pour le loop de tourelle
-- Les sons start/end restent gérés par animation_common / scripted_snd classiques

local enabled = true
local snd_obj = nil
local cached_id = nil
local current_snd_path = nil
local loop_active = false

local TARGET_WEAPON = "wpn_miniminigun"
local volume_base = 1

local function isIndoor()
    if sar_main and sar_main.current_score then
        if sar_main.current_score > sar_main.mcm_settings.upper_threshold[1] then
            return true
        end
    end
    return false
end

local function stop_loop_sound()
    if snd_obj and snd_obj:playing() then
        snd_obj:stop()
    end

    snd_obj = nil
    cached_id = nil
    current_snd_path = nil
    loop_active = false
end

local function is_target_weapon(item)
    return item and item:section() == TARGET_WEAPON
end

local function is_idle_aim_loop_anim(anm_name)
    if not anm_name then
        return false
    end

    if not string.find(anm_name, "idle_aim") then
        return false
    end

    if string.find(anm_name, "idle_aim_start") then
        return false
    end

    if string.find(anm_name, "idle_aim_end") then
        return false
    end

    return true
end

local function is_empty_aim_anim(anm_name)
    if not anm_name then
        return false
    end

    return string.find(anm_name, "_empty") ~= nil
end

local function read_loop_sound_value(section, anm_name)
    local indoor = isIndoor()
    local is_empty = is_empty_aim_anim(anm_name)
    local snd_value = nil

    -- priorité la plus spécifique
    if is_empty and indoor then
        snd_value = ini_sys:r_string_ex(section, "scripted_snd_idle_aim_loop_empty_indoor")
    end

    if (not snd_value or snd_value == "") and is_empty then
        snd_value = ini_sys:r_string_ex(section, "scripted_snd_idle_aim_loop_empty")
    end

    if (not snd_value or snd_value == "") and indoor then
        snd_value = ini_sys:r_string_ex(section, "scripted_snd_idle_aim_loop_indoor")
    end

    if (not snd_value or snd_value == "") then
        snd_value = ini_sys:r_string_ex(section, "scripted_snd_idle_aim_loop")
    end

    return snd_value
end

local function play_loop_for_anim(item, anm_name)
    local section = item:section()
    if not section then
        return
    end

    local snd_value = read_loop_sound_value(section, anm_name)
    if not snd_value or snd_value == "" then
        return
    end

    local snd_values = str_explode(snd_value, ",")
    local snd_path = snd_values[1]
    local volume = tonumber(snd_values[2]) or 1
    local frequency = tonumber(snd_values[3]) or 1
    local delay = tonumber(snd_values[4]) or 0

    if loop_active
        and snd_obj
        and snd_obj:playing()
        and cached_id == item:id()
        and current_snd_path == snd_path
    then
        return
    end

    stop_loop_sound()

    snd_obj = sound_object(snd_path)
    if not snd_obj then
        return
    end

    cached_id = item:id()
    current_snd_path = snd_path
    loop_active = true

    snd_obj:play(db.actor, delay, sound_object.s2d + sound_object.looped)
    snd_obj.volume = volume_base * volume
    snd_obj.frequency = frequency
end

function actor_on_hud_animation_play(anm_table, item)
    local active_item = db.actor and db.actor:active_item() or nil
    if not enabled or not item or not active_item then
        stop_loop_sound()
        return
    end

    if item:id() ~= active_item:id() then
        return
    end

    if not is_target_weapon(item) then
        if loop_active and cached_id == item:id() then
            stop_loop_sound()
        end
        return
    end

    local anm_name = anm_table and anm_table.anm_name or nil
    if not anm_name then
        return
    end

    if is_idle_aim_loop_anim(anm_name) then
        play_loop_for_anim(item, anm_name)
        return
    end

    if loop_active and cached_id == item:id() then
        stop_loop_sound()
    end
end

function actor_on_item_moved(item)
    if item and cached_id and item:id() == cached_id then
        stop_loop_sound()
    end
end

function stop_sound_playback()
    stop_loop_sound()
end

function on_game_start()
    RegisterScriptCallback("actor_on_hud_animation_play", actor_on_hud_animation_play)
    RegisterScriptCallback("actor_on_item_drop", actor_on_item_moved)
    RegisterScriptCallback("actor_item_to_ruck", actor_on_item_moved)
    RegisterScriptCallback("actor_item_to_slot", actor_on_item_moved)
    RegisterScriptCallback("actor_on_attach_vehicle", stop_sound_playback)
    RegisterScriptCallback("actor_on_before_death", stop_sound_playback)
    RegisterScriptCallback("actor_on_net_destroy", stop_sound_playback)
end