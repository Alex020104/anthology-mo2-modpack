# Track only MO2 mod scripts/configs.
*
!*/
!*/gamedata/
!*/gamedata/configs/**
!*/gamedata/scripts/**
!README.md
!.gitignore
!.gitattributes

# Managed manually outside the launcher update archive.
*R.A.K Weapon Pack Adaptation Global A.N.T.H.O.L.O.G.Y*/**

# Launcher-managed scripts for R.A.K Mag Redux.
!\[WPN\]\[3\]\[MAG\]\[R.A.K Weapon Pack Adaptation Global A.N.T.H.O.L.O.G.Y Mags Redux(ЗБТ)\]/
!\[WPN\]\[3\]\[MAG\]\[R.A.K Weapon Pack Adaptation Global A.N.T.H.O.L.O.G.Y Mags Redux(ЗБТ)\]/gamedata/
!\[WPN\]\[3\]\[MAG\]\[R.A.K Weapon Pack Adaptation Global A.N.T.H.O.L.O.G.Y Mags Redux(ЗБТ)\]/gamedata/scripts/
!\[WPN\]\[3\]\[MAG\]\[R.A.K Weapon Pack Adaptation Global A.N.T.H.O.L.O.G.Y Mags Redux(ЗБТ)\]/gamedata/scripts/**

