-- Anthology 2.1 - Mutant Loot Space Key Fix v1.0.0 BETA
-- The stock UIMutantLoot window advertises ENTER/SPACE for "Loot all",
-- but ui_mutant_loot.script handles only DIK_RETURN.
-- This compatibility patch maps DIK_SPACE to DIK_RETURN and then delegates
-- to the original handler without replacing mutant-loot mechanics.

local VERSION = "1.0.0-beta"
local LOG_TAG = "[MutantLootSpaceFix v1.0.0]"
local SENTINEL = "__anthology_mutant_loot_space_key_fix_v100"

local function install_patch()
    if not ui_mutant_loot or not ui_mutant_loot.UIMutantLoot then
        printf("%s deferred: UIMutantLoot is not ready", LOG_TAG)
        return false
    end

    local cls = ui_mutant_loot.UIMutantLoot
    if cls[SENTINEL] then
        return true
    end

    local original_on_keyboard = cls.OnKeyboard
    if type(original_on_keyboard) ~= "function" then
        printf("%s failed: original OnKeyboard is unavailable", LOG_TAG)
        return false
    end

    cls.OnKeyboard = function(self, dik, keyboard_action)
        if dik == DIK_keys.DIK_SPACE then
            dik = DIK_keys.DIK_RETURN
        end
        return original_on_keyboard(self, dik, keyboard_action)
    end

    cls[SENTINEL] = true
    printf("%s installed: DIK_SPACE -> DIK_RETURN", LOG_TAG)
    return true
end

function on_game_start()
    install_patch()
end

printf("[MutantLootSpaceFix] Anthology Mutant Loot Space Key Fix %s loaded", VERSION)
install_patch()
