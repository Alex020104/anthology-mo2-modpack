--- TODO:
--- add mcm option to set highlight color

--- mcm variables
local mcm_enable_animations = true
local mcm_unequip_helmet = false
local mcm_allow_skip_abuse = false
local mcm_strict_sprinting = false
local mcm_strict_helmets = false
--- local variables
local ini_eff = {}
local ini_strict_helmets_whitelist = {}
local opt_enable_animations = false
local bags = { actor_bag = true }
local ready_color = GetARGB(100, 255, 159, 82)
local items_in_use = {}
local r_nvg = z_beefs_nvgs or z_vanilla_nvgs
local pending_restore_helmet_id = nil
local pending_restore_helmet_section = nil
local pending_restore_nvg = false
local restore_headgear_delay = 2.25
local restore_nvg_delay = 1.0
local ini_toxic_gear = nil
local ini_actor_effects = nil
local bypass_integrated_helmet = false
local integrated_mask_hidden = false
local integrated_helmet_session_active = false
local integrated_hide_queued = false
local integrated_restore_queued = false
local pending_integrated_restore_section = nil
local restore_integrated_helmet_delay = 2.25
local created_integrated_use_action = false
local has_items_in_use
local hud_helmet_cache = {}
local preferred_hud_helmets = {
    hud_gass = { "helm_resp", "helm_respirator", "helm_respirator_gp5", "helm_respirator_joker", "helm_respirator_old" },
    hud_hard = { "helm_m40", "helm_ach7ex", "helm_m50", "helm_ranger", "helm_ppm88" },
    hud_mil = { "helm_tactic", "helm_battle", "helm_spartan", "helm_metro", "helm_ach7", "helm_hardhat", "helm_hardhat_snag" },
    hud_exo = { "helm_exo", "helm_m50", "helm_ranger", "helm_ach7ex" },
    hud_sci = { "helm_protective" },
}
-- callbacks
AddScriptCallback("on_fddar_consumable_anim_start") -- Params:(<string>)
AddScriptCallback("on_fddar_consumable_anim_end")   -- Params:(<string>)

local function trim_value(value)
    return value and string.gsub(value, "^%s*(.-)%s*$", "%1") or nil
end

local function read_csv_first(ini, section, key)
    if not (ini and section and key) then return nil end

    local ok, value = pcall(function()
        return ini:r_string_ex(section, key)
    end)
    if not (ok and value and value ~= "") then return nil end

    return trim_value(string.match(value, "^%s*([^,]+)"))
end

local function has_headgear_animation(section)
    return section and ini_sys and ini_sys:section_exist(section .. "_headgear_hud")
end

local function item_hud(section)
    if not section then return nil end
    return read_csv_first(ini_toxic_gear, "settings_gear", section) or read_csv_first(ini_actor_effects, "settings_helm", section)
end

local function mapped_to_hud(section, hud)
    local mapped_hud = item_hud(section)
    return mapped_hud and mapped_hud == hud
end

local function scan_helmet_for_hud(ini, group, hud)
    if not (ini and group and hud) then return nil end

    local ok_count, count = pcall(function()
        return ini:line_count(group)
    end)
    if not (ok_count and count) then return nil end

    for i = 0, count - 1 do
        local ok_line, _, id, value = pcall(function()
            return ini:r_line_ex(group, i, "", "")
        end)
        if ok_line and id and value and string.find(id, "^helm_") then
            local entry_hud = trim_value(string.match(value, "^%s*([^,]+)"))
            if entry_hud == hud and has_headgear_animation(id) then
                return id
            end
        end
    end

    return nil
end

local function refresh_integrated_helmet_ini()
    local ok_toxic, toxic_gear = pcall(ini_file, "plugins\\toxic_air_gear.ltx")
    local ok_actor, actor_effects_ini = pcall(ini_file, "plugins\\actor_effects.ltx")

    ini_toxic_gear = ok_toxic and toxic_gear or nil
    ini_actor_effects = ok_actor and actor_effects_ini or nil
    hud_helmet_cache = {}
end

local function helmet_for_hud(hud)
    if not hud then return nil end
    if hud_helmet_cache[hud] ~= nil then return hud_helmet_cache[hud] or nil end

    local preferred = preferred_hud_helmets[hud]
    if preferred then
        for i = 1, #preferred do
            local section = preferred[i]
            if has_headgear_animation(section) and mapped_to_hud(section, hud) then
                hud_helmet_cache[hud] = section
                return section
            end
        end
    end

    local scanned = scan_helmet_for_hud(ini_toxic_gear, "settings_gear", hud)
        or scan_helmet_for_hud(ini_actor_effects, "settings_helm", hud)

    hud_helmet_cache[hud] = scanned or false
    return scanned
end

local function virtual_headgear_section_for_outfit(outfit)
    local outfit_section = outfit and outfit:section()
    if not outfit_section then return nil end

    local hud = item_hud(outfit_section)
    return helmet_for_hud(hud) or outfit_section
end

local function actor_item_in_slot(slot)
    if not db.actor then return nil end

    local ok, obj = pcall(function()
        return db.actor:item_in_slot(slot)
    end)

    return ok and obj or nil
end

local function get_integrated_helmet_outfit()
    if actor_item_in_slot(12) then return nil end

    local outfit = actor_item_in_slot(7)
    if not outfit then return nil end

    local ok, custom_outfit = pcall(function()
        return outfit:cast_CustomOutfit()
    end)

    if ok and custom_outfit and custom_outfit.bIsHelmetAvaliable == false then
        return outfit
    end

    return nil
end

local function item_requires_open_face(obj_or_section)
    local section = type(obj_or_section) == "string" and obj_or_section or obj_or_section and obj_or_section:section()
    return section and ini_eff and ini_eff:section_exist(section) and ini_eff:r_bool_ex(section, "helm") == false
end

local function should_handle_integrated_helmet(obj_or_section)
    return mcm_strict_helmets and item_requires_open_face(obj_or_section) and get_integrated_helmet_outfit() ~= nil
end

function can_handle_integrated_helmet_use(obj_or_section)
    return should_handle_integrated_helmet(obj_or_section)
end

local function set_mask_hidden(hidden)
    if not (db.actor and ui_options and ui_options.get and actor_effects and actor_effects.switch_helm and actor_effects.Update_Mask) then
        return false
    end

    if not ui_options.get("video/player/mask_hud") then return false end
    if hidden and actor_effects.is_mask_on and not actor_effects.is_mask_on() then return false end

    actor_effects.switch_helm()
    actor_effects.Update_Mask(db.actor)
    return true
end

local function hide_integrated_helmet_mask()
    if not get_integrated_helmet_outfit() or integrated_mask_hidden then return false end

    local hidden = set_mask_hidden(true)
    if hidden then integrated_mask_hidden = true end
    return hidden
end

local function restore_integrated_helmet_mask()
    if not integrated_mask_hidden then return end

    set_mask_hidden(false)
    integrated_mask_hidden = false
    pending_integrated_restore_section = nil
end

local function reset_integrated_helmet_session()
    integrated_helmet_session_active = false
    integrated_hide_queued = false
    integrated_restore_queued = false
    pending_integrated_restore_section = nil
end

local function wrap_virtual_animation(action, tag, restore)
    if type(action) ~= "table" then return nil end

    local original_exit = action.exit
    action.tag = tag
    action.name = tag
    action.exit = function(self, ...)
        local result
        if original_exit then result = original_exit(self, ...) end

        if restore then
            restore_integrated_helmet_mask()
            reset_integrated_helmet_session()
        else
            integrated_hide_queued = false
            integrated_helmet_session_active = true
            hide_integrated_helmet_mask()
        end

        return result
    end

    return action
end

local function create_virtual_unequip_action(section)
    if not (liz_fdda_redone_headgear_animations and liz_fdda_redone_headgear_animations.ta_animation_unequip) then return nil end
    return wrap_virtual_animation(liz_fdda_redone_headgear_animations.ta_animation_unequip(section), "codex_integrated_helmet_hide", false)
end

local function create_virtual_equip_action(section)
    if not (liz_fdda_redone_headgear_animations and liz_fdda_redone_headgear_animations.ta_animation_equip) then return nil end
    return wrap_virtual_animation(liz_fdda_redone_headgear_animations.ta_animation_equip(section), "codex_integrated_helmet_restore", true)
end

local function schedule_delayed_integrated_helmet_restore(section)
    if not section then
        restore_integrated_helmet_mask()
        return
    end

    pending_integrated_restore_section = section
    RemoveTimeEvent("liz_fdda_consumables", "restore_integrated_helmet")
    CreateTimeEvent("liz_fdda_consumables", "restore_integrated_helmet", restore_integrated_helmet_delay, function()
        if not pending_integrated_restore_section then
            return true
        end

        if integrated_hide_queued or integrated_restore_queued or lam2.is_running() or has_items_in_use() then
            ResetTimeEvent("liz_fdda_consumables", "restore_integrated_helmet", restore_integrated_helmet_delay)
            return false
        end

        local equip_action = create_virtual_equip_action(pending_integrated_restore_section)
        pending_integrated_restore_section = nil
        if equip_action then
            integrated_restore_queued = true
            lam2.add_action(equip_action)
        else
            restore_integrated_helmet_mask()
            reset_integrated_helmet_session()
        end
        return true
    end)
end

local function queue_virtual_integrated_helmet_animations(obj)
    if not (created_integrated_use_action and lam2 and lam2.add_action and lam2.add_action_first) then return end

    local outfit = get_integrated_helmet_outfit()
    local section = virtual_headgear_section_for_outfit(outfit)
    if not section then return end

    if not (integrated_helmet_session_active or integrated_hide_queued or integrated_mask_hidden or integrated_restore_queued) then
        local unequip_action = create_virtual_unequip_action(section)
        if unequip_action then
            integrated_helmet_session_active = true
            integrated_hide_queued = true
            lam2.add_action_first(unequip_action)
        end
    end

    schedule_delayed_integrated_helmet_restore(section)
end

--- ------------------------------------------
--- init
--- ------------------------------------------

function on_game_start()
    RegisterScriptCallback("on_game_load", initialize)
    RegisterScriptCallback("on_option_change", initialize)
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	rax_persistent_highlight.register("liz_fdda", check_ready)
end


function initialize()
    ini_eff = ini_file("items\\items\\animations_settings.ltx")
    ini_strict_helmets_whitelist = ini_file("items\\items\\headgear_item_use_whitelist.ltx")
    refresh_integrated_helmet_ini()
    opt_enable_animations = ui_options.get("video/player/animations")
    mcm_enable_animations = liz_fdda_redone_mcm.get_config("consumables/enable")
    mcm_unequip_helmet = liz_fdda_redone_mcm.get_config("consumables/unequip_helmet")
    mcm_allow_skip_abuse = liz_fdda_redone_mcm.get_config("consumables/allow_skip_abuse")
    mcm_strict_sprinting = liz_fdda_redone_mcm.get_config("consumables/strict_sprinting")
    mcm_strict_helmets = liz_fdda_redone_mcm.get_config("headgear_anm/strict_helmets")
end


-- if game saved or loaded during animation there might be leftover dummy object. delete it
function actor_on_first_update()
    local obj_dummy = db.actor:object("items_anm_dummy")
    if obj_dummy then alife_release(obj_dummy) end
end

has_items_in_use = function()
    for _, value in pairs(items_in_use) do
        if value then
            return true
        end
    end
    return false
end

function schedule_delayed_headgear_restore()
    if not pending_restore_helmet_id then
        return
    end

    RemoveTimeEvent("liz_fdda_consumables", "restore_headgear")
    CreateTimeEvent("liz_fdda_consumables", "restore_headgear", restore_headgear_delay, function()
        if not db.actor or not db.actor:alive() then
            pending_restore_helmet_id = nil
            pending_restore_helmet_section = nil
            pending_restore_nvg = false
            return true
        end

        if lam2.is_running() or has_items_in_use() then
            ResetTimeEvent("liz_fdda_consumables", "restore_headgear", restore_headgear_delay)
            return false
        end

        if db.actor:item_in_slot(12) then
            if pending_restore_nvg then
                CreateTimeEvent("liz_fdda_consumables", "restore_nvg", restore_nvg_delay, restore_nvg_after_headgear)
            else
                pending_restore_helmet_id = nil
                pending_restore_helmet_section = nil
            end
            return true
        end

        local restored = false
        db.actor:iterate_ruck(function(actor, item)
            if item:id() == pending_restore_helmet_id then
                restored = true
                liz_fdda_redone_headgear_animations.on_toggle_equip(item)
            end
        end, nil)

        if restored then
            if pending_restore_nvg then
                CreateTimeEvent("liz_fdda_consumables", "restore_nvg", restore_nvg_delay, restore_nvg_after_headgear)
            else
                pending_restore_helmet_id = nil
                pending_restore_helmet_section = nil
            end
        else
            pending_restore_helmet_id = nil
            pending_restore_helmet_section = nil
            pending_restore_nvg = false
        end

        return true
    end)
end

function restore_nvg_after_headgear()
    if not pending_restore_nvg then
        pending_restore_helmet_id = nil
        pending_restore_helmet_section = nil
        return true
    end

    if not db.actor or not db.actor:alive() then
        pending_restore_helmet_id = nil
        pending_restore_helmet_section = nil
        pending_restore_nvg = false
        return true
    end

    if lam2.is_running() then
        ResetTimeEvent("liz_fdda_consumables", "restore_nvg", restore_nvg_delay)
        return false
    end

    if not db.actor:item_in_slot(12) then
        pending_restore_helmet_id = nil
        pending_restore_helmet_section = nil
        pending_restore_nvg = false
        return true
    end

    local torch = db.actor:item_in_slot(10)
    if torch and r_nvg and item_device and (not item_device.nv_state) then
        local used_animation = false
        if r_nvg.set_nightvision_animated then
            used_animation = r_nvg.set_nightvision_animated(torch:section(), true) == true
        end
        if not used_animation then
            item_device.set_nightvision(torch:section(), true)
        end
    end

    pending_restore_helmet_id = nil
    pending_restore_helmet_section = nil
    pending_restore_nvg = false
    return true
end

--- ------------------------------------------
--- monkey patches
--- ------------------------------------------

-- override default anomaly animation if FDDA animation for it exists
local originalAEPIF = actor_effects.play_item_fx
function actor_effects.play_item_fx(item)
    lam2.log("[CONSUMABLES] Item play fx fucntion called: %s", item)
    if mcm_enable_animations and ini_eff:section_exist(item) then
        return
    end
    -- don't do anything if consuming dummy item that should hide default item use sound. probably not needed
    if item == "items_anm_dummy" then
        return
    end
    -- or pay vanilla animation
    originalAEPIF(item)
end

-- override default item use behaviour (made it public for western goods patch)
originalAOIBU = itms_manager.actor_on_item_before_use
modifiedAOIBU = function (obj, flags)
    -- can't use items while on ladder
    if IsMoveState("mcClimb") then
		actor_menu.set_msg(1, game.translate_string("st_EA_ladder_item_not_allowed"),3)
		flags.ret_value = false
		return
	end
    -- strict helmets should try auto-unequip instead of hard-blocking food use
    if mcm_strict_helmets then
        if not is_can_consume_with_helmet(obj) and is_have_helmet() then
            local helmet = db.actor:item_in_slot(12)
            if not helmet and db.actor:item_in_slot(7) then
                hide_hud_inventory()
                actor_menu.set_msg(1, game.translate_string("liz_ha_text_cant_consume_item"), 3)
                flags.ret_value = false
                return
            end
        end
    end
    -- can't use items if strict sprint is enabled
    if mcm_strict_sprinting then
        if IsMoveState("mcSprint") then
            flags.ret_value = false
            return
        end
    end
    -- delay item use to play fdda animation
    if mcm_enable_animations and ini_eff:section_exist(obj:section()) and flags.ret_value then
        perform_item_use(obj)
        flags.ret_value = false
        return
    end
    -- delay item use to play vanilla animation
    if opt_enable_animations and flags.ret_value then
        perform_vanilla_item_use(obj)
        flags.ret_value = false
        return
    end
    lam2.log("[CONSUMABLES] actor on item before use EOF. flag state is: %s", flags.ret_value)
end
function actor_on_item_before_use(obj, flags, before_modified_callback)
    local should_bypass = should_handle_integrated_helmet(obj)
    created_integrated_use_action = false
    if should_bypass then
        bypass_integrated_helmet = true
    end

    local ok, err = pcall(function()
        originalAOIBU(obj, flags)
        if before_modified_callback then before_modified_callback(obj, flags) end
        modifiedAOIBU(obj, flags)
    end)

    if ok and should_bypass then
        queue_virtual_integrated_helmet_animations(obj)
    end

    bypass_integrated_helmet = false
    created_integrated_use_action = false

    if not ok then
        error(err)
    end
end

itms_manager.actor_on_item_before_use = actor_on_item_before_use

-- disassemble animations
local originalIPFD = item_parts.func_disassembly
item_parts.func_disassembly = function (obj, obj_d)
	if not opt_enable_animations then
        originalIPFD(obj, obj_d)
        return
	end
    perform_disassembly_animation(obj, obj_d)
end

-- hide dummy object
local originalUIPI = ui_inventory.UIInventory.ParseInventory
ui_inventory.UIInventory.ParseInventory = function (self, npc, all, id_list, ignore_kind)
    local inv = originalUIPI(self, npc, all, id_list, ignore_kind)
    local filtered = {}
    for i, o in pairs(inv) do
        if o:section() ~= "items_anm_dummy" then
            filtered[i] = o
        end
    end
    return filtered
end

--- ------------------------------------------
--- main
--- ------------------------------------------

function check_ready(cell)
    if bags[cell.container.ID] then
        return items_in_use[cell.ID] and ready_color
    end
end


function perform_item_use(obj)
    local obj_id = obj:id()
    local direct_integrated_bypass = should_handle_integrated_helmet(obj) and not bypass_integrated_helmet
    if direct_integrated_bypass then
        bypass_integrated_helmet = true
        created_integrated_use_action = false
    end

    if items_in_use[obj_id] then
        if direct_integrated_bypass then
            bypass_integrated_helmet = false
            created_integrated_use_action = false
        end
        return
    end
    items_in_use[obj_id] = true
    if pending_restore_helmet_id then
        schedule_delayed_headgear_restore()
    end

    --create action for item use
    local item_section = obj:section()
    if zzzz_tsx_enjoy_cigs and zzzz_tsx_enjoy_cigs.consume_enjoy_section then
        item_section = zzzz_tsx_enjoy_cigs.consume_enjoy_section(item_section)
    end
    local animation_action = get_template_action_play_animation_fdda_config(item_section)
    animation_action.item_id = obj:id()
    -- animation_action.flag_init = false
    animation_action.on_enter = function (self)
        alife_create_item("items_anm_dummy", db.actor)
    end
    animation_action.on_execute = function (self, time)
        lam2.log("[CONSUMABLES] Self.tm: %s | duration: %s", self.tm, self.duration)
        -- some checks in the first tick
        -- if not self.flag_init then
        --     self.flag_init = true
        --     -- skip if item don't exist
        --     local item_obj = level.object_by_id(self.item_id)
        --     if not item_obj then
        --         lam2.stop_current_action()
        --     end
        --     -- skip if item not in players inventory
        --     local parent = item_obj:parent()
        --     if not (parent and parent:id() == AC_ID) then
        --         lam2.stop_current_action()
        --     end
        --     -- skip item use if strict helmets mode is enabled
        --     if mcm_strict_helmets then
        --         if not is_can_consume_with_helmet(item_obj) and is_have_helmet() then
        --             hide_hud_inventory()
        --             actor_menu.set_msg(1, game.translate_string("liz_ha_text_cant_consume_item"), 3)
        --             lam2.stop_all_actions()
        --         end
        --     end
        -- end
        -- skip item use if strict mode is enabled (test every tick)
        if mcm_strict_sprinting then
            if IsMoveState("mcSprint") and self.can_skip then
                lam2.stop_all_actions()
            end
        end
        -- try to consume item
        if not self.is_consumed and (time > self.tm or time > self.duration) then
            self.is_consumed = true
            --remove from hidden items list
            items_in_use[self.item_id] = nil
            --check if item exists
            local item_obj = level.object_by_id(self.item_id)
            if not item_obj then
                lam2.stop_current_action()
                return lam2.states.fail
            end
            --check if item in player's inventory
            local parent = item_obj:parent()
            if not (parent and parent:id() == AC_ID) then
                lam2.stop_current_action()
                return lam2.states.fail
            end
            --consume
            db.actor:eat(item_obj)
            db.actor:eat(db.actor:object("items_anm_dummy"))
            if not mcm_allow_skip_abuse then
                self.can_skip = false
            end
        end
    end
    animation_action.on_skip = function (self)
        if not self.is_consumed then
            --- if item was not consumed it means that we interrupted item usage
            items_in_use[self.item_id] = nil
            db.actor:eat(db.actor:object("items_anm_dummy"))
        end
    end

    --auto unequip
    if mcm_strict_helmets then
        if not is_can_consume_with_helmet(obj) then
            if is_have_helmet() then
                local helmet = db.actor:item_in_slot(12)
                if helmet then
                    if not lam2.get_action_with_tag("headgear_animation") then
                        pending_restore_helmet_id = helmet:id()
                        pending_restore_helmet_section = helmet:section()
                        pending_restore_nvg = item_device and item_device.nv_state or false
                        liz_fdda_redone_headgear_animations_hotkey.set_last_helmet(helmet)
                        liz_fdda_redone_headgear_animations.on_toggle_unequip(helmet)
                        schedule_delayed_headgear_restore()
                    end
                else
                    items_in_use[obj_id] = nil
                    hide_hud_inventory()
                    actor_menu.set_msg(1, game.translate_string("liz_ha_text_cant_consume_item"), 3)
                    return
                end
            end
        end
    end

    --feed item use actioin to the lam2
    lam2.add_action(animation_action)
    if direct_integrated_bypass then
        queue_virtual_integrated_helmet_animations(obj)
        bypass_integrated_helmet = false
        created_integrated_use_action = false
    end

end


function perform_vanilla_item_use(obj)
    local obj_id = obj:id()
    if items_in_use[obj_id] then return end
    items_in_use[obj_id] = true

    local animation_action = {}
    animation_action.tag = "vanilla_item_use"   -- for debug
    animation_action.hands = 2                  -- works without it, but just in case
    animation_action.item_id = obj_id
    animation_action.flag_force_skip = false
    animation_action.enter = function (self)
        items_in_use[self.item_id] = nil
        -- check if item exists
        local item_obj = level.object_by_id(self.item_id)
        if not item_obj then
            self.flag_force_skip = true
            return
        end
        -- check if item belongs to the player
        local parent = item_obj:parent()
        if not (parent and parent:id() == AC_ID) then
            self.flag_force_skip = true
            return
        end
        -- consume
        db.actor:eat(item_obj)
    end
    animation_action.execute = function (self, time)
        if time > 15 or self.flag_force_skip then
            return lam2.states.fail
        end
        if actor_effects.item_not_in_use then
            return lam2.states.success
        end
        return lam2.states.running
    end

    lam2.add_action(animation_action)

    -- --sound test
    -- itms_manager.play_item_sound(obj)
end


function perform_disassembly_animation(obj, obj_d)
    local obj_id = obj:id()
    if items_in_use[obj_id] then return end
    items_in_use[obj_id] = true
    local a = {}
    a.hands = 2
    a.item_id = obj_id
    a.item_d_id = obj_d and obj_d:id() or nil
    a.d_flag = item_parts.d_flag    -- cache dissasembly safety button
    a.flag_force_skip = false
    a.enter = function (self)
        items_in_use[self.item_id] = nil
        --check if item still exists
        local item_obj = level.object_by_id(self.item_id)
        if not item_obj then
            self.flag_force_skip = true
            return
        end
        local item_d_obj = nil
        --if tool was provided
        if self.item_d_id then
            --check if tool still exists
            item_d_obj = level.object_by_id(self.item_d_id)
            if not item_d_obj then
                self.flag_force_skip = true
                return
            end
            --check if tool still in inventory
            local parent = item_d_obj:parent()
            if not (parent and parent:id() == AC_ID) then
                self.flag_force_skip = true
                return
            end
        end
        -- disassemble
        item_parts.d_flag = self.d_flag     -- get value from cache
        originalIPFD(item_obj, item_d_obj)
        item_parts.d_flag = false           -- reset just in case
    end
    a.execute = function (self, time)
        if time > 15 or self.flag_force_skip then
            return lam2.states.fail
        end
        if actor_effects.item_not_in_use then
            return lam2.states.success
        end
        return lam2.states.running
    end
    lam2.add_action(a)
end

--- ------------------------------------------
--- utils
--- ------------------------------------------

function is_have_helmet()
    if bypass_integrated_helmet and get_integrated_helmet_outfit() then
        return false
    end

    --check if we have helmet in helmet slot
    local o_helm = db.actor:item_in_slot(12)
    if o_helm then
        if ini_strict_helmets_whitelist:section_exist(o_helm:section()) then
            return false
        else
            return true
        end
    end

    --if not check if we have outfit that have integrated helmet
    local o_outfit = db.actor:item_in_slot(7)
    if o_outfit then
        local c_outfit = o_outfit:cast_CustomOutfit()
        if not c_outfit.bIsHelmetAvaliable then return true end
    end

    return false
end

function is_can_consume_with_helmet(obj)
    local helm = ini_eff:r_bool_ex(obj:section(), "helm")
    if helm ~= false then
        return true
    end
    return false
    -- return ini_eff:r_bool_ex(obj:section(), "helm") == false and false or true
end

--- ------------------------------------------
--- fdda action templates
--- ------------------------------------------

-- had to basically copy default template for playing animation from lam2 cuz of how FDDA handles animation configs
function get_template_action_play_animation_fdda_config(item_section)
    local a = {}
    a.duration = 0
    a.name = "fdda_anim_" .. item_section
    a.sec = ini_eff:r_string_ex(item_section, "anm") .. "_hud"
    a.anm = "anm_ea_show"
    a.cam = ini_eff:r_string_ex(item_section, "cam")
    a.snd = ini_eff:r_string_ex(item_section, "snd")
    a.tm = (ini_eff:r_float_ex(item_section, "tm") / 1000) * 0.367 --this formula is from origila fdda
    a.speed = ini_eff:r_float_ex(item_section, "speed") or 1
    a.item_sec = item_section
    a.hands = 2
    a.can_skip = true
    a.only_allow_movekeys = true
    a.disable_input = false
    a.codex_integrated_helmet_consumable = should_handle_integrated_helmet(item_section)
    if a.codex_integrated_helmet_consumable then
        created_integrated_use_action = true
    end

    a.enter = function(self)
        if self.on_init then self:on_init() end
        if self.codex_integrated_helmet_consumable and not integrated_mask_hidden then
            self.codex_integrated_helmet_hidden = hide_integrated_helmet_mask()
        end
        --animation
        self.duration = game.get_motion_length(self.sec, self.anm, self.speed) / 1000
        game.play_hud_motion(self.hands, self.sec, self.anm, false, self.speed)
        lam2.log("[CONSUMABLES] FDDA item speed is: %s", self.speed)
        --camera
        if self.cam then level.add_cam_effector(self.cam, 2190, false, "", 0, false) end
        --sound
        if self.snd then
            lam2.snd_obj = sound_object(self.snd)
            lam2.snd_obj:play(db.actor, 0, sound_object.s2d)
        end
        --fov
        local fov = ini_sys:r_float_ex(self.sec, "hud_fov")
        if fov then lam_fov_manager.set_fov(fov) else lam_fov_manager.set_fov(0.45) end
        --movement
        if self.disable_input then level.disable_input() end
        if self.only_allow_movekeys then
            liz_fdda_input_manager.is_input_disabled = true
            --liz_fdda_input_manager.disable()
            game.set_actor_allow_ladder(false)
        end
        --smoke (took as is from fdda)
        if ciga_effects and ini_eff:line_exist(self.item_sec, "smoke") then
            ciga_effects.ciga_start(self.item_sec)
        end
        --callbacks
        if self.on_enter then self:on_enter() end
        SendScriptCallback("on_fddar_consumable_anim_start", self.item_sec)
    end

    a.execute = function(self, time)
        local result = lam2.states.running
        if time > self.duration then
            lam2.log("[CONSUMABLES] Animation time: %s | duration: %s", time, self.duration)
            result = lam2.states.success
        end
        --callback
        if self.on_execute then
            callback_result = self:on_execute(time)
            if callback_result then result = callback_result end
        end
        return result
    end

    a.exit = function(self)
        lam_fov_manager.restore_fov()
        --movement
        if self.disable_input then level.enable_input() end
        if self.only_allow_movekeys then
            liz_fdda_input_manager.is_input_disabled = false
            -- liz_fdda_input_manager.enable()
            game.set_actor_allow_ladder(true)
        end
        --callbacks
        if self.on_exit then self:on_exit() end
        if self.codex_integrated_helmet_hidden then
            self.codex_integrated_helmet_hidden = nil
            schedule_delayed_integrated_helmet_restore(virtual_headgear_section_for_outfit(get_integrated_helmet_outfit()))
        elseif self.codex_integrated_helmet_consumable and integrated_mask_hidden and not lam2.get_action_with_tag("codex_integrated_helmet_restore") then
            schedule_delayed_integrated_helmet_restore(virtual_headgear_section_for_outfit(get_integrated_helmet_outfit()))
        end
        SendScriptCallback("on_fddar_consumable_anim_end", self.item_sec)
    end

    return a
end
