-- If you don't use MCM, change your defaults from here.
local defaults = {
	["enable_hud"] = true,
	["position_x"] = 865,
	["position_y"] = 700,
	["radioactive_air"] = true,
	["radioactive_air_mult"] = 1,
	["radiation_penetration"] = false,
	["rad_penetration_mult"] = 0.15,
	["radiation_damage"] = false,
	["rad_damage_mult"] = 0.25,
	["breathe_feature"] = true,
	["breathe_key"] = DIK_keys.DIK_G,
	["breathe_modifier"] = 0,
	["breathe_mode"] = 0,
	["filter_animation"] = true,
	["metro_toggle"] = true,
	["filter_equip_key"] = DIK_keys.DIK_G,
	["filter_equip_modifier"] = 0,
	["filter_equip_mode"] = 2,
	["filter_min_condition"] = 0.15,
	["choose_max_quality_filter"] = true,
	["filter_max_quality"] = 0.4,
	["filter_mod_equip_key"] = DIK_keys.DIK_G,
	["filter_mod_equip_modifier"] = 1,
	["filter_mod_equip_mode"] = 2,
	["choose_low_quality_filter"] = true,
	["filter_min_low_quality"] = 0.4,
	["filter_check_key"] = DIK_keys.DIK_G,
	["filter_check_modifier"] = 0,
	["filter_check_mode"] = 1,
	["filter_check_cond"] = true,
	["toxic_underground"] = true,
	["toxic_damage_mult"] = 1,
	["ppe_toggle"] = true,
	["sound_toggle"] = true,
	["filter_degradation_mult"] = 1,
	["flow_rate_mult"] = 1,
	["trader_items"] = 1,
	["spawn_items_with_chance"] = true,
	["chance_items_spawn"] = 0.5,
	["spawn_items_cond_mult"] = 0,
	["delete_items"] = false,
}

function get_config(key)
	if ui_mcm then return ui_mcm.get("toxic_air/"..key) else return defaults[key] end
end

function on_mcm_load()
	op = { id= "toxic_air",sh=true ,gr={
			{ id= "title",type= "slide",link= "ui_options_slider_player",text="ui_mcm_toxic_air_title",size= {512,50},spacing= 20 },
			{id= "divider", type = "line" },
			{id = "enable_hud", type = "check", val = 1, def = true},
			{id = "position_x", type = "input", val = 2, min=0, max=1000, def = 865},
			{id = "position_y", type = "input", val = 2, min=0, max=1000, def = 700},
			{id= "divider", type = "line" },
			{id = "radioactive_air", type = "check", val = 1, def = true},
			{id = "radioactive_air_mult", type = "track", val = 2, min=0.05, max=3, step=0.05, def = 1},
			{id = "radiation_penetration", type = "check", val = 1, def = false},
			{id = "rad_penetration_mult", type = "track", val = 2, min=0.01, max=0.5, step=0.01, def = 0.15},
			{id = "radiation_damage", type = "check", val = 1, def = false},
			{id = "rad_damage_mult", type = "track", val = 2, min=0.05, max=1.0, step=0.05, def = 0.25},
			{id= "divider", type = "line" },
			{id = "breathe_feature", type = "check", val = 1, def = true},
			{id = "breathe_key", type = "key_bind", val = 2, def = DIK_keys.DIK_G},
			{id = "breathe_modifier", type = ui_mcm.kb_mod_radio, val = 2, def = 0, hint = "mcm_kb_modifier", content = { { 0, "mcm_kb_mod_none" }, { 1, "mcm_kb_mod_shift" }, { 3, "mcm_kb_mod_alt" } } },
			{id = "breathe_mode", type = ui_mcm.kb_mod_radio, val = 2, def = 0, hint = "mcm_kb_mode", content = { { 0, "mcm_kb_mode_press" }, { 1, "mcm_kb_mode_dtap" }, { 2, "mcm_kb_mode_hold" } } },
			{id= "divider", type = "line" },
			{id = "filter_animation", type = "check", val = 1, def = true},
			{id = "metro_toggle", type = "check", val = 1, def = true},
			{id = "filter_equip_key", type = "key_bind", val = 2, def = DIK_keys.DIK_G},
			{id = "filter_equip_modifier", type = ui_mcm.kb_mod_radio, val = 2, def = 0, hint = "mcm_kb_modifier", content = { { 0, "mcm_kb_mod_none" }, { 1, "mcm_kb_mod_shift" }, { 3, "mcm_kb_mod_alt" } } },
			{id = "filter_equip_mode", type = ui_mcm.kb_mod_radio, val = 2, def = 2, hint = "mcm_kb_mode", content = { { 0, "mcm_kb_mode_press" }, { 1, "mcm_kb_mode_dtap" }, { 2, "mcm_kb_mode_hold" } } },
			{id = "filter_min_condition", type = "track", val = 2, min=0.05, max=0.85, step=0.05, def = 0.15},
			{id = "choose_max_quality_filter", type = "check", val = 1, def = true},
			{id = "filter_max_quality", type = "track", val = 2, min=0.05, max=0.5, step=0.05, def = 0.4},
			{id= "divider", type = "line" },
			{id = "filter_mod_equip_key", type = "key_bind", val = 2, def = DIK_keys.DIK_G},
			{id = "filter_mod_equip_modifier", type = ui_mcm.kb_mod_radio, val = 2, def = 1, hint = "mcm_kb_modifier", content = { { 0, "mcm_kb_mod_none" }, { 1, "mcm_kb_mod_shift" }, { 3, "mcm_kb_mod_alt" } } },
			{id = "filter_mod_equip_mode", type = ui_mcm.kb_mod_radio, val = 2, def = 2, hint = "mcm_kb_mode", content = { { 0, "mcm_kb_mode_press" }, { 1, "mcm_kb_mode_dtap" }, { 2, "mcm_kb_mode_hold" } } },
			{id = "choose_low_quality_filter", type = "check", val = 1, def = true},
			{id = "filter_min_low_quality", type = "track", val = 2, min=0.05, max=0.5, step=0.05, def = 0.4},
			{id= "divider", type = "line" },
			{id = "filter_check_key", type = "key_bind", val = 2, def = DIK_keys.DIK_G},
			{id = "filter_check_modifier", type = ui_mcm.kb_mod_radio, val = 2, def = 0, hint = "mcm_kb_modifier", content = { { 0, "mcm_kb_mod_none" }, { 1, "mcm_kb_mod_shift" }, { 3, "mcm_kb_mod_alt" } } },
			{id = "filter_check_mode", type = ui_mcm.kb_mod_radio, val = 2, def = 1, hint = "mcm_kb_mode", content = { { 0, "mcm_kb_mode_press" }, { 1, "mcm_kb_mode_dtap" }, { 2, "mcm_kb_mode_hold" } } },
			{id = "filter_check_cond", type = "check", val = 1, def = true},
			{id= "divider", type = "line" },
			{id = "toxic_underground", type = "check", val = 1, def = true},
			{id = "toxic_damage_mult", type = "track", val = 2, min=0.05, max=3, step=0.05, def = 1},
			{id = "ppe_toggle", type = "check", val = 1, def = true},
			{id = "sound_toggle", type = "check", val = 1, def = true},
			{id= "divider", type = "line" },
			{id = "filter_degradation_mult", type = "track", val = 2, min=0.05, max=10, step=0.05, def = 1},
			{id = "flow_rate_mult", type = "track", val = 2, min=0.05, max=5, step=0.05, def = 1},
			{id = "trader_items", type = "track", val = 2, min=0, max=2, step=1, def = 1},
			{id = "spawn_items_with_chance", type = "check", val = 1, def = true},
			{id = "chance_items_spawn", type = "track", val = 2, min=0, max=0.9, step=0.05, def = 0.5},
			{id = "spawn_items_cond_mult", type = "track", val = 2, min=0, max=0.5, step=0.05, def = 0},
			{id= "divider", type = "line" },
			{id= "divider", type = "line" },
			{id= "divider", type = "line" },
			{id = "delete_items", type = "check", val = 1, def = false},
		}
	}

	return op
end