	},
	["expert"] 			= {
		[1] = {"af_oxygen_tank_2", 0.25},
		[2] = {"af_mask_filter_r18", 0.2},
		[3] = {"af_mask_filter_3", 0.15},
		[4] = {"af_oxygen_tank_3", 0.1},
		[5] = {"tank_filling_station", 0.05},
	},
	["master"] 			= {
		[1] = {"af_mask_filter_r18", 0.3},
		[2] = {"af_mask_filter_3", 0.25},
		[3] = {"af_oxygen_tank_3", 0.2},
		[4] = {"af_mask_filter_3isg", 0.15},
		[5] = {"tank_filling_station", 0.10},
	},
	["legend"] 			= {
		[1] = {"af_mask_filter_r18", 0.4},
		[2] = {"af_mask_filter_3", 0.35},
		[3] = {"af_oxygen_tank_3", 0.3},
		[4] = {"af_mask_filter_3isg", 0.25},
		[5] = {"tank_filling_station", 0.20},
	},
}

function spawn_oxygen_tank(npc, npc_rank, npc_comm)
	local rank = npc_rank or "professional"
	local rank_choice = rank_table[rank]
	local random_k = rank_choice[rnd(1,#rank_choice)]
	local sec_to_spawn = random_k[1] or "af_oxygen_tank_1"
	local max_cond = ((mcm_spawn_items_cond_mult + random_k[2]) * 100) or 35
	local avg_cond = rnd(5, max_cond) / 100
	
	if mcm_spawn_items_with_chance then
		local rnd_threshold = rnd()
		if (rnd_threshold <= mcm_chance_items_spawn) then
			death_manager.spawn_with_condition(npc, sec_to_spawn, avg_cond)
		end
	else
		death_manager.spawn_with_condition(npc, sec_to_spawn, avg_cond)
	end
end

SpawnCosmetics = death_manager.spawn_cosmetics

function death_manager.spawn_cosmetics(npc, npc_id, npc_comm, npc_rank, visual, rand_condition)
    SpawnCosmetics(npc, npc_id, npc_comm, npc_rank, visual, rand_condition)
    spawn_oxygen_tank(npc, npc_rank, npc_comm)
end

