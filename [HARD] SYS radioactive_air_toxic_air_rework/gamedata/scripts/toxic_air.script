function actor_on_first_update()
	actor_dying = false

	if toxic_air_mcm.get_config("delete_items") then
		for i = 1, 65534 do
			if alife_object(i) and oxt_tbl[alife_object(i):section_name()] then
				alife_release(alife_object(i))
				tank_cond = {}
			end
			filters = make_filter_table({})
			tanks = make_id_bool_table({})
		end
	end

	restore_tanks_after_load()
	CreateTimeEvent("ta_restore_tanks_load_e", "ta_restore_tanks_load_a", 1, function()
		return restore_tanks_after_load()
	end)

	chemical_dmg = chemical_level[level.name()] or 0
	radioactive_dmg = radioactive_level[level.name()] or 0

	CreateTimeEvent("first_upd_allow_anm_e", "first_upd_allow_anm_a", 2, function()
		allow_anm_play = true
		return true
	end)
	
	CreateTimeEvent("first_upd_toxic_dmg", "first_upd_toxic_dmg", 10, function()
		first_upd_toxic_protect = false
		return true
	end)

end

function save_state(m_data)
    m_data.tank_cond = tank_cond
	tanks = normalize_id_bool_table(tanks)
	m_data.active_tanks = build_active_tank_restore_data()
	m_data.tanks = plain_id_bool_table(tanks)
	filters = normalize_filter_table(filters)
	m_data.filters = plain_filter_table(filters)
end

function load_state(m_data)
	tank_cond = m_data.tank_cond or {}
	tanks = normalize_id_bool_table(m_data.tanks)
	pending_tank_restore = {}
	pending_tank_restore_attempts = 0
	tank_restore_guard_until = 0
	for id, state in pairs(m_data.active_tanks or {}) do
		pending_tank_restore[id] = state
	end
	for id, active in pairs(m_data.tanks or {}) do
		if active and not pending_tank_restore[id] then
			pending_tank_restore[id] = {}
		end
	end
	filters = normalize_filter_table(m_data.filters)
end

------------------ manage equipment slot/ruck/belt -------------
function available_equipment(item)
	local def = is_supported_airgear(item)
	return def and def.mode == "filter" or false
end


function get_helmet_radiation_protection(object)
  local section_object = object and object:section()
  local id_object = object and object:id()
  local total_radiation_protection = 0
  local helmet_avaliable = false

  local se_object = id_object and alife_object(id_object)
  if se_object then
      local data = utils_stpk.get_item_data(se_object)

      for k,v in pairs(data) do
          local radiation_protection = utils_data.read_from_ini(ini_sys, section_object, "radiation_protection", "float", 0)
          total_radiation_protection = radiation_protection * object:condition()
		  helm_cond = object:condition()
          helmet_avaliable = utils_data.read_from_ini(ini_sys, section_object, "helmet_avaliable", "bool", false)
          break
      end
      
      for k,v in pairs(data.upgrades) do
          local upgrade_sect = utils_data.read_from_ini(ini_sys, tostring(v), "section", "string", nil)
          if upgrade_sect then
              local upgrade_radiation_protection = utils_data.read_from_ini(ini_sys, upgrade_sect, "radiation_protection", "float", 0)
              if (upgrade_radiation_protection) then
                  total_radiation_protection = total_radiation_protection + upgrade_radiation_protection
              end
          end
      end

      return total_radiation_protection
  end
end

function get_helmet_chemical_protection(object)
  local section_object = object and object:section()
  local id_object = object and object:id()
  local total_chemical_protection = 0
  local helmet_avaliable = false

  local se_object = id_object and alife_object(id_object)
  if se_object then
      local data = utils_stpk.get_item_data(se_object)

      for k,v in pairs(data) do
          local chemical_protection = utils_data.read_from_ini(ini_sys, section_object, "chemical_burn_protection", "float", 0)
          total_chemical_protection = chemical_protection * object:condition()
		  helm_cond = object:condition()
          helmet_avaliable = utils_data.read_from_ini(ini_sys, section_object, "helmet_avaliable", "bool", false)
          break
      end
      
      for k,v in pairs(data.upgrades) do
          local upgrade_sect = utils_data.read_from_ini(ini_sys, tostring(v), "section", "string", nil)
          if upgrade_sect then
              local upgrade_chemical_protection = utils_data.read_from_ini(ini_sys, upgrade_sect, "chemical_burn_protection", "float", 0)
              if (upgrade_chemical_protection) then
                  total_chemical_protection = total_chemical_protection + upgrade_chemical_protection
              end
          end
      end

      return total_chemical_protection
  end
end

function get_rad_protection(include_outfit)
	local hit_type_rad = HitTypeID["Radiation"]
	local actor = db.actor

	--Calculate new power
	local hit_additional = 0

	-- Outfit protection
	local outfit = actor:item_in_slot(7)
	if include_outfit and outfit then
		local c_obj = outfit:cast_CustomOutfit()
		local prot = c_obj and c_obj:GetDefHitTypeProtection(hit_type_rad) or 0

		hit_additional = hit_additional + prot / 10
	end

	-- Artefacts protection
	actor:iterate_belt(function(owner, obj)
		local sec = obj:section()
		local cond = obj:condition()
		local immunities_sec = SYS_GetParam(0, sec, "hit_absorbation_sect", sec)
		local prot = SYS_GetParam(2, immunities_sec, "radiation_immunity", 0) * cond

		hit_additional = hit_additional + prot
	end)

	-- Booster protection
	actor:cast_Actor():conditions():BoosterForEach(function(booster_type, booster_time, booster_value)
		-- printf("%s, %s, %s", booster_type, booster_time, booster_value)
		if booster_type == BoosterID["RadiationProtection"] then
			-- printf("booster_value %s", booster_value)
			hit_additional = hit_additional + booster_value
		end
	end)

	-- Final modifier
	return hit_additional
end

function get_chem_protection()
	local hit_type_chem = 2
	local actor = db.actor

	--Calculate new power
	local hit_additional = 0

	-- Artefacts protection
	actor:iterate_belt(function(owner, obj)
		local sec = obj:section()
		local cond = obj:condition()
		local immunities_sec = SYS_GetParam(0, sec, "hit_absorbation_sect", sec)
		local prot = SYS_GetParam(2, immunities_sec, "chemical_burn_immunity", 0) * cond

		hit_additional = hit_additional + prot
	end)

	-- Booster protection
	actor:cast_Actor():conditions():BoosterForEach(function(booster_type, booster_time, booster_value)
		-- printf("%s, %s, %s", booster_type, booster_time, booster_value)
		if booster_type == BoosterID["ChemicalBurnProtection"] then
			-- printf("booster_value %s", booster_value)
			hit_additional = hit_additional + booster_value
		end
	end)

	-- Final modifier
	return hit_additional
end

function actor_on_before_hit(s_hit)
	if actor_dying or not actor_is_alive() then
		return
	end

	local hit_type_rad = HitTypeID["Radiation"]
	
	if s_hit.type ~= hit_type_rad and s_hit.type ~= 2 then
		return
	end
	
	local airgear = get_active_airgear_item()
	local helm_gasmask = airgear and true or false
	local helmet = db.actor:item_in_slot(12)
	helm_cond = (airgear and airgear:condition()) or (helmet and helmet:condition()) or 1
	
	if (s_hit.type == hit_type_rad) then
		local hit_power = 0
		
		if arszi_radiation then
			if arszi_radiation.is_player_in_water() then
				hit_power = 0
			else
				hit_power = arszi_radiation.calculate_zone_radiation_power(s_hit.power, s_hit.draftsman)
			end
		else
			hit_power = s_hit.power
		end

		local has_rad_consumable = ((filter_air_protection > 0) or (tank_air_protection > 0)) and (not hold_breathe)
		local radiation_protection = get_rad_protection(has_rad_consumable)
		local helmet_rad_prot = has_rad_consumable and ((helmet and get_helmet_radiation_protection(helmet)) or 0) or 0
		local helm_rad_prot = helmet_rad_prot/10
		local filter_rad_prot = filter_rad_protection/10
		local tank_rad_prot = tank_rad_protection/10

		local diff_rad_helm = radiation_protection + helm_rad_prot - hit_power
		local diff_rad_no_helm = radiation_protection - hit_power
		local diff_rad_filter = radiation_protection + filter_rad_prot - hit_power
		local diff_rad_tank = radiation_protection + helm_rad_prot + tank_rad_prot * helm_cond - hit_power
		
		if (helm_gasmask == true) then
			if (filter_air_protection > 0) and (not hold_breathe) then
				rad_hit = hit_power
				filter_rad_cond()
				if (diff_rad_no_helm < 0) then
					if (diff_rad_helm > diff_rad_filter) then
						hit_power = -diff_rad_filter
					else
						hit_power = -diff_rad_helm
					end
				else
					hit_power = 0
				end
			elseif (tank_air_protection > 0) and (not hold_breathe) then
				s_hit.power = hit_power / 2
				if (diff_rad_tank < 0) then
					hit_power = -diff_rad_tank
				else
					hit_power = 0
				end
			else
				if hold_breathe then
					s_hit.power = hit_power / 2
					hit_power = 0
				else
					hit_power = hit_power - radiation_protection - helm_rad_prot
				end
			end
		else
			if hold_breathe then
				s_hit.power = hit_power / 2
				hit_power = 0
			else
				hit_power = hit_power - helm_rad_prot
			end
		end
		if (hit_power > 0) then
			db.actor:change_radiation(hit_power)
		end
		
		if mcm_rad_penetrarion and (diff_rad_no_helm < 0) then
			local rad_penetration = -diff_rad_no_helm * mcm_rad_penetrarion_mult
			db.actor:change_radiation(rad_penetration)
		end
		
		if mcm_rad_damage and (diff_rad_no_helm < 0) then
			local rad_damage = db.actor.health + diff_rad_no_helm * mcm_rad_damage_mult
			db.actor:set_health_ex(rad_damage)
		end
	end
	
	if (s_hit.type == 2) then
		local chem_hit_power = s_hit.power
		
		if (chem_hit_power > 0.01) then		-- ќграничитель урона, чтобы игрок не тер€л огромное кол-во здоровь€ при попадании в кислотные аномалии, а не пол€
			return
		end
		
		local chemical_protection = get_chem_protection()
		
		if (helm_gasmask == true) then
			if (filter_air_protection > 0) and (not hold_breathe) then
				chem_hit = s_hit.power
				filter_chem_cond()
				chem_hit_power = (chem_hit_power * (1 - filter_toxic_reduction)) - chemical_protection
			elseif (tank_air_protection > 0) and (not hold_breathe) then
				s_hit.power = chem_hit_power / 2
				chem_hit_power = (chem_hit_power * (1 - tank_toxic_reduction)) - chemical_protection
			else
				if hold_breathe then
					s_hit.power = chem_hit_power / 2
					chem_hit_power = 0
				else
					chem_hit_power = chem_hit_power - chemical_protection
				end
			end
		else
			if hold_breathe then
				s_hit.power = chem_hit_power / 2
				chem_hit_power = 0
			else
				chem_hit_power = chem_hit_power - chemical_protection
			end
		end
		if (chem_hit_power > 0) then
			local actor_hp = db.actor.health
			local actor_hp_reduction = actor_hp - chem_hit_power
			db.actor:set_health_ex(actor_hp_reduction)
		end
	end
end

local need_breathe_snd = sound_object("toxic_air\\need_breathe")
local hold_breathe_snd = sound_object("toxic_air\\hold_breathe")

function no_breathe()
	check_actor_move()
	hold_breathe_time = hold_breathe_time - 0.2 * move_mult
	if (hold_breathe_time <= 0) then
		need_hold_breathe = false
		hold_breathe = false
		need_breathe_snd:play(db.actor, 0, sound_object.s2d)
		actor_menu.set_msg(1, gc("st_need_restore_breath"), 4)
	end
	RemoveTimeEvent("no_breathe", "no_breathe")
	check_breathe()
end

function need_breathe_timer()
	check_actor_move()
	hold_breathe_time = hold_breathe_time + 0.3 / move_mult
	RemoveTimeEvent("need_breathe_timer", "need_breathe_timer")
	check_breathe()
end

function check_breathe()
	if need_hold_breathe then
		if not hold_breathe and (hold_breathe_time > 10) then
			hold_breathe = true
			actor_menu.set_msg(1, gc("st_hold_breath"), 4)
			hold_breathe_snd:play(db.actor, 0, sound_object.s2d)
		end
	else
		if hold_breathe then
			if (hold_breathe_time < hold_breathe_max_time / 2) then
				need_breathe_snd:play(db.actor, 0, sound_object.s2d)
			end
			hold_breathe = false
		end
	end
	
	if hold_breathe then
		if (hold_breathe_time > 0) then
			CreateTimeEvent("no_breathe", "no_breathe", 0.2, no_breathe)
		end
	else
		if (hold_breathe_time < hold_breathe_max_time) then
			CreateTimeEvent("need_breathe_timer", "need_breathe_timer", 0.2, need_breathe_timer)
		elseif (hold_breathe_time > hold_breathe_max_time) then
			hold_breathe_time = hold_breathe_max_time
		end
	end
end

function control_breathe()
	if not mcm_breathe_feature then
		return
	end

	if not need_hold_breathe then
		need_hold_breathe = true
	else
		need_hold_breathe = false
	end
	check_breathe()
end

function check_actor_move()
	local sprinting = IsMoveState('mcSprint')
	local moving = IsMoveState('mcAnyMove')
		
	if moving and not sprinting then
		move_mult = 2
	elseif sprinting then
		move_mult = 4
	else
		move_mult = 1
	end
end

function equip_filter()
	local gear, gear_def = get_filter_target_item()
	local gear_id = gear and gear:id()
	local helmet = gear
	local helmet_id = gear_id

	local animations_enabled = toxic_air_mcm.get_config("filter_animation")
	local item = get_installed_filter_item()
		
	if item then
		func_filters(item)
		if not animations_enabled then
			news_manager.send_tip(db.actor, gc("st_filter_off"), 0, nil, 5000)
		end
	else
		if not gear then
			news_manager.send_tip(db.actor, gc("st_no_gasmask"), 0, nil, 5000)
			return
		end
		
		local oItem
		local f_selected = false
		local filter_min_cond = toxic_air_mcm.get_config("filter_min_condition")
		local selected_max_quality = toxic_air_mcm.get_config("choose_max_quality_filter")
		local filter_max_quality = toxic_air_mcm.get_config("filter_max_quality")
		local max_quality = filter_max_quality * 0.062
		local helm_rad_prot = (gear and get_helmet_radiation_protection(gear)) or 0
		local h_rad_prot = helm_rad_prot
		local diff_quality = 0
			
		local function check_filters(actor, itm)
			if f_selected then
				return
			end
				
			local sec = itm:section()
			if (is_filter_consumable_section(sec) and can_use_filter_on_gear(gear, sec)) then
				local cond = itm:condition()
				local profile_entry = get_filter_profile_entry(gear_def, sec)
				local rad_prot = get_profile_rad_protection(profile_entry)
					
				if (cond > 0) and (cond >= filter_min_cond) then
					local rad_h_diff = rad_prot - h_rad_prot
			
					if (not selected_max_quality) then
						if ((rad_h_diff + diff_quality) >= 0) and (rad_h_diff <= 0.0031) then
							f_selected = true
							oItem = itm
						end
					else
						if ((rad_h_diff + diff_quality) >= 0) and (rad_h_diff <= 0.0031) and (rad_prot <= max_quality) then
							f_selected = true
							oItem = itm
						end
					end
				end
			end
		end
		
		while ((not f_selected) and (diff_quality < 0.062)) do
			db.actor:iterate_inventory(check_filters, db.actor)
			diff_quality = diff_quality + 0.0031
		end
		
		if oItem then
			install_filter_to_gear(gear, oItem, animations_enabled)
		else
			news_manager.send_tip(db.actor, gc("st_no_filters"), 0, nil, 5000)
		end
	end
end

function mod_equip_filter()
	local gear, gear_def = get_filter_target_item()
	local gear_id = gear and gear:id()
	local helmet = gear
	local helmet_id = gear_id

	local animations_enabled = toxic_air_mcm.get_config("filter_animation")
	local item = get_installed_filter_item()
		
	if item then
		func_filters(item)
		if not animations_enabled then
			news_manager.send_tip(db.actor, gc("st_filter_off"), 0, nil, 5000)
		end
	else
		if not gear then
			news_manager.send_tip(db.actor, gc("st_no_gasmask"), 0, nil, 5000)
			return
		end
		
		local oItem
		local f_selected = false
		local filter_min_cond = toxic_air_mcm.get_config("filter_min_condition")
		local selected_low_quality = toxic_air_mcm.get_config("choose_low_quality_filter")
		local filter_min_low_quality = toxic_air_mcm.get_config("filter_min_low_quality")
		local low_quality = filter_min_low_quality * 0.062
		local helm_rad_prot = (gear and get_helmet_radiation_protection(gear)) or 0
		local h_rad_prot = helm_rad_prot
		local diff_quality = 0
			
		local function check_filters(actor, itm)
			if f_selected then
				return
			end
				
			local sec = itm:section()
			if (is_filter_consumable_section(sec) and can_use_filter_on_gear(gear, sec)) then
				local cond = itm:condition()
				local profile_entry = get_filter_profile_entry(gear_def, sec)
				local rad_prot = get_profile_rad_protection(profile_entry)
					
				if (cond > 0) and (cond >= filter_min_cond) then
					local rad_h_diff = rad_prot - h_rad_prot

					if (not selected_low_quality) then
						if (rad_prot > diff_quality) and (rad_prot <= (diff_quality + 0.0031)) then
							f_selected = true
							oItem = itm
						end
					else
						if (rad_prot >= (low_quality + 0.0031)) and (rad_prot < (low_quality + diff_quality)) then
							f_selected = true
							oItem = itm
						end
					end
				end
			end
		end
			
		while ((not f_selected) and (diff_quality < 0.062)) do
			db.actor:iterate_inventory(check_filters, db.actor)
			diff_quality = diff_quality + 0.0031
		end
		
		if oItem then
			install_filter_to_gear(gear, oItem, animations_enabled)
		else
			news_manager.send_tip(db.actor, gc("st_no_filters"), 0, nil, 5000)
		end
	end
end

function filter_check()
	local item = get_installed_filter_item()
	local filter = item and get_filter_state(item:id())
	local filter_check_msg = ""
	
	if not filter then
		filter_check_msg = gc("st_filter_check_not_installed")
	else
		local sec = filter and filter.name
		local filter_cond = filter and filter.cond
		local filter_name = gc(ini_sys:r_string_ex(sec, "inv_name"))
		if mcm_filter_check_cond then
			local cond_str = ""
			
			if (filter_cond >= 0.5) then
				cond_str = gc("st_filter_check_100")
			elseif (filter_cond < 0.5) and (filter_cond >= 0.25) then
				cond_str = gc("st_filter_check_50")
			elseif (filter_cond < 0.25) and (filter_cond > 0) then
				cond_str = gc("st_filter_check_25")
			elseif (filter_cond <= 0) then
				cond_str = gc("st_filter_check_0")
			end
				
			filter_check_msg = filter_name .. ", " .. cond_str
		else
			filter_check_msg = filter_name
		end
	end
	actor_menu.set_msg(1, filter_check_msg, 4)
end

function on_key_hold(key)
	if mcm_keybinds and (key == mcm_filter_equip_key) and (mcm_filter_equip_mode == 2) and ui_mcm.get_mod_key(mcm_filter_equip_modifier) and ui_mcm.key_hold("equip_filter_kd", key) then
		equip_filter()
	end
	
	if mcm_keybinds and (key == mcm_mod_filter_equip_key) and (mcm_mod_filter_equip_mode == 2) and ui_mcm.get_mod_key(mcm_mod_filter_equip_modifier) and ui_mcm.key_hold("equip_filter_kd", key) then
		mod_equip_filter()
	end
	
	if mcm_keybinds and (key == mcm_breathe_key) and (mcm_breathe_mode == 2) and ui_mcm.get_mod_key(mcm_breathe_modifier) and ui_mcm.key_hold("breathe_kd", key) then
		control_breathe()
	end
	
	if mcm_keybinds and (key == mcm_filter_check_key) and (mcm_filter_check_mode == 2) and ui_mcm.get_mod_key(mcm_filter_check_modifier) and ui_mcm.key_hold("filter_check_kd", key) then
		filter_check()
	end
end

local hold_delay = 0.5

function on_key_press(key)
	if (key == mcm_filter_equip_key) then
		if (not mcm_keybinds) then
			CreateTimeEvent("filter_eq", "filter_eq", hold_delay, equip_filter)
		elseif (mcm_filter_equip_mode == 0) and ui_mcm.get_mod_key(mcm_filter_equip_modifier) then
			ui_mcm.simple_press("equip_filter_kd", key, equip_filter)
		elseif (mcm_filter_equip_mode == 1) and ui_mcm.get_mod_key(mcm_filter_equip_modifier) and ui_mcm.double_tap("equip_filter_kd", key) then
			equip_filter()
		end
	end
	
	if (key == mcm_mod_filter_equip_key) then
		if (not mcm_keybinds) then
			CreateTimeEvent("filter_eq", "filter_eq", hold_delay, equip_filter)
		elseif (mcm_mod_filter_equip_mode == 0) and ui_mcm.get_mod_key(mcm_mod_filter_equip_modifier) then
			ui_mcm.simple_press("equip_filter_kd", key, equip_filter)
		elseif (mcm_mod_filter_equip_mode == 1) and ui_mcm.get_mod_key(mcm_mod_filter_equip_modifier) and ui_mcm.double_tap("equip_filter_kd", key) then
			mod_equip_filter()
		end
	end

	if (key == mcm_breathe_key) then
		if (not mcm_keybinds) then
			CreateTimeEvent("breathe", "breathe", hold_delay, control_breathe)
		elseif (mcm_breathe_mode == 0) and ui_mcm.get_mod_key(mcm_breathe_modifier) then
			ui_mcm.simple_press("breathe_kd", key, control_breathe)
		elseif (mcm_breathe_mode == 1) and ui_mcm.get_mod_key(mcm_breathe_modifier) and ui_mcm.double_tap("breathe_kd", key) then
			control_breathe()
		end
	end
	
	if (key == mcm_filter_check_key) then
		if (not mcm_keybinds) then
			CreateTimeEvent("filter_chk", "filter_chk", hold_delay, filter_check)
		elseif (mcm_filter_check_mode == 0) and ui_mcm.get_mod_key(mcm_filter_check_modifier) then
			ui_mcm.simple_press("filter_chk", key, filter_check)
		elseif (mcm_filter_check_mode == 1) and ui_mcm.get_mod_key(mcm_filter_check_modifier) and ui_mcm.double_tap("filter_chk", key) then
			filter_check()
		end
	end
end

function on_key_release(key)
	if mcm_keybinds then return end

	if key == mcm_filter_equip_key then
		RemoveTimeEvent("filter_eq", "filter_eq")
	end
	
	if key == mcm_mod_filter_equip_key then
		RemoveTimeEvent("filter_eq", "filter_eq")
	end
	
	if key == mcm_breathe_key then
		RemoveTimeEvent("breathe", "breathe")
	end
	
	if key == mcm_filter_check_key then
		RemoveTimeEvent("filter_chk", "filter_chk")
	end
end

function filter_rad_cond()
	local item, gear_def = get_installed_filter_item()
	if not (item) then return end

	local item_id = item:id()
	local filter_def = get_filter_state(item_id)
	if not filter_def then return end
	local profile_entry = get_filter_profile_entry(gear_def, filter_def.name)

	local filter_resist = ini_sys:r_float_ex(filter_def.name, "air_immunity") or 0
	if filter_resist <= 0 then return end
	local cond_loss = ini_sys:r_float_ex(filter_def.name, "flow_rate") or 0
	local rad_immunity = get_profile_rad_protection(profile_entry)
	if rad_immunity <= 0 then return end
	local rad_prot = rad_immunity / 10
	local cond_koef = rad_hit / rad_prot / filter_resist / 2
	--[[
	if mcm_rad_air and (radioactive_dmg > 0) then
		cond_koef = cond_koef + radioactive_dmg / rad_prot / filter_resist / 2
	end
	]]
	check_actor_move()
	local condition_hit = cond_loss * cond_koef * mcm_filter_degradation_mult * move_mult * get_profile_toxic_degrade_mult(profile_entry)
	filter_def.cond = filter_def.cond - condition_hit
	filter_def.cond = clamp(filter_def.cond, 0, 1)
	rad_hit = 0
end

function filter_chem_cond()
	local item, gear_def = get_installed_filter_item()
	if not (item) then return end

	local item_id = item:id()
	local filter_def = get_filter_state(item_id)
	if not filter_def then return end
	local profile_entry = get_filter_profile_entry(gear_def, filter_def.name)

	local filter_resist = ini_sys:r_float_ex(filter_def.name, "air_immunity") or 0
	if filter_resist <= 0 then return end
	local cond_loss = ini_sys:r_float_ex(filter_def.name, "flow_rate") or 0
	local toxic_reduction = get_profile_toxic_reduction(profile_entry)
	if toxic_reduction <= 0 then return end
	local chem_prot = get_profile_chem_protection(profile_entry) / 10
	local cond_koef = chem_hit / chem_prot / filter_resist
	--[[
	if mcm_toxic_underground and (chemical_dmg > 0) then
		cond_koef = cond_koef + chemical_dmg / chem_prot / filter_resist * 6
	end
	]]
	check_actor_move()
	local condition_hit = cond_loss * cond_koef * mcm_filter_degradation_mult * move_mult * get_profile_toxic_degrade_mult(profile_entry)
	filter_def.cond = filter_def.cond - condition_hit
	filter_def.cond = clamp(filter_def.cond, 0, 1)
	chem_hit = 0
end

function chemical_level_damage()
	local safe_zone = actor_in_safe_zone()
	local chem_hit_power = chemical_dmg
	
	if safe_zone or first_upd_toxic_protect then
		chem_hit_power = 0
	end
	
	local airgear = get_active_airgear_item()
	local helm_gasmask = airgear and true or false
	local helmet = db.actor:item_in_slot(12)
	helm_cond = (airgear and airgear:condition()) or (helmet and helmet:condition()) or 1

	local t_cond = 0
	db.actor:iterate_belt( function(owner, tank)
		if get_tank_state(tank:id()) then
			t_cond = tank_cond[tank:id()]
		end
	end)
	
	local chemical_protection = get_chem_protection()
		
	if (helm_gasmask == true) then
		if (filter_air_protection > 0) and (not hold_breathe) then
		--	filter_chem_cond()
			chem_hit_power = (chem_hit_power * (1 - filter_toxic_reduction)) - chemical_protection
		elseif (tank_air_protection > 0) and (not hold_breathe) then
			chem_hit_power = (chem_hit_power * (1 - tank_toxic_reduction)) - chemical_protection
		else
			if hold_breathe then
				chem_hit_power = 0
			else
				chem_hit_power = chem_hit_power - chemical_protection
			end
		end
	else
		if not hold_breathe then
			control_breathe()
		end
		
		if hold_breathe then
			chem_hit_power = 0
		else
			chem_hit_power = chem_hit_power - chemical_protection
		end
	end
		
	if (chem_hit_power > 0) then
		CreateTimeEvent("toxic_zone_x", "toxic_zone_x", 5, send_actor_msg)
		effects_factor = chem_hit_power * 100
		
		-- ppe
		if (toxic_air_mcm.get_config("ppe_toggle")) then
			level.add_pp_effector("acidic_mine.ppe", 20201, true)
			level.set_pp_effector_factor(20201, effects_factor)
		else
			level.remove_pp_effector(20201)
		end
		-- sound
		if (toxic_air_mcm.get_config("sound_toggle")) then
			CreateTimeEvent("chem_cough", "chem_cough", 5, chem_cough_snd)
		else
			RemoveTimeEvent("chem_cough", "chem_cough")
		end
		
		local actor_hp = db.actor.health
		local actor_hp_reduction = actor_hp - chem_hit_power * 10 * toxic_air_mcm.get_config("toxic_damage_mult")
		db.actor:set_health_ex(actor_hp_reduction)
		
	else
		effects_factor = 0
		level.remove_pp_effector(20201)
		RemoveTimeEvent("toxic_zone_x", "toxic_zone_x")
		RemoveTimeEvent("chem_cough", "chem_cough")
	end

end

function chem_cough_snd()
	local snd
	if effects_factor < 0.1 then return end

	if effects_factor < 0.3 then
		snd = sound_object("actor\\health_2toxicair_" .. rnd(1, 4))
	elseif effects_factor < 0.5 then
		snd = sound_object("actor\\health_1toxicair_" .. rnd(0, 4))
	else
		snd = sound_object("actor\\die" .. rnd(0, 3))
	end
	snd:play_no_feedback(db.actor, sound_object.s2d, 0, VEC_ZERO, 1.0, 1.0)
	RemoveTimeEvent("chem_cough", "chem_cough")
end

function radiation_level_damage()
	local safe_zone = actor_in_safe_zone()
	local rad_hit_power = radioactive_dmg
	
	if safe_zone or first_upd_toxic_protect then
		return
	end
	
	local airgear = get_active_airgear_item()
	local helm_gasmask = airgear and true or false
	local helmet = db.actor:item_in_slot(12)
	helm_cond = (airgear and airgear:condition()) or (helmet and helmet:condition()) or 1
	
	local has_rad_consumable = ((filter_air_protection > 0) or (tank_air_protection > 0)) and (not hold_breathe)
	local radiation_protection = get_rad_protection(has_rad_consumable)
	local helmet_rad_prot = has_rad_consumable and ((helmet and get_helmet_radiation_protection(helmet)) or 0) or 0
	local helm_rad_prot = helmet_rad_prot/10
	local filter_rad_prot = filter_rad_protection/10
	local tank_rad_prot = tank_rad_protection/10

	local diff_rad_helm = radiation_protection + helm_rad_prot - rad_hit_power
	local diff_rad_filter = radiation_protection + filter_rad_prot - rad_hit_power
	local diff_rad_tank = radiation_protection + helm_rad_prot + tank_rad_prot * helm_cond - rad_hit_power
		
	if (helm_gasmask == true) then
		if (filter_air_protection > 0) and (not hold_breathe) then
		--	filter_rad_cond()
			if (diff_rad_helm > diff_rad_filter) then
				rad_hit_power = -diff_rad_filter
			else
				rad_hit_power = -diff_rad_helm
			end
		elseif (tank_air_protection > 0) and (not hold_breathe) then
			if (diff_rad_tank < 0) then
				rad_hit_power = -diff_rad_tank
			else
				rad_hit_power = 0
			end
		else
			if hold_breathe then
				rad_hit_power = 0
			else
				rad_hit_power = rad_hit_power - radiation_protection - helm_rad_prot
			end
		end
	else
		if hold_breathe then
			rad_hit_power = 0
		else
			rad_hit_power = rad_hit_power - radiation_protection - helm_rad_prot
		end
	end

	if (rad_hit_power > 0) then
		rad_hit_power = rad_hit_power * mcm_rad_air_mult
		db.actor:change_radiation(rad_hit_power)
	end

end

function slot_has_filter()
	if not db or not db.actor then return false end
	local outfit = db.actor:item_in_slot(7)
	local helmet = db.actor:item_in_slot(12)
	return (outfit and get_filter_state(outfit:id()) ~= nil) or (helmet and get_filter_state(helmet:id()) ~= nil) or false
end

-- tank_to_belt
local prevent_anm = false
function tank_in_belt(tank)
	if not (tank and is_tank_consumable_section(tank:section())) then return end

--	printf("tank: %s IN", tank:section())

	local tank_gear, tank_gear_def, tank_entry = get_active_tank_entry(tank:section())
	if not tank_entry then
		db.actor:move_to_ruck(tank)
		news_manager.send_tip(db.actor, gc("st_wrong_equip"), 0, nil, 5000)
		return
	end

	if restoring_tank_state or pending_restore_matches_tank(tank) then
		set_tank_state(tank:id(), true)
		tank_cond[tank:id()] = tank_cond[tank:id()] or tank:condition()
		if pending_restore_matches_tank(tank) then
			tank_restore_guard_until = math.max(tank_restore_guard_until, time_global() + 15000)
		end
		return
	end

	local already_active = get_tank_state(tank:id()) ~= nil
	if has_active_tank_except(tank:id()) or slot_has_filter() then		--	belt already has tank OR equipment has active filter - move tank to ruck
		db.actor:move_to_ruck(tank)		-- doesnt seem to fire tank_out_belt
		news_manager.send_tip(db.actor, gc("st_already_has_equipment"), 0, nil, 5000)	-- ilrathCXV (04/13/2024)
	else																			-- belt has no tanks and equipment has no filters - save tank ID
		set_tank_state(tank:id(), true)
		if not already_active then
			play_tank_anm("on", tank:section())		-- tank on animation
		end
	end

end

-- tank to ruck / tank on item drop
function tank_out_belt(tank)
	if not (tank and get_tank_state(tank:id())) then return end

	if pending_restore_matches_tank(tank) then
		set_tank_state(tank:id(), true)
		tank_cond[tank:id()] = tank_cond[tank:id()] or tank:condition()
		tank_restore_guard_until = math.max(tank_restore_guard_until, time_global() + 15000)
		return
	end

	reset_tank_runtime_state(tank:id())

	if not suppress_tank_out_animation then
		play_tank_anm("off", tank:section())		-- tank off animation
	end
	
--	printf("tank: %s OUT", tank:section())

end

-- filter_to_slot
function filter_to_slot(equip)
	local tanks_removed = false
	if equip and get_filter_state(equip:id()) then						-- if equipment with filter goes to slot - move tank to ruck
		db.actor:iterate_belt( function(owner, tank)
			if get_tank_state(tank:id()) then
				db.actor:move_to_ruck(tank)					-- tank_out_belt fires
				tanks_removed = true
			end
		end)
	end
	
	if tanks_removed then
		news_manager.send_tip(db.actor, gc("st_tanks_removed"), 0, nil, 5000)	-- ilrathCXV (04/13/2024)
	end
	
end

function send_actor_msg()
	actor_menu.set_msg(1, gc("st_air_is_toxic"), 3)
	return true
end

------------------------ smart terrain check ----------------------
function actor_in_safe_zone()
	local id = smart_terrain.nearest_to_actor_smart.id
	local smart = id and alife_object(id)
	local dist = smart_terrain.nearest_to_actor_smart.dist

	if (smart) and (safe_smart_radius[smart:name()]) and (dist <= safe_smart_radius[smart:name()]) then
	--	printf("id: [ %s ] || name: [ %s ] || dist: [ %s ] || safe: [ true ]", id, smart:name(), round_idp(dist, 2))
		return true
	end

	return false
end

------------------------------- filters ----------------------------
function filter_cond_prot()
	filter_air_protection = 0
	filter_rad_protection = 0
	filter_chem_protection = 0
	filter_rad_reduction = 0
	filter_toxic_reduction = 0
	filter_toxic_degrade_mult = 1

	local item, gear_def = get_installed_filter_item()
	if not (item) then return end

	local item_id = item:id()
	local filter_def = get_filter_state(item_id)
	if not filter_def then return end
	local profile_entry = get_filter_profile_entry(gear_def, filter_def.name)

	local filter_resist = ini_sys:r_float_ex(filter_def.name, "air_immunity") or 0
	if filter_resist <= 0 then return end

	local cond_loss = ini_sys:r_float_ex(filter_def.name, "flow_rate") or 0
	local rad_immunity = get_profile_rad_protection(profile_entry)
	filter_rad_reduction = get_profile_rad_reduction(profile_entry)
	filter_toxic_reduction = get_profile_toxic_reduction(profile_entry)
	filter_toxic_degrade_mult = get_profile_toxic_degrade_mult(profile_entry)
	filter_chem_protection = get_profile_chem_protection(profile_entry)
	filter_rad_protection = rad_immunity

	if not hold_breathe then
		check_actor_move()
		local cond_koef = 1 - filter_resist
		
		if mcm_rad_air and (radioactive_dmg > 0) and (rad_immunity > 0) then
			local rad_prot = rad_immunity / 10
			cond_koef = cond_koef + radioactive_dmg / rad_prot / filter_resist / 2
		end
		
		if mcm_toxic_underground and (chemical_dmg > 0) and (filter_toxic_reduction > 0) then
			local chem_prot = filter_chem_protection / 10
			cond_koef = cond_koef + chemical_dmg / chem_prot / filter_resist * 6 * filter_toxic_degrade_mult
		end
		
		local condition_hit = cond_loss * cond_koef * mcm_filter_degradation_mult * move_mult
		local safe_zone = actor_in_safe_zone()
		condition_hit = safe_zone and 0 or condition_hit
		filter_def.cond = filter_def.cond - condition_hit
		filter_def.cond = clamp(filter_def.cond, 0, 1)
	end

	filter_air_protection = (filter_def.cond > 0 and (filter_rad_reduction > 0 or filter_toxic_reduction > 0)) and filter_resist or 0
	
	if (filter_def.cond <= 0) then
		if not hold_breathe then
			control_breathe()
		end
	end

--	printf("filter [ %s ] , in item [ %s ] , condition [ %s ]", filter_def.name, item:section(), filter_def.cond)

end

-- on right click remove
function menu_filters(obj)
	local p = obj:parent()
	if not (p and p:id() == AC_ID) then return end

	local id = obj and obj:id()

	if not get_filter_state(id) then return end

	return gc("st_remove_filter")
end

function func_filters(obj)
	local p = obj:parent()
	if not (p and p:id() == AC_ID) then return end

	local id = obj and obj:id()
	local filter = get_filter_state(id)
	if not filter then return end

	local name = filter.name
	local con = filter.cond

	alife_create_item(name, db.actor, {cond = con})

	-- play "off" animation for slotted item
	local item = get_installed_filter_item()
	if item and item:id() == id then
		play_ta_anm(nil, "off", 0)		-- filter off animation
	end

--	news_manager.send_tip(db.actor, string.format("item [ %s ] created with condition [ %s ]", name, con), 0, nil, 1500)
	clear_filter_state(id)

end

local hud_fov = nil
function on_item_drag_dropped(give, take, slot_from, slot_to)
	if not (slot_from == EDDListType.iActorBag and (slot_to == EDDListType.iActorBag or slot_to == EDDListType.iActorSlot)) then
		return
	end

	local sec_give = give and give:section()
	local sec_take = take and take:section()
	local id_take = take:id()

	-- is given item filter?
	if not is_filter_consumable_section(sec_give) then return end

	-- is item tagged to receive filters + is item also not a filter?
	if not (available_equipment(take)) then
--[[		if not (sfind(sec_take, "mask_filter")) then
			-- ilrathCXV (04/13/2024): ensure this message only triggers if item being dragged to is not a filter
			news_manager.send_tip(db.actor, gc("st_wrong_equip"), 0, nil, 1500)	
		end]]
		return
	end

	if not can_use_filter_on_gear(take, sec_give) then
		news_manager.send_tip(db.actor, gc("st_wrong_equip"), 0, nil, 1500)
		return
	end

	-- does item already have filter?
	if (get_filter_state(id_take) ~= nil) then
		news_manager.send_tip(db.actor, gc("st_already_active"), 0, nil, 1500)
		return
	end

	-- save shet and release
	local filter_state = {
		name = sec_give,
		cond = give:condition(),
	}
	set_filter_state(id_take, filter_state)
--	printf("equipment id: [ %s ] , sec: [ %s ] , cond: [ %s ]", id_take, filter_state.name, round_idp(filter_state.cond, 2))
	alife_release(give)

	if tank_cond[give:id()] then tank_cond[give:id()] = nil end

	-- remove tanks from belt if filter attached to active slot
	local item = get_installed_filter_item()
	if not (item) then return end

	local item_id = item:id()
	if item and get_filter_state(item_id) then
		-- check tanks on belt
		local animations_enabled = toxic_air_mcm.get_config("filter_animation")
		local tank_on_belt, tank_sec_for_anm = move_active_tanks_to_ruck_for_filter()

	-- play tank "off" anm if tank removed and delay filter anm
		if tank_on_belt then
			play_ta_anm("off", "on", nil, tank_sec_for_anm)		-- tank off + filter on animation
			if not animations_enabled then
				news_manager.send_tip(db.actor, gc("st_filter_on_tanks_removed"), 0, nil, 5000)		-- ilrathCXV (04/13/2024)
			end
		else
		-- or play filter "on" animation for slotted item
			play_ta_anm(nil, "on", 0)		-- filter on animation
			if not animations_enabled then
				news_manager.send_tip(db.actor, gc("st_filter_on"), 0, nil, 5000)					-- ilrathCXV (04/13/2024)
			end
		end
	end

--	news_manager.send_tip(db.actor, string.format("item [ %s ] released, item [ %s ] receive", sec_give, sec_take), 0, nil, 1500)

end

-- manual table check coz binder sucks
function server_id_table_check()
	local sim = alife()
	for id, whatever in pairs(tank_cond) do
		local se_obj = alife_object(id)
		if not (se_obj) then
			tank_cond[id] = nil
		end
	end

end

-- arti's UI monkey patch
function get_cond_for_ui(obj, val)
	local filter_resist
	local condition_hit
	local rad_protection
	local chem_protection
	if val == "gear" then
		local filter_state = get_filter_state(obj:id())
		if not filter_state then return 0, 0, 0, 0 end
		local filter_sec = filter_state.name
		local _, gear_def = get_airgear_profile(obj)
		local profile_entry = get_filter_profile_entry(gear_def, filter_sec)
		local rad_reduction = get_profile_rad_reduction(profile_entry)
		local toxic_reduction = get_profile_toxic_reduction(profile_entry)
		local toxic_degrade_mult = get_profile_toxic_degrade_mult(profile_entry)
		filter_resist = ini_sys:r_float_ex(filter_sec, "air_immunity") or 0
		local cond_loss = ini_sys:r_float_ex(filter_sec, "flow_rate") or 0
		local cond_loss_factor = get_profile_rad_protection(profile_entry)
		if filter_resist <= 0 then return 0, 0, 0, 0 end
		local cond_koef = 1 - filter_resist
		
		if mcm_rad_air and (radioactive_dmg > 0) and (cond_loss_factor > 0) then
			local rad_prot = cond_loss_factor / 10
			cond_koef = cond_koef + radioactive_dmg / rad_prot / filter_resist / 2
		end
		
		if mcm_toxic_underground and (chemical_dmg > 0) and (toxic_reduction > 0) then
			local chem_prot = get_profile_chem_protection(profile_entry) / 10
			cond_koef = cond_koef + chemical_dmg / chem_prot / filter_resist * 6 * toxic_degrade_mult
		end
		
		condition_hit = cond_loss * cond_koef * mcm_filter_degradation_mult		-- cond loss per irl sec
		rad_protection = rad_reduction * 100
		chem_protection = toxic_reduction * 100
	elseif val == "no_gear" then
		local filter_gear, filter_gear_def = get_filter_target_item()
		local profile_entry = filter_gear and get_filter_profile_entry(filter_gear_def, obj:section()) or nil
		local rad_reduction = get_profile_rad_reduction(profile_entry)
		local toxic_reduction = get_profile_toxic_reduction(profile_entry)
		local toxic_degrade_mult = get_profile_toxic_degrade_mult(profile_entry)
		filter_resist = ini_sys:r_float_ex(obj:section(), "air_immunity") or 0
		local cond_loss = ini_sys:r_float_ex(obj:section(), "flow_rate") or 0
		local cond_loss_factor = get_profile_rad_protection(profile_entry)
		if filter_resist <= 0 then return 0, 0, 0, 0 end
		local cond_koef = 1 - filter_resist
		
		if mcm_rad_air and (radioactive_dmg > 0) and (cond_loss_factor > 0) then
			local rad_prot = cond_loss_factor / 10
			cond_koef = cond_koef + radioactive_dmg / rad_prot / filter_resist / 2
		end
		
		if mcm_toxic_underground and (chemical_dmg > 0) and (toxic_reduction > 0) then
			local chem_prot = get_profile_chem_protection(profile_entry) / 10
			cond_koef = cond_koef + chemical_dmg / chem_prot / filter_resist * 6 * toxic_degrade_mult
		end
		
		condition_hit = cond_loss * cond_koef * mcm_filter_degradation_mult		-- cond loss per irl sec
		rad_protection = rad_reduction * 100
		chem_protection = toxic_reduction * 100
	end

	return filter_resist, condition_hit, rad_protection, chem_protection
end

BuildHeader = ui_item.build_desc_header

local function ta_tip_line(line_clr, grey_clr, label_id, value)
	local text = gc(label_id)
	if value and value ~= "" then
		text = text .. " " .. value
	end
	return line_clr .. gc("st_krug_xd") .. " " .. grey_clr .. text .. "\\n" .. grey_clr
end

local function ta_percent(value)
	return round_idp(value or 0, 1) .. "%"
end

local function ta_rate_per_hour(cond_loss)
	return round_idp((cond_loss or 0) * 10 * 60 * 100, 1) .. gc("st_ta_ui_per_hour")
end

local function ta_protection_value(value, show_percent)
	value = tonumber(value) or 0
	if value <= 0 then
		return gc("st_ta_ui_absent")
	end

	return show_percent and ta_percent(value) or gc("st_ta_ui_present")
end

local function ta_desc_tail(str, grey_clr)
	if not (str and str ~= "") then return "" end
	return "\\n" .. grey_clr .. str
end

local function build_filter_gear_tooltip(obj, str, teal_clr, red_clr, grey_clr, safe_zone)
	prefer_separate_helmet_filter()
	local obj_id = obj:id()
	local filter_state = get_filter_state(obj_id)
	if filter_state then
		local filter_sec = filter_state.name
		local _, gear_def = get_airgear_profile(obj)
		local profile_entry = get_filter_profile_entry(gear_def, filter_sec)
		local tier = get_profile_ui_tier(profile_entry) or get_consumable_ui_tiers(filter_sec, "filter") or "?"
		local _, cond_loss, rad_prot, chem_prot = get_cond_for_ui(obj, "gear")
		local con = math.ceil((filter_state.cond or 0) * 100)
		local cond_clr = utils_xml.get_color_con(con)
		cond_loss = safe_zone and 0 or cond_loss

		return
			ta_tip_line(teal_clr, grey_clr, "st_ta_ui_filter_installed") ..
			ta_tip_line(teal_clr, grey_clr, "st_ta_ui_filter_class", tier) ..
			ta_tip_line(cond_clr, grey_clr, "st_ta_ui_filter_condition", cond_clr .. tostring(con) .. "%") ..
			ta_tip_line(teal_clr, grey_clr, "st_ta_ui_filter_drain", ta_rate_per_hour(cond_loss)) ..
			ta_tip_line(rad_prot > 0 and teal_clr or red_clr, grey_clr, "st_ta_ui_rad_air", ta_protection_value(rad_prot, false)) ..
			ta_tip_line(chem_prot > 0 and teal_clr or red_clr, grey_clr, "st_ta_ui_toxic_air", ta_protection_value(chem_prot, true)) ..
			BuildHeader(obj, obj:section(), str)
	end

	local profile = get_airgear_profile(obj)
	local tiers = get_profile_ui_tiers(profile) or "?"
	return
		ta_tip_line(red_clr, grey_clr, "st_ta_ui_filter_missing") ..
		ta_tip_line(teal_clr, grey_clr, "st_ta_ui_allowed_filter_class", tiers) ..
		ta_tip_line(red_clr, grey_clr, "st_ta_ui_rad_air", gc("st_ta_ui_absent")) ..
		ta_tip_line(red_clr, grey_clr, "st_ta_ui_toxic_air", gc("st_ta_ui_absent")) ..
		BuildHeader(obj, obj:section(), str)
end

local function build_tank_gear_tooltip(obj, str, teal_clr, red_clr, grey_clr, safe_zone)
	local profile, gear_def = get_airgear_profile(obj)
	local tank_item = get_equipped_tank_item()
	if tank_item then
		local tank_entry = get_tank_profile_entry(gear_def, tank_item:section())
		if tank_entry then
			local tier = get_profile_ui_tier(tank_entry) or get_consumable_ui_tiers(tank_item:section(), "tank") or "?"
			local con = math.ceil(((tank_cond[tank_item:id()] or tank_item:condition()) or 0) * 100)
			local cond_clr = utils_xml.get_color_con(con)
			local cond_loss = safe_zone and 0 or ((ini_sys:r_float_ex(tank_item:section(), "flow_rate") or 0) * mcm_flow_rate_mult)

			return
				ta_tip_line(teal_clr, grey_clr, "st_ta_ui_tank_connected") ..
				ta_tip_line(teal_clr, grey_clr, "st_ta_ui_tank_class", tier) ..
				ta_tip_line(cond_clr, grey_clr, "st_ta_ui_tank_condition", cond_clr .. tostring(con) .. "%") ..
				ta_tip_line(teal_clr, grey_clr, "st_ta_ui_air_drain", ta_rate_per_hour(cond_loss)) ..
				ta_tip_line(teal_clr, grey_clr, "st_ta_ui_rad_toxic_air", gc("st_ta_ui_full")) ..
				BuildHeader(obj, obj:section(), str)
		end
	end

	local tiers = get_profile_ui_tiers(profile) or "?"
	return
		ta_tip_line(red_clr, grey_clr, "st_ta_ui_tank_missing") ..
		ta_tip_line(teal_clr, grey_clr, "st_ta_ui_allowed_tank_class", tiers) ..
		ta_tip_line(red_clr, grey_clr, "st_ta_ui_rad_toxic_air", gc("st_ta_ui_absent")) ..
		BuildHeader(obj, obj:section(), str)
end

local function build_filter_item_tooltip(obj, str, teal_clr, red_clr, grey_clr, safe_zone)
	local filter_gear, filter_gear_def = get_filter_target_item()
	local profile_entry = filter_gear and get_filter_profile_entry(filter_gear_def, obj:section()) or nil
	local tier = (profile_entry and get_profile_ui_tier(profile_entry)) or get_consumable_ui_tiers(obj:section(), "filter") or "?"
	local con = math.ceil(obj:condition() * 100)
	local cond_clr = utils_xml.get_color_con(con)
	local result =
		ta_tip_line(teal_clr, grey_clr, "st_ta_ui_filter_class", tier) ..
		ta_tip_line(cond_clr, grey_clr, "st_ta_ui_filter_condition", cond_clr .. tostring(con) .. "%")

	if profile_entry then
		local _, cond_loss = get_cond_for_ui(obj, "no_gear")
		cond_loss = safe_zone and 0 or cond_loss
		result = result ..
			ta_tip_line(teal_clr, grey_clr, "st_ta_ui_filter_drain", ta_rate_per_hour(cond_loss))
	else
		result = result ..
			ta_tip_line(teal_clr, grey_clr, "st_ta_ui_filter_note")
	end

	return result .. ta_desc_tail(str, grey_clr)
end

local function build_tank_item_tooltip(obj, str, teal_clr, red_clr, grey_clr, safe_zone)
	local tank_gear, tank_gear_def = get_active_tank_gear()
	local tank_entry = get_tank_profile_entry(tank_gear_def, obj:section())
	local tier = (tank_entry and get_profile_ui_tier(tank_entry)) or get_consumable_ui_tiers(obj:section(), "tank") or "?"
	local con = math.ceil(((tank_cond[obj:id()] or obj:condition()) or 0) * 100)
	local cond_clr = utils_xml.get_color_con(con)
	local active = obj:id() and get_tank_state(obj:id()) and tank_entry
	local result =
		ta_tip_line(teal_clr, grey_clr, "st_ta_ui_tank_class", tier) ..
		ta_tip_line(cond_clr, grey_clr, "st_ta_ui_tank_condition", cond_clr .. tostring(con) .. "%")

	if active then
		local cond_loss = safe_zone and 0 or ((ini_sys:r_float_ex(obj:section(), "flow_rate") or 0) * mcm_flow_rate_mult)
		result = result ..
			ta_tip_line(teal_clr, grey_clr, "st_ta_ui_air_drain", ta_rate_per_hour(cond_loss))
	elseif not tank_entry then
		result = result ..
			ta_tip_line(teal_clr, grey_clr, "st_ta_ui_tank_note")
	end

	return result .. ta_desc_tail(str, grey_clr)
end

function ui_item.build_desc_header(obj, sec, str)
	str = str or gc(ini_sys:r_string_ex(sec, "description"))
	if (not str) then return "" end

	local cond_str = ""
	local cond_loss_str = ""
	local resist_str = ""
	local rad_prot_str = ""
	local rad_prot_max_str = ""
	local chem_prot_str = ""
	local chem_prot_max_str = ""
	local obj_id = obj and obj:id()
	local obj_sec = obj and obj:section()
	local teal_clr = strformat("%c[%s,%s,%s,%s]", 255, 150, 250, 240)
	local red_clr = strformat("%c[%s,%s,%s,%s]", 255, 250, 50, 50)
	local blue_clr = utils_xml.get_color("d_blue")
	local grey_clr_light = utils_xml.get_color("ui_gray_3")
	local grey_clr_xml = utils_xml.get_color("ui_gray_2")
	local grey_clr = utils_xml.get_color("ui_gray_1")
	local safe_zone = actor_in_safe_zone()
	local airgear_def = is_supported_airgear(obj)

	if obj and (IsHeadgear(obj) or IsOutfit(obj)) and airgear_def then
		if airgear_def.mode == "tank" then
			return build_tank_gear_tooltip(obj, str, teal_clr, red_clr, grey_clr, safe_zone)
		end
		return build_filter_gear_tooltip(obj, str, teal_clr, red_clr, grey_clr, safe_zone)
	elseif (is_filter_consumable_section(obj_sec)) then
		return build_filter_item_tooltip(obj, str, teal_clr, red_clr, grey_clr, safe_zone)
	elseif (is_tank_consumable_section(obj_sec)) then
		return build_tank_item_tooltip(obj, str, teal_clr, red_clr, grey_clr, safe_zone)
	end

	local helmet = db.actor:item_in_slot(12)
	local filter_gear = get_filter_target_item()
	local tank_gear = get_active_tank_gear()
	local helm_gasmask = filter_gear and true or false
	local airgear_str = get_airgear_tooltip_line(obj, teal_clr, grey_clr)

	-- filter on gear
	local obj_filter_state = get_filter_state(obj_id)
	if ((IsHeadgear(obj) or IsOutfit(obj)) and obj_filter_state) then
		local resist, cond_loss, rad_prot, chem_prot = get_cond_for_ui(obj, "gear")
		local con = math.ceil(obj_filter_state.cond * 100)
		local cond_clr = utils_xml.get_color_con(con)
		cond_loss = safe_zone and 0 or cond_loss
		cond_str = cond_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_descr") .. " " .. cond_clr .. tostring(con)  .. "%" .. "\\n" .. grey_clr		-- test double \\n and move cond_loss_str after buildheader
		rad_prot_max_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_rad_prot") .. " " .. round_idp(rad_prot, 1) .. "%" .. "\\n" .. grey_clr
		chem_prot_max_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_chem_prot") .. " " .. round_idp(chem_prot, 1) .. "%" .. "\\n" .. grey_clr
		local helmet_chem_prot = (IsHeadgear(obj) and get_helmet_chemical_protection(obj)) or 0
		helmet_chem_prot = (helmet_chem_prot < 0.1) and helmet_chem_prot or 0.1
		local gasmask_chem_prot = chem_prot - (helmet_chem_prot * 100 / 0.1)
		
		if (gasmask_chem_prot < 0) then
			chem_prot_str = red_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_gasmask_chem_prot") .. " " .. round_idp(gasmask_chem_prot, 1) .. "%" .. "\\n" .. grey_clr
		else
			chem_prot_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_gasmask_chem_max_prot") .. "\\n" .. grey_clr
		end
		
		local helmet_rad_prot = (IsHeadgear(obj) and get_helmet_radiation_protection(obj)) or 0
		local gasmask_rad_prot = rad_prot - (helmet_rad_prot * 100 / 0.062)
		
		if (gasmask_rad_prot < 0) then
			rad_prot_str = red_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_gasmask_prot") .. " " .. round_idp(gasmask_rad_prot, 1) .. "%" .. "\\n \\n" .. grey_clr
		else
			rad_prot_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_gasmask_max_prot") .. "\\n \\n" .. grey_clr
		end
		
		resist_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_immunity") .. " " .. round_idp(resist * 100, 1) .. "%" .. "\\n" .. grey_clr
		local dmg_check_str = (grey_clr_light .. round_idp(cond_loss * 10 * 60 * 100, 1) .. gc("st_tank_per_min"))
		cond_loss_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_location_rate") .. " " .. dmg_check_str .. "\\n" .. grey_clr
		
		return airgear_str .. cond_str .. cond_loss_str .. resist_str .. chem_prot_max_str .. chem_prot_str .. rad_prot_max_str .. rad_prot_str .. BuildHeader(obj, sec, str)
	-- filter by itself
	elseif (is_filter_consumable_section(obj_sec)) then
		local resist, cond_loss, rad_prot, chem_prot = get_cond_for_ui(obj, "no_gear")
		local con = math.ceil(obj:condition() * 100)
		local cond_clr = utils_xml.get_color_con(con)
		cond_loss = safe_zone and 0 or cond_loss
		cond_str = cond_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_descr") .. " " .. cond_clr .. tostring(con)  .. "%" .. "\\n" .. grey_clr		-- test double \\n and move cond_loss_str after buildheader
		local dmg_check_str = (grey_clr_light .. round_idp(cond_loss * 10 * 60 * 100, 1) .. gc("st_tank_per_min"))
		
		if helm_gasmask then
			cond_loss_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_location_rate") .. " " .. dmg_check_str .. "\\n" .. grey_clr
			local helmet_chem_prot = (helmet and get_helmet_chemical_protection(helmet)) or 0
			local helmet_rad_prot = (helmet and get_helmet_radiation_protection(helmet)) or 0
			helmet_chem_prot = (helmet_chem_prot < 0.1) and helmet_chem_prot or 0.1
			local gasmask_chem_prot = chem_prot - (helmet_chem_prot * 100 / 0.1)
			local gasmask_rad_prot = rad_prot - (helmet_rad_prot * 100 / 0.062)
			
			if (gasmask_chem_prot < 0) then
				chem_prot_str = red_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_gasmask_chem_prot") .. " " .. round_idp(gasmask_chem_prot, 1) .. "%" .. "\\n" .. grey_clr
			else
				chem_prot_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_gasmask_chem_max_prot") .. "\\n" .. grey_clr
			end
			
			if (gasmask_rad_prot < 0) then
				rad_prot_str = red_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_gasmask_prot") .. " " .. round_idp(gasmask_rad_prot, 1) .. "%" .. "\\n \\n" .. grey_clr
			else
				rad_prot_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_gasmask_max_prot") .. "\\n \\n" .. grey_clr
			end
			
			return cond_str .. cond_loss_str .. chem_prot_str .. rad_prot_str.. BuildHeader(obj, sec, str)
		else
			cond_loss_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_filter_location_rate") .. " " .. dmg_check_str .. "\\n \\n" .. grey_clr
			return cond_str .. cond_loss_str .. BuildHeader(obj, sec, str)
		end
	--	return cond_loss_str .. BuildHeader(obj, sec, str)
	-- tank
	elseif (is_tank_consumable_section(obj_sec)) then
		local tank_gear_def
		if tank_gear then
			local profile
			profile, tank_gear_def = get_airgear_profile(tank_gear)
		end
		local tank_entry = get_tank_profile_entry(tank_gear_def, obj_sec)
		local rad_reduction = get_profile_rad_reduction(tank_entry)
		local toxic_reduction = get_profile_toxic_reduction(tank_entry)
		local resist = (rad_reduction > 0 or toxic_reduction > 0) and 1 or 0
		local cond_loss = ini_sys:r_float_ex(obj_sec, "flow_rate") or 0
		local tank_rad_prot = rad_reduction * 100
		local tank_chem_prot = toxic_reduction * 100
		local dmg_check_str = (grey_clr_light .. round_idp(cond_loss * 10 * 60 * 100 * mcm_flow_rate_mult, 1) .. gc("st_tank_per_min"))
		cond_loss_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_tank_flow_rate") .. " " .. dmg_check_str .. "\\n" .. grey_clr
		
	--	chem_prot_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_tank_chem_prot") .. " " .. round_idp(tank_chem_prot, 1) .. "%" .. "\\n" .. grey_clr
		
	--	rad_prot_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_tank_rad_prot") .. " " .. round_idp(tank_rad_prot, 1) .. "%" .. "\\n \\n" .. grey_clr
		
		if tank_gear then
			helm_cond = tank_gear:condition()
			chem_prot_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_tank_chem_prot") .. " " .. round_idp(tank_chem_prot * helm_cond, 1) .. "%" .. "\\n" .. grey_clr
			rad_prot_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_tank_rad_prot") .. " " .. round_idp(tank_rad_prot * helm_cond, 1) .. "%" .. "\\n \\n" .. grey_clr
			return cond_loss_str .. chem_prot_str .. rad_prot_str .. BuildHeader(obj, sec, str)
		else
			chem_prot_max_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_tank_max_chem_prot") .. " " .. round_idp(tank_chem_prot, 1) .. "%" .. "\\n" .. grey_clr
			rad_prot_max_str = teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_tank_max_rad_prot") .. " " .. round_idp(tank_rad_prot, 1) .. "%" .. "\\n \\n" .. grey_clr
			return cond_loss_str .. chem_prot_max_str .. rad_prot_max_str .. BuildHeader(obj, sec, str)
		end
	elseif (obj_sec == "tank_filling_station") then
		local charge_station = math.ceil(obj:condition() * 100)
		local cond_clr = utils_xml.get_color_con(charge_station)
		cond_str = cond_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_charge_station") .. " " .. cond_clr .. tostring(charge_station)  .. "%" .. "\\n \\n" .. grey_clr
		return cond_str .. BuildHeader(obj, sec, str)
	elseif (airgear_str ~= "") then
		return airgear_str .. BuildHeader(obj, sec, str)
	-- normal str
	else
		return BuildHeader(obj, sec, str)
	end

end

CanRepair = inventory_upgrades.can_repair_item
function inventory_upgrades.can_repair_item(sec, cond, mechanic)
    if is_filter_consumable_section(sec) then return false end
    return CanRepair(sec, cond, mechanic)
end

function filters_install(obj)
	if not obj then return end

	local gear = get_filter_target_item()
	if not gear then
		news_manager.send_tip(db.actor, gc("st_no_gasmask"), 0, nil, 5000)
		return
	end

	local gear_id = gear:id()
	if get_filter_state(gear_id) then
		news_manager.send_tip(db.actor, gc("st_already_has_equipment"), 0, nil, 5000)
		return
	end

	if not can_use_filter_on_gear(gear, obj:section()) then
		news_manager.send_tip(db.actor, gc("st_wrong_equip"), 0, nil, 5000)
		return
	end

	install_filter_to_gear(gear, obj, toxic_air_mcm.get_config("filter_animation"))
end

function menu_filters_install(obj)
	local sec = obj and obj:section()
	if not is_filter_consumable_section(sec) then return end
	local gear = get_filter_target_item()
	if not (gear and can_use_filter_on_gear(gear, sec)) then return end
	return gc("st_install_filter")
end

-- arti's action functor monkey patch ;]
NameCustom = ui_inventory.UIInventory.Name_Custom

function ui_inventory.UIInventory:Name_Custom(obj, bag, temp, i)
	obj = self:CheckItem(obj,"Name_Custom " .. i)
	if i == 9 and get_filter_state(obj:id()) then
		return menu_filters(obj)
	else
		return NameCustom(self, obj, bag, temp, i)
	end
end

ActionCustom = ui_inventory.UIInventory.Action_Custom
function ui_inventory.UIInventory:Action_Custom(obj, bag, temp, i)
	obj = self:CheckItem(obj,"Action_Custom " .. i)
	if i == 9 and get_filter_state(obj:id()) then
		func_filters(obj)
	else
		ActionCustom(self, obj, bag, temp, i)
	end
end

------------------ anim (stole some from fdda) -------------------
local cur_slot, hud_fov, det_active
local anim_is_locked = false
local anim_token = 0

local function get_motion_seconds(hud_sec, motion, fallback)
	local length = hud_sec and motion and game.get_motion_length(hud_sec, motion, 1) or nil
	length = tonumber(length) or 0
	if length > 0 then
		return length / 1000
	end
	return fallback or 0
end

local function log_anim_message(message, value)
	if printf then
		if value ~= nil then
			printf(message, value)
		else
			printf(message)
		end
	end
end

local function get_tank_anim_hud_section(tank_sec)
	if not tank_sec then return "ta_rework_af_oxygen_tank_1_hud" end

	local hud_sec = "ta_rework_" .. tank_sec .. "_hud"
	if ini_sys:section_exist(hud_sec) then
		return hud_sec
	end

	hud_sec = "ta_" .. tank_sec .. "_hud"
	if ini_sys:section_exist(hud_sec) then
		return hud_sec
	end

	return "ta_rework_af_oxygen_tank_1_hud"
end

local function get_anim_hud_fov(tank_typ, filter_typ, tank_sec)
	if tank_typ then
		local tank_hud = get_tank_anim_hud_section(tank_sec)
		local tank_fov = tank_hud and ini_sys:r_float_ex(tank_hud, "hud_fov")
		if tank_fov then return tank_fov end
	end

	if filter_typ then
		local filter_hud = "ta_filter_" .. filter_typ .. "_hud"
		if ini_sys:section_exist(filter_hud) then
			local filter_fov = ini_sys:r_float_ex(filter_hud, "hud_fov")
			if filter_fov then return filter_fov end
		end
	end

	return 0.45
end

function play_tank_anm(tank_typ, tank_sec)
	if not tank_typ then return end
	if actor_dying or not actor_is_alive() then return end

	if allow_anm_play then
		play_ta_anm(tank_typ, nil, nil, tank_sec)
		return
	end

	CreateTimeEvent("ta_tank_delayed_" .. tank_typ .. "_e", "ta_tank_delayed_" .. tank_typ .. "_a", 2, function()
		if allow_anm_play and not actor_dying and actor_is_alive() then
			play_ta_anm(tank_typ, nil, nil, tank_sec)
		end
		return true
	end)
end

local function queue_lam2_ta_animation(tank_typ, filter_typ, filter_delay, tank_sec)
	if not (lam2 and lam2.get_template_action_play_animation and lam2.add_action) then
		return false
	end

	if tank_typ ~= nil then
		local tank_hud = get_tank_anim_hud_section(tank_sec)
		local tank_action = lam2.get_template_action_play_animation()
		tank_action.tag = "toxic_air"
		tank_action.name = "tank_" .. tank_typ
		tank_action.sec = tank_hud
		tank_action.anm = tank_typ == "off" and "anm_off" or "anm_on"
		tank_action.cam = "cam_" .. tank_typ
		tank_action.snd = "snd_" .. tank_typ
		tank_action.hands = 2
		tank_action.fallback_duration = tank_anm_length
		lam2.add_action(tank_action)
	end

	if filter_typ ~= nil then
		if filter_delay and filter_delay > 0 then
			lam2.add_action(lam2.get_template_action_wait_for_seconds(filter_delay))
		end

		local filter_action = lam2.get_template_action_play_animation()
		filter_action.tag = "toxic_air"
		filter_action.name = "filter_" .. filter_typ
		filter_action.sec = "ta_filter_" .. filter_typ .. "_hud"
		filter_action.anm = "anm_filter_show"
		filter_action.cam = "cam"
		filter_action.snd = "snd"
		filter_action.hands = 2
		filter_action.fallback_duration = 2
		lam2.add_action(filter_action)
	end

	return true
end

function play_ta_anm(tank_typ, filter_typ, filter_delay, tank_sec)		-- types: "on" / "off" / nil
	if not toxic_air_mcm.get_config("filter_animation") then return end
	if not allow_anm_play then return end
	if actor_dying or not actor_is_alive() then return end
	if not (db and db.actor and level) then return end

	if queue_lam2_ta_animation(tank_typ, filter_typ, filter_delay, tank_sec) then
		return
	end

--	printf("ANM PLAYING")

	-- prepare anm
	if anim_is_locked then
		restore()
	end

	anim_is_locked = true
	anim_token = anim_token + 1
	local this_anim_token = anim_token

	if hide_hud_inventory then
		hide_hud_inventory()
	end

	cur_slot = db.actor:active_slot()

	det_active = db.actor:active_detector() or nil
	if det_active then det_active:switch_state(2) end

	db.actor:activate_slot(0)

	local attempts = 0
	local function check_n_play()
		if not anim_is_locked or this_anim_token ~= anim_token then return true end
		if actor_dying or not actor_is_alive() then
			restore(false)
			return true
		end
		if not (db and db.actor) then
			restore()
			return true
		end

		attempts = attempts + 1
		if db.actor:active_slot() ~= 0 then
			db.actor:activate_slot(0)
		end

		local active_detector = db.actor:active_detector()
		if active_detector then
			active_detector:switch_state(2)
		end

		local menu_closed = (not actor_menu) or (not actor_menu.get_last_mode) or actor_menu.get_last_mode() == 0
		local hands_ready = db.actor:active_slot() == 0 and not db.actor:active_detector()
		if menu_closed and hands_ready then
			game.only_allow_movekeys(true)
			hud_fov = ui_options and ui_options.get and ui_options.get("video/basic/hud_fov") or nil
			exec_console_cmd("hud_fov " .. tostring(get_anim_hud_fov(tank_typ, filter_typ, tank_sec)))
			local ok, err = pcall(play_anm, tank_typ, filter_typ, filter_delay, tank_sec)
			if not ok then
				log_anim_message("toxic_air | animation failed: %s", tostring(err))
				restore()
			end
			return true
		end

		if attempts >= 20 then
			log_anim_message("toxic_air | animation cancelled: actor did not switch to idle slot")
			restore()
			return true
		end

		return false
	end

	CreateTimeEvent("ta_filter_anm_e", "ta_filter_anm_a", 1, check_n_play)
	CreateTimeEvent("ta_filter_anm_failsafe_e", "ta_filter_anm_failsafe_a", 8, function()
		if anim_is_locked and this_anim_token == anim_token then
			log_anim_message("toxic_air | animation failsafe restore")
			restore()
		end
		return true
	end)

end

function play_anm(tank_typ, filter_typ, filter_delay, tank_sec)
	local length = 0
	local tank_delay = 0
	if tank_typ ~= nil then
		local tank_hud = get_tank_anim_hud_section(tank_sec)
		local tank_anm = tank_typ == "off" and "anm_off" or "anm_on"
		tank_delay = get_motion_seconds(tank_hud, tank_anm, tank_anm_length)
		length = length + tank_delay
		game.play_hud_motion(2, tank_hud, tank_anm, false, 1)
		level.add_cam_effector(ini_sys:r_string_ex(tank_hud, "cam_" .. tank_typ) or ("toxic_air\\filter_use_" .. tank_typ .. ".anm"), 105613, false, "")
		local tank_snd = sound_object(ini_sys:r_string_ex(tank_hud, "snd_" .. tank_typ) or ("toxic_air\\ta_tank_" .. tank_typ))
		tank_snd:play_no_feedback(db.actor, sound_object.s2d, 0, VEC_ZERO, 1.0, 1.0)
	end

	if filter_typ ~= nil then
		local filter_hud = "ta_filter_" .. filter_typ .. "_hud"
		length = length + get_motion_seconds(filter_hud, "anm_filter_show", 2)
		local function delay_filter_anm()
			if not anim_is_locked then return true end
			if actor_dying or not actor_is_alive() then return true end
			local ok, err = pcall(function()
				game.play_hud_motion(2, filter_hud, "anm_filter_show", false, 1)
				level.add_cam_effector("toxic_air\\filter_use_" .. filter_typ .. ".anm", 105612, false, "")
				local filter_snd = sound_object("toxic_air\\filter_use_" .. filter_typ)
				filter_snd:play_no_feedback(db.actor, sound_object.s2d, 0, VEC_ZERO, 1.0, 1.0)
			end)
			if not ok then
				log_anim_message("toxic_air | delayed filter animation failed: %s", tostring(err))
				restore()
			end
			return true
		end
		CreateTimeEvent("ta_delay_filter_anm_e", "ta_delay_filter_anm_a", filter_delay or tank_delay, delay_filter_anm)
	end

	-- restore configs
	if length <= 0 then
		length = 0.1
	end
	CreateTimeEvent("ta_restore_settings_e", "ta_restore_settings_a", length, restore)

end

function restore(restore_slot)
	restore_slot = restore_slot ~= false
	anim_is_locked = false

	game.only_allow_movekeys(false)

	if hud_fov then
		exec_console_cmd("hud_fov " .. tostring(hud_fov))
	end

	if restore_slot and not actor_dying and db and db.actor then
		if cur_slot ~= nil then
			db.actor:activate_slot(cur_slot or 0)
		end

		if det_active then det_active:switch_state(1) end
	end

	cur_slot, hud_fov, det_active = nil, nil, nil

	return true
end

----------------------------- upd main --------------------------
function actor_on_update()
	if actor_dying or not actor_is_alive() then
		return
	end

	local tg = time_global()
	if (tmr_upd and tg < tmr_upd) then return end
	tmr_upd = tg + 1000
	if next(pending_tank_restore) then
		restore_tanks_after_load()
	end
	Metrofilters()
	server_id_table_check()

	filter_cond_prot()

--	news_manager.send_tip(db.actor, string.format("filter_prot [ %s ] , tank_prot [ %s ]", round_idp(filter_air_protection, 3), tank_air_protection), 0, nil, 1500)


	if not allow_anm_play then return end

	if (chemical_dmg > 0) and mcm_toxic_underground then
		chemical_level_damage()
	end
	
	if (radioactive_dmg > 0) and mcm_rad_air then
		radiation_level_damage()
	end
end

local metro_filter_cond_15 = false
local metro_filter_cond_0 = false

function Metrofilters()

	if not (toxic_air_mcm.get_config("metro_toggle")) then
		return
	end
	
	-- check filters
	local item = get_installed_filter_item()
	local filter_t = item and get_filter_state(item:id())
	local f_cond = filter_t and filter_t.cond
--	printf("filter_cond: %s", f_cond)

	-- check tanks
	local t_cond
	db.actor:iterate_belt( function(owner, tank)
		if get_tank_state(tank:id()) then
			t_cond = tank_cond[tank:id()]
		end
	end)
--	printf("tank_cond: %s", t_cond)

	-- has filter or tank
	local cur_cond = f_cond or t_cond
	if not cur_cond then return end
	
	if f_cond then
		if (cur_cond <= 0.15) then
			if (not metro_filter_cond_15) then
				local timer_snd2 = sound_object("toxic_air\\watch_timer_alarm_2")
				timer_snd2:play_no_feedback(db.actor, sound_object.s2d, 0, VEC_ZERO, 1.0, 1.0)
				news_manager.send_tip(db.actor, gc("st_filter_timer_warning2"), 0, nil, 5000)	-- ilrathCXV (04/13/2024)
				metro_filter_cond_15 = true
			end
		else
			metro_filter_cond_15 = false
		end
		
		if (cur_cond <= 0) then
			if (not metro_filter_cond_0) then
				local timer_snd = sound_object("toxic_air\\watch_timer_alarm_1")
				timer_snd:play_no_feedback(db.actor, sound_object.s2d, 0, VEC_ZERO, 1.0, 1.0)
				news_manager.send_tip(db.actor, gc("st_filter_timer_warning"), 0, nil, 5000)	-- ilrathCXV (04/13/2024)
				metro_filter_cond_0 = true
			end
		else
			metro_filter_cond_0 = false
		end
	end
	
	if t_cond then
		if (cur_cond <= 0.15) then
			if (not metro_filter_cond_15) then
				local timer_snd2 = sound_object("toxic_air\\watch_timer_alarm_2")
				timer_snd2:play_no_feedback(db.actor, sound_object.s2d, 0, VEC_ZERO, 1.0, 1.0)
				news_manager.send_tip(db.actor, gc("st_tank_timer_warning2"), 0, nil, 5000)	-- ilrathCXV (04/13/2024)
				metro_filter_cond_15 = true
			end
		else
			metro_filter_cond_15 = false
		end
		
		if (cur_cond <= 0.01) then
			if (not metro_filter_cond_0) then
				local timer_snd = sound_object("toxic_air\\watch_timer_alarm_1")
				timer_snd:play_no_feedback(db.actor, sound_object.s2d, 0, VEC_ZERO, 1.0, 1.0)
				news_manager.send_tip(db.actor, gc("st_tank_timer_warning"), 0, nil, 5000)	-- ilrathCXV (04/13/2024)
				metro_filter_cond_0 = true
			end
		else
			metro_filter_cond_0 = false
		end
	end

end

----------------------------- binder ---------------------------
function bind(obj)
	obj:bind_object(oxygen_tank(obj))
end

class "oxygen_tank" (object_binder)

function oxygen_tank:__init(obj) super(obj)
	self.first_update = nil
end

function oxygen_tank:update(delta)
	object_binder.update(self, delta)
	local obj = self.object
	local id = obj:id()

	if not self.first_update then
		self.first_update = true
		if tank_cond[id] then
			obj:set_condition(tank_cond[id])
--			printf("- obj id: [ %s ] , sec: [ %s ] , SET COND TO: [ %s ]", id, obj:section(), tank_cond[id])
		else
			tank_cond[id] = obj:condition()
--			printf("- SAVE id: [ %s ] , sec: [ %s ] , SAVE cond: [ %s ]", id, obj:section(), tank_cond[id])
		end
	end

	local tg = time_global()
	if (tmr_dgr and tg < tmr_dgr) then return end
	tmr_dgr = tg + 1000

	tank_degradation_and_protection(obj)

	tank_cond[id] = obj:condition()

end

function tank_degradation_and_protection(tank)

	if not (db.actor:is_on_belt(tank)) then return end

	if not get_tank_state(tank:id()) then return end
	
	local tank_sec = tank:section()
	local tank_gear, tank_gear_def, tank_entry = get_active_tank_entry(tank_sec)
	local helm_gasmask = tank_gear and true or false
	helm_cond = tank_gear and tank_gear:condition() or 1

	if helm_gasmask then
		
		local rad_air_active = mcm_rad_air and radioactive_dmg > 0 and get_profile_rad_reduction(tank_entry) > 0
		local toxic_air_active = mcm_toxic_underground and chemical_dmg > 0 and get_profile_toxic_reduction(tank_entry) > 0
		if (rad_air_active or toxic_air_active) and not actor_in_safe_zone() and not hold_breathe then
			local oxt_cond_hit = ini_sys:r_float_ex(tank_sec, "flow_rate") or 0
			check_actor_move()
			oxt_cond_hit = oxt_cond_hit * mcm_flow_rate_mult * move_mult * get_profile_toxic_degrade_mult(tank_entry)
			local oxt_cond = tank:condition() - oxt_cond_hit
			tank:set_condition(oxt_cond)
		end
		
		tank_rad_reduction = get_profile_rad_reduction(tank_entry)
		tank_toxic_reduction = get_profile_toxic_reduction(tank_entry)
		tank_toxic_degrade_mult = get_profile_toxic_degrade_mult(tank_entry)
		tank_air_protection = (tank_rad_reduction > 0 or tank_toxic_reduction > 0) and 1 or 0
		tank_rad_protection = get_profile_rad_protection(tank_entry)
		tank_chem_protection = get_profile_chem_protection(tank_entry)
	else
		tank_air_protection = 0
		tank_rad_protection = 0
		tank_chem_protection = 0
		tank_rad_reduction = 0
		tank_toxic_reduction = 0
		tank_toxic_degrade_mult = 1
	end

--	printf("tank_id: [ %s ] , condition: [ %s ] , cond_loss: [ %s ]", tank:id(), round_idp(oxt_cond, 4), oxt_cond_hit)

	if tank:condition() <= 0.001 then
		tank:set_condition(0.001)
		tank_air_protection = 0
		tank_rad_protection = 0
		tank_chem_protection = 0
		tank_rad_reduction = 0
		tank_toxic_reduction = 0
		tank_toxic_degrade_mult = 1
		
		if not hold_breathe then
			control_breathe()
		end
	end

end

function oxygen_tank:reload(section)
	object_binder.reload(self, section)
end

function oxygen_tank:reinit()
	object_binder.reinit(self)
end

function oxygen_tank:net_spawn(se_abstract)
	if not (object_binder.net_spawn(self, se_abstract)) then
		return false
	end
    return true
end

function oxygen_tank:net_destroy()
	object_binder.net_destroy(self)
end

function oxygen_tank:save(stpk)
end

function oxygen_tank:load(stpk)
end

