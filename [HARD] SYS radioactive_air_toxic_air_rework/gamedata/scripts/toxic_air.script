local tank_rad_protection = 0
local tank_chem_protection = 0
local tank_rad_reduction = 0
local tank_toxic_reduction = 0
local tank_toxic_degrade_mult = 1
local helm_cond = 0
local move_mult = 1

local rad_hit = 0
local chem_hit = 0

local function get_filter_state(id)
	return id and filters[id] or nil
end

local function set_filter_state(id, state)
	if not id then return end
	local key = normalized_filter_key(id)
	filters[key] = state
	local alt = filter_alt_key(key)
	if alt then
		rawset(filters, alt, nil)
	end
end

local function clear_filter_state(id)
	if not id then return end
	local key = normalized_filter_key(id)
	rawset(filters, key, nil)
	local alt = filter_alt_key(key)
	if alt then
		rawset(filters, alt, nil)
	end
end

local function actor_is_alive()
	if not (db and db.actor) then return false end
	if not db.actor.alive then return true end

	local ok, alive = pcall(function()
		return db.actor:alive()
	end)

	return ok and alive == true
end

local function get_tank_state(id)
	return id and tanks[id] or nil
end

local function set_tank_state(id, active)
	if not id then return end
	local key = normalized_filter_key(id)
	tanks[key] = active and true or nil
	local alt = filter_alt_key(key)
	if alt then
		rawset(tanks, alt, nil)
	end
end

local function clear_tank_state(id)
	if not id then return end
	local key = normalized_filter_key(id)
	rawset(tanks, key, nil)
	local alt = filter_alt_key(key)
	if alt then
		rawset(tanks, alt, nil)
	end
end

