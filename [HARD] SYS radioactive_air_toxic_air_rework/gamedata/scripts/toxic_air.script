base_add_bar = utils_ui.UICellItem.Add_ProgressBar
local XMLP = CScriptXmlInit()
XMLP:ParseFile("utils.xml")

function utils_ui.UICellItem:Add_ProgressBar(xml, obj, sec, clsid)
    if (not self.bar) and self.path == "equipment:cont_belt" then
        self.bar = XMLP:InitProgressBar("container:cell:bar", self.cell)

            local h_bar = self.bar:GetHeight()
        self.bar:SetWndPos(vector2():set( 0 , (self.H - h_bar)))
    end
    base_add_bar(self, xml, obj, sec, clsid)
end

---------------------------------------- HUD ------------------------------------------------

HUD = nil

function activate_hud()
	if HUD == nil then
		HUD = ToxicAir()
		get_hud():AddDialogToRender(HUD)
	end
end

function deactivate_hud()
	if HUD ~= nil then
		get_hud():RemoveDialogToRender(HUD)
		HUD = nil
	end
end

local function cleanup_actor_runtime()
	actor_dying = true
	allow_anm_play = false

	if anim_is_locked then
		restore(false)
	end

	deactivate_hud()
end

class "ToxicAir" (CUIScriptWnd)

function ToxicAir:__init() super()
	self:InitControls()
end

function ToxicAir:InitControls()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:SetAutoDelete(true)

	self.xml = CScriptXmlInit()
	local xml = self.xml
	xml:ParseFile("ui_toxic_air.xml")

	self.bg = xml:InitStatic("bg", self)
	self.bg:Show(false)

	self.bar = xml:InitProgressBar("bar", self.bg)
	self.bar:SetProgressPos(0)
	
	self.bar_air = xml:InitProgressBar("bar", self.bg)
	self.bar_air:SetColor(GetARGB(150, 0, 191, 255))
	self.bar_air:SetProgressPos(0)

	self.mask = xml:InitStatic("mask", self.bg)
	
	self.txt = xml:InitTextWnd("txt", self.bg)

	self:UpdPos()
end

local hud_tmr = 0
function ToxicAir:Update()
	CUIScriptWnd.Update(self)

	local tg = time_global()
	if hud_tmr > tg then return end
	hud_tmr = tg + 1000

	self.bg:Show(false)
	self.bar_air:Show(false)
	self.txt:Show(false)
	if not toxic_air_mcm.get_config("enable_hud") then return end
	
	local filter_item = get_installed_filter_item()
	local filter_t = filter_item and get_filter_state(filter_item:id())
	local f_cond = filter_t and filter_t.cond
--	printf("filter_cond: %s", f_cond)

	-- check tanks
	local t_cond
	local tank_gear = get_active_tank_gear()
	local tank_item
	if tank_gear then
		db.actor:iterate_belt( function(owner, tank)
			if get_tank_state(tank:id()) then
				t_cond = tank_cond[tank:id()]
				tank_item = tank
			end
		end)
	end
--	printf("tank_cond: %s", t_cond)

	-- has filter or tank
	local cur_cond = f_cond or t_cond
--	if not cur_cond then return end

	local air = hold_breathe_time / hold_breathe_max_time

	-- show bar
	if cur_cond then
		self.bg:Show(true)
		self.bar:Show(true)
		self.mask:Show(true)
		self.bar:SetProgressPos(cur_cond)
		if (air < 1) then
			self.bar_air:Show(true)
			self.bar_air:SetProgressPos(air)
		end
	elseif (air < 1) then
		self.bg:Show(true)
		self.bar:Show(false)
		self.mask:Show(false)
		self.bar_air:Show(true)
		self.bar_air:SetProgressPos(air)
	end

	local sec = filter_t and filter_t.name or (tank_item and tank_item:section())
	
	if sec then
		local filter_name = gc(ini_sys:r_string_ex(sec, "inv_name"))
		self.txt:Show(true)
		self.txt:SetText(filter_name)
	else
		self.txt:Show(false)
	end

end

function ToxicAir:UpdPos()
	self.bg:SetWndPos(vector2():set(toxic_air_mcm.get_config("position_x"), toxic_air_mcm.get_config("position_y")))
end

function ToxicAir:__finalize()
end

