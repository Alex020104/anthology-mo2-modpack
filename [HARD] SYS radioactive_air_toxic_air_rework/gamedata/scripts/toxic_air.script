local airgear_items = {}
local airgear_profiles = {}

local function trim_value(value)
	if not value then
		return ""
	end

	value = tostring(value)
	value = value:gsub("^%s+", "")
	value = value:gsub("%s+$", "")
	return value
end

local function normalize_mode(value)
	value = trim_value(value):lower()
	if (value == "tank") or (value == "tanks") then
		return "tank"
	end
	return "filter"
end

local function parse_bool_value(value)
	value = trim_value(value):lower()
	return (value == "true") or (value == "1") or (value == "yes")
end

local function parse_fraction_value(value, default)
	local result = tonumber(trim_value(value)) or default or 0
	if result < 0 then
		return 0
	elseif result > 1 then
		return 1
	end
	return result
end

local function parse_positive_value(value, default)
	local result = tonumber(trim_value(value)) or default or 0
	return result < 0 and 0 or result
end

local function profile_entry_allowed(entry)
	return (entry == true) or (type(entry) == "table" and entry.allowed == true)
end

local function get_profile_rad_reduction(entry)
	return type(entry) == "table" and (tonumber(entry.rad_reduction) or 0) or 0
end

local function get_profile_toxic_reduction(entry)
	return type(entry) == "table" and (tonumber(entry.toxic_reduction) or 0) or 0
end

local function get_profile_toxic_degrade_mult(entry)
	return type(entry) == "table" and (tonumber(entry.toxic_degrade_mult) or 1) or 1
end

local function get_profile_rad_protection(entry)
	return get_profile_rad_reduction(entry) * MAX_RAD_AIR_IMMUNITY
end

local function get_profile_chem_protection(entry)
	return get_profile_toxic_reduction(entry) * MAX_TOXIC_AIR_IMMUNITY
end

local function is_filter_consumable_section(sec)
	return sec and airgear_filter_consumables[sec] == true
end

local function is_tank_consumable_section(sec)
	return sec and airgear_tank_consumables[sec] == true
end

local function is_supported_airgear(item)
	return item and airgear_items[item:section()] or nil
end

local function get_airgear_profile(item)
	local def = is_supported_airgear(item)
	return def and airgear_profiles[def.hud] or nil, def
end

local function normalize_ui_tier_label(tier)
	tier = trim_value(tier)
	if tier == "" then return nil end

	local n = tier:match("^T(%d+)$") or tier:match("^(%d+)$")
	if n == "1" then return "I" end
	if n == "2" then return "II" end
	if n == "3" then return "III" end

	return tier
end

local function get_profile_ui_tier(entry)
	local tier = type(entry) == "table" and trim_value(entry.ui_tier) or ""
	return normalize_ui_tier_label(tier)
end

local function get_profile_ui_tiers(profile)
	if type(profile) ~= "table" then return nil end

	local tiers = {}
	local used = {}
	for _, entry in pairs(profile) do
		if profile_entry_allowed(entry) then
			local tier = get_profile_ui_tier(entry)
			if tier and not used[tier] then
				tiers[#tiers + 1] = tier
				used[tier] = true
			end
		end
	end

	if #tiers == 0 then return nil end
	table.sort(tiers)
	return table.concat(tiers, "/")
end

local function get_consumable_ui_tiers(sec, mode)
	if not sec then return nil end

	local tiers = {}
	local used = {}
	for hud, profile in pairs(airgear_profiles) do
		local modes = airgear_profile_modes[hud]
		if (not mode) or (modes and modes[mode]) then
			local entry = profile and profile[sec]
			if profile_entry_allowed(entry) then
				local tier = get_profile_ui_tier(entry)
				if tier and not used[tier] then
					tiers[#tiers + 1] = tier
					used[tier] = true
				end
			end
		end
	end

	if #tiers == 0 then return nil end
	table.sort(tiers)
	return table.concat(tiers, "/")
end

local function get_airgear_tooltip_line(item, teal_clr, grey_clr)
	local profile, def = get_airgear_profile(item)
	if not def then return "" end

	local mode = def.mode == "tank" and gc("st_toxic_air_tooltip_tank") or gc("st_toxic_air_tooltip_filter")
	local tiers = get_profile_ui_tiers(profile)
	local tier_str = ""
	if tiers and not (def.mode == "tank" and string.lower(tiers) == "tank") then
		tier_str = " " .. tiers
	end

	return teal_clr .. gc("st_krug_xd") .. " " .. grey_clr .. gc("st_toxic_air_tooltip_prefix") .. " " .. mode .. tier_str .. "\\n" .. grey_clr
end

local function prefer_separate_helmet_filter()
	if not (db and db.actor) then return end

	local outfit = db.actor:item_in_slot(7)
	local outfit_def = is_supported_airgear(outfit)
	local helmet = db.actor:item_in_slot(12)
	local helmet_def = is_supported_airgear(helmet)
	if not (outfit and outfit_def and outfit_def.mode == "filter" and helmet and helmet_def and helmet_def.mode == "filter") then
		return
	end

	local outfit_filter = get_filter_state(outfit:id())
	if outfit_filter and not get_filter_state(helmet:id()) then
		set_filter_state(helmet:id(), outfit_filter)
		clear_filter_state(outfit:id())
	end
end

local function get_filter_target_item()
	if not db or not db.actor then
		return nil, nil
	end

	prefer_separate_helmet_filter()

	local helmet = db.actor:item_in_slot(12)
	local helmet_def = is_supported_airgear(helmet)
	if helmet_def and helmet_def.mode == "filter" then
		return helmet, helmet_def
	end

	local outfit = db.actor:item_in_slot(7)
	local outfit_def = is_supported_airgear(outfit)
	if outfit_def and outfit_def.mode == "filter" then
		return outfit, outfit_def
	end

	return nil, nil
end

local function get_installed_filter_item()
	if not db or not db.actor then
		return nil, nil
	end

	prefer_separate_helmet_filter()

	local helmet = db.actor:item_in_slot(12)
	local helmet_def = is_supported_airgear(helmet)
	if helmet and helmet_def and helmet_def.mode == "filter" and get_filter_state(helmet:id()) then
		return helmet, helmet_def
	end

	local outfit = db.actor:item_in_slot(7)
	local outfit_def = is_supported_airgear(outfit)
	if outfit and outfit_def and outfit_def.mode == "filter" and get_filter_state(outfit:id()) then
		return outfit, outfit_def
	end

	return nil, nil
end

local function get_active_tank_gear()
	if not db or not db.actor then
		return nil, nil
	end

	local outfit = db.actor:item_in_slot(7)
	local outfit_def = is_supported_airgear(outfit)
	if outfit_def and outfit_def.mode == "tank" then
		return outfit, outfit_def
	end

	local helmet = db.actor:item_in_slot(12)
	local helmet_def = is_supported_airgear(helmet)
	if helmet_def and helmet_def.mode == "tank" then
		return helmet, helmet_def
	end

	return nil, nil
end

local function get_active_airgear_item()
	local item, def = get_installed_filter_item()
	if item then
		return item, def
	end

	item, def = get_active_tank_gear()
	if item then
		return item, def
	end

	if not db or not db.actor then
		return nil, nil
	end

	local helmet = db.actor:item_in_slot(12)
	local helmet_def = is_supported_airgear(helmet)
	if helmet_def then
		return helmet, helmet_def
	end

	local outfit = db.actor:item_in_slot(7)
	local outfit_def = is_supported_airgear(outfit)
	if outfit_def then
		return outfit, outfit_def
	end

	return nil, nil
end

local function can_use_filter_on_gear(gear, filter_sec)
	if not (gear and filter_sec) then
		return false
	end

	local profile, gear_def = get_airgear_profile(gear)
	if not (profile and gear_def and gear_def.mode == "filter") then
		return false
	end

	return profile_entry_allowed(profile[filter_sec])
end

local function get_filter_profile_entry(gear_def, filter_sec)
	if not (gear_def and filter_sec) then
		return nil
	end

	local profile = airgear_profiles[gear_def.hud]
	local entry = profile and profile[filter_sec]
	return profile_entry_allowed(entry) and entry or nil
end

local function get_tank_profile_entry(gear_def, tank_sec)
	if not (gear_def and tank_sec) then
		return nil
	end

	local profile = airgear_profiles[gear_def.hud]
	local entry = profile and profile[tank_sec]
	return profile_entry_allowed(entry) and entry or nil
end

local function get_active_tank_entry(tank_sec)
	local tank_gear, tank_gear_def = get_active_tank_gear()
	local tank_entry = get_tank_profile_entry(tank_gear_def, tank_sec)
	if not tank_entry then
		return nil, nil, nil
	end

	return tank_gear, tank_gear_def, tank_entry
end

local function get_equipped_tank_item()
	if not (db and db.actor) then return nil end

	local tank_item
	db.actor:iterate_belt(function(owner, tank)
		if not tank_item and get_tank_state(tank:id()) then
			tank_item = tank
		end
	end)

	return tank_item
end

local function filter_slot_has_filter()
	if not db or not db.actor then return false end

	local outfit = db.actor:item_in_slot(7)
	local helmet = db.actor:item_in_slot(12)
	return (outfit and get_filter_state(outfit:id()) ~= nil) or (helmet and get_filter_state(helmet:id()) ~= nil) or false
end

local function can_restore_tank(tank)
	if not (tank and is_tank_consumable_section(tank:section())) then return false end
	if filter_slot_has_filter() then return false end
	local _, _, tank_entry = get_active_tank_entry(tank:section())
	return tank_entry ~= nil
end

local function find_actor_item_by_id(id)
	if not (db and db.actor and id) then return nil end

	local target_id = tonumber(id) or id
	local found
	db.actor:iterate_belt(function(owner, item)
		if not found and item:id() == target_id then
			found = item
		end
	end)
	if found then return found end

	db.actor:iterate_inventory(function(owner, item)
		if not found and item:id() == target_id then
			found = item
		end
	end, db.actor)
	if found then return found end

	return nil
end

local function find_actor_tank_by_section(sec, cond)
	if not (db and db.actor and sec) then return nil end

	local best
	local best_diff
	local function check_item(owner, item)
		if item and item:section() == sec then
			local diff = cond and math.abs(item:condition() - cond) or 0
			if (not best) or diff < best_diff then
				best = item
				best_diff = diff
			end
		end
	end

	db.actor:iterate_belt(check_item)
	db.actor:iterate_inventory(check_item, db.actor)
	return best
end

local function build_active_tank_restore_data()
	local data = {}
	if not (db and db.actor) then return data end

	db.actor:iterate_belt(function(owner, tank)
		if tank and is_tank_consumable_section(tank:section()) and can_restore_tank(tank) then
			set_tank_state(tank:id(), true)
			data[tostring(tank:id())] = {
				section = tank:section(),
				cond = tank_cond[tank:id()] or tank:condition(),
			}
		end
	end)

	return data
end

local function sync_tanks_from_belt()
	if not (db and db.actor) then return false end

	local has_active = false
	db.actor:iterate_belt(function(owner, tank)
		if tank and is_tank_consumable_section(tank:section()) then
			if (not has_active) and can_restore_tank(tank) then
				set_tank_state(tank:id(), true)
				tank_cond[tank:id()] = tank_cond[tank:id()] or tank:condition()
				has_active = true
			else
				clear_tank_state(tank:id())
			end
		end
	end)

	return has_active
end

local function tank_restore_guard_active()
	return tank_restore_guard_until > 0 and time_global() < tank_restore_guard_until
end

local function pending_restore_matches_tank(tank)
	if not tank then return false end
	local tank_id = tank:id()
	local tank_sec = tank:section()
	for saved_id, state in pairs(pending_tank_restore or {}) do
		if (tonumber(saved_id) == tank_id) or (type(state) == "table" and state.section == tank_sec) then
			return true
		end
	end
	return false
end

local function has_active_tank_except(id)
	local cmp = normalized_filter_key(id)
	for tank_id, active in pairs(tanks or {}) do
		if active and normalized_filter_key(tank_id) ~= cmp then
			return true
		end
	end
	return false
end

local function restore_tanks_after_load()
	if not (db and db.actor) then return false end

	tanks = normalize_id_bool_table(tanks)
	if not next(pending_tank_restore) then
		sync_tanks_from_belt()
		return true
	end

	local tg = time_global()
	local guard_active = tank_restore_guard_until > tg
	local belt_synced = sync_tanks_from_belt()
	if belt_synced and guard_active then
		return false
	elseif belt_synced and (tank_restore_guard_until > 0) then
		pending_tank_restore = {}
		tank_restore_guard_until = 0
		return true
	end

	if filter_slot_has_filter() then
		pending_tank_restore = {}
		tank_restore_guard_until = 0
		return true
	end

	for saved_id, state in pairs(pending_tank_restore) do
		local data = type(state) == "table" and state or {}
		local sec = data.section
		local cond = tonumber(data.cond)
		local tank = find_actor_item_by_id(saved_id)
		if (not tank or (sec and tank:section() ~= sec)) and sec then
			tank = find_actor_tank_by_section(sec, cond)
		end

		if tank and can_restore_tank(tank) then
			if cond then
				tank:set_condition(cond)
				tank_cond[tank:id()] = cond
			else
				tank_cond[tank:id()] = tank_cond[tank:id()] or tank:condition()
			end

			if not db.actor:is_on_belt(tank) then
				restoring_tank_state = true
				db.actor:move_to_belt(tank)
				restoring_tank_state = false
			end

			if db.actor:is_on_belt(tank) then
				set_tank_state(tank:id(), true)
				tank_restore_guard_until = math.max(tank_restore_guard_until, tg + 15000)
				return false
			end
		end
	end

	pending_tank_restore_attempts = pending_tank_restore_attempts + 1
	if pending_tank_restore_attempts >= 15 then
		pending_tank_restore = {}
		tank_restore_guard_until = 0
		return true
	end

	return false
end

local suppress_tank_out_animation = false

local function reset_tank_runtime_state(tank_id)
	clear_tank_state(tank_id)
	tank_air_protection = 0
	tank_rad_protection = 0
	tank_chem_protection = 0
	tank_rad_reduction = 0
	tank_toxic_reduction = 0
	tank_toxic_degrade_mult = 1
end

local function move_active_tanks_to_ruck_for_filter()
	local tank_on_belt = false
	local tank_sec_for_anm

	suppress_tank_out_animation = true
	db.actor:iterate_belt(function(owner, tank)
		if tank and oxt_tbl[tank:section()] then
			tank_on_belt = true
			tank_sec_for_anm = tank_sec_for_anm or tank:section()
			reset_tank_runtime_state(tank:id())
			db.actor:move_to_ruck(tank)
		end
	end)
	suppress_tank_out_animation = false

	return tank_on_belt, tank_sec_for_anm
end

local function install_filter_to_gear(gear, filter_item, animations_enabled)
	if not (gear and filter_item) then
		return false
	end

	local gear_id = gear:id()
	local filter_id = filter_item:id()

	local filter_state = {
		name = filter_item:section(),
		cond = filter_item:condition(),
	}
	set_filter_state(filter_id, filter_state)

	alife_release(filter_item)
	set_filter_state(gear_id, filter_state)

	local tank_on_belt, tank_sec_for_anm = move_active_tanks_to_ruck_for_filter()

	if tank_on_belt then
		play_ta_anm("off", "on", nil, tank_sec_for_anm)
		if not animations_enabled then
			news_manager.send_tip(db.actor, gc("st_filter_on_tanks_removed"), 0, nil, 5000)
		end
	else
		play_ta_anm(nil, "on", 0)
		if not animations_enabled then
			news_manager.send_tip(db.actor, gc("st_filter_on"), 0, nil, 5000)
		end
	end

	return true
end

local function load_airgear_settings()
	if not airgear_ini then
		return
	end

	empty_table(airgear_items)
	empty_table(airgear_profiles)
	empty_table(airgear_filter_consumables)
	empty_table(airgear_tank_consumables)
	empty_table(airgear_profile_modes)
	empty_table(oxt_tbl)

	local profile_sections = {}

	if airgear_ini:section_exist("settings_gear") then
		local n = airgear_ini:line_count("settings_gear")
		for i = 0, n - 1 do
			local _, id, value = airgear_ini:r_line_ex("settings_gear", i, "", "")
			if id and value then
				local tbl = parse_list(airgear_ini, "settings_gear", id)
				local hud = tbl[1] and trim_value(tbl[1]) or "hud_gass"
				local mode = tbl[2] and normalize_mode(tbl[2]) or "filter"
				airgear_items[id] = {
					hud = hud,
					mode = mode,
					respi = parse_bool_value(tbl[3]),
				}
				profile_sections[hud] = true
				airgear_profile_modes[hud] = airgear_profile_modes[hud] or {}
				airgear_profile_modes[hud][mode] = true
			end
		end
	end

	for sec, _ in pairs(profile_sections) do
		local profile = {}

		if airgear_ini:section_exist(sec) then
			local n = airgear_ini:line_count(sec)
			for j = 0, n - 1 do
				local _, id, value = airgear_ini:r_line_ex(sec, j, "", "")
				if id and value then
					local tbl = parse_list(airgear_ini, sec, id)
					profile[id] = {
						allowed = parse_bool_value(tbl[1]),
						rad_reduction = parse_fraction_value(tbl[2], 0),
						toxic_reduction = parse_fraction_value(tbl[3], 0),
						toxic_degrade_mult = parse_positive_value(tbl[4], 1),
						ui_tier = trim_value(tbl[5]),
					}

					if profile[id].allowed then
						oxt_tbl[id] = true

						if airgear_profile_modes[sec] and airgear_profile_modes[sec].filter then
							airgear_filter_consumables[id] = true
						end

						if airgear_profile_modes[sec] and airgear_profile_modes[sec].tank then
							airgear_tank_consumables[id] = true
						end
					end
				end
			end
		end

		airgear_profiles[sec] = profile
	end

	if airgear_ini:section_exist("service_items") then
		local n = airgear_ini:line_count("service_items")
		for i = 0, n - 1 do
			local _, id, value = airgear_ini:r_line_ex("service_items", i, "", "")
			if id and value and parse_bool_value(value) then
				oxt_tbl[id] = true
			end
		end
	end
end

load_airgear_settings()

