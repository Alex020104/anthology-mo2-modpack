function server_entity_on_unregister(se_obj, typ)
    local id = se_obj.id
    tank_cond[id] = nil
	clear_tank_state(id)
end

function on_before_level_changing()
	allow_anm_play = false
end

function on_option_change()
	mcm_breathe_feature = toxic_air_mcm.get_config("breathe_feature")
	mcm_breathe_key = toxic_air_mcm.get_config("breathe_key")
	mcm_breathe_modifier = toxic_air_mcm.get_config("breathe_modifier")
	mcm_breathe_mode = toxic_air_mcm.get_config("breathe_mode")
	
	mcm_filter_equip_key = toxic_air_mcm.get_config("filter_equip_key")
	mcm_filter_equip_modifier = toxic_air_mcm.get_config("filter_equip_modifier")
	mcm_filter_equip_mode = toxic_air_mcm.get_config("filter_equip_mode")
	mcm_mod_filter_equip_key = toxic_air_mcm.get_config("filter_mod_equip_key")
	mcm_mod_filter_equip_modifier = toxic_air_mcm.get_config("filter_mod_equip_modifier")
	mcm_mod_filter_equip_mode = toxic_air_mcm.get_config("filter_mod_equip_mode")
	
	mcm_filter_check_key = toxic_air_mcm.get_config("filter_check_key")
	mcm_filter_check_modifier = toxic_air_mcm.get_config("filter_check_modifier")
	mcm_filter_check_mode = toxic_air_mcm.get_config("filter_check_mode")
	mcm_filter_check_cond = toxic_air_mcm.get_config("filter_check_cond")
	
	mcm_toxic_underground = toxic_air_mcm.get_config("toxic_underground")
	mcm_filter_degradation_mult = toxic_air_mcm.get_config("filter_degradation_mult")
	mcm_flow_rate_mult = toxic_air_mcm.get_config("flow_rate_mult")
	
	mcm_rad_air = toxic_air_mcm.get_config("radioactive_air")
	mcm_rad_air_mult = toxic_air_mcm.get_config("radioactive_air_mult")
	mcm_rad_penetrarion = toxic_air_mcm.get_config("radiation_penetration")
	mcm_rad_penetrarion_mult = toxic_air_mcm.get_config("rad_penetration_mult")
	mcm_rad_damage = toxic_air_mcm.get_config("radiation_damage")
	mcm_rad_damage_mult = toxic_air_mcm.get_config("rad_damage_mult")
	
	mcm_spawn_items_with_chance = toxic_air_mcm.get_config("spawn_items_with_chance")
	mcm_chance_items_spawn = toxic_air_mcm.get_config("chance_items_spawn")
	mcm_spawn_items_cond_mult = toxic_air_mcm.get_config("spawn_items_cond_mult")
	
	if HUD then
		HUD:UpdPos()
	end
end

function on_game_start()
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_before_hit",actor_on_before_hit)
	RegisterScriptCallback("actor_item_to_belt", tank_in_belt)
	RegisterScriptCallback("actor_item_to_ruck", tank_out_belt)
	RegisterScriptCallback("actor_on_item_drop", tank_out_belt)
	RegisterScriptCallback("actor_item_to_slot", filter_to_slot)
	RegisterScriptCallback("ActorMenu_on_item_drag_drop", on_item_drag_dropped)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("server_entity_on_unregister", server_entity_on_unregister)
	RegisterScriptCallback("on_before_level_changing", on_before_level_changing)
	RegisterScriptCallback("actor_on_first_update", activate_hud)
	RegisterScriptCallback("actor_on_net_destroy", cleanup_actor_runtime)
	RegisterScriptCallback("actor_on_before_death", cleanup_actor_runtime)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_key_press", on_key_press)
	RegisterScriptCallback("on_key_hold", on_key_hold)
	RegisterScriptCallback("on_key_release", on_key_release)
end
