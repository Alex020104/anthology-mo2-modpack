local filter_air_protection = 0
local effects_factor = 0
local tank_anm_length = 4

local function filter_alt_key(key)
	if type(key) == "number" then
		return tostring(key)
	elseif type(key) == "string" then
		return tonumber(key)
	end
	return nil
end

local function make_filter_table(tbl)
	return setmetatable(tbl or {}, {
		__index = function(t, key)
			local alt = filter_alt_key(key)
			return alt and rawget(t, alt) or nil
		end,
	})
end

local function normalized_filter_key(key)
	return tonumber(key) or key
end

local function plain_filter_table(tbl)
	local normalized = {}
	for key, value in pairs(tbl or {}) do
		if type(value) == "table" and value.name then
			normalized[normalized_filter_key(key)] = value
		end
	end
	return normalized
end

local function normalize_filter_table(tbl)
	return make_filter_table(plain_filter_table(tbl))
end

local filters = make_filter_table({})

local function make_id_bool_table(tbl)
	return setmetatable(tbl or {}, {
		__index = function(t, key)
			local alt = filter_alt_key(key)
			return alt and rawget(t, alt) or nil
		end,
	})
end

local function plain_id_bool_table(tbl)
	local normalized = {}
	for key, value in pairs(tbl or {}) do
		if value then
			normalized[normalized_filter_key(key)] = true
		end
	end
	return normalized
end

local function normalize_id_bool_table(tbl)
	return make_id_bool_table(plain_id_bool_table(tbl))
end

local tanks = make_id_bool_table({})
local pending_tank_restore = {}
local pending_tank_restore_attempts = 0
local tank_restore_guard_until = 0
local restoring_tank_state = false
