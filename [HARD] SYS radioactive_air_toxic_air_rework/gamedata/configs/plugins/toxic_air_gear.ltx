; Toxic Air gear matrix.
;
; [settings_gear]
; item_section = hud_profile, mode, respirator_flag
; mode = filter or tank
;
; [hud_*]
; consumable_section = allowed, radiation_reduction, toxic_reduction, degrade_mult, ui_tier
; radiation_reduction/toxic_reduction use 0..1, where 1 means full protection for this system.
; degrade_mult is an extra condition drain multiplier for that consumable in this HUD profile.
;
; To add new gear, add the outfit/helmet section in [settings_gear], then add allowed
; filters or tanks in the referenced HUD profile section.

[settings_gear]
