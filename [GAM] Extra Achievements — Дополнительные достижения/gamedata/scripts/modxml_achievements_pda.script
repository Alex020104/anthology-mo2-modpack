local section_id = "eptExtraAchievements"
local text_id = "pda_btn_extra_achievements"

local pda_xml_names = {
	[[ui\pda_16.xml]],
	[[ui\pda.xml]],
	[[pda_16.xml]],
	[[pda.xml]]
}

local function has_any(list)
	return list and #list > 0
end

local function is_pda_xml(xml_file_name)
	for _, name in ipairs(pda_xml_names) do
		if xml_file_name == name then
			return true
		end
	end
	return false
end

local function patch_pda_tab(xml_obj)
	local tabs = xml_obj:query("tab")
	if not has_any(tabs) then return end
	if has_any(xml_obj:query("tab button[id=" .. section_id .. "]")) then return end

	local tab = tabs[1]
	local new_button = string.format([[
<button x="0" y="0" width="89" height="27" id="%s" frame_mode="0">
	<text align="c" vert_align="c" x="0" y="0" width="89" height="27" font="letterica16">%s</text>
	<texture>ui_inGame2_pda_button</texture>
	<text_color>
		<t r="255" g="255" b="255"/>
		<d r="255" g="255" b="255"/>
		<e r="200" g="200" b="200"/>
		<h r="170" g="170" b="170"/>
	</text_color>
</button>
]], section_id, text_id)

	xml_obj:insertFromXMLString(new_button, tab, #tab.kids)
end

function on_xml_read()
	RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
		if is_pda_xml(xml_file_name) then
			patch_pda_tab(xml_obj)
		end
	end)
end