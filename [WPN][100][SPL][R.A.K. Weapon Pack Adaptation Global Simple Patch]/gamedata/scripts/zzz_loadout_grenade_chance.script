local patched = false
local original_create_item_on_npc
local wrapped_create_item_on_npc

local chance_by_rank = {
	novice       = 15,
	trainee      = 15,
	experienced  = 30,
	professional = 40,
	veteran      = 50,
	expert       = 60,
	master       = 70,
	legend       = 75,
}

local function get_rank_chance(rank)
	return chance_by_rank[rank or ""] or 0
end

local function should_keep_grenade(rank)
	local chance = get_rank_chance(rank)
	if chance <= 0 then
		return false
	end

	if chance >= 100 then
		return true
	end

	return math.random(100) <= chance
end

local function patch_loadouts()
	if not (xrs_rnd_npc_loadout and xrs_rnd_npc_loadout.create_item_on_npc) then
		return
	end

	if patched and xrs_rnd_npc_loadout.create_item_on_npc == wrapped_create_item_on_npc then
		return
	end

	original_create_item_on_npc = xrs_rnd_npc_loadout.create_item_on_npc

	wrapped_create_item_on_npc = function(se_npc, squad_name, comm, rank, visual, player_id, slot_type)
		if slot_type ~= "extra" then
			return original_create_item_on_npc(se_npc, squad_name, comm, rank, visual, player_id, slot_type)
		end

		if not should_keep_grenade(rank) then
			return nil
		end

		return original_create_item_on_npc(se_npc, squad_name, comm, rank, visual, player_id, slot_type)
	end

	xrs_rnd_npc_loadout.create_item_on_npc = wrapped_create_item_on_npc

	patched = true
end

function on_game_start()
	patch_loadouts()
	if RegisterScriptCallback then
		RegisterScriptCallback("actor_on_first_update", patch_loadouts)
	end
end
