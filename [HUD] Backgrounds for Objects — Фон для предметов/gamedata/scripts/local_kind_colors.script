i_mutant_part       = GetARGB(20,162,0,255),
i_attach            = GetARGB(20,236,0,255),
i_misc              = GetARGB(20,255,255,255),
i_part              = GetARGB(20,255,255,255),
}


local bags = {
    actor_bag = true,
    actor_trade_bag = true,
    npc_bag = true,
    npc_trade_bag = true
}

local function get_color_by_kind(cell)
    if bags[cell.container.ID] and cell.section then
        local kind = SYS_GetParam(0, cell.section, "kind", "na")
        return kind_colors[kind]
    end
end

function on_game_start()
	rax_persistent_highlight.register("item_type_color", get_color_by_kind)
end
