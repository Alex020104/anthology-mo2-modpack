local cfg_path = "items\\settings\\npc_loadouts\\rak_rank_knife_drops.ltx"
local cfg = ini_file(cfg_path)

local settings_sec = "rank_knife_drops_settings"

local cfg_bool

local function log(fmt, ...)
	if cfg_bool(settings_sec, "debug", false) then
		printf("[RAK Rank Knife Drops] " .. fmt, ...)
	end
end

local function trim(s)
	return s and s:gsub("^%s+", ""):gsub("%s+$", "") or nil
end

cfg_bool = function(sec, key, default)
	if not (cfg and cfg:section_exist(sec)) then
		return default
	end

	local value = cfg:r_string_ex(sec, key)
	if value == nil then
		return default
	end

	value = trim(value):lower()
	return value == "true" or value == "1" or value == "yes" or value == "on"
end

local function cfg_num(sec, key, default)
	if not (cfg and cfg:section_exist(sec)) then
		return default
	end

	local value = tonumber(cfg:r_string_ex(sec, key))
	if value == nil then
		return default
	end

	return value
end

local function normalize_chance(value)
	local chance = tonumber(value)
	if chance == nil then
		return nil
	end

	if chance > 1 then
		chance = chance / 100
	end

	if chance < 0 then
		return 0
	elseif chance > 1 then
		return 1
	end

	return chance
end

local function parse_entry(raw)
	local section, chance = raw:match("^%s*([^:=,%s]+)%s*[:=]%s*([%d%.]+)%s*$")
	if not (section and chance) then
		return nil, nil
	end

	return trim(section), normalize_chance(chance)
end

local function get_rank_name(npc)
	if ranks and ranks.get_obj_rank_name then
		local ok, rank_name = pcall(ranks.get_obj_rank_name, npc)
		if ok and rank_name then
			return rank_name
		end
	end

	return "default"
end

local function get_server_object(obj)
	if obj and obj.id and type(obj.id) == "function" then
		return alife_object(obj:id())
	end

	return obj
end

local function get_community_name(npc)
	if npc and character_community then
		local ok, comm = pcall(character_community, npc)
		if ok and comm then
			if comm == "army_npc" then
				return "army"
			elseif comm == "greh_npc" then
				return "greh"
			end

			return comm
		end
	end

	return "default"
end

local function collect_entries(sec, entries)
	if not (cfg and sec and cfg:section_exist(sec)) then
		return false
	end

	local n = cfg:line_count(sec) or 0
	for i = 0, n - 1 do
		local result, id, value = cfg:r_line_ex(sec, i, "", "")
		if result and id and id ~= "" then
			local raw = value and value ~= "" and (id .. ":" .. value) or id
			entries[#entries + 1] = raw
		end
	end

	return true
end

local function collect_rank_entries(rank_name, comm)
	local entries = {}
	local candidates = {
		(comm or "default") .. "_" .. (rank_name or "default") .. "_knife",
		(comm or "default") .. "_default_knife",
		(rank_name or "default") .. "_knife",
		"default_knife",
	}

	for i = 1, #candidates do
		if collect_entries(candidates[i], entries) then
			log("using table [%s] for community [%s] rank [%s], entries [%s]", candidates[i], comm or "nil", rank_name or "nil", #entries)
			return entries
		end
	end

	return nil
end

local function roll_condition()
	local min_cond = cfg_num(settings_sec, "condition_min", 0.45)
	local max_cond = cfg_num(settings_sec, "condition_max", 0.85)

	if max_cond < min_cond then
		min_cond, max_cond = max_cond, min_cond
	end

	return min_cond + (math.random() * (max_cond - min_cond))
end

local function spawn_knife(npc, section)
	if not (ini_sys and ini_sys:section_exist(section)) then
		log("skip missing section [%s]", section)
		return false
	end

	local se_obj = alife_create_item(section, npc, { cond = roll_condition() })
	if se_obj then
		log("spawned [%s] on [%s]", section, npc:name())
		return true
	end

	log("failed to spawn [%s]", section)
	return false
end

local function npc_on_death_callback(npc, who)
	if not cfg_bool(settings_sec, "enabled", true) then
		return
	end

	if not (npc and IsStalker and IsStalker(npc)) then
		return
	end

	local rank_name = get_rank_name(npc)
	local comm = get_community_name(npc)
	local entries = collect_rank_entries(rank_name, comm)
	if not (entries and #entries > 0) then
		log("no drop table for community [%s] rank [%s]", comm, rank_name)
		return
	end

	local drop_one = cfg_bool(settings_sec, "drop_one_per_npc", true)

	for i = 1, #entries do
		local raw = entries[i]
		local section, chance = parse_entry(raw)
		if not (section and chance) then
			log("bad entry [%s]", tostring(raw))
		elseif math.random() <= chance then
			if spawn_knife(npc, section) and drop_one then
				return
			end
		else
			log("roll failed [%s] chance [%s]", section, chance)
		end
	end
end

function on_game_start()
	log("registered")
	RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)
end
