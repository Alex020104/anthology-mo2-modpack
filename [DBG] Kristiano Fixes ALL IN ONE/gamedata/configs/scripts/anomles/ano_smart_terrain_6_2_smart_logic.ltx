[logic@merc_pri_a18_mech_mlr]
suitable = {=check_npc_name(merc_pri_a18_mech_mlr)} true, {=check_npc_mechanic} true
prior = 200
active = animpoint@base1
can_select_weapon = true
level_spot = mechanic
trade = items\trade\trade_generic_mechanic.ltx
dont_keep_items = true

[animpoint@base1]
cover_name = anomles_smart_cover_mlr_tech_merc
use_camp = false
meet = meet
combat_ignore_cond = {=is_warfare} false, {=actor_true_enemy =check_enemy_name(actor)} false, true
combat_ignore_keep_when_attacked = {=is_warfare} false, true
invulnerable = {=is_warfare} false, {!actor_true_enemy} true, false
reach_distance = 10
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info1 = {+awr_merc_pri_a18_mech_mlr_access} animpoint@resting

[animpoint@resting]:animpoint@base1
avail_animations = animpoint_sit_low_drink_vodka
meet = meet	;no_meet
on_game_timer = 2000 | animpoint@base1 %=awr_timer_msg_off%

