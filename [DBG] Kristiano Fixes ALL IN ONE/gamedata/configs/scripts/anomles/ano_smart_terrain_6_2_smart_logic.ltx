;-------------------------------------------------------------------------
[logic@merc_pri_grifon_mlr]
suitable = {=check_npc_name(merc_pri_grifon_mlr)} true
prior = 200
; Anthology Grifon Visibility Fix v1.0.4
; The original dedicated animpoint_stay_wall can intermittently cull Grifon's
; rendered model on Anthology 2.1 / MT-TEST while the NPC stays interactive.
; Keep the same NPC/story object but use a normal upright standing state.
active = remark@grifon_visibility_fix
can_select_weapon = true
level_spot = quest_npc
dont_keep_items = true

[remark@grifon_visibility_fix]
anim = wait
meet = meet
combat_ignore_cond = {=is_warfare} false, {=actor_true_enemy =check_enemy_name(actor)} false, true
combat_ignore_keep_when_attacked = {=is_warfare} false, true
invulnerable = {=is_warfare} false, {!actor_true_enemy} true, false
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false

[meet]
; v1.0.4: keep the stable remark/wait visibility bypass, but let the
; standard meet scheme turn Grifon toward the actor only at close range.
close_anim 		= wait
close_victim 	= actor
far_anim 		= nil
far_victim 		= nil
close_distance  = 5
far_distance 	= 0
close_snd_distance = 3
abuse           = false
use = {=actor_enemy} false, true
allow_break = false
meet_on_talking = false
trade_enable = false

;-------------------------------------------------------------------------
;camping
[meet@bench]
close_anim 		= nil
close_victim 	= nil
far_anim 		= nil
far_victim 		= nil
close_distance  = 0
far_distance 	= 0

