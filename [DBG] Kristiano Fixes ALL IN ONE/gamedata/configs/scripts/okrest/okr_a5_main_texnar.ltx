avail_animations = animpoint_sit_normal
reach_distance = 2
meet = meet@stalker_texnik_meet
on_info1 = {!npc_in_zone(okr_a5_sr_no_light)} %=teleport_npc(okr_a5_texnik_spawn_point)%
on_info2 = {+okr_s1_texnik_dialog_talks -okr_a5_texnik_baza_scena_end_ztk} animpoint@a5_stalker_texnik_scena 
on_info3 = {+okr_a5_texnik_dialog_talks -okr_a5_case_spawn_to_stol} %=okr_a5_spawn_case +okr_a5_case_spawn_to_stol%
out_restr = okr_a5_sr_no_light

[meet@stalker_texnik_meet]:meet@def
; Toolkit hand-in fix + permanent normal interaction in the technician's regular working state.
; Story "where are my tools?" is forced only after the separate story toolkit has actually been found.
meet_dialog	= {+okr_a5_texnik_baza_scena_end_ztk -okr_a5_texnik_open_case_dialog_talks}okr_a5_texnik_open_case_dialog,{=has_task(okr_a5_stalker_texnik_task_1:selected) =has_task_on_stage(okr_a5_stalker_texnik_task_1:1) =actor_has_item(itm_basickit)}dm_ordered_task_completed_dialog,{=has_task(okr_a5_stalker_texnik_task_2:selected) =has_task_on_stage(okr_a5_stalker_texnik_task_2:1) =actor_has_item(itm_advancedkit)}dm_ordered_task_completed_dialog,{=has_task(okr_a5_stalker_texnik_task_3:selected) =has_task_on_stage(okr_a5_stalker_texnik_task_3:1) =actor_has_item(itm_expertkit)}dm_ordered_task_completed_dialog,{-okr_a5_texnik_dialog_talks}okr_a5_texnik_dialog,{+okr_a5_texnik_dialog_talks +okr_s1_actor_give_instr -okr_s1_texnik_dialog_talks}okr_quest_s1_texnik_dialog,okr_stand_hello_texnik_dialog
; Always allow manual conversation in the normal animpoint. Scripted scene section still uses meet = no_meet.
use = true
close_snd_hello = {+okr_a5_texnik_baza_scena_end_ztk}okr_a5_texnik_hello, nil
close_snd_bye = {+okr_a5_texnik_baza_scena_end_ztk}okr_a5_texnik_poka, nil
trade_enable = true
far_snd_distance = 3

[animpoint@a5_stalker_texnik_scena]:animpoint@def
cover_name = okr_a5_texnik_animp
avail_animations = animpoint_sit_normal
reach_distance = 2
meet = no_meet
on_info1 = {!npc_in_zone(okr_a5_sr_no_light)} %=teleport_npc(okr_a5_texnik_spawn_point)%
on_game_timer2 = 62 | {+okr_a5_stol_texnik_reached_anim -okr_a5_texnik_baza_scena_end_ztk} %+okr_a5_texnik_baza_scena_end_ztk%
on_info3 = {+okr_a5_texnik_baza_scena_end_ztk} animpoint@a5_stalker_texnik 
on_info4 = {-okr_a5_instr_spawn_to_stol} %=play_sound(okr_a5_texnik_case_say) =okr_a5_spawn_instr +okr_a5_instr_spawn_to_stol%
on_info6 = {=animpoint_reached -okr_a5_stol_texnik_reached_anim} %+okr_a5_stol_texnik_reached_anim%
out_restr = okr_a5_sr_no_light
