--------------------------------------------------------------------------------
-- Space restrictor scheme for crowkiller minigame -----------------------------
-- Made by Peacemaker ----------------------------------------------------------
-- 26.12.07 --------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Anthology Busy Hands Stability Fix v0.4.8:
-- direct core replacement. The original ptr:level_vertex_id(0) can throw a
-- native Lua error on custom levels after loading/transition. This version
-- validates the patrol's game vertex and resolves the current level vertex from
-- the patrol point before spawning the cosmetic crow.
ANTHOLOGY_BUSYHANDS_CROW_FIX_VERSION = "0.4.8-beta-hotfix"

local INVALID_VERTEX_ID = 4294967295
local BAD_PATH_RETRY_MS = 300000
local SPAWN_POINT_IDLE_MS = 10000
local MIN_ACTOR_DIST_SQR = 10000
local reported_bad_paths = {}

local function valid_vertex_id(value)
    local number_value = tonumber(value)
    return number_value and number_value >= 0 and number_value < INVALID_VERTEX_ID
end

local function mark_path_idle(self, path_name, delay)
    if self and type(self.spawn_points_idle) == "table" and path_name then
        self.spawn_points_idle[path_name] = time_global() + delay
    end
end

local function report_bad_path(path_name, reason)
    local key = tostring(path_name) .. ":" .. tostring(reason)
    if reported_bad_paths[key] then
        return
    end

    printf(
        "[BusyHandsFix v0.4.8] Crow spawn skipped safely: path=%s reason=%s",
        tostring(path_name),
        tostring(reason)
    )
    reported_bad_paths[key] = true
end

printf("[BusyHandsFix v0.4.8] Patched sr_crow_spawner core loaded")

class "crowkiller"
-- Class constructor
function crowkiller:__init(obj, storage)
    self.object = obj
    self.st = storage
    self.time_for_spawn = time_global()
    self.spawn_points_idle = {}
    self.spawned_count = nil
end
-- On scheme switch resets all self params
function crowkiller:reset_scheme()
    for k,v in pairs(self.st.path_table) do
        self.spawn_points_idle[v] = time_global()
    end
end
-- Class update
function crowkiller:update(delta)
-- check for spawn crows on level
    if(self.time_for_spawn<time_global()) then
        self.spawned_count = bind_crow.crow_counter
        local surge_or_storm = (surge_manager.is_started() and not surge_manager.is_finished()) or (psi_storm_manager.is_started() and not psi_storm_manager.is_finished())
        if(not surge_or_storm and self.spawned_count<self.st.max_crows_on_level) then
            self:check_for_spawn_new_crow()
        else
            self.time_for_spawn = time_global() + 120000
        end
    end

    if(xr_logic.try_switch_to_another_section(self.object, self.st, db.actor)) then
        return
    end
end
-- Checks a need for spawn a new crow
function crowkiller:check_for_spawn_new_crow()
    local path_table = self and self.st and self.st.path_table
    if type(path_table) ~= "table" or #path_table == 0 then
        return false
    end

    local selected_path = path_table[math.random(1, #path_table)]
    if type(selected_path) ~= "string" or selected_path == "" then
        return false
    end

    local tg = time_global()
    if type(self.spawn_points_idle) == "table"
    and self.spawn_points_idle[selected_path]
    and tg <= self.spawn_points_idle[selected_path] then
        return false
    end

    if level.patrol_path_exists and not level.patrol_path_exists(selected_path) then
        mark_path_idle(self, selected_path, BAD_PATH_RETRY_MS)
        report_bad_path(selected_path, "patrol path is absent on current level")
        return false
    end

    local ptr = patrol(selected_path)
    if not ptr or ptr:count() <= 0 then
        mark_path_idle(self, selected_path, BAD_PATH_RETRY_MS)
        report_bad_path(selected_path, "patrol path has no points")
        return false
    end

    local pos = ptr:point(0)
    if not pos then
        mark_path_idle(self, selected_path, BAD_PATH_RETRY_MS)
        report_bad_path(selected_path, "patrol point is unavailable")
        return false
    end

    local actor = db and db.actor
    if not actor then
        return false
    end

    local graph = game_graph()
    if not graph then
        mark_path_idle(self, selected_path, BAD_PATH_RETRY_MS)
        report_bad_path(selected_path, "game graph is unavailable")
        return false
    end

    -- The game vertex is global graph data. It can be checked without touching
    -- the current level graph, unlike patrol:level_vertex_id(0).
    local gvid = ptr:game_vertex_id(0)
    if not valid_vertex_id(gvid) or not graph:valid_vertex_id(gvid) then
        mark_path_idle(self, selected_path, BAD_PATH_RETRY_MS)
        report_bad_path(selected_path, "invalid game vertex")
        return false
    end

    local actor_gvid = actor:game_vertex_id()
    if not valid_vertex_id(actor_gvid) or not graph:valid_vertex_id(actor_gvid) then
        return false
    end

    local path_vertex = graph:vertex(gvid)
    local actor_vertex = graph:vertex(actor_gvid)
    local path_level_id = path_vertex and path_vertex:level_id() or nil
    local actor_level_id = actor_vertex and actor_vertex:level_id() or nil

    if not path_level_id or not actor_level_id or path_level_id ~= actor_level_id then
        mark_path_idle(self, selected_path, BAD_PATH_RETRY_MS)
        report_bad_path(selected_path, "patrol belongs to another or unready level")
        return false
    end

    -- Never call ptr:level_vertex_id(0). Resolve the local vertex only after the
    -- game vertex proves that the patrol belongs to the actor's current level.
    local lvid = level.vertex_id(pos)
    if not valid_vertex_id(lvid) then
        mark_path_idle(self, selected_path, BAD_PATH_RETRY_MS)
        report_bad_path(selected_path, "current level vertex is invalid")
        return false
    end

    local actor_pos = actor:position()
    if actor_pos and pos:distance_to_sqr(actor_pos) <= MIN_ACTOR_DIST_SQR then
        return false
    end

    mark_path_idle(self, selected_path, SPAWN_POINT_IDLE_MS)
    alife_create("m_crow", pos, lvid, gvid)
    return true
end
--------------------------------------------------------------------------------
-- Standart functions
--------------------------------------------------------------------------------
function add_to_binder(npc, ini, scheme, section, storage)
    xr_logic.subscribe_action_for_events(npc, storage, crowkiller(npc, storage))
end
function set_scheme(obj, ini, scheme, section, gulag_name)
    local st = xr_logic.assign_storage_and_bind(obj, ini, scheme, section)
    st.logic = xr_logic.cfg_get_switch_conditions(ini, section, obj)

    st.max_crows_on_level = ini:r_float_ex(section,"max_crows_on_level") or 7

    local path = ini:r_string_ex(section,"spawn_path")
    st.path_table = path and parse_names(path) or nil
end
