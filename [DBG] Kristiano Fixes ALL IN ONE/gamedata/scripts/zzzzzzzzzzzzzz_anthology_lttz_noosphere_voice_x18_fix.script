-- Anthology LTTZ Noosphere Voice X18 Fix
-- Repairs missing exclusive jobs on dar_control_poltergeist and recovers saves
-- stuck after killing one of the Dark Presence apparitions.

local VERSION = "1.0.1-beta"
local PREFIX = "[NoosphereVoiceX18Fix " .. VERSION .. "]"

local state = {
    callbacks_registered = false,
    ready_at = 0,
    next_check = 0,
    missing_checks = {},
    recovery_active = false
}

local stages = {
    {
        spawn = "stalker_stitch_zombied_spawn",
        story = "stalker_stitch_zombied",
        done = "stalker_stitch_zombied_despawn"
    },
    {
        spawn = "stalker_rogue_monolith_spawn",
        story = "stalker_rogue_monolith",
        done = "stalker_rogue_monolith_despawn"
    },
    {
        spawn = "army_degtyarev_dark_spawn",
        story = "army_degtyarev_dark",
        done = "army_degtyarev_dark_despawn"
    },
    {
        spawn = "stalker_strelok_dark_spawn",
        story = "stalker_strelok_dark",
        done = "stalker_strelok_dark_despawn"
    },
    {
        spawn = "monolith_eidolon_ghost_spawn",
        story = "monolith_eidolon_ghost",
        done = "monolith_eidolon_ghost_despawn"
    },
    {
        spawn = "greh_sabaoth_ghost_squad_spawn",
        story = "greh_sabaoth_ghost",
        done = "greh_sabaoth_ghost_despawn"
    },
    {
        spawn = "x18_dark_presence_final_squad_spawn",
        story = "x18_dark_presence_final",
        done = "x18_dark_presence_final_dead",
        final = true
    }
}

local death_flags = {
    stalker_stitch_zombied = {
        spawn = "stalker_stitch_zombied_spawn",
        done = "stalker_stitch_zombied_despawn"
    },
    stalker_rogue_monolith = {
        spawn = "stalker_rogue_monolith_spawn",
        done = "stalker_rogue_monolith_despawn"
    },
    army_degtyarev_dark = {
        spawn = "army_degtyarev_dark_spawn",
        done = "army_degtyarev_dark_despawn"
    },
    stalker_strelok_dark = {
        spawn = "stalker_strelok_dark_spawn",
        done = "stalker_strelok_dark_despawn"
    },
    monolith_eidolon_ghost = {
        spawn = "monolith_eidolon_ghost_spawn",
        done = "monolith_eidolon_ghost_despawn"
    },
    greh_sabaoth_ghost = {
        spawn = "greh_sabaoth_ghost_squad_spawn",
        done = "greh_sabaoth_ghost_despawn"
    }
}

local function log(fmt, ...)
    local ok, msg = pcall(string.format, fmt, ...)
    if not ok then
        msg = tostring(fmt)
    end

    if type(printf) == "function" then
        printf("%s %s", PREFIX, msg)
    else
        print(PREFIX .. " " .. msg)
    end
end

local function now_ms()
    local ok, value = pcall(time_global)
    return ok and tonumber(value) or 0
end

local function has_info(info)
    if not info or type(has_alife_info) ~= "function" then
        return false
    end

    local ok, value = pcall(has_alife_info, info)
    return ok and value == true
end

local function give_info_safe(info, reason)
    if not info or has_info(info) then
        return false
    end

    local ok = false
    if type(give_info) == "function" then
        ok = pcall(give_info, info)
    elseif db and db.actor then
        ok = pcall(function()
            db.actor:give_info_portion(info)
        end)
    end

    if ok then
        log("%s -> +%s", tostring(reason or "repair"), tostring(info))
        return true
    end

    log("ERROR: failed to give info %s", tostring(info))
    return false
end

local function current_level_is_x18()
    if not level or type(level.name) ~= "function" then
        return false
    end

    local ok, name = pcall(level.name)
    return ok and name == "l04u_labx18"
end

local function quest_is_repairable()
    return db
        and db.actor
        and current_level_is_x18()
        and has_info("lttz_dp_active")
        and has_info("x18_dark_presence_dialog")
        and not has_info("lttz_dp_noosphere_voice_complete")
        and not has_info("x18_dark_presence_final_dead")
end

local function safe_story_squad(story_id)
    if type(get_story_squad) ~= "function" then
        return nil
    end

    local ok, squad = pcall(get_story_squad, story_id)
    return ok and squad or nil
end

local function safe_npc_count(squad)
    if not squad then
        return nil
    end

    local ok, count = pcall(function()
        return squad:npc_count()
    end)
    return ok and tonumber(count) or nil
end

local function safe_member_id(member)
    if not member then
        return nil
    end

    local ok, id = pcall(function()
        if type(member.id) == "function" then
            return member:id()
        end
        return member.id
    end)

    return ok and tonumber(id) or nil
end

local function object_alive_by_id(id)
    id = tonumber(id)
    if not id then
        return nil
    end

    local online = nil
    if level and type(level.object_by_id) == "function" then
        local ok, value = pcall(level.object_by_id, id)
        if ok then
            online = value
        end
    end

    if online then
        local ok, alive = pcall(function()
            return online:alive()
        end)
        if ok then
            return alive == true
        end
    end

    local sim = nil
    if type(alife) == "function" then
        local ok, value = pcall(alife)
        if ok then
            sim = value
        end
    end

    if sim then
        local ok_obj, se_obj = pcall(function()
            return sim:object(id)
        end)
        if ok_obj and se_obj then
            local ok_alive, alive = pcall(function()
                return se_obj:alive()
            end)
            if ok_alive then
                return alive == true
            end
        end
    end

    return nil
end

-- Returns: "alive", "dead", "empty", or "unknown".
local function squad_state(squad)
    if not squad then
        return "missing"
    end

    local count = safe_npc_count(squad)
    if count == 0 then
        return "empty"
    end

    local checked = 0
    local alive_found = false
    local ok = pcall(function()
        for member in squad:squad_members() do
            local id = safe_member_id(member)
            local alive = object_alive_by_id(id)
            if alive ~= nil then
                checked = checked + 1
                if alive then
                    alive_found = true
                    break
                end
            end
        end
    end)

    if not ok then
        return "unknown"
    end
    if alive_found then
        return "alive"
    end
    if checked > 0 then
        return "dead"
    end
    if count and count > 0 then
        return "unknown"
    end
    return "empty"
end

local function recover_stage(stage)
    if not has_info(stage.spawn) or has_info(stage.done) then
        state.missing_checks[stage.story] = 0
        return false
    end

    local squad = safe_story_squad(stage.story)
    local status = squad_state(squad)

    if status == "alive" or status == "unknown" then
        state.missing_checks[stage.story] = 0
        return false
    end

    if status == "missing" then
        local misses = (state.missing_checks[stage.story] or 0) + 1
        state.missing_checks[stage.story] = misses
        if misses < 3 then
            return false
        end
    else
        state.missing_checks[stage.story] = 0
    end

    local reason = string.format(
        "RECOVERY story=%s state=%s",
        tostring(stage.story),
        tostring(status)
    )
    return give_info_safe(stage.done, reason)
end

local function run_recovery()
    if not quest_is_repairable() then
        state.recovery_active = false
        return
    end

    -- Repair only the first unresolved, already spawned stage. This prevents
    -- skipping a living apparition or advancing several stages in one tick.
    for _, stage in ipairs(stages) do
        if has_info(stage.spawn) and not has_info(stage.done) then
            local repaired = recover_stage(stage)

            -- Recovery is needed only for a stage already broken in the save.
            -- If it was repaired, or the stage has a live/valid squad, the
            -- death callback and the restored smart-terrain logic take over.
            -- Keep polling only while a missing squad is being confirmed.
            if repaired or (state.missing_checks[stage.story] or 0) == 0 then
                state.recovery_active = false
            end
            return
        end
    end

    state.recovery_active = false
end

local function arm_recovery(delay_ms)
    local now = now_ms()
    state.ready_at = now + (tonumber(delay_ms) or 8000)
    state.next_check = state.ready_at
    state.missing_checks = {}
    state.recovery_active = true
end

local function actor_on_update()
    if not state.recovery_active then
        return
    end

    local now = now_ms()
    if now < state.ready_at or now < state.next_check then
        return
    end

    state.next_check = now + 2000
    run_recovery()
end

local function actor_on_first_update()
    -- Do not leave a time_global()/recovery poll running after the quest is
    -- complete or while the actor is outside the affected X18 stage.
    if quest_is_repairable() then
        arm_recovery(3000)
    else
        state.recovery_active = false
    end
end

local function on_game_load()
    arm_recovery(8000)
end

local function victim_section(victim)
    if not victim then
        return nil
    end

    local ok, section = pcall(function()
        return victim:section()
    end)
    return ok and section or nil
end

local function final_squad_matches(victim)
    if not victim or type(get_object_squad) ~= "function" then
        return false
    end

    local ok, squad = pcall(get_object_squad, victim)
    if not ok or not squad then
        return false
    end

    local ok_sec, section = pcall(function()
        return squad:section_name()
    end)
    return ok_sec and section == "x18_dark_presence_final_squad"
end

local function npc_on_death_callback(victim, killer)
    if not quest_is_repairable() then
        return
    end

    local section = victim_section(victim)
    local flags = section and death_flags[section]
    if flags
        and has_info(flags.spawn)
        and not has_info(flags.done)
    then
        give_info_safe(
            flags.done,
            "DEATH FALLBACK section=" .. tostring(section)
        )
        return
    end

    if section == "m_poltergeist_normal_black"
        and has_info("x18_dark_presence_final_squad_spawn")
        and not has_info("x18_dark_presence_final_dead")
        and final_squad_matches(victim)
    then
        give_info_safe(
            "x18_dark_presence_final_dead",
            "DEATH FALLBACK final squad"
        )
        state.recovery_active = false
    end
end

function on_game_start()
    if state.callbacks_registered then
        return
    end

    state.callbacks_registered = true
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("on_game_load", on_game_load)
    RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)

    arm_recovery(8000)
    log("loaded; smart exclusive jobs=9; recovery=one-shot")
end
