-- Anthology Busy Hands Stability Fix v0.4.8 Beta Hotfix
local VERSION = "0.4.8-beta-hotfix"
local installed = false

-- X-Ray can keep a destroyed CScriptGameObject as non-nil Lua userdata.
-- Calling any native method on that userdata raises "Accessing destroyed object".
local function safe_object_id(obj)
    local obj_id

    if type(obj) == "number" then
        obj_id = math.floor(obj)
    else
        if not obj then
            return nil
        end

        local ok
        ok, obj_id = pcall(function()
            return obj:id()
        end)
        if not ok then
            return nil
        end
    end

    -- Destroyed X-Ray userdata commonly reports 0. Lua treats 0 as true.
    if type(obj_id) ~= "number" or obj_id <= 0 or obj_id >= 65535 then
        return nil
    end

    if not level.object_by_id(obj_id) then
        return nil
    end

    return obj_id
end

local function log_cancel(source)
    printf("[BusyHandsFix v0.4.8] %s cancelled: object was nil or destroyed", source)
end

local function install_trader_guards()
    local installed_count = 0

    if trade_manager and trade_manager.update then
        local original_trade_manager_update = trade_manager.update
        trade_manager.update = function(npc, ...)
            if not safe_object_id(npc) then
                log_cancel("trade_manager.update")
                return
            end
            return original_trade_manager_update(npc, ...)
        end
        installed_count = installed_count + 1
    end

    if trader_autoinject and trader_autoinject.update then
        local original_trader_update = trader_autoinject.update
        trader_autoinject.update = function(npc, ...)
            if not safe_object_id(npc) then
                log_cancel("trader_autoinject.update")
                return
            end
            return original_trader_update(npc, ...)
        end
        installed_count = installed_count + 1
    end

    if trader_autoinject and trader_autoinject.timed_update then
        local original_timed_update = trader_autoinject.timed_update
        trader_autoinject.timed_update = function(npc, ...)
            if not safe_object_id(npc) then
                log_cancel("trader_autoinject.timed_update")
                return true
            end
            return original_timed_update(npc, ...)
        end
        installed_count = installed_count + 1
    end

    if trader_autoinject and trader_autoinject.get_trader_type then
        local original_get_trader_type = trader_autoinject.get_trader_type
        trader_autoinject.get_trader_type = function(npc, ...)
            if not safe_object_id(npc) then
                return -1
            end
            return original_get_trader_type(npc, ...)
        end
        installed_count = installed_count + 1
    end

    if trader_autoinject and trader_autoinject.supply_level then
        local original_supply_level = trader_autoinject.supply_level
        trader_autoinject.supply_level = function(npc, ...)
            if not safe_object_id(npc) then
                return nil
            end
            return original_supply_level(npc, ...)
        end
        installed_count = installed_count + 1
    end

    if trader_autoinject and trader_autoinject.spawn_items then
        local original_spawn_items = trader_autoinject.spawn_items
        trader_autoinject.spawn_items = function(npc, ...)
            if not safe_object_id(npc) then
                log_cancel("trader_autoinject.spawn_items")
                return
            end
            return original_spawn_items(npc, ...)
        end
        installed_count = installed_count + 1
    end

    if western_goods_utils and western_goods_utils.get_real_community then
        local original_get_real_community = western_goods_utils.get_real_community
        western_goods_utils.get_real_community = function(npc, default, ...)
            if not safe_object_id(npc) then
                log_cancel("western_goods_utils.get_real_community")
                return default
            end
            return original_get_real_community(npc, default, ...)
        end
        installed_count = installed_count + 1
    end

    if western_goods_loot and western_goods_loot.spawn_trader_loot then
        local original_spawn_trader_loot = western_goods_loot.spawn_trader_loot
        western_goods_loot.spawn_trader_loot = function(npc, ...)
            if not safe_object_id(npc) then
                log_cancel("western_goods_loot.spawn_trader_loot")
                return
            end
            return original_spawn_trader_loot(npc, ...)
        end
        installed_count = installed_count + 1
    end

    return installed_count
end

-- v0.4.8 retains the v0.4.7 direct crow-spawner replacement. A loose,
-- patched sr_crow_spawner.script replaces the archived core file before any
-- restrictor instances are created. This verification only confirms that the
-- replacement module won the VFS conflict.
local function install_crow_spawner_guard()
    local module = _G["sr_crow_spawner"]
    if type(module) == "table"
    and module.ANTHOLOGY_BUSYHANDS_CROW_FIX_VERSION == VERSION then
        printf("[BusyHandsFix v0.4.8] Crow spawner guard mode: loose core replacement")
        return 1
    end

    printf("[BusyHandsFix v0.4.8] Patched sr_crow_spawner core was not detected")
    return 0
end

local function verify_mon_sleep_guard()
    local module = _G["mon_sleep"]
    if type(module) == "table"
    and module.ANTHOLOGY_BUSYHANDS_MON_SLEEP_FIX_VERSION == VERSION then
        printf("[BusyHandsFix v0.4.8] mon_sleep guard mode: loose core replacement")
        return 1
    end

    printf("[BusyHandsFix v0.4.8] Patched mon_sleep core was not detected")
    return 0
end

function on_game_start()
    printf("[BusyHandsFix] Anthology Busy Hands Stability Fix %s loaded", VERSION)

    if installed then
        return
    end
    installed = true

    local guard_count = install_trader_guards()
    local crow_guard_count = install_crow_spawner_guard()
    local mon_sleep_guard_count = verify_mon_sleep_guard()

    printf("[BusyHandsFix v0.4.8] Trader/Western Goods guards installed: %s", guard_count)
    printf("[BusyHandsFix v0.4.8] Crow spawner guards installed: %s", crow_guard_count)
    printf("[BusyHandsFix v0.4.8] mon_sleep guards installed: %s", mon_sleep_guard_count)
end
