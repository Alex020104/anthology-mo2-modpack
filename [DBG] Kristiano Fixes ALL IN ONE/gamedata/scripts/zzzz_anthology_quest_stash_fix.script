-- Anthology 2.1 quest stash repair v1.4
-- 1) Keeps the safe v1.1 exact target blacklist.
-- 2) Repairs active Anthology stash tasks (types 1001-1038) whose pending
--    treasure cache was consumed while their quest item section was missing.
-- The item sections themselves are restored by items_zz_anthology_quest_stash_fix.ltx.

local TAG = "[quest_stash_fix_v14]"
local installed = false
local pending_boxes = {}
local repaired_tasks = {}
local scan_until = 0
local next_scan = 0

local legacy_task_sections = {
    ["jup_b6_scientist_biochemist_task_3"] = "drx_sl_quest_item_1002", -- legacy stash_type=1
    ["jup_a6_duty_leader_task_4"] = "drx_sl_quest_item_1003", -- legacy stash_type=3
    ["jup_a6_freedom_leader_task_4"] = "drx_sl_quest_item_1004", -- legacy stash_type=2
    ["zat_b106_stalker_gonta_task_2"] = "drx_sl_quest_item_1005", -- legacy stash_type=3
    ["jup_a6_stalker_barmen_task_2"] = "drx_sl_quest_item_1006", -- legacy stash_type=3
    ["zat_a2_stalker_nimble_task_8"] = "drx_sl_quest_item_1007", -- legacy stash_type=3
    ["zat_b30_owl_stalker_trader_task_2"] = "drx_sl_quest_item_1008", -- legacy stash_type=3
    ["zat_b103_lost_merc_leader_task_4"] = "drx_sl_quest_item_1009", -- legacy stash_type=2
    ["jup_a10_bandit_leader_task_4"] = "drx_sl_quest_item_1010", -- legacy stash_type=4
    ["jup_a12_bandit_chief_task_4"] = "drx_sl_quest_item_1011", -- legacy stash_type=5
    ["mil_svoboda_master_max_task_12"] = "drx_sl_quest_item_1012", -- legacy stash_type=5
    ["mil_svoboda_cook_task_2"] = "drx_sl_quest_item_1013", -- legacy stash_type=7
    ["bar_npc_dolg_svayzist_task_4"] = "drx_sl_quest_item_1014", -- legacy stash_type=6
    ["bar_informator_mlr_task_2"] = "drx_sl_quest_item_1015", -- legacy stash_type=3
    ["esc_2_12_stalker_fanat_task_10"] = "drx_sl_quest_item_1016", -- legacy stash_type=2
    ["esc_2_12_stalker_wolf_task_10"] = "drx_sl_quest_item_1017", -- legacy stash_type=1
    ["esc_m_trader_task_5"] = "drx_sl_quest_item_1018", -- legacy stash_type=3
    ["esc_main_base_trader_mlr_task_9"] = "drx_sl_quest_item_1019", -- legacy stash_type=2
    ["gar_bandit_leader_task_4"] = "drx_sl_quest_item_1020", -- legacy stash_type=2
    ["gar_bandit_trader_task_4"] = "drx_sl_quest_item_1021", -- legacy stash_type=2
    ["ratniy_task_8"] = "drx_sl_quest_item_1022", -- legacy stash_type=2
    ["seven_task_8"] = "drx_sl_quest_item_1023", -- legacy stash_type=2
    ["sys_sergei_task_8"] = "drx_sl_quest_item_1024", -- legacy stash_type=2
    ["vanta_task_8"] = "drx_sl_quest_item_1025", -- legacy stash_type=2
    ["chimik_task_5"] = "drx_sl_quest_item_1026", -- legacy stash_type=2
    ["shura_task_8"] = "drx_sl_quest_item_1027", -- legacy stash_type=2
    ["fenix_task_2"] = "drx_sl_quest_item_1028", -- legacy stash_type=2
    ["daynega_task_8"] = "drx_sl_quest_item_1029", -- legacy stash_type=2
    ["eloquent_task_4"] = "drx_sl_quest_item_1030", -- legacy stash_type=2
    ["dmitrov_kirill_task_8"] = "drx_sl_quest_item_1031", -- legacy stash_type=3
    ["evkor_task_4"] = "drx_sl_quest_item_1032", -- legacy stash_type=2
    ["mar_smart_terrain_10_5_renegade_leader_task_4"] = "drx_sl_quest_item_1033", -- legacy stash_type=3
    ["mar_smart_terrain_10_5_renegade_trader_task_2"] = "drx_sl_quest_item_1034", -- legacy stash_type=2
    ["red_greh_trader_task_2"] = "drx_sl_quest_item_1035", -- legacy stash_type=2
    ["red_greh_medic_task_5"] = "drx_sl_quest_item_1036", -- legacy stash_type=3
    ["yan_fort_milstalk_trader_task_8"] = "drx_sl_quest_item_1037", -- legacy stash_type=1
    ["rosf_isg_trader_task_5"] = "drx_sl_quest_item_1038", -- legacy stash_type=2
