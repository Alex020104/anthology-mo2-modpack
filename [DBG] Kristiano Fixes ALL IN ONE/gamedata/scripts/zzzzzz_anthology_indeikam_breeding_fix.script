-- Anthology Indeikam Breeding Fix v1.0.7
-- Diagnostic only. Definitions are loaded from:
-- gamedata\configs\mod_system_anthology_indeikam_breeding_fix.ltx

local VERSION = "1.0.7"

local function yn(value)
    return value and "yes" or "no"
end

local function read_float(ini, section, key)
    if not ini or not ini:section_exist(section) or not ini:line_exist(section, key) then
        return "missing"
    end

    local ok, value = pcall(function()
        return ini:r_float(section, key)
    end)

    return ok and tostring(value) or "read_error"
end

local function read_string(ini, section, key)
    if not ini or not ini:section_exist(section) or not ini:line_exist(section, key) then
        return "missing"
    end

    local ok, value = pcall(function()
        return ini:r_string(section, key)
    end)

    return ok and tostring(value) or "read_error"
end

function on_game_start()
    local ini = system_ini()
    local s1 = ini and ini:section_exist("af_indeikam_breeding_1")
    local s2 = ini and ini:section_exist("af_indeikam_breeding_2")
    local s3 = ini and ini:section_exist("af_indeikam_breeding_3")

    printf(
        "[IndeikamBreedingFix v%s] sections loaded: breeding_1=%s breeding_2=%s breeding_3=%s",
        VERSION,
        yn(s1),
        yn(s2),
        yn(s3)
    )

    printf(
        "[IndeikamBreedingFix v%s] values: b1_rad=%s b2_weight=%s b3_health=%s b3_power=%s",
        VERSION,
        read_float(ini, "af_indeikam_breeding_1", "radiation_restore_speed"),
        read_float(ini, "af_indeikam_breeding_2", "additional_inventory_weight"),
        read_float(ini, "af_indeikam_breeding_3", "health_restore_speed"),
        read_float(ini, "af_indeikam_breeding_3", "power_restore_speed")
    )

    printf(
        "[IndeikamBreedingFix v%s] name keys: af_indeikam=%s af_indeikam3=%s",
        VERSION,
        read_string(ini, "af_indeikam", "inv_name"),
        read_string(ini, "af_indeikam3", "inv_name")
    )

    printf(
        "[IndeikamBreedingFix v%s] container keys: iam=%s aac=%s aam=%s llmc=%s",
        VERSION,
        read_string(ini, "af_indeikam3_af_iam", "inv_name"),
        read_string(ini, "af_indeikam3_af_aac", "inv_name"),
        read_string(ini, "af_indeikam3_af_aam", "inv_name"),
        read_string(ini, "af_indeikam3_lead_box", "inv_name")
    )
end
