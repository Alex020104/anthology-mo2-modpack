--[[
    Anthology Ashot Army Warehouses Travel Fix v1.0.5 BETA

    Exact issue confirmed by runtime trace:
      western_goods_guide.script:85-93 calls ChangeLevel with the obsolete
      destination signature:
        level vertex = 281438
        game vertex  = 2093
        position     = -11.5322, -8.5719, -21.651699
      In Anthology 2.1 this resolves to l04u_labx18.

    This patch does not replace Western Goods and does not touch other routes.
    It intercepts only that exact Western Goods transition from Jupiter and
    rewrites it to the current Anthology smart terrain mil_smart_terrain_7_7.
--]]

local VERSION = "1.0.5-beta"
local PREFIX = "[AshotWarehousesFix " .. VERSION .. "]"

local BAD_LVID = 281438
local BAD_GVID = 2093
local BAD_X = -11.532200
local BAD_Y = -8.571900
local BAD_Z = -21.651699

local TARGET_SMART = "mil_smart_terrain_7_7"

local function log(fmt, ...)
    if type(printf) == "function" then
        printf(PREFIX .. " " .. fmt, ...)
    end
end

local function current_level_name()
    if type(level) == "table" and type(level.name) == "function" then
        local ok, value = pcall(level.name)
        if ok then
            return value
        end
    end
    return nil
end

local function get_callstack()
    if type(callstack) == "function" then
        local ok, value = pcall(callstack, false, true)
        if ok and value then
            return tostring(value)
        end
    end

    if debug and type(debug.traceback) == "function" then
        local ok, value = pcall(debug.traceback, "", 3)
        if ok and value then
            return tostring(value)
        end
    end

    return ""
end

local function caller_is_western_goods_guide()
    local stack = get_callstack()
    return string.find(stack, "western_goods_guide.script", 1, true) ~= nil
end

local function approximately(value, expected)
    return type(value) == "number" and math.abs(value - expected) < 0.05
end

local function position_matches(pos)
    if not pos then
        return false
    end

    local ok, result = pcall(function()
        return approximately(pos.x, BAD_X)
            and approximately(pos.y, BAD_Y)
            and approximately(pos.z, BAD_Z)
    end)

    return ok and result or false
end

local function resolve_level_name(gvid)
    local ok, destination = pcall(function()
        local graph = game_graph()
        local vertex = graph and graph:vertex(gvid) or nil
        local level_id = vertex and vertex:level_id() or nil
        return level_id ~= nil and alife():level_name(level_id) or nil
    end)

    return ok and destination or nil
end

local function is_exact_bad_route(pos, lvid, gvid)
    if current_level_name() ~= "jupiter" then
        return false
    end

    if tonumber(lvid) ~= BAD_LVID or tonumber(gvid) ~= BAD_GVID then
        return false
    end

    if not position_matches(pos) then
        return false
    end

    local destination = resolve_level_name(gvid)
    if destination ~= "l04u_labx18" then
        return false
    end

    return caller_is_western_goods_guide()
end

local function resolve_target()
    local registry = SIMBOARD and SIMBOARD.smarts_by_names
    local smart = registry and registry[TARGET_SMART] or nil

    if not smart
    or not smart.position
    or smart.m_level_vertex_id == nil
    or smart.m_game_vertex_id == nil then
        return nil, "smart terrain is unavailable"
    end

    local destination = resolve_level_name(smart.m_game_vertex_id)
    if destination ~= "military" and destination ~= "l07_military" then
        return nil, "smart terrain resolves to " .. tostring(destination)
    end

    return smart, destination
end

local function install()
    local current = _G.ChangeLevel
    if type(current) ~= "function" then
        log("ERROR: global ChangeLevel is unavailable")
        return false
    end

    if current == _G.__anthology_ashot_wg_changelevel_wrapper then
        return true
    end

    local original = current

    local wrapper = function(pos, lvid, gvid, angle, anim, ...)
        if is_exact_bad_route(pos, lvid, gvid) then
            log(
                "intercepted Western Goods obsolete route: source=jupiter destination=l04u_labx18 lvid=%s gvid=%s",
                tostring(lvid),
                tostring(gvid)
            )

            local smart, destination_or_error = resolve_target()
            if not smart then
                log(
                    "ERROR: cannot resolve %s (%s); transition cancelled to prevent X-18 teleport",
                    TARGET_SMART,
                    tostring(destination_or_error)
                )
                return false
            end

            local target_angle = vector():set(0, 0, 0)

            log(
                "redirecting to smart=%s destination=%s lvid=%s gvid=%s pos=%.3f,%.3f,%.3f",
                TARGET_SMART,
                tostring(destination_or_error),
                tostring(smart.m_level_vertex_id),
                tostring(smart.m_game_vertex_id),
                smart.position.x,
                smart.position.y,
                smart.position.z
            )

            return original(
                smart.position,
                smart.m_level_vertex_id,
                smart.m_game_vertex_id,
                target_angle,
                anim,
                ...
            )
        end

        return original(pos, lvid, gvid, angle, anim, ...)
    end

    _G.__anthology_ashot_wg_changelevel_wrapper = wrapper
    _G.ChangeLevel = wrapper

    log(
        "installed exact Western Goods route guard: bad(lvid=%d,gvid=%d) -> %s",
        BAD_LVID,
        BAD_GVID,
        TARGET_SMART
    )

    return true
end

function actor_on_first_update()
    install()
end

function on_game_start()
    install()

    if type(RegisterScriptCallback) == "function" then
        RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    end
end

install()
