-- =======================================================================
--[[    Interaction Dot Marks ("DotMarks")
-- =======================================================================
		CONTAINER INTERACTION CONTROL - LOOT WINDOW MONKEYPATCH

    Intercepts attempts to open a loot window for a container, and checks
    for conditions that would block access to an inventory container.

    Unless that one specific runtime flag is on, all other calls will be
    passed through untouched.
-- =====================================================================]]
local base_ui_inventory_start = ui_inventory.start

-- Anthology Busy Hands Stability Fix v0.2
local function busyhands_safe_container_info(obj)
   if not obj then return nil, nil, nil, false end
   local ok, sec, name, id = pcall(function()
      return obj:section(), obj:name(), obj:id()
   end)
   if not ok then return nil, nil, nil, false end
   return sec, name, id, true
end

local function busyhands_is_living_stalker(obj)
   if not obj then return false end
   local ok, value = pcall(function() return IsStalker(obj) and obj:alive() end)
   return ok and value or false
end

function ui_inventory.start(mode, obj)
   local idm   = ui_hud_dotmarks
   local dm    = dotmarks_main
   local sec, obj_name, obj_id, obj_valid = busyhands_safe_container_info(obj)
   local log   = (DEV_DEBUG or (idm and idm.debuglogs))
   local _     = log and printf("[%s] Trying to start inventory in %s mode for container %s (%s)", time_global(), mode, obj_name, obj_id)

   -- A nil object is normal for the player's own inventory, but a loot-mode
   -- object must be valid. Do not forward destroyed userdata to later patches.
   if mode == "loot" and not obj_valid then
      printf("[BusyHandsFix v0.2] DotMarks blocked loot window for nil or destroyed object")
      return
   end
   
   if    idm and idm.is_system_active()            -- DotMarks is installed and running
         and idm.cfg.manage_container_access       -- Container management is enabled
         and idm.cfg.block_loot_window             -- block_loot_window flag is active
         and (mode == "loot")                      -- Inventory mode is "loot"
         and (not dm.is_container_whitelisted(sec))-- Container isn't whitelisted by section
         and (not busyhands_is_living_stalker(obj))-- Inventory owner isn't a living stalker 
   then
      _ = log and printf("[%s][z_ui_inventory_dotmarks] cfg.block_loot_window is true, blocking access to container %s (%s)", time_global(), obj_name, obj_id)
      -- Block the loot window
      return
   end

   -- Allow inv window to open without interference
   base_ui_inventory_start(mode, obj)
end
