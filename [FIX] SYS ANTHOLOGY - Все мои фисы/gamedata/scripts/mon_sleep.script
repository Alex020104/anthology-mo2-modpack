	sleep_sound_min_ms = 25000,
	sleep_sound_max_ms = 60000,
	disable_interaction_while_sleep = true,
	allow_story_npcs = false,
	allow_companions = false,
	allow_smart_fallback = true,
	allow_current_position_fallback = true,
	debug = false,
	allowed_communities = parse_set("stalker, bandit, csky, dolg, freedom, army, killer, ecolog, monolith, renegade, greh, isg, army_npc, greh_npc"),
	blocked_schemes = parse_set("companion"),
}

local function dbg(fmt, ...)
	if settings.debug and printf then
		printf("[mon_sleep] " .. fmt, ...)
	end
end

local function clear_sleep_sound(npc)
	local id = npc and npc:id()
	local sound_st = id and db.sound and db.sound[id]
	if sound_st and sound_st.theme == "sleep" then
		sound_st.theme = ""
		sound_st.snd = {}
		sound_st.last_snd = sound_st.last_snd or {}
	end
end

local function can_play_sleep_sound(npc)
	if not (settings.sleep_sound_enabled and npc and xr_sound and xr_sound.set_sound_play) then
		return false
	end

	local theme = settings.sleep_sound_theme
	if not (theme and theme ~= "" and sound_theme and sound_theme.theme and sound_theme.theme[theme]) then
		return false
	end

	return true
end

local function play_sleep_sound(npc, st, force)
	if not can_play_sleep_sound(npc) then
		return
	end

	local tg = time_global()
	if not force and st.sleep_sound_next and st.sleep_sound_next > tg then
		return
	end

	clear_sleep_sound(npc)
	xr_sound.set_sound_play(npc:id(), settings.sleep_sound_theme)
	st.sleep_sound_next = tg + math.random(settings.sleep_sound_min_ms, settings.sleep_sound_max_ms)
end

local function safe_bool_call(obj, method, default)
	local ok, value = pcall(function()
		return obj[method](obj)
	end)
	return ok and value or default
end

local function safe_call(obj, method, ...)
	if not obj then
		return
	end

	pcall(function(...)
		obj[method](obj, ...)
	end, ...)
end

local function get_sleep_mute_condlists()
	if sleep_mute_condlists then
		return sleep_mute_condlists
	end

	if not (xr_logic and xr_logic.parse_condlist) then
		return nil
	end

	local function cl(field, value)
		return xr_logic.parse_condlist(nil, "mon_sleep", field, value)
	end

	sleep_mute_condlists = {
		close_distance = cl("close_distance", "0"),
		close_snd_distance = cl("close_snd_distance", "0"),
		close_snd_hello = cl("close_snd_hello", "nil"),
		close_snd_bye = cl("close_snd_bye", "nil"),
		far_distance = cl("far_distance", "0"),
		far_snd_distance = cl("far_snd_distance", "0"),
		far_snd = cl("far_snd", "nil"),
		snd_on_use = cl("snd_on_use", "nil"),
		use = cl("use", "false"),
		use_text = cl("use_text", "nil"),
		meet_dialog = cl("meet_dialog", "nil"),
		meet_on_talking = cl("meet_on_talking", "false"),
		trade_enable = cl("trade_enable", "false"),
		abuse = cl("abuse", "false"),
	}

	return sleep_mute_condlists
end

local function apply_sleep_interaction_block(npc)
	if not (settings.disable_interaction_while_sleep and npc) then
		return
	end

	local id = npc:id()
	local data = sleep_mute_state[id]
	if not data then
		data = {
			talk_enabled = safe_bool_call(npc, "is_talk_enabled", false),
			trade_enabled = safe_bool_call(npc, "is_trade_enabled", false),
		}

		local root_st = db.storage and db.storage[id]
		local meet = root_st and root_st.meet
		if meet then
			data.meet = meet
			data.meet_values = {
				close_distance = meet.close_distance,
				close_snd_distance = meet.close_snd_distance,
				close_snd_hello = meet.close_snd_hello,
				close_snd_bye = meet.close_snd_bye,
				far_distance = meet.far_distance,
				far_snd_distance = meet.far_snd_distance,
				far_snd = meet.far_snd,
				snd_on_use = meet.snd_on_use,
				use = meet.use,
				use_text = meet.use_text,
				meet_dialog = meet.meet_dialog,
				meet_on_talking = meet.meet_on_talking,
				trade_enable = meet.trade_enable,
				abuse = meet.abuse,
			}
		end

		sleep_mute_state[id] = data
	end

	if safe_bool_call(npc, "is_talking", false) then
		safe_call(npc, "stop_talk")
	end
	safe_call(npc, "disable_talk")
	safe_call(npc, "disable_trade")
	safe_call(npc, "set_tip_text", "")

	local mute = get_sleep_mute_condlists()
	local meet = data.meet
	if mute and meet then
		for key, value in pairs(mute) do
			meet[key] = value
		end

		local manager = meet.meet_manager
		if manager then
			manager.current_distance = nil
			manager.use = "false"
			manager.abuse_mode = "false"
			manager.startdialog = nil
		end
	end
end

local function restore_sleep_interaction_block(npc)
	local id = npc and npc:id()
	local data = id and sleep_mute_state[id]
	if not data then
		return
	end

	if data.meet and data.meet_values then
		for key, value in pairs(data.meet_values) do
			data.meet[key] = value
		end
	end

	if npc and npc:alive() and not IsWounded(npc) then
		if data.trade_enabled then
			safe_call(npc, "enable_trade")
		else
			safe_call(npc, "disable_trade")
		end

		if data.talk_enabled then
			safe_call(npc, "enable_talk")
		else
			safe_call(npc, "disable_talk")
		end
	else
		safe_call(npc, "disable_trade")
		safe_call(npc, "disable_talk")
	end

	sleep_mute_state[id] = nil
end

local function read_settings()
	local ok, ini = pcall(ini_file, CFG_PATH)
	if not (ok and ini and ini:section_exist("settings")) then
		return
	end

	local function bool_value(key, default)
		local value = ini:r_bool_ex("settings", key, default)
		if value == nil then
			return default
		end
		return value
	end

	local function num_value(key, default)
		return tonumber(ini:r_float_ex("settings", key)) or default
	end

	settings.enable = bool_value("enable", settings.enable)
	settings.night_start_hour = num_value("night_start_hour", settings.night_start_hour)
	settings.sleep_start_hour = num_value("sleep_start_hour", settings.sleep_start_hour)
	settings.sleep_end_hour = num_value("sleep_end_hour", settings.sleep_end_hour)
	settings.wake_hour = num_value("wake_hour", settings.wake_hour)
	settings.check_min_ms = num_value("check_min_ms", settings.check_min_ms)
	settings.check_max_ms = num_value("check_max_ms", settings.check_max_ms)
	settings.fail_min_ms = num_value("fail_min_ms", settings.fail_min_ms)
	settings.fail_max_ms = num_value("fail_max_ms", settings.fail_max_ms)
	settings.hit_wakeup_min_ms = num_value("hit_wakeup_min_ms", settings.hit_wakeup_min_ms)
	settings.hit_wakeup_max_ms = num_value("hit_wakeup_max_ms", settings.hit_wakeup_max_ms)
	settings.sleep_distance = num_value("sleep_distance", settings.sleep_distance)
	settings.sit_distance = num_value("sit_distance", settings.sit_distance)
	settings.run_distance = num_value("run_distance", settings.run_distance)
	settings.sleep_npc_limit = num_value("sleep_npc_limit", settings.sleep_npc_limit)
	settings.sleep_claim_ms = num_value("sleep_claim_ms", settings.sleep_claim_ms)
	settings.prefer_sleep_zones = bool_value("prefer_sleep_zones", settings.prefer_sleep_zones)
	settings.sleep_zone_npc_limit = num_value("sleep_zone_npc_limit", settings.sleep_zone_npc_limit)
	settings.sleep_zone_claim_ms = num_value("sleep_zone_claim_ms", settings.sleep_zone_claim_ms)
	settings.sleep_zone_max_distance = num_value("sleep_zone_max_distance", settings.sleep_zone_max_distance)
	settings.sleep_zone_min_radius = num_value("sleep_zone_min_radius", settings.sleep_zone_min_radius)
	settings.sleep_zone_max_radius = num_value("sleep_zone_max_radius", settings.sleep_zone_max_radius)
	settings.sleep_zone_random_attempts = num_value("sleep_zone_random_attempts", settings.sleep_zone_random_attempts)
	settings.sleep_sound_enabled = bool_value("sleep_sound_enabled", settings.sleep_sound_enabled)
	settings.sleep_sound_theme = ini:r_string_ex("settings", "sleep_sound_theme") or settings.sleep_sound_theme
	settings.sleep_sound_min_ms = num_value("sleep_sound_min_ms", settings.sleep_sound_min_ms)
	settings.sleep_sound_max_ms = num_value("sleep_sound_max_ms", settings.sleep_sound_max_ms)
	settings.disable_interaction_while_sleep = bool_value("disable_interaction_while_sleep", settings.disable_interaction_while_sleep)
	settings.allow_story_npcs = bool_value("allow_story_npcs", settings.allow_story_npcs)
	settings.allow_companions = bool_value("allow_companions", settings.allow_companions)
	settings.allow_smart_fallback = bool_value("allow_smart_fallback", settings.allow_smart_fallback)
	settings.allow_current_position_fallback = bool_value("allow_current_position_fallback", settings.allow_current_position_fallback)
	settings.debug = bool_value("debug", settings.debug)

	local communities = ini:r_string_ex("settings", "allowed_communities")
	if communities then
		settings.allowed_communities = parse_set(communities)
	end

	local blocked = ini:r_string_ex("settings", "blocked_schemes")
	if blocked then
		settings.blocked_schemes = parse_set(blocked)
	end
end

local function add_precondition(action, property, value)
	if action and property then
		action:add_precondition(world_property(property, value))
	end
end

local function valid_vid(npc, vid)
	return vid and vid < 4294967295 and npc:accessible(vid)
end

local function nearest_accessible(npc, vid)
	if not npc then
		return nil
	end

	if not vid or vid >= 4294967295 then
		return npc:level_vertex_id()
	end

	if npc:accessible(vid) then
		return vid
	end

	local level_api = level
	if not (level_api and level_api.vertex_position) then
		return npc:level_vertex_id()
	end

	local vertex_position = level_api.vertex_position
	local new_vid = npc:accessible_nearest(vertex_position(vid), VEC_ZERO)
	if valid_vid(npc, new_vid) then
		return new_vid
	end

	return npc:level_vertex_id()
end

local function random_accessible_near(npc, pos, min_rad, max_rad)
	if not (npc and pos) then
		return nil
	end

	local vid = utils_obj.find_random_cover(npc, pos, min_rad or 2, max_rad or 8)
	if valid_vid(npc, vid) then
		return vid
	end

	local level_api = level
	if not (level_api and level_api.vertex_id) then
		return npc:level_vertex_id()
	end

	local vertex_id = level_api.vertex_id
	vid = vertex_id(pos)
	if valid_vid(npc, vid) then
		return vid
	end

	return nearest_accessible(npc, vid)
end

local function object_position(obj)
	if not (obj and obj.position) then
		return nil
	end

	local ok, pos = pcall(function()
		return obj:position()
	end)

	return ok and pos or nil
end

local function resolve_sleep_zone(name)
	if not name then
		return nil
	end

	local zone = db.zone_by_name and db.zone_by_name[name]
	if zone then
		return zone
	end

	if level_object_by_sid then
		zone = level_object_by_sid(name) or level_object_by_sid(name .. "_id")
	end

	return zone
end

local function is_inside_zone(zone, pos)
	if not (zone and zone.inside and pos) then
		return true
	end

	local ok, inside = pcall(function()
		return zone:inside(pos)
	end)

	return ok and inside
end

local function zone_vertex_if_valid(npc, zone, vid)
	if not valid_vid(npc, vid) then
		return nil
	end

	local level_api = level
	if not (level_api and level_api.vertex_position) then
		return vid
	end

	local vpos = level_api.vertex_position(vid)
	return is_inside_zone(zone, vpos) and vid or nil
end

local function random_accessible_in_zone(npc, zone, pos)
	local level_api = level
	if not (level_api and level_api.vertex_id) then
		return nil
	end

	local base_vid = level_api.vertex_id(pos)
	if not (base_vid and base_vid < 4294967295) then
		return nil
	end

	if level_api.vertex_in_direction and vector then
		local min_rad = math.floor(tonumber(settings.sleep_zone_min_radius) or 0)
		local max_rad = math.floor(tonumber(settings.sleep_zone_max_radius) or min_rad)
		local attempts = math.max(1, math.floor(tonumber(settings.sleep_zone_random_attempts) or 8))
		if min_rad < 0 then
			min_rad = 0
		end
		if max_rad < 1 then
			max_rad = 1
		end
		if max_rad < min_rad then
			max_rad = min_rad
		end

		for i = 1, attempts do
			local angle = math.random() * 6.28318530718
			local dir = vector():set(math.cos(angle), 0, math.sin(angle))
			local candidate = level_api.vertex_in_direction(base_vid, dir, math.random(min_rad, max_rad))
			local vid = zone_vertex_if_valid(npc, zone, candidate)
			if vid then
				return vid
			end

			candidate = nearest_accessible(npc, candidate)
			vid = zone_vertex_if_valid(npc, zone, candidate)
			if vid then
				return vid
			end
		end
	end

	local vid = zone_vertex_if_valid(npc, zone, base_vid)
	if vid then
		return vid
	end

	local near_vid = nearest_accessible(npc, base_vid)
	vid = zone_vertex_if_valid(npc, zone, near_vid)
	if vid then
		return vid
	end

	return valid_vid(npc, near_vid) and near_vid or nil
end

local function release_sleep_zone_claim(npc, zone_name)
	local npc_id = type(npc) == "number" and npc or npc and npc:id()
	if not npc_id then
		return
	end

	if zone_name then
		local claims = sleep_zone_claims[zone_name]
		if claims then
			claims[npc_id] = nil
			if not next(claims) then
				sleep_zone_claims[zone_name] = nil
			end
		end
		return
	end

	for name, claims in pairs(sleep_zone_claims) do
		claims[npc_id] = nil
		if not next(claims) then
			sleep_zone_claims[name] = nil
		end
	end
end

local function claim_sleep_zone(name, npc)
	local npc_id = npc and npc:id()
	if not (name and npc_id) then
		return
	end

	local claims = sleep_zone_claims[name]
	if not claims then
		claims = {}
		sleep_zone_claims[name] = claims
	end

	claims[npc_id] = time_global() + settings.sleep_zone_claim_ms
end

local function get_online_object(obj_id)
	local level_api = level
	return level_api and level_api.object_by_id and level_api.object_by_id(obj_id)
end

local function sleep_claim_count(npc_id)
	local tg = time_global()
	local count = 0
	local claimed_by_npc = false

	for id, claim_until in pairs(sleep_claims) do
		local keep = claim_until and claim_until > tg
		if keep then
			local obj = get_online_object(id)
			local root_st = db.storage and db.storage[id]
			local local_st = root_st and root_st.mon_sleep
			keep = obj and obj:alive() and local_st and local_st.sleep_claimed
		end

		if keep then
			count = count + 1
			if id == npc_id then
				claimed_by_npc = true
			end
		else
			sleep_claims[id] = nil
		end
	end

	return count, claimed_by_npc
end

local function release_sleep_claim(npc, st)
	local npc_id = type(npc) == "number" and npc or npc and npc:id()
	if npc_id then
		sleep_claims[npc_id] = nil
	end

	release_sleep_zone_claim(npc, st and st.sleep_zone_name)
	if st then
		st.sleep_claimed = nil
	end
end

local function claim_sleep_slot(npc, st)
	local npc_id = npc and npc:id()
	if not npc_id then
		return false
	end

	local limit = math.floor(tonumber(settings.sleep_npc_limit) or 0)
	if limit <= 0 then
		return false
	end

	local count, claimed_by_npc = sleep_claim_count(npc_id)
	if st and st.sleep_claimed and not claimed_by_npc then
		count = count + 1
		claimed_by_npc = true
	end

	if not claimed_by_npc and count >= limit then
		return false
	end

	sleep_claims[npc_id] = time_global() + settings.sleep_claim_ms
	if st then
		st.sleep_claimed = true
	end
	return true
end

local function sleep_zone_claim_count(name, npc_id)
	local claims = sleep_zone_claims[name]
	if not claims then
		return 0, false
	end

	local tg = time_global()
	local count = 0
	local claimed_by_npc = false
	for id, claim_until in pairs(claims) do
		local keep = claim_until and claim_until > tg
		if keep then
			local obj = get_online_object(id)
			local root_st = db.storage and db.storage[id]
			local local_st = root_st and root_st.mon_sleep
			keep = obj and obj:alive() and local_st and local_st.sleep_zone_name == name
		end

		if keep then
			count = count + 1
			if id == npc_id then
				claimed_by_npc = true
			end
		else
			claims[id] = nil
		end
	end

	if not next(claims) then
		sleep_zone_claims[name] = nil
	end

	return count, claimed_by_npc
end

local function find_sleep_zone_target(npc, st)
	if not (settings.prefer_sleep_zones and db and db.zone_by_name) then
		return nil
	end

	local npc_pos = npc:position()
	local npc_id = npc:id()
	local npc_limit = math.max(1, math.floor(tonumber(settings.sleep_zone_npc_limit) or 1))
	local max_dist = tonumber(settings.sleep_zone_max_distance) or 0
	local max_dist_sqr = max_dist > 0 and max_dist * max_dist or nil
	local best_vid
	local best_pos
	local best_name
	local best_dist

	for i = 1, #sleep_zones do
		local name = sleep_zones[i]
		local zone = resolve_sleep_zone(name)
		local pos = object_position(zone)
		if pos then
			local claim_count, claimed_by_npc = sleep_zone_claim_count(name, npc_id)
			local dist = npc_pos:distance_to_sqr(pos)
			if (claimed_by_npc or claim_count < npc_limit) and (not max_dist_sqr or dist <= max_dist_sqr) and (not best_dist or dist < best_dist) then
				local vid = random_accessible_in_zone(npc, zone, pos)
				if valid_vid(npc, vid) then
					local level_api = level
					best_vid = vid
					best_pos = level_api and level_api.vertex_position and level_api.vertex_position(vid) or pos
					best_name = name
					best_dist = dist
				end
			end
		end
	end

	if best_vid then
		if st and st.sleep_zone_name and st.sleep_zone_name ~= best_name then
			release_sleep_zone_claim(npc, st.sleep_zone_name)
		end
		claim_sleep_zone(best_name, npc)
		dbg("%s uses sleep zone %s", npc:name(), tostring(best_name))
		return nearest_accessible(npc, best_vid), best_pos, best_name
	end

	return nil
end

local function find_sleep_target(npc, st)
	if not claim_sleep_slot(npc, st) then
		release_sleep_zone_claim(npc, st.sleep_zone_name)
		st.sleep_zone_name = nil
		return nil
	end

	local zone_vid, zone_pos, zone_name = find_sleep_zone_target(npc, st)
	if zone_vid then
		st.sleep_zone_name = zone_name
		return zone_vid, zone_pos
	end
	release_sleep_zone_claim(npc, st.sleep_zone_name)
	st.sleep_zone_name = nil

	local camp = sr_camp and sr_camp.get_current_camp and sr_camp.get_current_camp(npc:position())
	if camp then
		local pos = camp.object and camp.object:position() or npc:position()
		local vid = random_accessible_near(npc, pos, 2, 8) or npc:level_vertex_id()
		return nearest_accessible(npc, vid), pos
	end

	local smart = xr_gulag and xr_gulag.get_npc_smart and xr_gulag.get_npc_smart(npc)
	local smart_name = smart and smart:name()
	local campfires = smart_name and db.campfire_table_by_smart_names and db.campfire_table_by_smart_names[smart_name]
	local list = {}
	if campfires then
		for _, binder in pairs(campfires) do
			if binder and binder.object then
				list[#list + 1] = binder.object
			end
		end
	end

	if #list > 0 then
		local obj = list[math.random(#list)]
		local pos = obj:position()
		local vid = random_accessible_near(npc, pos, 2, 8)
		if not valid_vid(npc, vid) then
			vid = obj:level_vertex_id()
		end

		return nearest_accessible(npc, vid), pos
	end

	if settings.allow_smart_fallback and smart and smart.position then
		local pos = smart.position
		local vid = random_accessible_near(npc, pos, 5, 15)
		dbg("%s uses smart fallback %s", npc:name(), tostring(smart_name))
		return nearest_accessible(npc, vid), pos
	end

	if settings.allow_current_position_fallback then
		local pos = npc:position()
		dbg("%s uses current-position fallback", npc:name())
		return npc:level_vertex_id(), pos
	end

	release_sleep_claim(npc, st)
	return nil
end

local function time_in_window(hour, minute, start_hour, start_minute, end_hour, end_minute)
	local now = hour * 60 + minute
	local start_time = start_hour * 60 + (start_minute or 0)
	local end_time = end_hour * 60 + (end_minute or 0)

	if start_time <= end_time then
		return now >= start_time and now <= end_time
	end
	return now >= start_time or now <= end_time
end

local function is_night_time(hour, minute)
	return time_in_window(hour, minute, settings.night_start_hour, 0, settings.wake_hour, 0)
end

local function is_deep_sleep_time(hour, minute, random_minute)
	return time_in_window(hour, minute, settings.sleep_start_hour, random_minute, settings.sleep_end_hour, random_minute)
end

local function is_story_npc(npc)
	if get_object_story_id and get_object_story_id(npc:id()) then
		return true
	end

	local ok, sid = pcall(function()
		return npc:story_id()
	end)

	if not (ok and sid) then
		return false
	end

	return sid ~= 0 and sid ~= -1 and sid ~= 65535 and sid ~= 4294967295 and sid ~= 4294967296
end

local function is_valid_npc(npc)
	if not (settings.enable and npc and npc:alive()) then
		return false
	end

	if npc:section() == "actor_visual_stalker" then
		return false
	end

	if not settings.allow_companions and npc:has_info("npcx_is_companion") then
		return false
	end

	if not settings.allow_story_npcs and is_story_npc(npc) then
		dbg("%s rejected: story npc", npc:name())
		return false
	end

	local community = character_community(npc)
	if not (community and settings.allowed_communities[community]) then
		dbg("%s rejected: community %s", npc:name(), tostring(community))
		return false
	end

	return true
end

local function should_abort_sleep(npc, root_st, local_st)
	if not is_valid_npc(npc) then
		return true
	end

	if IsWounded(npc) then
		return true
	end

	if npc:best_enemy() then
		return true
	end

	if xr_danger and xr_danger.has_danger and xr_danger.has_danger(npc) then
		return true
	end

	if xr_conditions and xr_conditions.surge_started and xr_conditions.surge_started() then
		return true
	end

	local active = root_st and root_st.active_scheme
	if active and settings.blocked_schemes[active] then
		dbg("%s rejected: blocked active scheme %s", npc:name(), tostring(active))
		return true
	end

	local active_st = active and root_st[active]
	if active_st and active_st.no_sleep then
		return true
	end

	local wake_until = local_st and local_st.force_wake_until
	if wake_until and wake_until > time_global() then
		return true
	end

	return false
end

class "evaluator_sleep" (property_evaluator)
function evaluator_sleep:__init(npc, name, storage) super(nil, name)
	self.st = storage
	self.delay = time_global() + math.random(500, 1500)
	self.random_minute = 0
	self.res = false
end

function evaluator_sleep:evaluate()
	local npc = self.object
	local tg = time_global()
	if self.delay and self.delay > tg then
		return self.res
	end

	local level_api = level
	if not (level_api and level_api.get_time_hours and level_api.get_time_minutes) then
		self.delay = tg + math.random(settings.fail_min_ms, settings.fail_max_ms)
		self.res = false
		return false
	end

	local root_st = db.storage[npc:id()]
	if should_abort_sleep(npc, root_st, self.st) then
		release_sleep_claim(npc, self.st)
		self.st.target_vid = nil
		self.st.look_pos = nil
		self.st.sit = nil
		self.st.sleep_zone_name = nil
		self.st.sleep_claimed = nil
		self.delay = tg + math.random(settings.fail_min_ms, settings.fail_max_ms)
		self.res = false
		return false
	end

	local get_time_hours = level_api.get_time_hours
	local get_time_minutes = level_api.get_time_minutes
	local hour = get_time_hours()
	local minute = get_time_minutes()
	if not is_night_time(hour, minute) then
		release_sleep_claim(npc, self.st)
		self.st.target_vid = nil
		self.st.look_pos = nil
		self.st.sit = nil
		self.st.sleep_zone_name = nil
		self.st.sleep_claimed = nil
		self.delay = tg + math.random(settings.fail_min_ms, settings.fail_max_ms)
		self.res = false
		return false
	end

	local vid, look_pos = find_sleep_target(npc, self.st)
	if not vid then
		release_sleep_claim(npc, self.st)
		self.delay = tg + math.random(settings.fail_min_ms, settings.fail_max_ms)
		self.res = false
		return false
	end

	self.st.target_vid = vid
	self.st.look_pos = look_pos
	self.st.sit = not is_deep_sleep_time(hour, minute, self.random_minute)
	self.delay = tg + math.random(settings.check_min_ms, settings.check_max_ms)
	self.res = true
	return true
end

class "action_sleep" (action_base)
function action_sleep:__init(npc, action_name, storage) super(nil, action_name)
	self.st = storage
end

function action_sleep:initialize()
	action_base.initialize(self)

	local npc = self.object
	apply_sleep_interaction_block(npc)
	npc:set_desired_position()
	npc:set_desired_direction()
	npc:set_path_type(game_object.level_path)

	self.delay = time_global() + 1000
	self.sleep = false
	self.wfa = nil
	self.st.sleep_sound_next = nil

	local base_pos = self.st.look_pos or npc:position()
	self.look_pos = vector():set(
		base_pos.x + math.random() * 6 - 3,
		base_pos.y,
		base_pos.z + math.random() * 6 - 3
	)

	local level_api = level
	if not (level_api and level_api.vertex_position) then
		return
	end

	local vertex_position = level_api.vertex_position
	local target_pos = self.st.target_vid and vertex_position(self.st.target_vid)
	local dist_limit = self.st.sit and settings.sit_distance or settings.sleep_distance
	if target_pos and target_pos:distance_to_sqr(npc:position()) <= dist_limit * dist_limit then
		self.sleep = true
	end
end

function action_sleep:execute()
	action_base.execute(self)

	local npc = self.object
	if not (npc and self.st.target_vid) then
		return
	end

	apply_sleep_interaction_block(npc)
	claim_sleep_slot(npc, self.st)
	if self.st.sleep_zone_name then
		claim_sleep_zone(self.st.sleep_zone_name, npc)
	end

	local wake_until = self.st.force_wake_until
	if wake_until and wake_until > time_global() then
		state_mgr.set_state(npc, "guard")
		return
	end

	if self.sleep then
		local sleep_state = self.st.sit and "sleep_sit" or "sleep"
		if state_mgr.get_state(npc) ~= sleep_state then
			state_mgr.set_state(npc, sleep_state, nil, nil, {look_position = self.look_pos}, {animation = true})
			play_sleep_sound(npc, self.st, true)
		else
			play_sleep_sound(npc, self.st, false)
		end
		return
	end

	local tg = time_global()
	if self.wfa and self.wfa < tg then
		self.sleep = true
		return
	end

	if self.delay and self.delay > tg then
		return
	end

	local level_api = level
	if not (level_api and level_api.vertex_position) then
		return
	end

	local vertex_position = level_api.vertex_position
	local target_pos = vertex_position(self.st.target_vid)
	if not target_pos then
		return
	end

	local dist_sqr = target_pos:distance_to_sqr(npc:position())
	local dist_limit = self.st.sit and settings.sit_distance or settings.sleep_distance
	if dist_sqr <= dist_limit * dist_limit then
		self.sleep = true
		return
	end

	if npc:path_type() ~= game_object.level_path then
		npc:set_path_type(game_object.level_path)
	end

	self.st.target_vid = utils_obj.send_to_nearest_accessible_vertex(npc, self.st.target_vid, "mon_sleep")
	state_mgr.set_state(npc, dist_sqr > settings.run_distance * settings.run_distance and "patrol" or "walk")
	self.delay = tg + 4000

	if dist_sqr < 100 and not self.wfa then
		self.wfa = tg + 20000
	end
end

function action_sleep:finalize()
	release_sleep_claim(self.object, self.st)
	restore_sleep_interaction_block(self.object)
	clear_sleep_sound(self.object)
	self.sleep = nil
	self.delay = nil
	self.wfa = nil
	self.look_pos = nil
	self.st.target_vid = nil
	self.st.look_pos = nil
	self.st.sit = nil
	self.st.sleep_zone_name = nil
	self.st.sleep_claimed = nil
	self.st.sleep_sound_next = nil
	action_base.finalize(self)
end

local function npc_on_hit_callback(npc)
	local st = npc and db.storage[npc:id()] and db.storage[npc:id()].mon_sleep
	if not st then
		return
	end

	st.force_wake_until = time_global() + math.random(settings.hit_wakeup_min_ms, settings.hit_wakeup_max_ms)
	release_sleep_claim(npc, st)
	restore_sleep_interaction_block(npc)
	st.target_vid = nil
	st.look_pos = nil
	st.sit = nil
	st.sleep_zone_name = nil
	st.sleep_claimed = nil
	st.sleep_sound_next = nil
end

function on_game_start()
	read_settings()
	if not settings.enable then
		return
	end

	LoadScheme("mon_sleep", "mon_sleep", modules.stype_stalker)
	RegisterScriptCallback("npc_on_hit_callback", npc_on_hit_callback)
end

function setup_generic_scheme(npc, ini, scheme, section, stype, temp)
	xr_logic.assign_storage_and_bind(npc, ini, "mon_sleep", section, temp)
end

function add_to_binder(npc, ini, scheme, section, st, temp)
	if not npc then
		return
	end

	local manager = npc:motivation_action_manager()
	if not manager then
		return
	end

	if not is_valid_npc(npc) then
		manager:add_evaluator(evaid, property_evaluator_const(false))
		if temp then
			temp.needs_configured = false
		end
		return
	end

	local evaluator = evaluator_sleep(npc, "eva_mon_sleep", st)
	local action = action_sleep(npc, "act_mon_sleep", st)
	if not (evaluator and action) then
		return
	end

	manager:add_evaluator(evaid, evaluator)

	local wp = world_property
	action:add_precondition(wp(evaid, true))
	action:add_precondition(wp(stalker_ids.property_alive, true))
	action:add_precondition(wp(stalker_ids.property_enemy, false))
	action:add_precondition(wp(stalker_ids.property_danger, false))
	action:add_effect(wp(evaid, false))
	manager:add_action(actid, action)

	if temp then
		temp.action = action
	end
end

function configure_actions(npc, ini, scheme, section, stype, temp)
	local manager = npc and npc:motivation_action_manager()
	local action = temp and temp.action
	if not (manager and action) then
		return
	end

	add_precondition(action, xr_evaluators_id.stohe_meet_base + 1, false)
	add_precondition(action, xr_evaluators_id.sidor_wounded_base, false)
	add_precondition(action, xr_evaluators_id.abuse_base, false)
	add_precondition(action, xr_evaluators_id.wounded_exist, false)
	if _G.schemes["corpse_detection"] then
		add_precondition(action, xr_evaluators_id.corpse_exist, false)
	end
	if xr_gather_items and xr_gather_items.evaid then
		add_precondition(action, xr_gather_items.evaid, false)
	end
	if axr_turn_on_campfire and axr_turn_on_campfire.evaid then
		add_precondition(action, axr_turn_on_campfire.evaid, false)
	end
	if xrs_facer and xrs_facer.evid_facer then
		add_precondition(action, xrs_facer.evid_facer, false)
	end

	local function block_action(action_id)
		local other = action_id and manager:action(action_id)
		if other then
			add_precondition(other, evaid, false)
		end
	end

	block_action(xr_actions_id.alife)
	block_action(xr_actions_id.state_mgr + 2)
	block_action(xr_actions_id.zmey_walker_base + 1)
	block_action(xr_campfire_point and xr_campfire_point.actid)
end

function reset_generic_scheme(npc, scheme, section, stype, root_st)
	local st = root_st and root_st.mon_sleep
	if st then
		release_sleep_claim(npc, st)
		restore_sleep_interaction_block(npc)
		st.target_vid = nil
		st.look_pos = nil
		st.sit = nil
		st.sleep_zone_name = nil
		st.sleep_claimed = nil
		st.sleep_sound_next = nil
	end
end

function npc_add_precondition(action)
	add_precondition(action, evaid, false)
end

function is_under_mon_sleep(npc)
	local mgr = npc and npc:motivation_action_manager()
	return mgr and mgr:initialized() and mgr:current_action_id() == actid
end
