local sleep_zone_claims = {}
local sleep_claims = {}
local sleep_mute_state = {}
local sleep_mute_condlists = nil

local function parse_set(value)
	local result = {}
	if not value then
		return result
	end

	for token in string.gmatch(value, "([^,%s]+)") do
		result[token] = true
	end
	return result
end

local settings = {
	enable = true,
	night_start_hour = 22,
	sleep_start_hour = 1,
	sleep_end_hour = 6,
	wake_hour = 7,
	check_min_ms = 1000,
	check_max_ms = 3000,
	fail_min_ms = 3000,
	fail_max_ms = 8000,
	hit_wakeup_min_ms = 10000,
	hit_wakeup_max_ms = 30000,
