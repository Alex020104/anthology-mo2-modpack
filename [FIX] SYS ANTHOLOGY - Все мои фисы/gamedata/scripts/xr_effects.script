function mod_zapiska_scene_upd(actor, npc, p)
	if p[1] then
		local hud = get_hud()
		local mod_zapiska_wnd = hud:GetCustomStatic("mod_zapiska_scene")
		if mod_zapiska_wnd then
			hud:RemoveCustomStatic("mod_zapiska_scene")
		end
		hud:AddCustomStatic("mod_zapiska_scene", true)
        mod_zapiska_wnd = get_hud():GetCustomStatic("mod_zapiska_scene"):wnd()
        mod_zapiska_wnd:SetWndRect( Frect():set( 0, 0, 1024, 768 ) )
	end
end

function mod_zapiska_scene_dwn(actor, npc, p)
local hud = get_hud()
mod_zapiska_wnd = hud:GetCustomStatic("mod_zapiska_scene")
if mod_zapiska_wnd then
hud:RemoveCustomStatic("mod_zapiska_scene")
end
end

