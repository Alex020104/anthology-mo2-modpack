function mod_ship_cutscene_f()
mod_ship_cutscene_sound = sound_object([[characters_voice\scenario\cutscenes\mod_ship_cutscene_sound]])
mod_ship_cutscene_sound:play_at_pos(db.actor, vector():set(0,0,0), 1, sound_object.s2d)
