function fast_set_animation(actor, npc, p)
	if not p[1] or not npc then
		return
	end

	npc:clear_animations()

	db.storage[npc:id()].state_mgr:set_state(p[1])
	local state_mgr = db.storage[npc:id()].state_mgr
	if state_mgr ~= nil then
		state_mgr.animation:set_state(nil, true)
		state_mgr.animation:set_state(p[1])
		state_mgr.animation:set_control()
	end
end

