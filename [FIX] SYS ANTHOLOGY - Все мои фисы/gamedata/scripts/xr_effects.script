function mod_ui_kapli_upd(actor, npc, p)
	if p[1] then
		local hud = get_hud()
		local mod_kapli_wnd = hud:GetCustomStatic("mod_ui_kapli")
		if mod_kapli_wnd then
			hud:RemoveCustomStatic("mod_ui_kapli")
		end
		hud:AddCustomStatic("mod_ui_kapli", true)
        mod_kapli_wnd = get_hud():GetCustomStatic("mod_ui_kapli"):wnd()
        mod_kapli_wnd:SetWndRect( Frect():set( 0, 0, 1024, 768 ) )
	end
end

function mod_ui_kapli_dwn(actor, npc, p)
local hud = get_hud()
mod_kapli_wnd = hud:GetCustomStatic("mod_ui_kapli")
if mod_kapli_wnd then
hud:RemoveCustomStatic("mod_ui_kapli")
end
end

