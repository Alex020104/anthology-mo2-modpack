function show_go_to_from_2scf( actor, npc, p )
	local text = ""
	if p[ 1 ] == "to" then
		text = "%c[default]%c[255,238,153,26]Вы уже ранее зачистили катакомбы, поэтому если хотите то можете сразу отправиться на неизведанные территории, для этого - нажмите ДА. Если вы хотите спуститься вновь в катакомбы - нажмите НЕТ."
	else
		text = "%c[default]%c[255,238,153,26]Вы уже ранее зачистили катакомбы, поэтому если хотите то можете сразу отправиться на неизведанные территории, для этого - нажмите ДА. Если вы хотите спуститься вновь в катакомбы - нажмите НЕТ."
	end
	show4( "message_box_yes_no", text )
end

function show4( mb_type, text )
	game_control = scf2_mod_changer()
	game_control:show4( mb_type, text )
end

class "scf2_mod_changer" ( CUIScriptWnd )
function scf2_mod_changer:__init() super()
	self:SetWndRect( Frect():set( 0, 0, 1024, 768 ) )
	self.freeplay_mb = CUIMessageBoxEx()
	self:Register( self.freeplay_mb, "freeplay_mb" )

	self:AddCallback( "freeplay_mb", ui_events.MESSAGE_BOX_OK_CLICKED, self.OnMsgOk, self )
	self:AddCallback( "freeplay_mb", ui_events.MESSAGE_BOX_YES_CLICKED, self.OnMsgYes, self )
	self:AddCallback( "freeplay_mb", ui_events.MESSAGE_BOX_NO_CLICKED, self.OnMsgNo, self )
end

function scf2_mod_changer:show4( mb_type, text )
	self.freeplay_mb:InitMessageBox( mb_type )
	self.freeplay_mb:SetText( text )
    self.freeplay_mb:ShowDialog( true )
end

function scf2_mod_changer:OnMsgOk()
	db.actor:give_info_portion( "scf_ph_show_actor_to_chur" )
end

function scf2_mod_changer:OnMsgYes()
	db.actor:give_info_portion( "scf_ph_show_actor_to_chur" )
end

function scf2_mod_changer:OnMsgNo()
	db.actor:give_info_portion( "scf_ph_show_actor_to_coll" )
end

