function tp_svali_companion_to_actor(actor, npc)
    local cam_pos = device().cam_pos
    local pos_svali = vector():set(cam_pos.x, db.actor:position().y, cam_pos.z):add(vector():set(device().cam_dir):mul(-3.5))
	if npc then
	npc:set_npc_position(pos_svali)
	end
end

function teleport_companion_to_actor(actor, npc)
    local cam_pos = device().cam_pos
    local pos = vector():set(cam_pos.x, db.actor:position().y, cam_pos.z):add(vector():set(device().cam_dir):mul(-2.5))
	if npc then
	npc:set_npc_position(pos)
	end
end

