function start_qte(actor, npc, p)
	local force = p[1]
	local anm = p[2]
	local sound = p[3]
	local clicks = p[4]
	if (p[2]) and (p[2] == "nil") then anm = nil end
	if (p[3]) and (p[3] == "nil") then sound = nil end
	emmis_quick_time_event.StartQte(force, anm, sound, clicks)
end

