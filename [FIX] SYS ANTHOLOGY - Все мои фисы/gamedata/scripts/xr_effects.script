function play_particle_on_me(actor, npc, p)
	local name = p[1]
	local sobj = alife():object(npc:id())
	local path = npc:position()
	
	if name == nil or path == nil then
		return
	end
	local particle = particles_object(name)
	particle:play_at_pos(path)
end

