function weapon_shoot_mod(actor, obj, p)
	local sound_shoot_svd = sound_object([[weapons
_svd_shot]])
	local sound_shoot_ak74 = sound_object([[weapons
_ak74_shot]])
	local sound_shoot_spas12 = sound_object([[weapons
_spas12_shot]])
	local sound_shoot_pm = sound_object([[weapons
_pm_shot]])
	local sound_shoot_vintorez = sound_object([[weapons
_vintorez_shot]])
	local sound_shoot_usp = sound_object([[weapons
_usp_shot]])
	local sound_explode = sound_object([[weapons	_f1_explosion]])
	local weap = p[1]
	if weap == "svd" then
	sound_shoot_svd:play_at_pos(obj, db.actor:position(), 0, sound_object.s3d)
	elseif weap == "ak74" then
	sound_shoot_ak74:play_at_pos(obj, db.actor:position(), 0, sound_object.s3d)
	elseif weap == "spas12" then
	sound_shoot_spas12:play_at_pos(obj, db.actor:position(), 0, sound_object.s3d)
	elseif weap == "pm" then
	sound_shoot_pm:play_at_pos(obj, db.actor:position(), 0, sound_object.s3d)
	elseif weap == "vintorez" then
	sound_shoot_vintorez:play_at_pos(obj, db.actor:position(), 0, sound_object.s3d)
	elseif weap == "explode" then
	sound_explode:play_at_pos(obj, db.actor:position(), 0, sound_object.s3d)
	elseif weap == "usp" then
	sound_shoot_usp:play_at_pos(obj, db.actor:position(), 0, sound_object.s3d)
	end
end

