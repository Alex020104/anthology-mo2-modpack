local particle = nil
function play_particle_on_restrictor(actor, npc, p)
	local name = p[1]
	if name == nil then
		return
	end
	local particle_position = npc:position()
	particle = particles_object(name)
	particle:play_at_pos(particle_position)
end

function stop_particle_on_restrictor(actor, npc, p)
	if particle ~= nil then
		if particle:playing() then
			particle:stop()
		end
	end
end

