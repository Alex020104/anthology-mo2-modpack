function mod_und_video_actor_upd(actor, npc, p)
	if p[1] then
		local hud = get_hud()
		local mod_und_video_cutscene_game = hud:GetCustomStatic("mod_und_cam_scene")
		if mod_und_video_cutscene_game then
			hud:RemoveCustomStatic("mod_und_cam_scene")
		end
		hud:AddCustomStatic("mod_und_cam_scene", true)
        mod_und_video_cutscene_game = get_hud():GetCustomStatic("mod_und_cam_scene"):wnd()
        mod_und_video_cutscene_game:SetWndRect( Frect():set( 0, 0, 1024, 768 ) )
	end
end

function mod_und_video_actor_dwn(actor, npc, p)
local hud = get_hud()
mod_und_video_cutscene_game = hud:GetCustomStatic("mod_und_cam_scene")
if mod_und_video_cutscene_game then
hud:RemoveCustomStatic("mod_und_cam_scene")
end
end

