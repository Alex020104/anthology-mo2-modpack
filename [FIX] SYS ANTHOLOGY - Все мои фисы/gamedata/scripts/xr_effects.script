function mod_video_actor_upd(actor, npc, p)
	if p[1] then
		local hud = get_hud()
		local mod_video_cutscene_game = hud:GetCustomStatic("mod_video_scene")
		if mod_video_cutscene_game then
			hud:RemoveCustomStatic("mod_video_scene")
		end
		hud:AddCustomStatic("mod_video_scene", true)
        mod_video_cutscene_game = get_hud():GetCustomStatic("mod_video_scene"):wnd()
        mod_video_cutscene_game:SetWndRect( Frect():set( 0, 0, 1024, 768 ) )
	end
end

function off_mod_video_actor_upd( actor, npc )
get_hud():AddCustomStatic("mod_video_scene")
mod_video_cutscene_game = get_hud():GetCustomStatic("mod_video_scene"):wnd()
mod_video_cutscene_game:SetWndRect( Frect():set( 0, 0, 1024, 768 ) )
end

function mod_video_actor_dwn(actor, npc, p)
local hud = get_hud()
mod_video_cutscene_game = hud:GetCustomStatic("mod_video_scene")
if mod_video_cutscene_game then
hud:RemoveCustomStatic("mod_video_scene")
end
end

