function take_ph_money(actor, npc, p)
	local min = tonumber(p[1])
	local max = tonumber(p[2])
	local give_money = 0
	if max ~= nil then
		give_money = math.random(min, max)
	else
		give_money = min
	end
	db.actor:give_money(give_money)
	news_manager.relocate_money( actor, "in" , give_money )
end

function heal_npc(actor, npc, p)
	local obj = npc
	if p[2] ~= nil then
		obj = get_story_object(p[2])
	end
	obj.health = tonumber(p[1])
end

function damage_npc(actor, npc, p)
	local obj = npc
	if p[2] ~= nil then
		obj = get_story_object(p[2])
	end
	obj.health = -tonumber(p[1])
end

function show_go_to_from_scf( actor, npc, p )
	local text = ""
	if p[ 1 ] == "to" then
		text = "%c[default]%c[255,238,153,26]Вы уже ранее зачистили катакомбы, поэтому если хотите то можете сразу отправиться в Залесье, для этого - нажмите ДА. Если вы хотите спуститься вновь в катакомбы - нажмите НЕТ."
	else
		text = "%c[default]%c[255,238,153,26]Вы уже ранее зачистили катакомбы, поэтому если хотите то можете сразу отправиться в Залесье, для этого - нажмите ДА. Если вы хотите спуститься вновь в катакомбы - нажмите НЕТ."
	end
	show3( "message_box_yes_no", text )
end

function show3( mb_type, text )
	game_control = chu_mod_changer()
	game_control:Show3( mb_type, text )
end

class "chu_mod_changer" ( CUIScriptWnd )
function chu_mod_changer:__init() super()
	self:SetWndRect( Frect():set( 0, 0, 1024, 768 ) )
	self.freeplay_mb = CUIMessageBoxEx()
	self:Register( self.freeplay_mb, "freeplay_mb" )

	self:AddCallback( "freeplay_mb", ui_events.MESSAGE_BOX_OK_CLICKED, self.OnMsgOk, self )
	self:AddCallback( "freeplay_mb", ui_events.MESSAGE_BOX_YES_CLICKED, self.OnMsgYes, self )
	self:AddCallback( "freeplay_mb", ui_events.MESSAGE_BOX_NO_CLICKED, self.OnMsgNo, self )
end

function chu_mod_changer:Show3( mb_type, text )
	self.freeplay_mb:InitMessageBox( mb_type )
	self.freeplay_mb:SetText( text )
    self.freeplay_mb:ShowDialog( true )
end

function chu_mod_changer:OnMsgOk()
	db.actor:give_info_portion( "chu_n1_actor_in_inst" )
end

function chu_mod_changer:OnMsgYes()
	db.actor:give_info_portion( "chu_n1_actor_in_inst" )
end

function chu_mod_changer:OnMsgNo()
	db.actor:give_info_portion( "chu_n1_actor_out_inst" )
end

