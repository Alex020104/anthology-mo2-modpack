function mod_ship_upd(actor, npc, p)
	if p[1] then
		local hud = get_hud()
		local mod_ship_texture = hud:GetCustomStatic("mod_ship_scene")
		if mod_ship_texture then
			hud:RemoveCustomStatic("mod_ship_scene")
		end
		hud:AddCustomStatic("mod_ship_scene", true)
        mod_ship_texture = get_hud():GetCustomStatic("mod_ship_scene"):wnd()
        mod_ship_texture:SetWndRect( Frect():set( 0, 0, 1024, 768 ) )
	end
end

function mod_ship_dwn(actor, npc, p)
local hud = get_hud()
mod_ship_texture = hud:GetCustomStatic("mod_ship_scene")
if mod_ship_texture then
hud:RemoveCustomStatic("mod_ship_scene")
end
end

