function add_subtitles(actor, npc, p) 
	bind_stalker.add_subtitles_on_hud(p[1], p[2], p[3], p[4], p[5])
end

function add_cut_text(actor, npc, p)
	if p[1] then
		local hud = get_hud()
		local cs_text = hud:GetCustomStatic("text_screen_chapters")
		if cs_text then
			hud:RemoveCustomStatic("text_screen_chapters")
		end
		hud:AddCustomStatic("text_screen_chapters", true)
		cs_text = hud:GetCustomStatic("text_screen_chapters")
		cs_text:wnd():TextControl():SetText(game.translate_string(p[1]))
	end
end

function del_cut_text(actor, npc, p)
	local hud = get_hud()
	cs_text = hud:GetCustomStatic("text_screen_chapters")
	if cs_text then
		hud:RemoveCustomStatic("text_screen_chapters")
	end
end

function add_aes_text(actor, npc, p)
	if p[1] then
		local hud = get_hud()
		local cs_text = hud:GetCustomStatic("text_screen_aes")
		if cs_text then
			hud:RemoveCustomStatic("text_screen_aes")
		end
		hud:AddCustomStatic("text_screen_aes", true)
		cs_text = hud:GetCustomStatic("text_screen_aes")
		cs_text:wnd():TextControl():SetText(game.translate_string(p[1]))
	end
end

function del_aes_text(actor, npc, p)
	local hud = get_hud()
	cs_text = hud:GetCustomStatic("text_screen_aes")
	if cs_text then
		hud:RemoveCustomStatic("text_screen_aes")
	end
end

function add_show_subtitres(actor, npc, p)
local hud = get_hud():AddCustomStatic("text_screen_subtitres", true)
hud:wnd():TextControl():SetTextST(game.translate_string(p[1]))
hud.m_endTime = time_global()/1000+80
end

function del_show_subtitres(actor, npc, p)
	local hud = get_hud()
	show_text = hud:GetCustomStatic("text_screen_subtitres")
	if show_text then
		hud:RemoveCustomStatic("text_screen_subtitres")
	end
end

local pending_map_spots = {}
local restored_existing_map_spots = false
local anthology_map_spot_sections = {
	"avanpost_spot_loc",
	"crlc_big",
	"crlc_small",
	"icon_mod_anomaly_spot",
	"icon_mod_car_spt",
	"icon_mod_locator_stn_spot",
	"icon_mod_quest_container_spt",
	"icon_mod_quest_door_spt",
	"icon_mod_quest_house_spt",
	"icon_mod_ship_spt",
	"icon_mod_sobitie_spot",
	"level_changer_down",
	"level_changer_down_left",
	"level_changer_left_up",
	"level_changer_new_spot_loc",
	"level_changer_right_down",
	"level_changer_up",
	"mod_helli_metka",
	"mod_perehod_metka",
	"mp_team_base_0_location",
	"mp_team_base_1_location",
	"mp_team_base_2_location",
	"oblako_dialog_spot_loc",
	"psy_vozdeistvie_spot_loc",
	"secret_doc_spot_loc",
	"time_skip_spot_loc",
	"ui_pda2_actor_zolbox_location",
	"ui_pda2_sekt_box_location",
}

local function map_spot_key(target, spot)
	return tostring(target) .. "|" .. tostring(spot)
end

local function map_spot_same_token(a, b)
	if a == nil or b == nil then
		return false
	end
	return string.lower(tostring(a)) == string.lower(tostring(b))
end

local function map_spot_logic_basename(filename)
	if type(filename) ~= "string" or filename == "" then
		return nil
	end

	local name = string.gsub(filename, "\\", "/")
	name = string.match(name, "([^/]+)$") or name
	name = string.gsub(name, "^%s+", "")
	name = string.gsub(name, "%s+$", "")
	name = string.gsub(name, "^\"", "")
	name = string.gsub(name, "\"$", "")
	name = string.lower(name)
	name = string.gsub(name, "%.ltx$", "")
	return name
end

local function map_spot_logic_file_matches(filename, target)
	local logic_name = map_spot_logic_basename(filename)
	return logic_name and map_spot_same_token(logic_name, target) or false
end

local function map_spot_object_id_value(obj)
	if not obj then
		return nil
	end

	local id = obj.id
	if type(id) == "number" then
		return id
	elseif type(id) == "function" then
		return obj:id()
	end
	return nil
end

local function map_spot_object_section(obj)
	if not obj then
		return nil
	end

	if obj.section_name then
		return obj:section_name()
	elseif obj.section then
		return obj:section()
	end
	return nil
end

local function map_spot_object_name(obj)
	if obj and obj.name then
		return obj:name()
	end
	return nil
end

local function map_spot_se_object_by_id(id)
	if not id then
		return nil
	end
	if alife_object then
		local obj = alife_object(id)
		if obj then
			return obj
		end
	end
	local sim = alife and alife()
	return sim and sim:object(id) or nil
end

local function map_spot_ini_logic_matches(ini, section, target)
	if not (ini and section and ini:section_exist(section)) then
		return false
	end

	local cfg = ini:r_string_ex(section, "cfg")
	if map_spot_logic_file_matches(cfg, target) then
		return true
	end

	local custom_data = ini:r_string_ex(section, "custom_data")
	if map_spot_logic_file_matches(custom_data, target) then
		return true
	end

	return false
end

local function map_spot_storage_matches(id, target)
	local st = db and db.storage and id and db.storage[id]
	if not st then
		return false
	end

	if map_spot_logic_file_matches(st.ini_filename, target) then
		return true
	end

	if map_spot_ini_logic_matches(st.ini, st.section_logic or "logic", target) then
		return true
	end

	return false
end

local function map_spot_spawn_ini_matches(obj, target)
	local spawn_ini = obj and obj.spawn_ini and obj:spawn_ini()
	if not spawn_ini then
		return false
	end

	if map_spot_ini_logic_matches(spawn_ini, "logic", target) then
		return true
	end

	if spawn_ini:section_exist("story_object") then
		local result, id, value = spawn_ini:r_line("story_object", 0, "", "")
		if map_spot_same_token(id, target) or (id == "story_id" and map_spot_same_token(value, target)) then
			return true
		end
	end

	return false
end

local function map_spot_object_matches(obj, target)
	if not obj then
		return false
	end

	local id = map_spot_object_id_value(obj)
	if map_spot_storage_matches(id, target) then
		return true
	end

	if map_spot_same_token(map_spot_object_name(obj), target) then
		return true
	end

	local section = map_spot_object_section(obj)
	if map_spot_same_token(section, target) then
		return true
	end

	if id and get_object_story_id and map_spot_same_token(get_object_story_id(id), target) then
		return true
	end

	if ini_sys and section then
		if map_spot_same_token(ini_sys:r_string_ex(section, "story_id"), target) then
			return true
		end
		if map_spot_logic_file_matches(ini_sys:r_string_ex(section, "custom_data"), target) then
			return true
		end
	end

	if map_spot_spawn_ini_matches(obj, target) then
		return true
	end

	return false
end

local function map_spot_object_id(target, npc)
	if not target then
		return nil, nil
	end

	local sim = alife()
	local npc_id = map_spot_object_id_value(npc)
	if npc_id then
		if IsInvbox and IsInvbox(npc) then
			return npc_id, map_spot_se_object_by_id(npc_id)
		end
		if map_spot_storage_matches(npc_id, target) or map_spot_spawn_ini_matches(npc, target) then
			return npc_id, map_spot_se_object_by_id(npc_id)
		end
	end

	local id = tonumber(target)
	if id and id > 0 and id < 65535 then
		local obj = sim:object(id)
		if obj then
			return id, obj
		end
	end

	if get_story_se_object then
		local obj = get_story_se_object(target)
		if obj then
			return obj.id, obj
		end
	end

	if get_story_se_item then
		local obj = get_story_se_item(target)
		if obj then
			return obj.id, obj
		end
	end

	if get_story_object_id then
		id = get_story_object_id(target)
		if id then
			return id, map_spot_se_object_by_id(id)
		end
	end

	if id_by_sid then
		id = id_by_sid(target)
		if id then
			return id, map_spot_se_object_by_id(id)
		end
	end

	if npc and map_spot_object_matches(npc, target) then
		id = map_spot_object_id_value(npc)
		if id then
			return id, map_spot_se_object_by_id(id)
		end
	end

	if db and db.storage then
		for obj_id, st in pairs(db.storage) do
			if map_spot_storage_matches(obj_id, target) then
				local se_obj = map_spot_se_object_by_id(obj_id)
				if se_obj then
					return obj_id, se_obj
				end
			end
		end
	end

	for i = 1, 65534 do
		local obj = sim:object(i)
		if map_spot_object_matches(obj, target) then
			return obj.id or i, obj
		end
	end

	return nil, nil
end
local function apply_map_spot(id, se_obj, spot, hint, online_obj)
	if se_obj then
		se_obj:visible_for_map(true)
	end

	if level.map_has_object_spot(id, spot) == 0 then
		if online_obj then
			level.map_add_object_spot(id, spot, hint)
		else
			level.map_add_object_spot_ser(id, spot, hint)
		end
	else
		level.map_change_spot_hint(id, spot, hint)
	end
end

local function show_map_spot_for_target(target, spot, hint, npc)
	local id, se_obj = map_spot_object_id(target, npc)
	if not id then
		return false
	end

	apply_map_spot(id, se_obj, spot, hint, npc ~= nil and map_spot_object_id_value(npc) == id)
	return true, id
end

local function queue_map_spot(target, spot, hint)
	pending_map_spots[map_spot_key(target, spot)] = { target = target, spot = spot, hint = hint }
end

local function flush_pending_map_spots()
	for key, entry in pairs(pending_map_spots) do
		if show_map_spot_for_target(entry.target, entry.spot, entry.hint) then
			pending_map_spots[key] = nil
		end
	end
end

local function restore_existing_map_spot_visibility()
	if restored_existing_map_spots or _G.anthology_map_spot_visibility_restored then
		return
	end

	restored_existing_map_spots = true
	_G.anthology_map_spot_visibility_restored = true
	local sim = alife()
	for id = 1, 65534 do
		local obj = sim:object(id)
		if obj and not obj:visible_for_map() then
			for i = 1, #anthology_map_spot_sections do
				if level.map_has_object_spot(id, anthology_map_spot_sections[i]) ~= 0 then
					obj:visible_for_map(true)
					break
				end
			end
		end
	end
end

local function map_spot_actor_on_first_update()
	restore_existing_map_spot_visibility()
	flush_pending_map_spots()
end

local function map_spot_server_entity_on_register(se_obj, type_name)
	if not next(pending_map_spots) then
		return
	end

	for key, entry in pairs(pending_map_spots) do
		if map_spot_object_matches(se_obj, entry.target) then
			apply_map_spot(se_obj.id, se_obj, entry.spot, entry.hint, false)
			pending_map_spots[key] = nil
		end
	end
end

function on_game_start()
	if RegisterScriptCallback then
		RegisterScriptCallback("server_entity_on_register", map_spot_server_entity_on_register)
		RegisterScriptCallback("actor_on_first_update", map_spot_actor_on_first_update)
	end
end

function show_spot_on_map(actor, npc, p)
	if not (p and p[1]) then
		printf("show_spot_on_map: target is not set")
		return
	end

	local spot = p[2] or "primary_object"
	local hint = p[3] or ""
	local ok, id = show_map_spot_for_target(p[1], spot, hint, npc)
	if ok then
		printf("show_spot_on_map: target [%s] spot [%s] id [%s]", tostring(p[1]), tostring(spot), tostring(id))
	else
		queue_map_spot(p[1], spot, hint)
		local npc_id = map_spot_object_id_value(npc)
		local st = db and db.storage and npc_id and db.storage[npc_id]
		printf("show_spot_on_map: target [%s] not found, queued; npc_id=[%s] npc_name=[%s] npc_section=[%s] npc_logic=[%s]", tostring(p[1]), tostring(npc_id), tostring(map_spot_object_name(npc)), tostring(map_spot_object_section(npc)), tostring(st and st.ini_filename))
	end
end

function remove_spot_on_map(actor, npc, p)
	if not (p and p[1]) then
		printf("remove_spot_on_map: target is not set")
		return
	end

	local spot = p[2] or "primary_object"
	pending_map_spots[map_spot_key(p[1], spot)] = nil

	local id = map_spot_object_id(p[1], npc)
	if not id then
		printf("remove_spot_on_map: target [%s] not found", tostring(p[1]))
		return
	end

	if level.map_has_object_spot(id, spot) ~= 0 then
		level.map_remove_object_spot(id, spot)
	end
end

function mod_health_and_eat( actor, obj )
	if db.actor:alive() then
		db.actor.health = 1
		db.actor.power = 1
		db.actor.radiation = -1
		db.actor.bleeding = 1
		db.actor.satiety = 1
	end
end

function rst_anm(actor, npc,p)
	local state_mgr = db.storage[npc:id()].state_mgr
	if state_mgr == nil then
		return
	end
	local planner = npc:motivation_action_manager()

	state_mgr.animation:set_state(nil, true)
	state_mgr.animation:set_control()
	state_mgr.animstate:set_state(nil, true)
	state_mgr.animstate:set_control()

	state_mgr:set_state("idle", nil, nil, nil, {fast_set = true})

	state_mgr:update()
	state_mgr:update()
	state_mgr:update()
	state_mgr:update()
	state_mgr:update()
	state_mgr:update()
	state_mgr:update()

	npc:set_body_state(move.standing)
	npc:set_mental_state(anim.free)
end

function give_game_news(actor, npc, p)
local actor = db.actor
local news_caption = game.translate_string(p[1])
local news_text = game.translate_string(p[2])
actor:give_game_news(news_caption, news_text, p[3], 0, p[4])
end

function hit_obj_electric(actor, npc, p)
	local h = hit()
	local obj = get_story_object(p[1])
	local sid = nil

	if not obj then
--    abort("HIT_OBJ [%s]. Target object does not exist", npc:name())
		return
	end

	h:bone(p[2])
	h.power = p[3]
	h.impulse = p[4]

	if p[5] then
		sid = get_story_object(sid)
		if sid then
			h.direction = vector():sub(sid:position(), obj:position())
		end
		if not sid then
			h.direction = vector():sub(patrol(p[5]):point(0), obj:position())
		end
	else
		h.direction = vector():sub(npc:position(), obj:position())
	end

	h.draftsman = sid or npc
	h.type = hit.shock
	obj:hit(h)
end

