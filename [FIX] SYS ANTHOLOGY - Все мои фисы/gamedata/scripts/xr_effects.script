function show_go_to_from_institut2( actor, npc, p )
	local text = ""
	if p[ 1 ] == "to" then
		text = "%c[default]%c[255,238,153,26]Покинуть научно-исследовательский институт?"
	else
		text = "%c[default]%c[255,238,153,26]Покинуть научно-исследовательский институт?"
	end
	show2( "message_box_yes_no", text )
end

function show2( mb_type, text )
	game_control = inst_mod_changer2()
	game_control:Show2( mb_type, text )
end

class "inst_mod_changer2" ( CUIScriptWnd )
function inst_mod_changer2:__init() super()
	self:SetWndRect( Frect():set( 0, 0, 1024, 768 ) )
	self.freeplay_mb = CUIMessageBoxEx()
	self:Register( self.freeplay_mb, "freeplay_mb" )

	self:AddCallback( "freeplay_mb", ui_events.MESSAGE_BOX_OK_CLICKED, self.OnMsgOk, self )
	self:AddCallback( "freeplay_mb", ui_events.MESSAGE_BOX_YES_CLICKED, self.OnMsgYes, self )
	self:AddCallback( "freeplay_mb", ui_events.MESSAGE_BOX_NO_CLICKED, self.OnMsgNo, self )
end

function inst_mod_changer2:Show2( mb_type, text )
	self.freeplay_mb:InitMessageBox( mb_type )
	self.freeplay_mb:SetText( text )
    self.freeplay_mb:ShowDialog( true )
end

function inst_mod_changer2:OnMsgOk()
	db.actor:give_info_portion( "inst_n1_actor_in_inst2" )
end

function inst_mod_changer2:OnMsgYes()
	db.actor:give_info_portion( "inst_n1_actor_in_inst2" )
end

function inst_mod_changer2:OnMsgNo()
	db.actor:give_info_portion( "inst_n1_actor_out_inst2" )
end

function show_go_to_from_institut( actor, npc, p )
	local text = ""
	if p[ 1 ] == "to" then
		text = "%c[default]%c[255,238,153,26]Войти в научно-исследовательский институт?"
	else
		text = "%c[default]%c[255,238,153,26]Войти в научно-исследовательский институт?"
	end
	show( "message_box_yes_no", text )
end

function show( mb_type, text )
	game_control = inst_mod_changer()
	game_control:Show( mb_type, text )
end

class "inst_mod_changer" ( CUIScriptWnd )
function inst_mod_changer:__init() super()
	self:SetWndRect( Frect():set( 0, 0, 1024, 768 ) )
	self.freeplay_mb = CUIMessageBoxEx()
	self:Register( self.freeplay_mb, "freeplay_mb" )

	self:AddCallback( "freeplay_mb", ui_events.MESSAGE_BOX_OK_CLICKED, self.OnMsgOk, self )
	self:AddCallback( "freeplay_mb", ui_events.MESSAGE_BOX_YES_CLICKED, self.OnMsgYes, self )
	self:AddCallback( "freeplay_mb", ui_events.MESSAGE_BOX_NO_CLICKED, self.OnMsgNo, self )
end

function inst_mod_changer:Show( mb_type, text )
	self.freeplay_mb:InitMessageBox( mb_type )
	self.freeplay_mb:SetText( text )
    self.freeplay_mb:ShowDialog( true )
end

