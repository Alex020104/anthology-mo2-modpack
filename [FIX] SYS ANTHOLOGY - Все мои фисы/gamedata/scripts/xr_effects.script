function remove_item_no_news( actor, npc, p )
	if (p and p[1]) == nil then abort("Wrong parameters in function 'remove_item_no_news'!!!") end
	local item = p[1]

	local obj = actor:object( item )
	if obj ~= nil then
		alife():release( alife():object( obj:id() ), true )
	else
		abort("Actor has no such item!")
	end
end

