function disable_ui_hud(actor, npc)
    local hud = get_hud()
	hud:HidePdaMenu()
	hud:HideActorMenu()
end

function disable_ui_inventory(actor, npc)
	if db.actor:is_talking() then
		db.actor:stop_talk()
	end

	if not p or (p and p[1] ~= "true") then
		local slot = db.actor:active_slot()
		if(slot~=0) then
			ui_active_slot = slot
			db.actor:activate_slot(0)
		end
	end

	local hud = get_hud()
	hud:HidePdaMenu()
	hud:HideActorMenu()
end

