function control_position( actor, npc, p )
	if p then
		if p[ 3 ] ~= nil then
			if p[ 3 ] == "true" then
				npc:movement_enabled( false )
			end
		end
		local distance = tonumber( p[ 2 ] ) or 0.5
		local position_point = patrol( p[ 1 ] ):point( 0 )
		if npc:position():distance_to_sqr( position_point ) >= distance * distance then
			reset_animation( npc )
			npc:set_npc_position( position_point )
		end
	end
end

