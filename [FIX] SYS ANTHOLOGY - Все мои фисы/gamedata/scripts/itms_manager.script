----------------------------------------------------------------------------------------------------
-- FIX: Артефакты в инвентаре НПС (СИМКИ) теряют condition 33-66%
--
-- Баг: death_manager.script вызывает alife_create_item(section, npc, item_prop_table)
-- с item_prop_table = { cond_r = {30,70}, cond_ct = "part", cond_cr = {0.5,0.75,1} }
-- Но в ItemProcessor:Create_Item проверка utils_item.is_degradable(nil, section)
-- стоит ПЕРЕД использованием t.cond_r. Для артефактов is_degradable = false,
-- поэтому cond_r игнорируется, и артефакт спавнится с дефолтным condition (100%).
--
-- При перезагрузке сейва condition остаётся 100%, потому что bind_item.script
-- не сохраняет его — self.degradable = false для артефактов.
--
-- Фикс: перехватываем ItemProcessor:Create_Item и форсируем установку condition
-- для любых предметов, у которых в t (property table) передан cond_r/cond_cr/cond.
-- Также фиксим bind_item.script, добавляя артефакты в список degradable для сериализации.
----------------------------------------------------------------------------------------------------

do
	local c_instance = itms_manager.ItemProcessor

	local _Create_Item = c_instance.Create_Item
	function c_instance:Create_Item(section, owner, t)
		local se_itm = _Create_Item(self, section, owner, t)
		if not se_itm then return se_itm end

		t = t or {}
		local cond

		if t.cond then
			cond = t.cond
		elseif t.cond_cr and t.cond_ct and IsItem(t.cond_ct, section) then
			cond = (#t.cond_cr > 2) and self:Random_Choice(t.cond_cr) or self:Random_Condition(t.cond_cr)
		elseif t.cond_r then
			cond = (#t.cond_r > 2) and self:Random_Choice(t.cond_r) or self:Random_Condition(t.cond_r)
		end

		-- Если есть явный cond, применяем его даже для недеградабельных предметов (артефактов)
		if cond then
			self.Cond[se_itm.id] = cond
		end

		return se_itm
	end
end

do
	-- FIX: bind_item.script — артефакты не сохраняют condition при перезагрузке сейва.
	-- Добавляем IsArtefact(obj) в условие для self.degradable.

	local _item_binder_update = item_binder.update
	function item_binder:update(delta)
		if not self.first_update then
			self.first_update = true
			local obj = self.object
			local id = obj:id()

			local mdata = alife_storage_manager.get_state()
			if mdata.device_condition and mdata.device_condition[id] then
				item_condition[id] = mdata.device_condition[id]
				mdata.device_condition[id] = nil
			end

			if item_uses[id] then
				obj:set_remaining_uses(item_uses[id])
			elseif item_condition[id] then
				obj:set_condition(item_condition[id])
			end

			local sec = obj:section()
			if IsItem("multiuse", sec) then
				self.multiuse = true
			elseif ini_sys:r_bool_ex(sec, "use_condition") or IsArtefact(obj) then
				-- FIX: артефакты теперь тоже сохраняют condition между загрузками сейва
				self.degradable = true
			end

			return
		end

		if self.multiuse then
			item_uses[self.object:id()] = self.object:get_remaining_uses()
		elseif self.degradable then
			item_condition[self.object:id()] = self.object:condition()
		end
	end
end
