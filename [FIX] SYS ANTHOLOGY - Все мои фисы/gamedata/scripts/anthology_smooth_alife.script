local EVENT_ID = "anthology_smooth_alife"

local WARMUP_OBJECTS_PER_UPDATE = 4
local NORMAL_OBJECTS_PER_UPDATE = 8
local SLEEP_OBJECTS_PER_UPDATE = 4
local SLEEP_RECOVERY_OBJECTS_PER_UPDATE = 16
local SLEEP_PRIME_OBJECTS_PER_UPDATE_1 = 4096
local SLEEP_PRIME_OBJECTS_PER_UPDATE_2 = 8192
local SLEEP_PRIME_OBJECTS_PER_UPDATE_3 = 16384
local CACHE_PRIME_OBJECTS_PER_UPDATE = 65534
local CACHE_PRIME_DURATION_SEC = 0.25
local SLEEP_PRIME_DURATION_SEC = 0.2
local WARMUP_SWITCH_DISTANCE = 2000
local NORMAL_SWITCH_DISTANCE = 150
local SLEEP_FINAL_SWITCH_DISTANCE = 2000
local SWITCH_DISTANCE_WARMUP_SEC = 5
local RESTORE_DELAY_SEC = 60
local SLEEP_RESTORE_DELAY_SEC = 20
local OFFLINE_COMBAT_DELAY_SEC = 45
local PRIMARY_SPOTS_DELAY_SEC = 30
local DEFERRED_STORY_WORK_RELEASE_SEC = 45
local MAP_SPOT_FLUSH_BATCH = 4
local MAP_SPOT_FLUSH_INTERVAL_SEC = 0.35

_G.anthology_smooth_story_id_defer = true
_G.anthology_map_spot_visibility_restored = true

local original_show_spot_on_map
local map_spot_patch_installed = false
local queued_map_spots = {}
local queued_map_spot_index = 1

local function get_alife_sim()
	if type(alife) ~= "function" then
		return nil
	end

	local ok, sim = pcall(alife)
	if not (ok and sim) then
		return nil
	end

	return sim
end

local function set_objects_per_update(value)
	local sim = get_alife_sim()
	if not sim then
		return
	end

	pcall(function()
		sim:set_objects_per_update(value)
	end)
end

local function set_switch_distance(value)
	local sim = get_alife_sim()
	if not sim then
		return
	end

	local ok = pcall(function()
		sim:set_switch_distance(value)
	end)
	if ok then
		return
	end

	pcall(function()
		sim:switch_distance(value)
	end)
end

local function set_story_id_defer(enabled)
	_G.anthology_smooth_story_id_defer = enabled and true or false
end

local function create_time_event(action_id, delay, func)
	if type(CreateTimeEvent) ~= "function" then
		return
	end

	if type(RemoveTimeEvent) == "function" then
		RemoveTimeEvent(EVENT_ID, action_id)
	end

	CreateTimeEvent(EVENT_ID, action_id, delay, func)
end

local function queue_map_spot_request(actor, npc, p)
	if type(p) ~= "table" then
		return
	end

	queued_map_spots[#queued_map_spots + 1] = {
		actor = actor,
		npc = npc,
		p = { p[1], p[2], p[3] },
	}
end

local function flush_map_spot_queue()
	if not original_show_spot_on_map then
		return true
	end

	local processed = 0
	while processed < MAP_SPOT_FLUSH_BATCH and queued_map_spot_index <= #queued_map_spots do
		local entry = queued_map_spots[queued_map_spot_index]
		queued_map_spot_index = queued_map_spot_index + 1
		processed = processed + 1

		if entry then
			pcall(original_show_spot_on_map, entry.actor, entry.npc, entry.p)
		end
	end

	if queued_map_spot_index <= #queued_map_spots then
		create_time_event("flush_map_spot_queue", MAP_SPOT_FLUSH_INTERVAL_SEC, flush_map_spot_queue)
	else
		queued_map_spots = {}
		queued_map_spot_index = 1
	end

	return true
end

local function ensure_map_spot_patch()
	if map_spot_patch_installed then
		return
	end

	if not (xr_effects and type(xr_effects.show_spot_on_map) == "function") then
		return
	end

	original_show_spot_on_map = xr_effects.show_spot_on_map
	xr_effects.show_spot_on_map = function(actor, npc, p)
		if _G.anthology_smooth_story_id_defer then
			queue_map_spot_request(actor, npc, p)
			return true
		end

		return original_show_spot_on_map(actor, npc, p)
	end

	map_spot_patch_installed = true
end

local function delay_offline_combat()
	if type(ResetTimeEvent) == "function" then
		pcall(ResetTimeEvent, "cycle", "ocs", OFFLINE_COMBAT_DELAY_SEC)
	end
	return true
end

local function release_deferred_story_work()
	set_story_id_defer(false)
	flush_map_spot_queue()
	return true
end

local function restore_objects_per_update()
	set_story_id_defer(false)
	flush_map_spot_queue()
	set_switch_distance(NORMAL_SWITCH_DISTANCE)
	set_objects_per_update(NORMAL_OBJECTS_PER_UPDATE)
	return true
end

local function restore_switch_distance()
	set_switch_distance(NORMAL_SWITCH_DISTANCE)
	return true
end

local function restore_warmup_objects_per_update(objects_per_update)
	set_objects_per_update(objects_per_update)
	return true
end

local function delay_known_events()
	if type(ResetTimeEvent) == "function" then
		pcall(ResetTimeEvent, 0, "ScanForSpots", PRIMARY_SPOTS_DELAY_SEC)
	end
	return true
end

local function start_warmup(objects_per_update)
	ensure_map_spot_patch()
	set_story_id_defer(true)
	set_switch_distance(WARMUP_SWITCH_DISTANCE)
	set_objects_per_update(CACHE_PRIME_OBJECTS_PER_UPDATE)
	create_time_event("delay_ocs", 0.2, delay_offline_combat)
	create_time_event("restore_warmup_objects", CACHE_PRIME_DURATION_SEC, function()
		return restore_warmup_objects_per_update(objects_per_update)
	end)
	create_time_event("delay_known_events_1", 0.5, delay_known_events)
	create_time_event("switch_distance_refresh_1", 0.5, function()
		set_switch_distance(WARMUP_SWITCH_DISTANCE)
		return true
	end)
	create_time_event("warmup_refresh_1", 1.5, function()
		set_switch_distance(WARMUP_SWITCH_DISTANCE)
		set_objects_per_update(objects_per_update)
		return true
	end)
	create_time_event("warmup_refresh_2", 5, function()
		set_objects_per_update(objects_per_update)
		return true
	end)
	create_time_event("restore_switch_distance", SWITCH_DISTANCE_WARMUP_SEC, restore_switch_distance)
	create_time_event("delay_known_events_2", 6, delay_known_events)
	create_time_event("warmup_refresh_3", 12, function()
		set_objects_per_update(objects_per_update)
		return true
	end)
	create_time_event("delay_known_events_3", 12, delay_known_events)
	create_time_event("warmup_refresh_4", 25, function()
		set_objects_per_update(objects_per_update)
		return true
	end)
	create_time_event("warmup_refresh_5", 45, function()
		set_objects_per_update(objects_per_update)
		return true
	end)
	create_time_event("release_deferred_story_work", DEFERRED_STORY_WORK_RELEASE_SEC, release_deferred_story_work)
	create_time_event("restore_objects", RESTORE_DELAY_SEC, restore_objects_per_update)
end

local function start_sleep_warmup()
	ensure_map_spot_patch()
	set_story_id_defer(true)
	set_objects_per_update(SLEEP_OBJECTS_PER_UPDATE)
	create_time_event("delay_ocs", 0.2, delay_offline_combat)
	create_time_event("delay_known_events_1", 0.5, delay_known_events)

	create_time_event("sleep_prime_1", 1.5, function()
		set_switch_distance(SLEEP_FINAL_SWITCH_DISTANCE)
		set_objects_per_update(SLEEP_PRIME_OBJECTS_PER_UPDATE_1)
		return true
	end)
	create_time_event("sleep_prime_restore_1", 1.5 + SLEEP_PRIME_DURATION_SEC, function()
		set_objects_per_update(SLEEP_RECOVERY_OBJECTS_PER_UPDATE)
		return true
	end)

	create_time_event("sleep_prime_2", 3.5, function()
		set_switch_distance(SLEEP_FINAL_SWITCH_DISTANCE)
		set_objects_per_update(SLEEP_PRIME_OBJECTS_PER_UPDATE_2)
		return true
	end)
	create_time_event("sleep_prime_restore_2", 3.5 + SLEEP_PRIME_DURATION_SEC, function()
		set_objects_per_update(SLEEP_RECOVERY_OBJECTS_PER_UPDATE)
		return true
	end)

	create_time_event("sleep_prime_3", 7, function()
		set_switch_distance(SLEEP_FINAL_SWITCH_DISTANCE)
		set_objects_per_update(SLEEP_PRIME_OBJECTS_PER_UPDATE_3)
		return true
	end)
	create_time_event("sleep_prime_restore_3", 7 + SLEEP_PRIME_DURATION_SEC, function()
		set_objects_per_update(SLEEP_RECOVERY_OBJECTS_PER_UPDATE)
		return true
	end)

	create_time_event("release_deferred_story_work", DEFERRED_STORY_WORK_RELEASE_SEC, release_deferred_story_work)
	create_time_event("restore_objects", SLEEP_RESTORE_DELAY_SEC, restore_objects_per_update)
end

local function on_game_load()
	start_warmup(WARMUP_OBJECTS_PER_UPDATE)
end

local function actor_on_first_update()
	start_warmup(WARMUP_OBJECTS_PER_UPDATE)
end

local function actor_on_sleep()
	start_sleep_warmup()
end

function on_game_start()
	ensure_map_spot_patch()
	set_story_id_defer(true)
	RegisterScriptCallback("on_game_load", on_game_load)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_sleep", actor_on_sleep)
end
