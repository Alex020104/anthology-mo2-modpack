--------------------------------------------------------------------------------
-- Space restrictor scheme for crowkiller minigame -----------------------------
-- Made by Peacemaker ----------------------------------------------------------
-- 26.12.07 --------------------------------------------------------------------
--------------------------------------------------------------------------------
class "crowkiller"

local CROW_SECTION = "m_crow"
local CROW_GLOBAL_LIMIT = 80
local CROW_CLEANUP_THRESHOLD = 120
local CROW_CLEANUP_BATCH = 100
local CROW_CLEANUP_INTERVAL = 5000
local CROW_SCAN_INTERVAL = 60000
local CROW_ALIFE_STOP = 63000

local crow_cache = {
	next_scan = 0,
	count = 0,
	offline_ids = {}
}

local function is_online_crow(id)
	return bind_crow and bind_crow.crow_storage and bind_crow.crow_storage[id] ~= nil
end

local function scan_saved_crows(force)
	local tg = time_global()
	if (not force) and (tg < crow_cache.next_scan) then
		return crow_cache.count
	end

	local sim = alife()
	local count = 0
	local offline_ids = {}
	if sim then
		for id = 1, 65534 do
			local se_obj = sim:object(id)
			if se_obj and se_obj:section_name() == CROW_SECTION then
				count = count + 1
				if not is_online_crow(id) then
					offline_ids[#offline_ids + 1] = id
				end
			end
		end
	end

	crow_cache.next_scan = tg + CROW_SCAN_INTERVAL
	crow_cache.count = count
	crow_cache.offline_ids = offline_ids
	return count
end

local function cleanup_saved_crows(force)
	local count = scan_saved_crows(force)
	if count <= CROW_GLOBAL_LIMIT then
		return count
	end

	local sim = alife()
	if not sim then
		return count
	end

	local released = 0
	for i = 1, #crow_cache.offline_ids do
		if count <= CROW_GLOBAL_LIMIT or released >= CROW_CLEANUP_BATCH then
			break
		end

		local id = crow_cache.offline_ids[i]
		local se_obj = sim:object(id)
		if se_obj and se_obj:section_name() == CROW_SECTION and not is_online_crow(id) then
			safe_release_manager.release(se_obj)
			released = released + 1
			count = count - 1
		end
	end

	if released > 0 then
		printf("[CROW_RESCUE] released %s offline crows, remaining about %s", released, count)
		crow_cache.next_scan = 0
		crow_cache.count = count
	end

	return count
end

-- Class constructor
function crowkiller:__init(obj, storage)
    self.object = obj
    self.st = storage
    self.time_for_spawn = time_global()
    self.spawn_points_idle = {}
    self.spawned_count = nil
end
-- On scheme switch resets all self params
function crowkiller:reset_scheme()
    for k,v in pairs(self.st.path_table) do
        self.spawn_points_idle[v] = time_global()
    end
end
-- Class update
function crowkiller:update(delta)
-- check for spawn crows on level
    if(self.time_for_spawn<time_global()) then
        self.spawned_count = bind_crow.crow_counter
		local saved_crows = cleanup_saved_crows(false)
		local surge_or_storm = (surge_manager.is_started() and not surge_manager.is_finished()) or (psi_storm_manager.is_started() and not psi_storm_manager.is_finished())
        if saved_crows > CROW_CLEANUP_THRESHOLD then
            cleanup_saved_crows(true)
            self.time_for_spawn = time_global() + CROW_CLEANUP_INTERVAL
        elseif (_ALIFE_CNT and _ALIFE_CNT >= CROW_ALIFE_STOP) then
            self.time_for_spawn = time_global() + CROW_SCAN_INTERVAL
        elseif(not surge_or_storm and self.spawned_count<self.st.max_crows_on_level and saved_crows<CROW_GLOBAL_LIMIT) then
            if self:check_for_spawn_new_crow() then
				crow_cache.count = saved_crows + 1
			end
			self.time_for_spawn = time_global() + 30000
        else
            self.time_for_spawn = time_global() + 120000
        end
    end

    if(xr_logic.try_switch_to_another_section(self.object, self.st, db.actor)) then
        return
    end
end
-- Checks a need for spawn a new crow
function crowkiller:check_for_spawn_new_crow()
	if not (self.st and self.st.path_table and db.actor) then
		return
	end
	if (#self.st.path_table < 1) then
		return false
	end
	local n = math.random(1,#self.st.path_table)
	local selected_path = self.st.path_table[n]
	local tg = time_global()
	self.spawn_points_idle = self.spawn_points_idle or {}
	if (selected_path) and (self.spawn_points_idle[selected_path] == nil or tg > self.spawn_points_idle[selected_path]) then
		local ok_ptr, ptr = pcall(function() return patrol(selected_path) end)
		if not (ok_ptr and ptr) then
			self.spawn_points_idle[selected_path] = tg + 60000
			return false
		end
		local ok_data, point, lvid, gvid = pcall(function()
			return ptr:point(0), ptr:level_vertex_id(0), ptr:game_vertex_id(0)
		end)
		local ok_actor_pos, actor_pos = pcall(function() return db.actor:position() end)
		if (ok_data and ok_actor_pos and point and lvid and gvid and actor_pos and point:distance_to_sqr(actor_pos)>10000) then
			self.spawn_points_idle[selected_path] = time_global() + 10000
			alife_create(CROW_SECTION, point, lvid, gvid)
			return true
		end
	end
	return false
end
--------------------------------------------------------------------------------
-- Standart functions
--------------------------------------------------------------------------------
function add_to_binder(npc, ini, scheme, section, storage)
    xr_logic.subscribe_action_for_events(npc, storage, crowkiller(npc, storage))
end
function set_scheme(obj, ini, scheme, section, gulag_name)
    local st = xr_logic.assign_storage_and_bind(obj, ini, scheme, section)
    st.logic = xr_logic.cfg_get_switch_conditions(ini, section, obj)

    st.max_crows_on_level = ini:r_float_ex(section,"max_crows_on_level") or 7

    local path = ini:r_string_ex(section,"spawn_path")
    st.path_table = path and parse_names(path) or nil
end
