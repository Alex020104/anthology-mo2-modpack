end

function sad_dist_to_squad_ge(actor, npc, p) -- dist^2
	local position
	local squad = get_story_squad(p[1])
	if squad == nil then
		return true
	end
	for k in squad:squad_members() do
		position = (db.storage[k.id] and db.storage[k.id].object and db.storage[k.id].object:position()) or k.object.position
		if db.actor:position():distance_to_sqr(position) < p[2] then
			return false
		end
	end
	return true
end

function sad_dist_to_squad_le(actor, npc, p) -- dist^2
	local position
	local squad = get_story_squad(p[1])
	if squad == nil then
		return false
	end
	for k in squad:squad_members() do
		position = (db.storage[k.id] and db.storage[k.id].object and db.storage[k.id].object:position()) or k.object.position
		if db.actor:position():distance_to_sqr(position) < p[2] then
			return true
		end
	end
	return false
end

function sad_is_actor_gulag_enemy(actor, npc,p)
	if p[1]==nil then
		return false
	end
	local gulag = xr_gulag.get_gulag_by_name(p[1])
	for k,v in pairs(gulag.npc_info) do
		local sobj = v.se_obj
		if sobj ~= nil then
			local object = db.storage[sobj.id] and db.storage[sobj.id].object
			if object ~= nil then
				if object:relation(actor) == game_object.enemy then
					return true
				end
			end
		end
	end
	
	return false
end

function sad_sim_16_actor_in_zone(actor, npc, p)
	local actor_position = actor:position()
	if actor_position:distance_to_sqr( vector():set(-174.0, 0.0, -26.0) ) < 2500.0 then return true end
	if actor_position:distance_to_sqr( vector():set(-210.0, 0.0, 15.0) ) < 1850.0 then return true end
	return false
end

function sad_actor_activate_granata(actor, npc)
	local obj = actor:active_item ()
	if obj == nil then return false end
	if obj:section() ~= "grenade_rgd5" and obj:section() ~= "grenade_f1" then return false end
	return true
end

function sad_ready_to_take_zombo_art(actor,npc,p)
	local dev = device()
	local vec = vector():set(413.7, -16.44, 243.0)
	if vec:distance_to_sqr(dev.cam_pos) > 5. then return false end
	vec:sub(dev.cam_pos)
	vec:normalize()
	return dev.cam_dir:dotproduct(vec) > 0.95 	-- ~18 deg
end

function sad_zombocave_check(actor,npc,p)
	local dev = device()
	local actor_pos = dev.cam_pos --actor:position()
	local pos = vector():set(429.35,-15.406,238.775)
	if p[1] == 2 then
		pos = vector():set(422.71,-15.406,258.434)
	elseif p[1] == 3 then
		pos = vector():set(403.568,-15.406,245.062)
	end
	if p[2] == 2 then
		return actor_pos:distance_to_sqr(pos) < 16.0
	end
	if actor_pos:distance_to_sqr(pos) > 25.0 then 
		return false
	end
	local the_angle = pos:sub(actor_pos):getH() - dev.cam_dir:getH()		--actor:direction():getH()
	if math.abs(the_angle) > 2.0 then
		return false
	end
	return true
end

function is_actor_look_at_point(actor, npc, p) -- (patrol_path:point_index:angle)
	local point_path = patrol(p[1])
	local point_index = p[2]
	local the_angle = tonumber(p[3])
	local dev = device()
	local vec = patrol(point_path):point(point_index)
	vec:sub(pos, dev.cam_pos)
	vec:normalize()
	local dp = math.deg(math.acos(dev.cam_dir:dotproduct(vec)))
	return dp <= the_angle
end

function actor_dont_look_at_squad(actor, npc, p)
	local squad = get_story_squad(p[1])
	if squad == nil then
		return true
	end
	local npc_dir
	local dev = device()
	local dir = dev.cam_dir
	if math.abs(dir.y) > 0.9 then
		return true
	end
	dir.y = 0
	dir:normalize()
	for k in squad:squad_members() do
		npc_dir = (db.storage[k.id] and db.storage[k.id].object and db.storage[k.id].object:position()) or k.object.position
		npc_dir:sub(db.actor:position())
		npc_dir.y = 0
		npc_dir:normalize()
		if npc_dir:dotproduct(dir) > .65 then
			return false
		end
	end
	return true
end

function sad_actor_in_bottom(actor, npc, p)
	if db.actor == nil then
		return false
	end
	local pos = actor:position()
	if pos.y > -17.5 then
		return false
	end
	pos.y = 0
	-- zombocave
	if pos:distance_to_sqr(vector():set(398, 0, 208)) < 441.0 then return false end
	if pos.x>396 and pos.x<436 and pos.z>206 and pos.z<266 then return false end
	-- sim 18
	if pos:distance_to_sqr(vector():set(255.6, 0, -87.3)) < 1850.0 then return false end
	return true
end

function sad_cave_actor_side_check(actor, npc, p)
	if db.actor == nil then
		return false
	end
	return db.actor:position().x > -398.0
end

function squad_near_point_all(actor, npc, p) -- {squad,path,point,dist^2}
	local story_id = p[1]
	local squad = get_story_squad(story_id)
	if squad == nil then
		return false
	end
	
	local dest_point = patrol(p[2]):point(p[3])

	for k in squad:squad_members() do
		local position = (db.storage[k.id] and db.storage[k.id].object and db.storage[k.id].object:position()) or k.object.position
		if position:distance_to_sqr(dest_point) > p[4] then
			return false
		end
	end
	return true
end

function squad_near_point(actor, npc, p) -- {squad,path,point,dist^2}
	local story_id = p[1]
	local squad = get_story_squad(story_id)
	if squad == nil then
		return false
	end
	
	local dest_point = patrol(p[2]):point(p[3])

	for k in squad:squad_members() do
		local position = (db.storage[k.id] and db.storage[k.id].object and db.storage[k.id].object:position()) or k.object.position
		if position:distance_to_sqr(dest_point) <= p[4] then
			return true
		end
	end
	return false
end

function sad_grisha_check_for_teleport(actor, npc, p)
	if db.actor == nil then
		return false
	end
	local pos = actor:position()
	if pos.x < 275.0 or pos.z < 265.0 then
		return false
	end
	local dev = device()
	local dir = dev.cam_dir
	if math.abs(dir.y) > 0.95 then
		return true
	end
	dir.y = 0
	dir:normalize()
	if vector():set(1,0,0):dotproduct(dir) < .2 then
		return false
	end
	return true
end

function sad_turist_visit_check(actor, npc, p)
	-- p[1]=squad
	--local squad = get_story_squad(p[1])
	--if squad == nil then
		--return false
	--end
	if squad_has_enemy(actor, nil, {p[1]}) then
		return false
	end
	
	local pos = actor:position()
	
	if pos.z > 80 then	-- ???????? ???5
		if not has_alife_info("sad_turist_visit_sim_5") then
			if pos:distance_to_sqr(vector():set(-3.9, -7.0, 316.1)) < 625 then
				if squad_near_point_all(actor, nil, {p[1],"sad_sim_5_walker_2_look",0,400}) then
					give_info("sad_turist_visit_sim_5")
					return true
				end
			end
		end
	elseif pos.x < -40 then
		if not has_alife_info("sad_turist_visit_sim_15") then
			if pos:distance_to_sqr(vector():set(-75, -6, -66)) < 625 then
				if squad_near_point_all(actor, nil, {p[1],"sad_start_turist_sim_15_1_walk",0,400}) then
					give_info("sad_turist_visit_sim_15")
					return true
				end
			end
		end
		if not has_alife_info("sad_turist_visit_cave") then
			if pos:distance_to_sqr(vector():set(-351, -12, -160)) < 350 then
				if squad_near_point_all(actor, nil, {p[1],"sad_start_turist_cave_look",0,350}) then
					give_info("sad_turist_visit_cave")
					return true
				end
			end
		end
	elseif pos.x > 300 then -- ???????? ???17
		if not has_alife_info("sad_turist_visit_sim_17") then
			if pos:distance_to_sqr(vector():set(370.5, -7.7, -330.8)) < 625 then
				if squad_near_point_all(actor, nil, {p[1],"sad_sim_18_ucheny_zamer2_walk",0,400}) then
					give_info("sad_turist_visit_sim_17")
					return true
				end
			end
		end
	else -- ???????? ???18 ? ???9
		if not has_alife_info("sad_turist_visit_sim_18") then
			if pos:distance_to_sqr(vector():set(248.4, -10.0, -78.7)) < 625 then
				if squad_near_point_all(actor, nil, {p[1],"sad_sim_18_ucheny_zamer_walk",0,400}) then
					give_info("sad_turist_visit_sim_18")
					return true
				end
			end
		end
		if not has_alife_info("sad_turist_visit_sim_9") then
			if pos:distance_to_sqr(vector():set(186.3, -6.5, -173.4)) < 625 then
				if squad_near_point_all(actor, nil, {p[1],"sad_sim_9_monster_home_1",0,400}) then
					give_info("sad_turist_visit_sim_9")
					return true
				end
			end
		end
	end
	
	return false
end

function turist_combat_check(enemy, npc, p)
-- turist_ignore_default, turist_ignore_until_actor, turist_ignore_by_dist_30, turist_ignore_by_dist_50, turist_ignore_follow_actor_20
	if has_alife_info("turist_ignore_follow_actor_20") then
		return db.actor:position():distance_to_sqr(npc:position()) >= 400
	end
	if has_alife_info("turist_ignore_default") then
		return false
	end
	if has_alife_info("turist_ignore_until_actor") then
		return true
	end
	if has_alife_info("turist_ignore_by_dist_30") then
		return enemy:position():distance_to_sqr(npc:position()) >= 900
	elseif has_alife_info("turist_ignore_by_dist_50") then
		return enemy:position():distance_to_sqr(npc:position()) >= 2500
	end
	return false
end

function sad_actor_b3_far_enough(actor, npc, p)
	if db.actor == nil then
		return false
	end
	return (actor:position().x < -220 and actor:position().z > 250)
end

function sad_actor_activate_item(actor, npc, p)
	local obj = actor:active_item ()
	if obj == nil then return false end
	for k, v in pairs(p) do
		if obj:section() == v then return true end
	end
	return false
end

function check_npc_state(actor, npc, p)
	local state_mgr = db.storage[npc:id()].state_mgr
	if state_mgr == nil then
		return false
	end
	return state_mgr.target_state == p[1]
end

--' ???????? ?? ????????? ????? ????????? ????????????
function smart_captured_by_faction(actor,obj,p)
	local smart_name = p[1]
	local faction_name = p[2]

	if smart_name == nil or faction_name == nil then
		abort("Wrong parameters")
	end

	local smrt = sim_board.get_sim_board().smarts_by_names[smart_name]
	if smrt == nil then
		abort("Smart name [%s] doesn't exist.", smart_name)
	end

	if smrt.faction == faction_name then
		return true
	end
	return false
end

