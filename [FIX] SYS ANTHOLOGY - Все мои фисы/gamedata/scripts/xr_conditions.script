function is_monster_chimera(actor, npc)
	return npc:clsid() == clsid.chimera_s
end

function is_monster_gigant(actor, npc)
	return npc:clsid() == clsid.gigant_s
end

function sad_sher_actor_has_needed_food(actor, npc, p)
	return dialogs_sad.sad_sher_actor_has_needed_food(actor, npc)
end

function sad_actor_has_killer_outfit(actor, npc, p)
	if actor:item_in_slot(7) ~= nil and actor:item_in_slot(7):section() == "killer_outfit" then 
		return true 
	end
	return false
end


function sad_warning_check(actor, npc, p) -- p[1]=dist^2
	if npc:relation(actor) == game_object.enemy then
		return false
	end
	local wobj = actor:active_item ()
	if wobj == nil then 
		return false
	end
	if isWeapon_cop (wobj) == false then 
		return false
	end
	local dist = p[1] or 25

	return npc:position():distance_to_sqr(actor:position()) <= dist
end

function sad_dist_to_path_ge(actor, npc, p) -- (path, dist^2, index)
	local patrol_path = p[1]
	if patrol_path == nil then
		return true
	end
	local dist = p[2] or 25
	local patrol_point_index = p[3] or 0
	local patrol_position = patrol(patrol_path):point(patrol_point_index)
	return db.actor:position():distance_to_sqr(patrol_position) > dist
end

function sad_dist_to_path_le(actor, npc, p) -- (path, dist^2, index)
	local patrol_path = p[1]
	if patrol_path == nil then
		return true
	end
	local dist = p[2] or 25
	local patrol_point_index = p[3] or 0
	local patrol_position = patrol(patrol_path):point(patrol_point_index)
	return db.actor:position():distance_to_sqr(patrol_position) < dist
end

function sad_sim_9_mob_combat_check(actor, npc, p)
	local actor_position = actor:position()
	if actor_position.z > - 101.0 then return false end
	if actor_position:distance_to_sqr( vector():set(177.0, 0.0, -187.0) ) < 7396.0 then return true end
	if actor_position:distance_to_sqr( vector():set(253.0, 0.0, -191.0) ) < 3025.0 then return true end
	return false
end

