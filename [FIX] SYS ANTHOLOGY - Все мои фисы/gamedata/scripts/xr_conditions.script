function pb_find_food_for_duty_check(first_speaker, second_speaker)
local item_sections	= {
		[1] = "bread",
		[2] = "kolbasa",
		[3] = "conserva",
		[4] = "tushonka",
		[5] = "protein",
		[6] = "tomato",
		[7] = "sausage",
		[8] = "corn",
		[9] = "beans",
		[10] = "chili",
		[11] = "salmon",
		[12] = "raisins",
		[13] = "chocolate",
		[14] = "chocolate_p",
		[15] = "nuts",
		[16] = "mint",
		[17] = "mre",
		[18] = "ration_ru",
		[19] = "ration_ukr"
}
local needed = 5
local count	= 0
local item_section
local function calc(temp, item)
if item:section() == item_section then
count = count + 1
end
end
for k,v in pairs(item_sections) do
item_section = v
get_story_object("actor"):iterate_inventory(calc, actor)
end
return count >= needed
end

