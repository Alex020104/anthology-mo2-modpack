	[1] = {center = vector():set(158.169, 0.0, -129.623)} , 
	[2] = {center = vector():set(138.971, 0.0, -153.764)} , 
	[3] = {center = vector():set(151.64, 0.0, -185.099)} , 
	[4] = {center = vector():set(173.674, 0.0, -202.351)} , 
	[5] = {center = vector():set(210.707, 0.0, -220.042)} , 
	[6] = {center = vector():set(227.102, 0.0, -191.345)} , 
	[7] = {center = vector():set(228.842, 0.0, -154.101)} , 
	[8] = {center = vector():set(194.439, 0.0, -134.834)} , 
}

function sad_sim_9_mob_jump_check(actor, npc, p)
	if db.actor:position():distance_to_sqr(vector():set(186.0, 1.0, -170.0)) > 5000.0 then return false end
	local npc_pos = npc:position()
	npc_pos.y = 0
	if npc_pos:distance_to_sqr(sad_sim_9_jump_table[p[1]].center) <= 100.0 then
		--local str = "jump_"..p[1]
		--db.actor:give_game_news("mob in jump zone", str, "ui_iconsTotal_grouping", 0, 3000, 0)
		return true
	else
		return false
	end
end

function sad_time_to_lights_off(actor, npc)
	return db.actor ~= nil and level.get_time_hours() >= 6 and level.get_time_hours() < 21
end

function sad_is_time_in_interval(actor, npc,p) -- interval p[1]:p[2] to p[3]:p[4]
	local m1 = p[1]*60 + p[2]
	local m2 = p[3]*60 + p[4]
	local m = level.get_time_hours()*60 + level.get_time_minutes()
	if m1 > m2 then
		return (m > m1) or (m < m2)
	else
		return (m > m1) and (m < m2)
	end
end

function distance_from_npc_to_obj_le(actor, npc, p) -- dist^2
	local npc_id = get_story_object_id(p[1])
	local npc1 = npc_id and alife():object(npc_id)
	if npc1 then
		return npc:position():distance_to_sqr(npc1.position) < p[2]
	end
	return false
end

function distance_from_npc_to_point_ge(actor, npc, p) -- (path:point:dist^2)
	return npc:position():distance_to_sqr(patrol(p[1]):point(p[2])) >= p[3]
end

function distance_from_npc_to_point_le(actor, npc, p) -- (path:point:dist^2)
	return npc:position():distance_to_sqr(patrol(p[1]):point(p[2])) <= p[3]
end

function sad_npc_has_medkit(actor, npc, p)
