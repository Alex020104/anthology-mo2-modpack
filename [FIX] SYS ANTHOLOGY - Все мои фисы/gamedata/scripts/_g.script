-- 'Проверка обновления скриптов мода.
function mod_update()
   return sgm_flags.bool_mod_update==nil or sgm_flags.bool_mod_update==true
end
-- 'Проверка секундного таймера с коллбеком.
function check_seconds(name)
   if name==1 then name="one"
   elseif name==2 then name="two"
   elseif name==3 then name="three"
   elseif name==4 then name="four"
   elseif name==5 then name="fifth"
   elseif name==10 then name="ten"
   elseif name==20 then name="twenty"
   elseif name==30 then name="thirty"
   elseif name==40 then name="fourty"
   elseif name==50 then name="fifty"
   end
   return sgm_flags["timer_"..name.."_seconds"]==0
end
-- 'Проверка на отсутствие инфопортации.
function dont_has_alife_info(info_id)
   return not has_alife_info(info_id)
end
------------------------------------------------------------------------------
--                      Работа с автосохранениями                           --
------------------------------------------------------------------------------
-- 'Условие для успешного автосохранения.
function autosave_precond()
   if object_exists(db.actor) and device().precache_frame==0 and (not db.actor:is_talking()) then
      return true
   elseif object_exists(db.actor) and device().precache_frame~=0 and (not db.actor:is_talking()) then
      return false
   else
      return false
   end
end
-- 'Запись автосохранения. Если условия не соблюдены, ставится на очередь.
function game_autosave_sgm(save_descr,default_mode)
  if default_mode==nil or default_mode==false then
     if autosave_precond() then
        if save_descr~=nil and dont_has_alife_info(save_descr) then
           give_info(save_descr)
           if IsImportantSave() then
              local save_param = user_name().." - "..game.translate_string("st_"..save_descr)
              get_console():execute("save "..save_param)
           end
        end
     else
        if sgm_flags.table_mod_autosaves[save_descr]==nil and IsImportantSave() then
           sgm_flags.table_mod_autosaves[save_descr]=true
        end
     end
  else
     if (autosave_precond() or find_in_string(save_descr,"st_save_travel_")) and IsImportantSave() then
        local save_param = user_name().." - "..game.translate_string(save_descr)
        get_console():execute("save "..save_param)
     else
        if sgm_flags.table_mod_autosaves[save_descr]==nil and IsImportantSave() then
           sgm_flags.table_mod_autosaves[save_descr]=true
        end
     end
  end
end
