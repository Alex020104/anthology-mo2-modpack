--/ подсчет предметов
function get_item_count(need_item)
   local item_section=need_item
   local has_count=0
   local function calc(temp,item)
      if item:section()==item_section then
         has_count=has_count+1
      end
   end
   db.actor:iterate_inventory(calc,db.actor)
   return has_count
end

