--]] -----------------------------------------------------------------------------------------------
--/											DBG Function
--]] -----------------------------------------------------------------------------------------------
function GetDbgScripts()
	tDbgScr = GetIniSection("tbl_dbg_scripts","sp_configs.ltx")
	local sNotExistMsg, sErrMsg
	for i=1,#tDbgScr do
		local bNotExist
		if not bAuto and not getFS():exist("$game_scripts$", tDbgScr[i]..".script") then
			if tDbgScr[i] ~= "_dbg" then
				sNotExistMsg = "Файл gamedata\\scripts\\" .. tDbgScr[i]..".script" .. " не найден!!!"
			end
			bNotExist = true
		end
		if not bNotExist and not _G[tDbgScr[i]] then
			sErrMsg = "Cкрипт " .. tDbgScr[i] .. " содержит синтаксические ошибки!!!"
		end
	end
	return {sNotExistMsg, sErrMsg}
end

--[[
-- 	Получает ini секцию в таблицу, с заданым типом
-- 	@param	string	sSec	название секции в ини файле.
-- 	@param	table 	...		(путь)Имя файла/Тип таблици(оба параметра не обязательны).
-- 	@return	table
--
--	TODO после завершения отладки перетащить!!!!!!
--]]
function GetIniSection(sSec,...)
	local tRet = {}
	local aArgs = {...}
	local oLtx, tType, bDev
	if next(aArgs) then
		for i=1,2 do
			if tostring(aArgs[i]):match('(.+)%.(%w+)') then
				oLtx = ini_file(aArgs[i])
			else
				tType = aArgs[i]
			end
		end
	end
	oLtx = oLtx or system_ini()
	if GetSectionExist(sSec,oLtx) then
		local bRes, sKey, sValue, s
		if tType then s = "" end
		for i=0, GetLineCount(sSec,oLtx)-1 do
			bRes, sKey, sValue = oLtx:r_line(sSec,i,"",s)
			sKey = tostring(sKey)
			if tType == nil then 							-- в таблицу только одиночные значения
				tRet[#tRet+1] = sKey
			elseif tType == "matrix" then 					-- матрица
				tRet[#tRet+1] = {sKey, sValue}
			elseif tType == "string" then 					-- таблица со строками
				tRet[sKey] = sValue
			elseif tType == "number" then 					-- таблица с числами
				tRet[sKey] = tonumber(sValue)
			elseif tType == "true" and tType == sValue then -- таблица с true
				tRet[sKey] = true
			elseif tType == "bool" then						-- таблица с bool
				if sValue and (sValue == true or sValue=="true") then
					tRet[sKey] = true
				else
					tRet[sKey] = false
				end
			end
		end
		return tRet
	end
end

