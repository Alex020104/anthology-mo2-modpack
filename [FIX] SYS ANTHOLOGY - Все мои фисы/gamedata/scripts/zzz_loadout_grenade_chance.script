local patched = false
local death_manager_patched = false
local original_create_item_on_npc
local wrapped_create_item_on_npc
local original_decide_items_to_keep
local original_keep_item
local wrapped_decide_items_to_keep
local wrapped_keep_item
local loadout_grenade_by_npc = {}
local death_grenade_by_npc = {}

local chance_by_rank = {
	novice       = 15,
	trainee      = 15,
	experienced  = 20,
	professional = 20,
	veteran      = 25,
	expert       = 30,
	master       = 50,
	legend       = 75,
}

local function is_grenade(section)
	if not section or section == "" then
		return false
	end

	if string.sub(section, 1, 8) == "grenade_" then
		return true
	end

	local cls = ini_sys and ini_sys:section_exist(section) and ini_sys:r_string_ex(section, "class")
	return cls and string.sub(cls, 1, 2) == "G_"
end

local function get_rank_chance(rank)
	return chance_by_rank[rank or ""] or 0
end

local function should_keep_grenade(rank)
	local chance = get_rank_chance(rank)
	if chance <= 0 then
		return false
	end

	if chance >= 100 then
		return true
	end

	return math.random(100) <= chance
end

local function get_npc_id(npc)
	if not npc then
		return nil
	end

	local id = npc.id
	if type(id) == "number" then
		return id
	end

	if type(id) == "function" then
		return npc:id()
	end

	return nil
end

local function release_item(item)
	local se_item = item and alife_object(item:id())
	if se_item then
		alife_release(se_item)
	end
end

local function patch_loadouts()
	if not (xrs_rnd_npc_loadout and xrs_rnd_npc_loadout.create_item_on_npc) then
		return
	end

	if patched and xrs_rnd_npc_loadout.create_item_on_npc == wrapped_create_item_on_npc then
		return
	end

	original_create_item_on_npc = xrs_rnd_npc_loadout.create_item_on_npc

	wrapped_create_item_on_npc = function(se_npc, squad_name, comm, rank, visual, player_id, slot_type)
		local npc_id = get_npc_id(se_npc)
		local original_alife_create_item = alife_create_item

		alife_create_item = function(section, obj, t)
			if is_grenade(section) then
				if npc_id and loadout_grenade_by_npc[npc_id] then
					return nil
				end

				if not should_keep_grenade(rank) then
					return nil
				end

				local se_item = original_alife_create_item(section, obj, t)
				if se_item and npc_id then
					loadout_grenade_by_npc[npc_id] = true
				end

				return se_item
			end

			return original_alife_create_item(section, obj, t)
		end

		local ok, result = pcall(original_create_item_on_npc, se_npc, squad_name, comm, rank, visual, player_id, slot_type)
		alife_create_item = original_alife_create_item

		if not ok then
			error(result)
		end

		return result
	end

	xrs_rnd_npc_loadout.create_item_on_npc = wrapped_create_item_on_npc

	patched = true
end

local function patch_death_manager()
	if not (death_manager and death_manager.decide_items_to_keep and death_manager.keep_item) then
		return
	end

	if death_manager_patched and death_manager.decide_items_to_keep == wrapped_decide_items_to_keep then
		return
	end

	original_decide_items_to_keep = death_manager.decide_items_to_keep
	original_keep_item = death_manager.keep_item

	wrapped_decide_items_to_keep = function(npc, npc_id, npc_name)
		if npc_id then
			death_grenade_by_npc[npc_id] = nil
		end

		return original_decide_items_to_keep(npc, npc_id, npc_name)
	end

	wrapped_keep_item = function(npc, item)
		local section = item and item:section()

		if is_grenade(section) then
			local npc_id = npc and npc:id()
			local rank = npc and ranks and ranks.get_obj_rank_name(npc)

			if (npc_id and death_grenade_by_npc[npc_id]) or not should_keep_grenade(rank) then
				release_item(item)
				return
			end

			if npc_id then
				death_grenade_by_npc[npc_id] = true
			end

			return
		end

		return original_keep_item(npc, item)
	end

	death_manager.decide_items_to_keep = wrapped_decide_items_to_keep
	death_manager.keep_item = wrapped_keep_item

	death_manager_patched = true
end

function on_game_start()
	patch_loadouts()
	patch_death_manager()
	if RegisterScriptCallback then
		RegisterScriptCallback("actor_on_first_update", patch_loadouts)
		RegisterScriptCallback("actor_on_first_update", patch_death_manager)
	end
end
