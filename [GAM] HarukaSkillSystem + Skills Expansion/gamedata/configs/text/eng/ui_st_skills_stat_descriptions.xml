    <!-- Scavenging -->
    <string id="st_player_skills_hint_scavenging">
		<text>%c[255,255,255,255]Perception increases the amount of loot you find on stalkers.\n \nThe Perception skill is improved by looting stalkers. \n \n</text>
	</string>
	<string id="st_skills_stats_scavenging_skill_positive">
