    <string id="st_player_skills_hint_survival">
		<text>%c[255,255,255,255]Survival improves your resilience and lets you harvest more body parts.\n \nThe Survival skill is improved by taking damage from bullets and mutants and by field dressing mutants. \n \n</text>
