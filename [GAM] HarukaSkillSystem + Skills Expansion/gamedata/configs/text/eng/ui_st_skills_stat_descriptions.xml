    </string>


    <!-- Strength -->
    <string id="st_player_skills_hint_strength">
		<text>%c[255,255,255,255]Increasing strength allows you to carry more weight and hit harder in melee.\n \nThe Strength skill is improved by moving around with heavy loads and by using melee weapons. \n \n</text>
	</string>

    <string id="st_skills_stats_weight_modifer_positive">
