    <!-- Medicine -->
	<string id="st_player_skills_hint_medicine">
		<text>%c[255,255,255,255]Performing first aid with medical items grants a short burst of improved health or radiation restoration based on the item.\n \nThe First Aid skill is improved by using medicine and drug items.\n \n</text>
	</string>
	<string id="st_skills_stats_restore_boost_positive">
        <text>\n%c[d_cyan]•%c[255,255,255,255] Restoration Boost from Medical Items: %c[d_cyan]+$stat %</text>
    </string>
