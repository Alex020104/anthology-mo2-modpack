        <text>\n%c[255,255,86,86]•%c[255,255,255,255] Restoration Boost from Medical Items: %c[255,255,86,86]$stat %</text>
    </string>

	<!-- Insanity -->
	<string id="st_player_skills_hint_insanity">
		<text>%c[255,255,255,255]Stress resistance speeds up psy recovery and affects how much psy damage you take.\n \nThe Stress Resistance skill is improved by taking psy damage and by playing instruments in combat.\n \n%c[d_cyan]Psy Recovery Rate%c[255,255,255,255] bonus is doubled when playing an instrument.\n \n</text>
	</string>
    <string id="st_skills_stats_psy_regen_positive">
        <text>\n%c[d_cyan]•%c[255,255,255,255] Psy Recovery Rate: %c[d_cyan]+$stat% %c[255,255,255,255]/sec</text>
    </string>

    <string id="st_skills_stats_psy_hit_resistance_positive">
