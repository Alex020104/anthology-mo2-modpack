-- Вспомогательная функция для записи конфигурационных файлов через виртуальную файловую систему движка ($game_config$)
local function write_gamedata_file(relative_name, content)
    local fs = getFS()
    if not fs then
        printf("[G2X_Writer] ERROR: getFS() unavailable")
        return false
    end
    -- Получаем реальный путь внутри виртуальной папки конфигов игры																														  
    local file_path = fs:update_path("$game_config$", relative_name)
    local f, err = io.open(file_path, "wb")
    if not f then
        printf("[G2X_Writer] ERROR: io.open write failed for %s: %s", tostring(file_path), tostring(err))
        return false
    end
    f:write(content)
    f:close()
    printf("[G2X_Writer] Successfully written config: %s", file_path)
    return true
end

-- Вспомогательная функция для безопасного извлечения числовых значений из пресета по умолчанию
local function parse_preset_color(color_str, index)
    if not color_str then return 1.0 end
    local t = {}
    for val in string.gmatch(color_str, "[^,%s]+") do
        table.insert(t, tonumber(val) or 1.0)
    end
    return t[index] or 1.0
end

-- Главная функция применения настроек из MCM меню
function apply_mcm_settings()
    if not ui_mcm then return end

    -- Считываем выбранные ключи пресетов из MCM
    local hl_key = ui_mcm.get("g2x_module/g2x/hl_preset") or "hl_ref_600_5500k"
    local fl_key = ui_mcm.get("g2x_module/g2x/fl_preset") or "fl_tir_600_5500k"

    -- Получаем таблицы пресетов по ключам
    local hl = PRESETS_HEADLAMP[hl_key] or PRESETS_HEADLAMP["hl_ref_600_5500k"]
    local fl = PRESETS_FLASHLIGHT[fl_key] or PRESETS_FLASHLIGHT["fl_tir_600_5500k"]

    -- =========================================================================
    -- ЛОГИКА РУЧНЫХ ОВЕРРАЙДОВ (ПЕРЕХВАТА) ИЗ MCM (ТОЛЬКО ДЛЯ DX11 / R2)
    -- =========================================================================
    
    -- Проверяем включен ли ручной режим для налобника
    local hl_manual    = ui_mcm.get("g2x_module/g2x/hl_manual_override")

    local hl_omni_r2   = (hl_manual and ui_mcm.get("g2x_module/g2x/hl_omni_range_r2")) or (hl.omni_range_r2 or 0)

    local hl_range_r2  = (hl_manual and ui_mcm.get("g2x_module/g2x/hl_range_r2")) or hl.range
    local hl_angle     = (hl_manual and ui_mcm.get("g2x_module/g2x/hl_spot_angle")) or hl.spot_angle

    -- Сборка строки цвета для налобника из ползунков или пресета
    local hl_color_r2 = hl.color_r2
    if hl_manual then
        local r2 = ui_mcm.get("g2x_module/g2x/hl_color_r2_r") or parse_preset_color(hl.color_r2, 1)
        local g2 = ui_mcm.get("g2x_module/g2x/hl_color_r2_g") or parse_preset_color(hl.color_r2, 2)
        local b2 = ui_mcm.get("g2x_module/g2x/hl_color_r2_b") or parse_preset_color(hl.color_r2, 3)
        local a2 = ui_mcm.get("g2x_module/g2x/hl_color_r2_a") or parse_preset_color(hl.color_r2, 4)
        hl_color_r2 = string.format("%.2f,%.2f,%.2f,%.2f", r2, g2, b2, a2)
    end

    -- Проверяем включен ли ручной режим для тактического фонаря
    local fl_manual    = ui_mcm.get("g2x_module/g2x/fl_manual_override")

    local fl_omni_r2   = (fl_manual and ui_mcm.get("g2x_module/g2x/fl_omni_range_r2")) or (fl.omni_range_r2 or 0)

    local fl_range_r2  = (fl_manual and ui_mcm.get("g2x_module/g2x/fl_range_r2")) or fl.range
    local fl_angle     = (fl_manual and ui_mcm.get("g2x_module/g2x/fl_spot_angle")) or fl.spot_angle


    -- Сборка строки цвета для тактика из ползунков или пресета
    local fl_color_r2 = fl.color_r2
    if fl_manual then
        local fr2 = ui_mcm.get("g2x_module/g2x/fl_color_r2_r") or parse_preset_color(fl.color_r2, 1)
        local fg2 = ui_mcm.get("g2x_module/g2x/fl_color_r2_g") or parse_preset_color(fl.color_r2, 2)
        local fb2 = ui_mcm.get("g2x_module/g2x/fl_color_r2_b") or parse_preset_color(fl.color_r2, 3)
        local fa2 = ui_mcm.get("g2x_module/g2x/fl_color_r2_a") or parse_preset_color(fl.color_r2, 4)
        fl_color_r2 = string.format("%.2f,%.2f,%.2f,%.2f", fr2, fg2, fb2, fa2)
    end

    -- Текстуры свечения (свечения подбираются автоматически под красный диод или кастомный пресет)
    local hl_glow = hl.glow_texture or (hl.is_red and "glow\\glow_yellow_01" or "glow\\glow_yellow")
    local fl_glow = fl.glow_texture or "glow\\glow_tactical_torch"

    -- Генерация содержимого LTX-файла для налобного фонаря (только DX11 параметры)
    local hl_ltx = "; DLTX Auto-generated Headlamp Buffer (DX11)\n" ..
        "![torch_definition]\n" ..
        "omni_range              = 0\n" ..
        "omni_range_r2           = " .. tostring(hl_omni_r2) .. "\n" ..
        "range                   = " .. tostring(hl_range_r2) .. "\n" ..
        "range_r2                = " .. tostring(hl_range_r2) .. "\n" ..
        "spot_angle              = " .. tostring(hl_angle) .. "\n" ..
        "color                   = 1.0, 1.0, 1.0, 0.2\n" ..
        "color_r2                = " .. tostring(hl_color_r2) .. "\n" ..
        "spot_texture            = " .. tostring(hl.spot_texture) .. "\n" ..
        "glow_texture            = " .. tostring(hl_glow) .. "\n" ..
        "color_animator          = empty\n" ..
        "volumetric              = false\n" ..
        "volumetric_quality      = " .. tostring(hl.v_q) .. "\n" ..
        "volumetric_intensity    = " .. tostring(hl.v_i) .. "\n" ..
        "volumetric_distance     = " .. tostring(hl.v_d) .. "\n"

    -- Генерация содержимого LTX-файла для тактического фонаря (только DX11 параметры)
    local fl_ltx = "; DLTX Auto-generated Flashlight Buffer (DX11)\n" ..
        "![flashlight_definition]\n" ..
        "omni_range              = 0\n" ..
        "omni_range_r2           = " .. tostring(fl_omni_r2) .. "\n" ..
        "range                   = " .. tostring(fl_range_r2) .. "\n" ..
        "range_r2                = " .. tostring(fl_range_r2) .. "\n" ..
        "spot_angle              = " .. tostring(fl_angle) .. "\n" ..
        "color                   = 1.0, 1.0, 1.0, 0.2\n" ..
        "color_r2                = " .. tostring(fl_color_r2) .. "\n" ..
        "spot_texture            = " .. tostring(fl.spot_texture) .. "\n" ..
        "glow_texture            = " .. tostring(fl_glow) .. "\n" ..
        "color_animator          = empty\n" ..
        "volumetric              = false\n" ..
        "volumetric_quality      = " .. tostring(fl.v_q) .. "\n" ..
        "volumetric_intensity    = " .. tostring(fl.v_i) .. "\n" ..
        "volumetric_distance     = " .. tostring(fl.v_d) .. "\n"

    -- Запись сгенерированных конфигураций в файлы DLTX
	write_gamedata_file("mod_system_z_ref_torch_definition.ltx", hl_ltx)
	write_gamedata_file("mod_system_z_red_flashlight_definition.ltx", fl_ltx)

    -- Генерация фикса позиций (подмена .ogf моделей и смещений для стандартного/красного налобника)
    local pos_fix_ltx = ""
    if hl.is_red then
        pos_fix_ltx = "; DLTX Position Fix (Red LED Variant with custom model)\n" ..
            "![device_torch]\n" ..
            "attach_angle_offset     = 0.02, -3.14, 1.57\n" ..
            "attach_position_offset  = 0.115, 0.0, 0.082\n" ..
            "visual                  = dynamics\\devices\\dev_torch_light\\dev_torch_light_red.ogf\n"
    else
        pos_fix_ltx = "; DLTX Position Fix (Standard Variant)\n" ..
            "![device_torch]\n" ..
            "attach_angle_offset     = 0.07, -3.14, 1.57\n" ..
            "attach_position_offset  = 0.115, 0.0, 0.082\n" ..
            "visual                  = dynamics\\devices\\dev_torch_light\\dev_torch_light.ogf\n"
    end

    write_gamedata_file("mod_system_position_fix.ltx", pos_fix_ltx)
end

-- Обработчик события изменения настроек в MCM меню
function on_option_change()
    apply_mcm_settings()
end

-- Регистрация игровых колбэков при старте
function on_game_start()
    RegisterScriptCallback("on_option_change", on_option_change)
    RegisterScriptCallback("on_game_load", apply_mcm_settings)
    apply_mcm_settings()
end