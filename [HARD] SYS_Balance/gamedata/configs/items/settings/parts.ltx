;[[

; Tronex
; Item disassembly and parts (Normal / Conditional)
;--------------------------------------------------
; You can define items componenets/parts in here, they are divided in 2 groups: conditional and normal
; Difference is that conditional items (outfits/weapons) can be repaired at the workshop by using identical parts (those parts should have condition enabled) (defined under [con_parts_list])
; Normal items don't have this feature, their componenets are mostly used for crafing (defined under [nor_parts_list])

;-- ATTENTION about conditional items:
;-- never add identical parts for your item. Every part must be different for the same item
;-- You can add up to 6 parts here

;]]

;;--==========================< Settings >=============================
[settings]
disassembly_chance = 40 ;-- A permanent increase in the chance of obtaining a part when disassembling, in formula wpn_cond*100+x >= math.random(1,100)


[weapons_spare_parts]
prt_i_scrap


