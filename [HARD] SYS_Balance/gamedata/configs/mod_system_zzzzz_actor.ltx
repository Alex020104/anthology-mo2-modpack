; ============================================================
; ============================================================
; ACTOR – Conditions / Radiation / Environmental Effects
; ============================================================
; satiety_v                – rate at which hunger / satiety decreases over time
; radiation_v              – rate at which actor accumulates radiation naturally
; radiation_health_v       – effect of radiation on health over time
; radio_zone_max_power     – max damage / effect power from radio anomalies
; fire_zone_max_power      – max damage / effect power from fire anomalies
; acid_zone_max_power      – max damage / effect power from acid anomalies
; psi_zone_max_power       – max damage / effect power from psychic / psionic anomalies
; electra_zone_max_power   – max damage / effect power from electricity / shock anomalies
; ============================================================
![actor_condition]
satiety_v                   = 0.000033
fire_zone_max_power			= 0.59
acid_zone_max_power			= 0.55
psi_zone_max_power			= 0.265
electra_zone_max_power		= 1.32
