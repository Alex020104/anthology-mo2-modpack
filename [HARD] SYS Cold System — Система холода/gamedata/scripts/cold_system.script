--------------------- wind  ---------------------
function actor_on_first_update()
	local g_pairs = pairs
	if not (cold.val) then cold.val = 0 end
	if not (cold.sickness) then cold.sickness = 0 end

	-- get config names
	local wthr_tbl = {}
	local folder = getFS():file_list_open("$game_weathers$", 1)
	local folder_size = folder:Size()
	for i = 1, folder_size - 1 do
		local file = folder:GetAt(i)
		wthr_tbl[i] = file
	end

	-- get wind_velocity of each config's section
	local wind_tbl = {}
	for id, file_name in g_pairs(wthr_tbl) do
		local wthr_ini = ini_file_ex("environment\\weathers\\" .. tostring(file_name) .. "").ini
		wthr_ini:section_for_each(function(section)
			wind_tbl[#wind_tbl + 1] = wthr_ini:r_float_ex(section, "wind_velocity") or 0
		end)
	end

	-- get max wind_velocity
	max_wind_velocity = haruwu_sort(wind_tbl)

	-- extra outfit check
	outfit_check()

	for k, v in g_pairs(wthr_tbl) do
		pr("wthr tbl: [ %s ] | [ %s ] ", k, v)
	end

	for k, v in g_pairs(wind_tbl) do
		pr("wind tbl: [ %s ] | [ %s ]", k, v)
	end

	pr("max_wind_velocity: [ %s ]", max_wind_velocity)

end

--------------------- indoors ---------------------
function actor_indoors()
	local indoors = GetEvent("current_safe_cover")
	if indoors then
		return true
	end

	return false
end

--------------------- rain ---------------------
function set_rain_rays()
	local hitbox = 0.6
	local range = 200
	rain_indoors[1] = ray_main(0, 0, 0, range, 0, 0.5, 0)
	rain_indoors[2] = ray_main(hitbox, 0, 0, range, 0, 0.5, 0)
	rain_indoors[3] = ray_main(-hitbox, 0, 0, range, 0, 0.5, 0)
	rain_indoors[4] = ray_main(0, 0, hitbox, range, 0, 0.5, 0)
	rain_indoors[5] = ray_main(0, 0, -hitbox, range, 0, 0.5, 0)

end

function actor_rain_indoors()
	set_rain_rays()

	local cnt = 0
	for k, v in pairs(rain_indoors) do
		if v > 0 then
			cnt = cnt + 1
		end
	end

	if cnt >= 3 then
		return true
	end

	return false
end

--------------------- time ---------------------
function calc_winter_time()
	local winter_time
	local hours = level.get_time_hours() + level.get_time_minutes() / 60
	local min_period = (hours >= 12 and hours <= 14) and 0.25 or nil
	local max_period = (hours >= 23 or hours <= 4) and 1 or nil

	if hours > 4 and hours < 12 then
		winter_time = -0.1036 * hours + 1.44
	elseif hours > 14 and hours < 23 then
		winter_time = 0.0816 * hours - 0.897
	else
		winter_time = min_period or max_period or 0.25
	end

	return winter_time * 2
end

function calc_summer_time()
	local summer_time
	local hours = level.get_time_hours() + level.get_time_minutes() / 60
	local min_period = (hours >= 11 and hours <= 16) and 0 or nil
	local max_period = (hours >= 1 and hours <= 3) and 0.75 or nil

	if hours >= 0 and hours < 1 then
		hours = hours + 24
	end

	if hours > 3 and hours < 11 then
		summer_time = -0.09 * hours + 1.02
	elseif hours > 16 and hours < 25 then
		summer_time = 0.0816 * hours - 1.311
	else
		summer_time = min_period or max_period or 0
	end

	return summer_time
end

--------------------- outfit ---------------------
local function section_has_marker(sec, marker_t)
	if not sec then return false end
	local s = slower(sec)
	for marker, _ in pairs(marker_t) do
		if sfind(s, marker, 1, true) then
			return true
		end
	end

	return false
end

local function is_exo_section(sec)
	if not sec then return false end
	sec = slower(sec)
	return sfind(sec, "nosorog", 1, true) or sfind(sec, "exolight", 1, true) or sfind(sec, "proto_exo", 1, true) or sfind(sec, "_exo", 1, true) or sfind(sec, "exo_", 1, true)
end

local function get_outfit_cold_protection(sec, kind)
	local prot = kind and outfit_kind[kind] or nil
	if not prot then
		prot = outfit_kind["no_outfit"]
	end

	if sec then
		local s = slower(sec)
		for marker, value in pairs(outfit_grade) do
			if sfind(s, marker, 1, true) and value > prot then
				prot = value
			end
		end
	end

	return prot
end

local function is_warm_headgear(obj)
	local sec = obj and obj:section() or nil
	if section_has_marker(sec, warm_headgear) then
		return true
	end

	local inv_name = sec and ini_sys:r_string_ex(sec, "inv_name") or nil
	if section_has_marker(inv_name, warm_headgear) then
		return true
	end

	local inv_name_short = sec and ini_sys:r_string_ex(sec, "inv_name_short") or nil
	return section_has_marker(inv_name_short, warm_headgear)
end

local function refresh_equipment_cold_protection()
	local outfit = db.actor:item_in_slot(7)
	local sec = outfit and outfit:section() or nil
	local kind = sec and ini_sys:r_string_ex(sec, "kind") or nil
	outfit_mult = get_outfit_cold_protection(sec, kind)
	outfit_freeze_immune = is_exo_section(sec)

	for i = 1, 13 do
		local obj = db.actor:item_in_slot(i)
		if obj and IsHeadgear(obj) and is_warm_headgear(obj) then
			outfit_mult = outfit_mult + warm_headgear_bonus
			break
		end
	end
end

function slot_in_out(obj)
	if obj and not (IsOutfit(obj) or IsHeadgear(obj)) then return end
	refresh_equipment_cold_protection()
end

function outfit_check()
	refresh_equipment_cold_protection()
end

--------------------- campfire (arti) ---------------------
function campfire_check(dist)
    if not (bind_campfire and bind_campfire.campfires_all and db and db.actor) then
        return nil
    end

    local pos = db.actor:position()
    local nearest_dist = nil

    for _, binder in pairs(bind_campfire.campfires_all) do
        if binder and binder.campfire and binder.object and binder.campfire:is_on() then
            local campfire_pos = binder.object:position()
            if campfire_pos then
                local current_dist = pos:distance_to(campfire_pos)
                if current_dist <= dist and (not nearest_dist or current_dist < nearest_dist) then
                    nearest_dist = current_dist
                end
            end
        end
    end

    return nearest_dist
end
