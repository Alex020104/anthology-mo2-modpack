----------------------- utils ------------------------------
----------------------------------------------------------
function pr(...)
	if not (cold_system_mcm.get_config("debugx")) then return end
	printf(...)
end

function r(val)
	return round_idp(val, 2)
end

function cold_system_get_state()
	return cold
end

function cold_system_get_status_info()
	local cold_val = tonumber(cold and cold.val) or 0
	local sickness_val = tonumber(cold and cold.sickness) or 0
	local cold_percent = 0
	if (max_cold or 0) > 0 then
		cold_percent = math.floor((cold_val / max_cold) * 100 + 0.5)
	end

	return {
		cold_val = cold_val,
		cold_percent = cold_percent,
		sickness = sickness_val,
		max_cold = max_cold,
	}
end

cold_system = cold_system or {}
cold_system.get_state = cold_system_get_state
cold_system.get_status_info = cold_system_get_status_info

function haruwu_sort(a)
	local t = {}
	for k, v in pairs(a) do
		t[#t+1] =  v
	end
	table.sort(t)

	return t[#t]
end

function get_pos_vec(add_pos_x, add_pos_y, add_pos_z)
	local pos = device().cam_pos
	pos.x = pos.x + add_pos_x
	pos.y = pos.y + add_pos_y
	pos.z = pos.z + add_pos_z

	return pos
end

function ray_main(add_x, add_y, add_z, range, dir_x, dir_y, dir_z)
	local pick = ray_pick()
	local pos = get_pos_vec(add_x, add_y, add_z)
	pick:set_position(pos)
	pick:set_direction(vector():set(dir_x, dir_y, dir_z))
	pick:set_flags(2)
	pick:set_range(range)
	pick:query()
	local distance = pick:get_distance()

	return distance
end

