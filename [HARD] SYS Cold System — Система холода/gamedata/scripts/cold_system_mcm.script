	["hud"] = false,
	["keybind"] = 50,
	["main_hud_position_x"] = 884,
	["main_hud_position_y"] = 189,
	["main_bar_text_mode"] = false,
	["main_hud_font"] = 4,
	["main_hud_descr_type"] = 2,
	["thermo_hud_position_x"] = 980,
	["thermo_hud_position_y"] = 50,
	["thermo_bar_text_mode"] = false,
	["thermo_hud_font"] = 4,
	["thermo_hud_descr_type"] = 1,

	["sickness"] = 1,
	["medicine"] = 1,
	["sleep"] = 1,
	["food_cooling"] = 1,
	["consumables"] = 1,
	["ppe"] = true,
	["debugx"] = false,
